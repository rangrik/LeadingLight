--- /dev/null
+++ b/cmd/berthd/mobile_address.go
@@ -0,0 +1,44 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+
+	"github.com/cosscom/shipyard/internal/network"
+	"tailscale.com/ipn/ipnstate"
+)
+
+// LeadingLight: an ISP may use CGNAT too; only Tailscale can name its own address.
+func mobileAddr() (string, error) {
+	return confirmedMobileAddr(context.Background(), network.SystemStatus, interfaceIPs())
+}
+
+func confirmedMobileAddr(ctx context.Context, status func(context.Context) (*ipnstate.Status, error), local []net.IP) (string, error) {
+	st, err := status(ctx)
+	if err != nil {
+		return "", errors.New("Open Tailscale on this Mac and make sure its command-line tool is available.")
+	}
+	if st == nil || st.BackendState != "Running" || st.Self == nil {
+		return "", errors.New("Connect Tailscale on this Mac before allowing mobile access.")
+	}
+	present := map[netip.Addr]bool{}
+	for _, ip := range local {
+		if addr, ok := netip.AddrFromSlice(ip); ok {
+			present[addr.Unmap()] = true
+		}
+	}
+	for _, ipv4 := range []bool{true, false} {
+		for _, addr := range st.Self.TailscaleIPs {
+			addr = addr.Unmap()
+			if addr.Is4() != ipv4 || !present[addr] {
+				continue
+			}
+			if carrierGradeNAT.Contains(addr) || netip.MustParsePrefix("fd7a:115c:a1e0::/48").Contains(addr) {
+				return addr.String(), nil
+			}
+		}
+	}
+	return "", errors.New("Tailscale has no active address on this Mac. Reconnect Tailscale and try again.")
+}
