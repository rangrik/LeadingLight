index 0000000..6c2c8e5
--- /dev/null
+++ b/internal/box/mobile_tls.go
@@ -0,0 +1,54 @@
+package box
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/base64"
+	"encoding/pem"
+	bigint "math/big"
+	"net"
+	"os"
+	"time"
+
+	"github.com/cosscom/shipyard/internal/statefile"
+)
+
+// LeadingLight: the pairing code pins this certificate, including its IP address.
+func mobileCertificate(path, host string) (tls.Certificate, string, error) {
+	if data, err := os.ReadFile(path); err == nil {
+		if pair, err := tls.X509KeyPair(data, data); err == nil && len(pair.Certificate) > 0 {
+			if cert, err := x509.ParseCertificate(pair.Certificate[0]); err == nil && cert.VerifyHostname(host) == nil && time.Now().After(cert.NotBefore) && time.Now().Add(24*time.Hour).Before(cert.NotAfter) {
+				return pair, base64.StdEncoding.EncodeToString(cert.Raw), nil
+			}
+		}
+	} else if !os.IsNotExist(err) {
+		return tls.Certificate{}, "", err
+	}
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		return tls.Certificate{}, "", err
+	}
+	serial, err := rand.Int(rand.Reader, new(bigint.Int).Lsh(bigint.NewInt(1), 128))
+	if err != nil {
+		return tls.Certificate{}, "", err
+	}
+	cert := &x509.Certificate{SerialNumber: serial, Subject: pkix.Name{CommonName: "LeadingLight Mac"}, NotBefore: time.Now().Add(-5 * time.Minute), NotAfter: time.Now().AddDate(5, 0, 0), IPAddresses: []net.IP{net.ParseIP(host)}, KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, BasicConstraintsValid: true, IsCA: false}
+	der, err := x509.CreateCertificate(rand.Reader, cert, cert, &key.PublicKey, key)
+	if err != nil {
+		return tls.Certificate{}, "", err
+	}
+	private, err := x509.MarshalPKCS8PrivateKey(key)
+	if err != nil {
+		return tls.Certificate{}, "", err
+	}
+	data := append(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: private})...)
+	if err := statefile.Write(path, data); err != nil {
+		return tls.Certificate{}, "", err
+	}
+	pair, err := tls.X509KeyPair(data, data)
+	return pair, base64.StdEncoding.EncodeToString(der), err
+}
