@@ -0,0 +1,42 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"tailscale.com/ipn/ipnstate"
+)
+
+// The seam is plaintext binding: an unrelated CGNAT interface is never a trusted tunnel.
+func TestMobileAddressRequiresTailscaleSelfAndLocalInterface(t *testing.T) {
+	for _, tc := range []struct {
+		name, status string
+		local        []string
+		want         string
+	}{
+		{"own IPv4", `{"BackendState":"Running","Self":{"TailscaleIPs":["100.90.1.2"]}}`, []string{"100.64.1.1", "100.90.1.2"}, "100.90.1.2"},
+		{"unrelated CGNAT", `{"BackendState":"Running","Self":{"TailscaleIPs":["100.90.1.2"]}}`, []string{"100.64.1.1"}, ""},
+		{"peer is not self", `{"BackendState":"Running","TailscaleIPs":["100.64.1.1"]}`, []string{"100.64.1.1"}, ""},
+		{"disconnected", `{"BackendState":"Stopped","Self":{"TailscaleIPs":["100.64.1.1"]}}`, []string{"100.64.1.1"}, ""},
+		{"own IPv6", `{"BackendState":"Running","Self":{"TailscaleIPs":["fd7a:115c:a1e0::1"]}}`, []string{"fd7a:115c:a1e0::1"}, "fd7a:115c:a1e0::1"},
+		{"not a tailnet address", `{"BackendState":"Running","Self":{"TailscaleIPs":["192.168.1.1"]}}`, []string{"192.168.1.1"}, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			status := func(context.Context) (*ipnstate.Status, error) {
+				var st ipnstate.Status
+				err := json.Unmarshal([]byte(tc.status), &st)
+				return &st, err
+			}
+			got, err := confirmedMobileAddr(context.Background(), status, ips(tc.local...))
+			if got != tc.want || (err == nil) != (tc.want != "") {
+				t.Fatalf("got %q, %v", got, err)
+			}
+		})
+	}
+	unavailable := func(context.Context) (*ipnstate.Status, error) { return nil, errors.New("missing CLI") }
+	if got, err := confirmedMobileAddr(context.Background(), unavailable, ips("100.64.1.1")); got != "" || err == nil {
+		t.Fatal(got, err)
+	}
+}
