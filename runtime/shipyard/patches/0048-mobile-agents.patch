+package box
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/base64"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// The seam is the credential transport: only the pinned key and address complete TLS.
+func TestMobileTLSRequiresThePinnedCertificateAndAddress(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "mobile.pem")
+	pair, encoded, err := mobileCertificate(file, "127.0.0.1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, again, err := mobileCertificate(file, "127.0.0.1")
+	if err != nil || again != encoded {
+		t.Fatal("certificate changed", err)
+	}
+	if st, _ := os.Stat(file); st.Mode().Perm() != 0600 {
+		t.Fatal(st.Mode())
+	}
+	der, _ := base64.StdEncoding.DecodeString(encoded)
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cert.IsCA {
+		t.Fatal("server must be an end-entity certificate")
+	}
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var reached atomic.Int32
+	srv := &http.Server{ErrorLog: log.New(io.Discard, "", 0), Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { reached.Add(1); w.WriteHeader(204) })}
+	go srv.Serve(tls.NewListener(ln, &tls.Config{MinVersion: tls.VersionTLS13, Certificates: []tls.Certificate{pair}}))
+	t.Cleanup(func() { srv.Close() })
+	request := func(roots *x509.CertPool, host string) error {
+		tr := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots, ServerName: host, MinVersion: tls.VersionTLS13}}
+		defer tr.CloseIdleConnections()
+		client := &http.Client{Transport: tr, Timeout: 3 * time.Second}
+		req, _ := http.NewRequest("GET", "https://"+ln.Addr().String(), nil)
+		req.Header.Set("Authorization", "Bearer device-secret")
+		res, err := client.Do(req)
+		if res != nil {
+			res.Body.Close()
+		}
+		return err
+	}
+	roots := x509.NewCertPool()
+	roots.AddCert(cert)
+	if err := request(roots, "127.0.0.1"); err != nil {
+		t.Fatal("pinned handshake", err)
+	}
+	if err := request(roots, "100.64.0.1"); err == nil {
+		t.Fatal("wrong address accepted")
+	}
+	if err := request(x509.NewCertPool(), "127.0.0.1"); err == nil {
+		t.Fatal("untrusted certificate accepted")
+	}
+	_, otherEncoded, err := mobileCertificate(filepath.Join(t.TempDir(), "other.pem"), "127.0.0.1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	otherDER, _ := base64.StdEncoding.DecodeString(otherEncoded)
+	other, _ := x509.ParseCertificate(otherDER)
+	wrong := x509.NewCertPool()
+	wrong.AddCert(other)
+	if err := request(wrong, "127.0.0.1"); err == nil {
+		t.Fatal("another Mac's pin accepted")
+	}
+	if reached.Load() != 1 {
+		t.Fatal("credentials reached an unverified endpoint", reached.Load())
+	}
+	if _, changed, err := mobileCertificate(file, "100.64.0.1"); err != nil || changed == encoded {
+		t.Fatal("address change must require pairing", err)
+	}
+}
