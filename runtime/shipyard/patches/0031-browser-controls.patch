+func (br *browser) rememberRefusal(id string) {
+	r, ok := br.controls.requests[id]
+	if !ok || len(br.controls.refusedHosts) >= 32 {
+		return
+	}
+	px, err := br.m.b.BrowserProxies.For(br.m.b, br.path)
+	if err != nil || !px.refusedAfter(r.host, r.started) {
+		return
+	}
+	if br.controls.refusedHosts == nil {
+		br.controls.refusedHosts = map[string]bool{}
+	}
+	br.controls.refusedHosts[r.host] = true
+}
+
+func (br *browser) controlEvent(method string, raw json.RawMessage) {
+	br.mu.Lock()
+	defer br.mu.Unlock()
+	if br.controls.closed {
+		return
+	}
+	switch method {
+	case "Page.frameAttached":
+		var p struct {
+			ID string `json:"frameId"`
+		}
+		if json.Unmarshal(raw, &p) == nil {
+			if br.controls.frames == nil {
+				br.controls.frames = map[string]bool{}
+			}
+			br.controls.frames[p.ID] = true
+		}
+	case "Page.frameDetached":
+		var p struct {
+			ID string `json:"frameId"`
+		}
+		if json.Unmarshal(raw, &p) == nil {
+			delete(br.controls.frames, p.ID)
+		}
+	case "Page.frameNavigated":
+		var p struct {
+			Frame struct {
+				ID string `json:"id"`
+			} `json:"frame"`
+		}
+		if json.Unmarshal(raw, &p) == nil {
+			if br.controls.frames == nil {
+				br.controls.frames = map[string]bool{}
+			}
+			br.controls.frames[p.Frame.ID] = true
+			if p.Frame.ID == br.target {
+				br.controls.chooser, br.controls.chooserID = 0, ""
+				br.invalidateInspections()
+			}
+		}
+	case "Page.navigatedWithinDocument":
+		var p struct {
+			Frame string `json:"frameId"`
+		}
+		json.Unmarshal(raw, &p)
+		if p.Frame == br.target {
+			br.controls.chooser, br.controls.chooserID = 0, ""
+			br.invalidateInspections()
+			br.controls.requests, br.controls.refusedHosts = nil, nil
+		}
+	case "Page.frameStartedLoading":
+		var p struct {
+			Frame string `json:"frameId"`
+		}
+		json.Unmarshal(raw, &p)
+		if p.Frame != br.target {
+			return
+		}
+		br.controls.loading = true
+		br.controls.failure = ""
+		br.controls.requests, br.controls.refusedHosts = nil, nil
+	case "Page.frameStoppedLoading":
+		var p struct {
+			Frame string `json:"frameId"`
+		}
+		json.Unmarshal(raw, &p)
+		if p.Frame != br.target {
+			return
+		}
+		br.controls.loading = false
+	case "Page.loadEventFired":
+		br.controls.loading = false
+		factor := br.controls.zoom
+		if factor > 0 && factor != 1 {
+			go func() {
+				ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+				defer cancel()
+				br.applyControlZoom(ctx, 0)
+			}()
+		}
+	case "Page.javascriptDialogOpening":
+		var d BrowserDialog
+		if json.Unmarshal(raw, &d) == nil {
+			br.controls.dialog = &d
+		}
+	case "Page.javascriptDialogClosed":
+		br.controls.dialog = nil
+	case "Page.fileChooserOpened":
+		var p struct {
+			BackendNodeID int64  `json:"backendNodeId"`
+			Mode          string `json:"mode"`
+		}
+		if json.Unmarshal(raw, &p) == nil {
+			br.controls.chooserSeq++
+			br.controls.chooserID = fmt.Sprintf("%s-%d", br.target, br.controls.chooserSeq)
+			br.controls.chooser = p.BackendNodeID
+			br.controls.multiple = p.Mode == "selectMultiple"
+		}
+	case "Network.requestWillBeSent":
+		var p struct {
+			ID       string  `json:"requestId"`
+			Frame    string  `json:"frameId"`
+			Type     string  `json:"type"`
+			WallTime float64 `json:"wallTime"`
+			Request  struct {
+				URL string `json:"url"`
+			} `json:"request"`
+		}
+		if json.Unmarshal(raw, &p) != nil {
+			return
+		}
+		if u, err := url.Parse(p.Request.URL); err == nil && (u.Scheme == "http" || u.Scheme == "https") && u.Hostname() != "" && len(u.Hostname()) <= 253 && p.WallTime > 0 {
+			if br.controls.requests == nil {
+				br.controls.requests = map[string]browserControlRequest{}
+			}
+			if _, known := br.controls.requests[p.ID]; known || len(br.controls.requests) < 512 {
+				br.controls.requests[p.ID] = browserControlRequest{strings.TrimSuffix(strings.ToLower(u.Hostname()), "."), time.Unix(0, int64(p.WallTime*float64(time.Second)))}
+			}
+		}
+		if p.Frame == br.target && p.Type == "Document" {
+			if br.controls.mainRequests == nil {
+				br.controls.mainRequests = map[string]bool{}
+			}
+			br.controls.mainRequests[p.ID] = true
+		}
+	case "Network.responseReceived":
+		var p struct {
+			ID       string `json:"requestId"`
+			Response struct {
+				Status int `json:"status"`
+			} `json:"response"`
+		}
+		if json.Unmarshal(raw, &p) == nil && p.Response.Status == http.StatusForbidden {
+			br.rememberRefusal(p.ID)
+		}
+	case "Network.loadingFinished":
+		var p struct {
+			ID string `json:"requestId"`
+		}
+		if json.Unmarshal(raw, &p) == nil {
+			delete(br.controls.mainRequests, p.ID)
+			delete(br.controls.requests, p.ID)
+		}
+	case "Network.loadingFailed":
+		var p struct {
+			ID        string `json:"requestId"`
+			Type      string `json:"type"`
+			ErrorText string `json:"errorText"`
+			Canceled  bool   `json:"canceled"`
+		}
+		if json.Unmarshal(raw, &p) == nil && br.controls.mainRequests[p.ID] && !p.Canceled {
+			br.controls.failure = p.ErrorText
+			br.controls.loading = false
+		}
+		if !p.Canceled {
+			br.rememberRefusal(p.ID)
+		}
+		delete(br.controls.mainRequests, p.ID)
+		delete(br.controls.requests, p.ID)
+	case "Inspector.targetCrashed":
+		br.controls.failure = "This tab crashed. Reload to try again."
+		br.controls.loading = false
+	}
+}
+
+func (c *chromium) controlTargetEvent(method string, raw json.RawMessage) {
+	if method == "Target.targetDestroyed" {
+		var p struct {
+			TargetID string `json:"targetId"`
+		}
+		json.Unmarshal(raw, &p)
+		for _, br := range c.list() {
+			if br.target == p.TargetID {
+				c.forgetControlTab(br, "closed")
+			}
+		}
+	}
+	if method != "Target.targetCreated" {
+		return
+	}
+	var p struct {
+		Info struct {
+			ID      string `json:"targetId"`
+			Type    string `json:"type"`
+			Opener  string `json:"openerId"`
+			Frame   string `json:"openerFrameId"`
+			Context string `json:"browserContextId"`
+		} `json:"targetInfo"`
+	}
+	if json.Unmarshal(raw, &p) != nil || p.Info.Type != "page" {
+		return
+	}
+	c.tmu.Lock()
+	defaultContext, source, sourceAt := c.defaultContext, c.popupSource, c.popupSourceAt
+	c.tmu.Unlock()
+	contextMatches := func(br *browser) bool {
+		return br.bctx != "" && br.bctx == p.Info.Context || br.bctx == "" && p.Info.Context == defaultContext
+	}
+	var owner *browser
+	for _, br := range c.list() {
+		br.mu.Lock()
+		ownsFrame := p.Info.Frame != "" && br.controls.frames[p.Info.Frame]
+		br.mu.Unlock()
+		if br.target == p.Info.Opener || ownsFrame {
+			owner = br
+			break
+		}
+	}
+	if owner == nil && source != nil && time.Since(sourceAt) < time.Second && contextMatches(source) {
+		owner = source
+	}
+	if owner == nil {
+		for _, br := range c.list() {
+			if contextMatches(br) && (br.bctx != "" || userBrowserTab(br.tab)) {
+				owner = br
+				break
+			}
+		}
+	}
+	if owner != nil {
+		br := owner
+		go func() {
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			c.opening.Lock()
+			defer c.opening.Unlock()
+			if c.lookup(br.tab) != br {
+				return
+			}
+			for _, existing := range c.list() {
+				if existing.target == p.Info.ID {
+					return
+				}
+			}
+			if c.counted() >= c.m.tabLimit() {
+				c.cdp.call(ctx, "", "Target.closeTarget", map[string]any{"targetId": p.Info.ID}, nil)
+				return
+			}
+			prefix := br.tab
+			if prefix == "" {
+				prefix = "agent"
+			}
+			if len(prefix) > 24 {
+				prefix = prefix[:24]
+			}
+			if userBrowserTab(br.tab) {
+				prefix = "user"
+			}
+			name := prefix + "-popup-" + strings.ToLower(p.Info.ID[:min(12, len(p.Info.ID))])
+			if _, err := c.attachTab(ctx, name, p.Info.ID, br.bctx, br.currentViewport()); err == nil {
+				c.publishControlTab("browser.tab.opened", name, "popup")
+			}
+		}()
+	}
+}
+
+func (c *chromium) publishControlTab(kind, name, why string) {
+	c.m.b.Events.Publish(events.Event{Type: kind, Box: c.m.b.Name, Origin: "browser", Data: map[string]any{"location": c.location, "name": c.worktree, "path": c.path, "tab": name, "reason": why}})
+}
+
+func (br *browser) closeControls() {
+	br.mu.Lock()
+	br.controls.closed = true
+	if br.controls.navCancel != nil {
+		br.controls.navCancel()
+		br.controls.navCancel = nil
+	}
+	br.invalidateInspections()
+	dirs := br.controls.uploadDirs
+	br.controls.uploadDirs = nil
+	br.mu.Unlock()
+	for _, dir := range dirs {
+		os.RemoveAll(dir)
+	}
+}
+
+func (c *chromium) forgetControlTab(br *browser, why string) {
+	c.tmu.Lock()
+	if c.tabs[br.tab] != br {
+		c.tmu.Unlock()
+		return
+	}
+	delete(c.tabs, br.tab)
+	delete(c.sessions, br.session)
+	c.tmu.Unlock()
+	br.closeControls()
+	br.closeWatchers()
+	c.publishControlTab("browser.tab.closed", br.tab, why)
+	if br.bctx != "" {
+		go func() {
+			c.opening.Lock()
+			defer c.opening.Unlock()
+			for _, other := range c.list() {
+				if other.bctx == br.bctx {
+					return
+				}
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			c.cdp.call(ctx, "", "Target.disposeBrowserContext", map[string]any{"browserContextId": br.bctx}, nil)
+		}()
+	}
+}
+
+// Files cross the app bridge as bounded data; names never become trusted paths.
+func (b *Box) browserUpload(w http.ResponseWriter, r *http.Request) error {
+	r.Body = http.MaxBytesReader(w, r.Body, 45<<20)
+	var req struct {
+		Chooser string `json:"chooser"`
+		Files   []struct {
+			Name string `json:"name"`
+			Data string `json:"data"`
+		} `json:"files"`
+	}
+	if err := decodeLimit(r, &req, 45<<20); err != nil {
+		return err
+	}
+	br, _, wt, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	br.uploadMu.Lock()
+	defer br.uploadMu.Unlock()
+	br.mu.Lock()
+	if br.controls.closed || req.Chooser == "" || req.Chooser != br.controls.chooserID {
+		br.mu.Unlock()
+		return httpError{http.StatusConflict, "This file request changed. Choose the files again."}
+	}
+	node, multiple := br.controls.chooser, br.controls.multiple
+	uploads := len(br.controls.uploadDirs)
+	br.mu.Unlock()
+	if uploads >= 32 {
+		return badRequest("close this tab before uploading more files")
+	}
+	if node == 0 {
+		return badRequest("this tab has not asked for files")
+	}
+	if len(req.Files) > 20 || (!multiple && len(req.Files) > 1) {
+		return badRequest("too many files")
+	}
+	dir := filepath.Join(browserFiles(wt.Path), "uploads")
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return err
+	}
+	dir, err = os.MkdirTemp(dir, "pick-")
+	if err != nil {
+		return err
+	}
+	keep := false
+	defer func() {
+		if !keep {
+			os.RemoveAll(dir)
+		}
+	}()
+	files := []string{}
+	total := 0
+	for index, f := range req.Files {
+		if f.Name == "" || f.Name == "." || f.Name == ".." || strings.ContainsAny(f.Name, "/\\\x00") || len(f.Name) > 255 {
+			return badRequest("invalid file name")
+		}
+		data, err := base64.StdEncoding.DecodeString(f.Data)
+		if err != nil {
+			return badRequest("invalid file data")
+		}
+		total += len(data)
+		if total > 32<<20 {
+			return badRequest("files must total at most 32 MB")
+		}
+		folder := filepath.Join(dir, strconv.Itoa(index))
+		if err := os.Mkdir(folder, 0o700); err != nil {
+			return err
+		}
+		name := filepath.Join(folder, f.Name)
+		if err := os.WriteFile(name, data, 0o600); err != nil {
+			return err
+		}
+		files = append(files, name)
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+	defer cancel()
+	br.mu.Lock()
+	stale := br.controls.closed || req.Chooser != br.controls.chooserID
+	br.mu.Unlock()
+	if stale {
+		return httpError{http.StatusConflict, "This file request changed. Choose the files again."}
+	}
+	if err := br.cdp.call(ctx, br.session, "DOM.setFileInputFiles", map[string]any{"backendNodeId": node, "files": files}, nil); err != nil {
+		return err
+	}
+	br.mu.Lock()
+	if br.controls.closed || req.Chooser == "" || req.Chooser != br.controls.chooserID {
+		br.mu.Unlock()
+		return httpError{http.StatusConflict, "This file request changed. Choose the files again."}
+	}
+	if br.controls.chooser == node {
+		br.controls.chooser = 0
+		br.controls.chooserID = ""
+	}
+	br.controls.uploadDirs = append(br.controls.uploadDirs, dir)
+	keep = true
+	br.mu.Unlock()
+	writeJSON(w, map[string]bool{"ok": true})
+	return nil
+}
+
+type BrowserDownload struct {
+	ID         string  `json:"id"`
+	Name       string  `json:"name"`
+	URL        string  `json:"url"`
+	State      string  `json:"state"`
+	Received   float64 `json:"receivedBytes"`
+	Total      float64 `json:"totalBytes"`
+	Tab        string  `json:"tab"`
+	CreatedAt  string  `json:"createdAt"`
+	Context    string  `json:"-"`
+	Identified bool    `json:"-"`
+}
+
+var downloadID = regexp.MustCompile(`^[A-Za-z0-9-]{1,80}$`)
+
+func downloadDir(path string) string { return filepath.Join(browserFiles(path), "downloads") }
+
+// Bound encoded metadata too: JSON expands HTML characters and control bytes.
+func browserDownloadText(value string, limit int) string {
+	used := 0
+	for index, r := range value {
+		size := utf8.RuneLen(r)
+		switch {
+		case r < 0x20 || r == '<' || r == '>' || r == '&' || r == '\u2028' || r == '\u2029' || r == utf8.RuneError:
+			size = 6
+		case r == '"' || r == '\\':
+			size = 2
+		}
+		if used+size > limit-3 {
+			return strings.ToValidUTF8(value[:index], "\ufffd") + "…"
+		}
+		used += size
+	}
+	return strings.ToValidUTF8(value, "\ufffd")
+}
+
+func browserDownloadURL(value string) string {
+	if len(value) >= 5 && (strings.EqualFold(value[:5], "data:") || strings.EqualFold(value[:5], "blob:")) {
+		return strings.ToLower(value[:5]) + "…"
+	}
+	return browserDownloadText(value, 2048)
+}
+
+func (c *chromium) downloadEvent(method string, raw json.RawMessage) {
+	if method != "Browser.downloadWillBegin" && method != "Browser.downloadProgress" {
+		return
+	}
+	var p struct {
+		GUID              string  `json:"guid"`
+		SuggestedFilename string  `json:"suggestedFilename"`
+		URL               string  `json:"url"`
+		FrameID           string  `json:"frameId"`
+		State             string  `json:"state"`
+		Received          float64 `json:"receivedBytes"`
+		Total             float64 `json:"totalBytes"`
+	}
+	if json.Unmarshal(raw, &p) != nil || !downloadID.MatchString(p.GUID) {
+		return
+	}
+	c.dmu.Lock()
+	defer c.dmu.Unlock()
+	if c.downloads == nil {
+		c.downloads = readDownloads(c.path)
+	}
+	d := c.downloads[p.GUID]
+	if method == "Browser.downloadWillBegin" {
+		d = BrowserDownload{ID: p.GUID, Name: browserDownloadText(filepath.Base(p.SuggestedFilename), 255), URL: browserDownloadURL(p.URL), State: "inProgress", CreatedAt: time.Now().UTC().Format(time.RFC3339)}
+		for _, br := range c.list() {
+			br.mu.Lock()
+			owns := br.target == p.FrameID || br.controls.frames[p.FrameID]
+			br.mu.Unlock()
+			if owns {
+				d.Tab, d.Context, d.Identified = br.tab, br.bctx, true
+				break
+			}
+		}
+	} else {
+		if d.ID == "" {
+			return
+		}
+		d.State = p.State
+		d.Received = p.Received
+		d.Total = p.Total
+	}
+	c.downloads[p.GUID] = d
+	if len(c.downloads) > 200 {
+		var oldest BrowserDownload
+		for _, x := range c.downloads {
+			if x.State != "inProgress" && (oldest.ID == "" || x.CreatedAt < oldest.CreatedAt) {
+				oldest = x
+			}
+		}
+		if oldest.ID != "" {
+			delete(c.downloads, oldest.ID)
+		}
+	}
+	if method == "Browser.downloadWillBegin" || p.State != "inProgress" {
+		data, _ := json.Marshal(c.downloads)
+		statefile.Write(filepath.Join(downloadDir(c.path), "index.json"), data)
+	}
+}
+
+func readDownloads(path string) map[string]BrowserDownload {
+	out := map[string]BrowserDownload{}
+	raw, err := os.ReadFile(filepath.Join(downloadDir(path), "index.json"))
+	if err == nil && len(raw) < 1<<20 {
+		json.Unmarshal(raw, &out)
+	}
+	if out == nil {
+		out = map[string]BrowserDownload{}
+	}
+	for k, d := range out {
+		if d.State == "inProgress" {
+			d.State = "canceled"
+			out[k] = d
+		}
+		if !downloadID.MatchString(k) || k != d.ID {
+			delete(out, k)
+		}
+	}
+	return out
+}
+
+func (b *Box) browserDownloads(w http.ResponseWriter, r *http.Request) error {
+	_, wt, err := b.browserTarget(r)
+	if err != nil {
+		return err
+	}
+	all := readDownloads(wt.Path)
+	if c := b.Browsers.lookupChromium(wt.Path); c != nil {
+		c.dmu.Lock()
+		if c.downloads != nil {
+			all = map[string]BrowserDownload{}
+			for k, d := range c.downloads {
+				all[k] = d
+			}
+		}
+		c.dmu.Unlock()
+	}
+	list := []BrowserDownload{}
+	for _, d := range all {
+		list = append(list, d)
+	}
+	sort.Slice(list, func(i, j int) bool { return list[i].CreatedAt > list[j].CreatedAt })
+	writeJSON(w, map[string]any{"downloads": list})
+	return nil
+}
+
+func (b *Box) browserCancelDownload(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		ID string `json:"id"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	if !downloadID.MatchString(req.ID) {
+		return badRequest("invalid download")
+	}
+	_, wt, err := b.browserTarget(r)
+	if err != nil {
+		return err
+	}
+	c := b.Browsers.lookupChromium(wt.Path)
+	if c == nil {
+		return badRequest("the browser closed")
+	}
+	c.dmu.Lock()
+	d, ok := c.downloads[req.ID]
+	c.dmu.Unlock()
+	if !ok || d.State != "inProgress" {
+		return badRequest("this download is not running")
+	}
+	if !d.Identified {
+		return badRequest("this download's browser context is unavailable")
+	}
+	params := map[string]any{"guid": req.ID}
+	if d.Context != "" {
+		params["browserContextId"] = d.Context
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	if err := c.cdp.call(ctx, "", "Browser.cancelDownload", params, nil); err != nil {
+		return err
+	}
+	writeJSON(w, map[string]bool{"ok": true})
+	return nil
+}
+
+func browserFileChunk(dir, name string, offset, length int64) ([]byte, int64, string, error) {
+	if !downloadID.MatchString(name) || offset < 0 || length < 1 || length > 1<<20 {
+		return nil, 0, "", errors.New("invalid download range")
+	}
+	root, err := os.OpenRoot(dir)
+	if err != nil {
+		return nil, 0, "", err
+	}
+	defer root.Close()
+	st, err := root.Lstat(name)
+	if err != nil {
+		return nil, 0, "", err
+	}
+	if !st.Mode().IsRegular() {
+		return nil, 0, "", errors.New("not a regular file")
+	}
+	f, err := root.Open(name)
+	if err != nil {
+		return nil, 0, "", err
+	}
+	defer f.Close()
+	st, err = f.Stat()
+	if err != nil {
+		return nil, 0, "", err
+	}
+	if !st.Mode().IsRegular() || offset > st.Size() {
+		return nil, 0, "", errors.New("invalid download range")
+	}
+	n := min(length, st.Size()-offset)
+	data, err := io.ReadAll(io.NewSectionReader(f, offset, n))
+	if err != nil {
+		return nil, 0, "", err
+	}
+	if int64(len(data)) != n {
+		return nil, 0, "", errors.New("the download changed during export")
+	}
+	header := make([]byte, 512)
+	count, _ := f.ReadAt(header, 0)
+	return data, st.Size(), http.DetectContentType(header[:count]), nil
+}
+
+func boundedBrowserFile(dir, name string) ([]byte, error) {
+	if name == "" || name == "." || name == ".." || strings.ContainsAny(name, "/\\\x00") {
+		return nil, errors.New("invalid file name")
+	}
+	root, err := os.OpenRoot(dir)
+	if err != nil {
+		return nil, err
+	}
+	defer root.Close()
+	st, err := root.Lstat(name)
+	if err != nil {
+		return nil, err
+	}
+	if !st.Mode().IsRegular() {
+		return nil, errors.New("not a regular file")
+	}
+	if st.Size() > 32<<20 {
+		return nil, errors.New("this file exceeds the 32 MB export limit")
+	}
+	f, err := root.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	data, err := io.ReadAll(io.LimitReader(f, (32<<20)+1))
+	if len(data) > 32<<20 {
+		return nil, errors.New("this file exceeds the 32 MB export limit")
+	}
+	return data, err
+}
+
+func (b *Box) browserDownloadData(w http.ResponseWriter, r *http.Request) error {
+	_, wt, err := b.browserTarget(r)
+	if err != nil {
+		return err
+	}
+	id := r.PathValue("id")
+	if !downloadID.MatchString(id) {
+		return badRequest("invalid download")
+	}
+	d, ok := readDownloads(wt.Path)[id]
+	if !ok || d.State != "completed" {
+		return badRequest("this download has not completed")
+	}
+	if r.URL.Query().Has("offset") || r.URL.Query().Has("length") {
+		offset, length := int64(0), int64(1<<20)
+		if value := r.URL.Query().Get("offset"); value != "" {
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil {
+				return badRequest("invalid download offset")
+			}
+			offset = n
+		}
+		if value := r.URL.Query().Get("length"); value != "" {
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil {
+				return badRequest("invalid download length")
+			}
+			length = n
+		}
+		data, total, mime, err := browserFileChunk(downloadDir(wt.Path), id, offset, length)
+		if err != nil {
+			return badRequest("%v", err)
+		}
+		writeJSON(w, map[string]any{"name": d.Name, "mime": mime, "data": base64.StdEncoding.EncodeToString(data), "totalBytes": total, "offset": offset, "done": offset+int64(len(data)) == total})
+		return nil
+	}
+	data, err := boundedBrowserFile(downloadDir(wt.Path), id)
+	if err != nil {
+		return badRequest("%v", err)
+	}
+	writeJSON(w, map[string]string{"name": d.Name, "mime": http.DetectContentType(data), "data": base64.StdEncoding.EncodeToString(data)})
+	return nil
+}
+
+func (b *Box) browserShotData(w http.ResponseWriter, r *http.Request) error {
+	loc, wt, err := b.browserTarget(r)
+	if err != nil {
+		return err
+	}
+	name := r.PathValue("name")
+	if !shotName.MatchString(name) {
+		return badRequest("invalid screenshot")
+	}
+	data, err := boundedBrowserFile(b.Browsers.shotDir(loc.Name, wt.Name), name)
+	if err != nil {
+		return badRequest("%v", err)
+	}
+	writeJSON(w, map[string]string{"name": name, "mime": "image/png", "data": base64.StdEncoding.EncodeToString(data)})
+	return nil
+}
+
+var browserPermissionsMu sync.Mutex
+
+func (b *Box) browserPermissions(w http.ResponseWriter, r *http.Request) error {
+	hosts := b.browserAllowList()
+	if hosts == nil {
+		hosts = []string{}
+	}
+	writeJSON(w, map[string]any{"hosts": hosts})
+	return nil
+}
+func (b *Box) browserRevoke(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Origin string `json:"origin"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	host := allowHost(req.Origin)
+	if host == "" {
+		return badRequest("give a site to revoke")
+	}
+	if b.Flows == nil || b.Flows.Path == "" {
+		return badRequest("this box has no config folder")
+	}
+	browserPermissionsMu.Lock()
+	defer browserPermissionsMu.Unlock()
+	file := filepath.Join(filepath.Dir(b.Flows.Path), NetworkFile)
+	raw, err := os.ReadFile(file)
+	if os.IsNotExist(err) {
+		writeJSON(w, map[string]any{"hosts": []string{}})
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	var doc map[string]any
+	if json.Unmarshal(raw, &doc) != nil {
+		return badRequest("invalid network settings")
+	}
+	list := []string{}
+	if all, ok := doc["browser_allow"].([]any); ok {
+		for _, x := range all {
+			if s, ok := x.(string); ok && allowHost(s) != host {
+				list = append(list, s)
+			}
+		}
+	}
+	doc["browser_allow"] = list
+	raw, _ = json.MarshalIndent(doc, "", "  ")
+	if err := statefile.Write(file, raw); err != nil {
+		return err
+	}
+	if b.BrowserProxies != nil {
+		b.BrowserProxies.mu.Lock()
+		proxies := []*worktreeProxy{}
+		for _, p := range b.BrowserProxies.proxies {
+			proxies = append(proxies, p)
+		}
+		b.BrowserProxies.mu.Unlock()
+		for _, p := range proxies {
+			p.mu.Lock()
+			for conn, h := range p.tunnels {
+				if h == host {
+					conn.Close()
+					delete(p.tunnels, conn)
+				}
+			}
+			p.mu.Unlock()
+		}
+	}
+	b.publish(r, "config.changed", map[string]any{"browser_revoke": host})
+	writeJSON(w, map[string]any{"hosts": list})
+	return nil
+}
+
+func (b *Box) browserClearProfile(w http.ResponseWriter, r *http.Request) error {
+	if EmbeddedFiles == "" {
+		return badRequest("profile clearing needs the LeadingLight runtime")
+	}
+	var req struct {
+		Confirm bool `json:"confirm"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	if !req.Confirm {
+		return badRequest("confirm clearing this browser's sign-ins and personal tabs")
+	}
+	_, wt, err := b.browserTarget(r)
+	if err != nil {
+		return err
+	}
+	b.Browsers.launchMu.Lock()
+	defer b.Browsers.launchMu.Unlock()
+	if c := b.Browsers.lookupChromium(wt.Path); c != nil {
+		c.opening.Lock()
+		defer c.opening.Unlock()
+		for _, br := range c.list() {
+			if (br.tab != "" && !userBrowserTab(br.tab)) || (br.tab == "" && br.tabStatus().used()) {
+				return httpError{http.StatusConflict, "close this workspace's agent tabs before clearing personal browsing data"}
+			}
+		}
+		b.Browsers.close(c, "personal browsing data cleared")
+	}
+	if err := os.RemoveAll(personalBrowserProfile(b.Browsers.Dir, wt.Path)); err != nil {
+		return err
+	}
+	writeJSON(w, map[string]bool{"cleared": true})
+	return nil
+}
+
+var browserWorkspaceMu sync.Mutex
+
+func (b *Box) browserWorkspace(w http.ResponseWriter, r *http.Request) error {
+	if EmbeddedFiles == "" || b.Browsers == nil {
+		return badRequest("personal browsing needs the LeadingLight runtime")
+	}
+	browserWorkspaceMu.Lock()
+	defer browserWorkspaceMu.Unlock()
+	dir := filepath.Join(b.Browsers.Dir, "workspace")
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return err
+	}
+	sum := sha256.Sum256([]byte(dir))
+	name := fmt.Sprintf("ll-browser-%x", sum[:4])
+	loc, err := b.Locations.Get(r.Context(), name)
+	if err != nil {
+		loc, err = b.Locations.Add(r.Context(), name, dir)
+	}
+	if err != nil {
+		return err
+	}
+	if !samePath(loc.Path, dir) {
+		return badRequest("the personal browser workspace name is already in use")
+	}
+	loc, err = b.Locations.Get(r.Context(), name)
+	if err != nil {
+		return err
+	}
+	for _, wt := range loc.Worktrees {
+		if wt.Main {
+			writeJSON(w, map[string]any{"location": loc.Name, "worktree": wt.Name, "port": wt.Port})
+			return nil
+		}
+	}
+	return badRequest("the browser workspace is unavailable")
+}
+
+func (b *Box) mountBrowserControls(route func(string, func(http.ResponseWriter, *http.Request) error)) {
+	route("POST /v1/browser/workspace", b.browserWorkspace)
+	p := "/v1/worktrees/{loc}/{wt}/browser/"
+	route("GET "+p+"state", b.browserControlState)
+	route("POST "+p+"navigate", b.browserNavigate)
+	route("POST "+p+"input", b.browserInput)
+	route("POST "+p+"find", b.browserFind)
+	route("POST "+p+"zoom", b.browserZoom)
+	route("POST "+p+"dialog", b.browserDialog)
+	route("GET "+p+"selection", b.browserSelection)
+	route("POST "+p+"inspect", b.browserInspect)
+	route("POST "+p+"inspect/reveal", b.browserInspectReveal)
+	route("POST "+p+"style", b.browserStyle)
+	route("POST "+p+"style/reset", b.browserStyleReset)
+	route("DELETE "+p+"profile", b.browserClearProfile)
+	route("POST "+p+"upload", b.browserUpload)
+	route("GET "+p+"downloads", b.browserDownloads)
+	route("POST "+p+"downloads/cancel", b.browserCancelDownload)
+	route("GET "+p+"downloads/{id}/data", b.browserDownloadData)
+	route("GET "+p+"shots/{name}/data", b.browserShotData)
+	route("GET /v1/browser/permissions", b.browserPermissions)
+	route("DELETE /v1/browser/permissions", b.browserRevoke)
+}
