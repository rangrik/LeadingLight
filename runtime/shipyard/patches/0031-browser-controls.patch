+	}()
+	body := `{"chooser":"test-pick","files":[{"name":"picked.txt","data":"ZmlsZQ=="}]}`
+	req := httptest.NewRequest("POST", "http://box/?tab=qa", strings.NewReader(body))
+	req.SetPathValue("loc", "cal")
+	req.SetPathValue("wt", "billing")
+	if err := b.browserUpload(httptest.NewRecorder(), req); err == nil {
+		t.Fatal("upload committed after tab close")
+	} else if status, ok := err.(httpError); !ok || status.status != http.StatusConflict {
+		t.Fatalf("wrong close error: %v", err)
+	}
+	<-replied
+	files, err := os.ReadDir(filepath.Join(browserFiles(wt.Path), "uploads"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(files) != 0 || len(br.controls.uploadDirs) != 0 {
+		t.Fatal("closed tab retained upload files", files)
+	}
+}
+
+// A delayed native picker cannot authorize files for a newer input or document.
+func TestBrowserUploadRequiresCurrentChooser(t *testing.T) {
+	b, wt, _ := browserBox(t, func(http.ResponseWriter, *http.Request) {})
+	c := &chromium{cdp: &cdpConn{}, done: make(chan struct{}), tabs: map[string]*browser{}}
+	br := &browser{chromium: c, target: "main", tab: "qa"}
+	c.tabs[br.tab] = br
+	b.Browsers = &Browsers{open: map[string]*chromium{wt.Path: c}}
+	chooser := func(node int) string {
+		raw, _ := json.Marshal(map[string]any{"backendNodeId": node, "mode": "selectSingle"})
+		br.controlEvent("Page.fileChooserOpened", raw)
+		return br.controls.chooserID
+	}
+	reject := func(token string, cancel bool) {
+		t.Helper()
+		files := []map[string]string{}
+		if !cancel {
+			files = append(files, map[string]string{"name": "picked.txt", "data": "ZmlsZQ=="})
+		}
+		body, _ := json.Marshal(map[string]any{"chooser": token, "files": files})
+		req := httptest.NewRequest("POST", "http://box/?tab=qa", bytes.NewReader(body))
+		req.SetPathValue("loc", "cal")
+		req.SetPathValue("wt", "billing")
+		err := b.browserUpload(httptest.NewRecorder(), req)
+		if status, ok := err.(httpError); !ok || status.status != http.StatusConflict {
+			t.Fatalf("stale picker was not rejected: %v", err)
+		}
+	}
+	old := chooser(1)
+	reject("", false)
+	next := chooser(2)
+	if old == next {
+		t.Fatal("chooser identity reused")
+	}
+	reject(old, false)
+	reject(old, true)
+	if br.controls.chooserID != next || br.controls.chooser != 2 {
+		t.Fatal("stale cancellation cleared the current picker")
+	}
+	br.controlEvent("Page.navigatedWithinDocument", json.RawMessage(`{"frameId":"main","url":"https://example.com/next"}`))
+	reject(next, false)
+	reject(next, true)
+	next = chooser(3)
+	br.controlEvent("Page.frameNavigated", json.RawMessage(`{"frame":{"id":"main","url":"https://example.com/reload"}}`))
+	reject(next, false)
+	if br.controls.chooser != 0 || br.controls.chooserID != "" {
+		t.Fatal("navigation kept its chooser")
+	}
+	if c.cdp.next != 0 {
+		t.Fatal("stale files reached Chromium")
+	}
+}
+
+// Omitting --tab must not grant an agent the saved personal browsing profile.
+func TestBrowserUnnamedAgentKeepsPersonalDataSeparate(t *testing.T) {
+	if testing.Short() {
+		t.Skip("starts Chromium")
+	}
+	if _, err := FindChromium(); err != nil {
+		t.Skip(err)
+	}
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = before })
+	b, wt, _ := browserBox(t, func(w http.ResponseWriter, r *http.Request) { fmt.Fprint(w, "<title>Cookies</title>") })
+	m := b.NewBrowsers(t.TempDir(), 1)
+	defer m.CloseAll("test")
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	loc, _ := b.Locations.Get(ctx, "cal")
+	personal, err := m.get(ctx, loc, wt, "user-private")
+	if err != nil {
+		t.Fatal(err)
+	}
+	site := "http://billing.cal.devbox.localhost:1377"
+	if _, err := personal.Open(ctx, site); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := personal.evaluate(ctx, `document.cookie='personal=secret;path=/;max-age=3600';localStorage.setItem('personal','secret');true`); err != nil {
+		t.Fatal(err)
+	}
+	main, err := m.get(ctx, loc, wt, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := main.Open(ctx, site); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := main.evaluate(ctx, `[document.cookie,localStorage.getItem('personal')]`)
+	if err != nil || strings.Contains(string(raw), "secret") {
+		t.Fatal("unnamed agent accessed personal browser data", string(raw), err)
+	}
+	if main.bctx == "" {
+		t.Fatal("unnamed agent used the personal context")
+	}
+	if _, err := main.evaluate(ctx, `document.cookie='agent=private;path=/';true`); err != nil {
+		t.Fatal(err)
+	}
+	raw, err = personal.evaluate(ctx, "document.cookie")
+	if err != nil || !strings.Contains(string(raw), "personal=secret") || strings.Contains(string(raw), "agent=private") {
+		t.Fatal("agent data reached personal browsing", string(raw), err)
+	}
+	shared, err := m.get(ctx, loc, wt, "user-shared")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := shared.Open(ctx, site); err != nil {
+		t.Fatal(err)
+	}
+	raw, err = shared.evaluate(ctx, "document.cookie")
+	if err != nil || !strings.Contains(string(raw), "personal=secret") {
+		t.Fatal("explicit personal tabs stopped sharing", string(raw), err)
+	}
+	m.Close(wt.Path, "test restart")
+	main, err = m.get(ctx, loc, wt, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var targets struct {
+		Infos []struct {
+			Type string `json:"type"`
+		} `json:"targetInfos"`
+	}
+	if err := main.cdp.call(ctx, "", "Target.getTargets", nil, &targets); err != nil {
+		t.Fatal(err)
+	}
+	pages := 0
+	for _, target := range targets.Infos {
+		if target.Type == "page" {
+			pages++
+		}
+	}
+	if pages != 1 || len(main.chromium.list()) != 1 {
+		t.Fatal("startup retained an unused default target", pages)
+	}
+	if _, err := main.Open(ctx, site); err != nil {
+		t.Fatal(err)
+	}
+	raw, err = main.evaluate(ctx, `[document.cookie,localStorage.getItem('personal')]`)
+	if err != nil || strings.Contains(string(raw), "secret") || strings.Contains(string(raw), "private") {
+		t.Fatal("restarted unnamed agent gained saved browser data", string(raw), err)
+	}
+	personal, err = m.get(ctx, loc, wt, "user-restored")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := personal.Open(ctx, site); err != nil {
+		t.Fatal(err)
+	}
+	raw, err = personal.evaluate(ctx, `[document.cookie,localStorage.getItem('personal')]`)
+	if err != nil || !strings.Contains(string(raw), "personal=secret") || !strings.Contains(string(raw), `"secret"`) {
+		t.Fatal("personal browser data did not survive restart", string(raw), err)
+	}
+
+}
diff --git a/internal/box/browserdownload_metadata_test.go b/internal/box/browserdownload_metadata_test.go
new file mode 100644
index 0000000..3aa983e
--- /dev/null
+++ b/internal/box/browserdownload_metadata_test.go
@@ -0,0 +1,67 @@
+package box
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"unicode/utf8"
+)
+
+// Oversized source URLs must not make the persisted index unreadable or block completed exports.
+func TestBrowserDownloadMetadataKeepsIndexReadable(t *testing.T) {
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	defer func() { EmbeddedFiles = before }()
+	c := &chromium{path: t.TempDir(), downloads: map[string]BrowserDownload{}, tabs: map[string]*browser{}}
+	c.tabs["owner"] = &browser{tab: strings.Repeat("t", 48), target: "main"}
+	dir := downloadDir(c.path)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	emit := func(method string, value map[string]any) {
+		raw, err := json.Marshal(value)
+		if err != nil {
+			t.Fatal(err)
+		}
+		c.downloadEvent(method, raw)
+	}
+	for i := range 200 {
+		id := strings.Repeat("d", 76) + fmt.Sprintf("%04d", i)
+		url := "https://example.com/?" + strings.Repeat("&<>\u2028\u2029\x00\"\\東京", 1000)
+		if i < 2 {
+			url = []string{"data:", "blob:"}[i] + strings.Repeat("a", 1<<20)
+		}
+		emit("Browser.downloadWillBegin", map[string]any{"guid": id, "frameId": "main", "url": url, "suggestedFilename": strings.Repeat("&<>\u2028\x00東京", 1000)})
+		emit("Browser.downloadProgress", map[string]any{"guid": id, "state": "completed", "receivedBytes": math.MaxFloat64, "totalBytes": math.MaxFloat64})
+	}
+	raw, err := os.ReadFile(filepath.Join(dir, "index.json"))
+	if err != nil || len(raw) >= 1<<20 {
+		t.Fatalf("index exceeds read bound: %d bytes, %v", len(raw), err)
+	}
+	saved := readDownloads(c.path)
+	if len(saved) != 200 {
+		t.Fatalf("completed downloads disappeared: %d", len(saved))
+	}
+	for id, d := range saved {
+		name, _ := json.Marshal(d.Name)
+		url, _ := json.Marshal(d.URL)
+		if len(name) > 257 || len(url) > 2050 || !utf8.ValidString(d.Name+d.URL) || d.State != "completed" {
+			t.Fatalf("metadata exceeded its encoded bound: name=%d url=%d", len(name), len(url))
+		}
+		if strings.HasSuffix(id, "0000") && d.URL != "data:…" || strings.HasSuffix(id, "0001") && d.URL != "blob:…" {
+			t.Fatal("embedded download URL was not summarized")
+		}
+	}
+	id := strings.Repeat("d", 76) + "0000"
+	if err := os.WriteFile(filepath.Join(dir, id), []byte("download bytes"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	data, total, _, err := browserFileChunk(dir, saved[id].ID, 0, 1<<20)
+	if err != nil || string(data) != "download bytes" || total != 14 {
+		t.Fatalf("completed data-URL export failed: %q, %d, %v", data, total, err)
+	}
+}
diff --git a/internal/box/browserinspect.go b/internal/box/browserinspect.go
new file mode 100644
index 0000000..7d4a725
--- /dev/null
+++ b/internal/box/browserinspect.go
@@ -0,0 +1,405 @@
+package box
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"math"
+	"net/http"
+	"regexp"
+	"strings"
+	"time"
+)
+
+type browserStyleValue struct {
+	Value    string `json:"value"`
+	Priority string `json:"priority"`
+}
+type browserStyleSnapshot struct {
+	Attribute  *string                      `json:"attribute"`
+	Properties map[string]browserStyleValue `json:"properties"`
+}
+type browserInspectOptions struct {
+	baseline *browserStyleSnapshot
+	reveal   bool
+}
+type browserInspection struct {
+	Handle   string `json:"handle"`
+	Tag      string `json:"tag"`
+	Text     string `json:"text"`
+	Selector string `json:"selector"`
+	URL      string `json:"url"`
+	Bounds   struct {
+		X      float64 `json:"x"`
+		Y      float64 `json:"y"`
+		Width  float64 `json:"width"`
+		Height float64 `json:"height"`
+	} `json:"bounds"`
+	Styles map[string]string `json:"styles"`
+}
+type browserInspectedNode struct {
+	node     int64
+	epoch    uint64
+	original map[string]browserStyleValue
+	baseline *browserStyleSnapshot
+}
+
+var browserVisualProperties = []string{"color", "background-color", "font-size", "font-weight", "line-height", "padding", "border-radius", "width", "height"}
+var browserStyleChars = regexp.MustCompile(`^[a-zA-Z0-9\s#%.,()+-]+$`)
+var browserStyleFunctions = regexp.MustCompile(`([a-zA-Z][a-zA-Z0-9-]*)\s*\(`)
+
+func validateBrowserStyle(property, value string) error {
+	allowed := false
+	for _, p := range browserVisualProperties {
+		if p == property {
+			allowed = true
+			break
+		}
+	}
+	if !allowed || len(value) == 0 || len(value) > 256 || !browserStyleChars.MatchString(value) {
+		return badRequest("choose a supported visual property and CSS value")
+	}
+	for _, match := range browserStyleFunctions.FindAllStringSubmatch(value, -1) {
+		switch strings.ToLower(match[1]) {
+		case "rgb", "rgba", "hsl", "hsla", "hwb", "lab", "lch", "oklab", "oklch", "color", "calc", "min", "max", "clamp":
+		default:
+			return badRequest("this CSS function is not supported")
+		}
+	}
+	return nil
+}
+
+// All code runs in an isolated world, so a page cannot replace the DOM helpers we call.
+const browserInspectFunction = `function(properties,property,value,restore,baseline,reveal){
+ const e=this;
+ if(!(e instanceof Element)||!e.isConnected||e.ownerDocument!==document) return {error:'The element changed. Inspect it again.'};
+ if(/^(IFRAME|FRAME|OBJECT|EMBED)$/.test(e.tagName)) return {error:'Element feedback inside frames is not supported yet.'};
+ const original={attribute:property?e.getAttribute('style'):null,properties:{}};
+ if(property){
+  if(!CSS.supports(property,value)) return {invalid:'This is not a valid CSS value for '+property+'.'};
+  const names=property==='padding'?['padding-top','padding-right','padding-bottom','padding-left']:property==='border-radius'?['border-top-left-radius','border-top-right-radius','border-bottom-right-radius','border-bottom-left-radius']:[property];
+  for(const p of names)original.properties[p]={value:e.style.getPropertyValue(p),priority:e.style.getPropertyPriority(p)};
+  e.style.setProperty(property,value,'important');
+ }
+ if(restore){
+  for(const [p,v] of Object.entries(restore)){if(v.value)e.style.setProperty(p,v.value,v.priority);else e.style.removeProperty(p);}
+  if(baseline){
+   const expected=document.createElement('div').style;
+   expected.cssText=baseline.attribute||'';
+   const names=new Set([...expected,...e.style]);
+   if([...names].every(p=>expected.getPropertyValue(p)===e.style.getPropertyValue(p)&&expected.getPropertyPriority(p)===e.style.getPropertyPriority(p))){
+    if(baseline.attribute===null)e.removeAttribute('style');else e.setAttribute('style',baseline.attribute);
+   }
+  }
+ }
+ if(reveal){
+  const r=e.getBoundingClientRect(),v=window.visualViewport,x=v?v.offsetLeft:0,y=v?v.offsetTop:0,w=v?v.width:innerWidth,h=v?v.height:innerHeight;
+  if(r.left<x||r.top<y||r.right>x+w||r.bottom>y+h)Element.prototype.scrollIntoView.call(e,{block:'nearest',inline:'nearest',behavior:'instant'});
+ }
+ const r=e.getBoundingClientRect(),v=window.visualViewport,s=v?v.scale:1;
+ const styles={},computed=getComputedStyle(e);
+ for(const p of properties)styles[p]=computed.getPropertyValue(p);
+ let selector=e.localName;
+ if(e.id)selector+='#'+CSS.escape(e.id);else for(const name of [...e.classList].slice(0,3))selector+='.'+CSS.escape(name);
+ return {tag:e.localName,text:(e.innerText||'').slice(0,2048),selector:selector.slice(0,1024),url:location.href,bounds:{x:(r.x-(v?v.offsetLeft:0))*s,y:(r.y-(v?v.offsetTop:0))*s,width:r.width*s,height:r.height*s},styles,original};
+}`
+
+func (br *browser) inspectNode(ctx context.Context, node int64, property, value string, restore map[string]browserStyleValue, options ...browserInspectOptions) (browserInspection, browserStyleSnapshot, error) {
+	var out browserInspection
+	var world struct {
+		ID int `json:"executionContextId"`
+	}
+	if err := br.cdp.call(ctx, br.session, "Page.createIsolatedWorld", map[string]any{"frameId": br.target, "worldName": "leadinglight-element-feedback"}, &world); err != nil {
+		return out, browserStyleSnapshot{}, err
+	}
+	var remote struct {
+		Object struct {
+			ID string `json:"objectId"`
+		} `json:"object"`
+	}
+	if err := br.cdp.call(ctx, br.session, "DOM.resolveNode", map[string]any{"backendNodeId": node, "executionContextId": world.ID}, &remote); err != nil {
+		return out, browserStyleSnapshot{}, httpError{http.StatusConflict, "The element changed. Inspect it again."}
+	}
+	defer br.cdp.call(ctx, br.session, "Runtime.releaseObject", map[string]any{"objectId": remote.Object.ID}, nil)
+	var opts browserInspectOptions
+	if len(options) > 0 {
+		opts = options[0]
+	}
+	args := []map[string]any{{"value": browserVisualProperties}, {"value": property}, {"value": value}, {"value": restore}, {"value": opts.baseline}, {"value": opts.reveal}}
+	var result struct {
+		Result struct {
+			Value json.RawMessage `json:"value"`
+		} `json:"result"`
+		Exception json.RawMessage `json:"exceptionDetails"`
+	}
+	if err := br.cdp.call(ctx, br.session, "Runtime.callFunctionOn", map[string]any{"objectId": remote.Object.ID, "functionDeclaration": browserInspectFunction, "arguments": args, "returnByValue": true}, &result); err != nil {
+		return out, browserStyleSnapshot{}, err
+	}
+	if len(result.Exception) > 0 {
+		return out, browserStyleSnapshot{}, httpError{http.StatusConflict, "The element changed. Inspect it again."}
+	}
+	var info struct {
+		Error    string               `json:"error"`
+		Invalid  string               `json:"invalid"`
+		Original browserStyleSnapshot `json:"original"`
+	}
+	if err := json.Unmarshal(result.Result.Value, &info); err != nil {
+		return out, browserStyleSnapshot{}, err
+	}
+	if info.Error != "" {
+		return out, browserStyleSnapshot{}, httpError{http.StatusConflict, info.Error}
+	}
+	if info.Invalid != "" {
+		return out, browserStyleSnapshot{}, badRequest("%s", info.Invalid)
+	}
+	if err := json.Unmarshal(result.Result.Value, &out); err != nil {
+		return out, browserStyleSnapshot{}, err
+	}
+	return out, info.Original, nil
+}
+
+func (b *Box) browserInspect(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		X float64 `json:"x"`
+		Y float64 `json:"y"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	if math.IsNaN(req.X) || math.IsNaN(req.Y) || math.IsInf(req.X, 0) || math.IsInf(req.Y, 0) || req.X < 0 || req.Y < 0 || req.X > 16384 || req.Y > 16384 {
+		return badRequest("choose a point inside the page")
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	br.inspectMu.Lock()
+	defer br.inspectMu.Unlock()
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	br.restoreInspectionPreviews(ctx)
+	br.mu.Lock()
+	epoch := br.controls.inspectEpoch
+	closed := br.controls.closed
+	br.mu.Unlock()
+	if closed {
+		return httpError{http.StatusConflict, "This tab closed."}
+	}
+	var hit struct {
+		Node  int64  `json:"backendNodeId"`
+		Frame string `json:"frameId"`
+	}
+	// CDP hit-tests document pixels; the stream uses visual viewport pixels.
+	var metrics struct {
+		Visual struct {
+			Scale float64 `json:"scale"`
+			X     float64 `json:"pageX"`
+			Y     float64 `json:"pageY"`
+		} `json:"cssVisualViewport"`
+	}
+	if err := br.cdp.call(ctx, br.session, "Page.getLayoutMetrics", nil, &metrics); err != nil {
+		return err
+	}
+	scale := metrics.Visual.Scale
+	if scale <= 0 {
+		scale = 1
+	}
+	if err := br.cdp.call(ctx, br.session, "DOM.getNodeForLocation", map[string]any{"x": int(req.X/scale + metrics.Visual.X), "y": int(req.Y/scale + metrics.Visual.Y)}, &hit); err != nil {
+		return err
+	}
+	if hit.Frame != br.target {
+		return httpError{http.StatusConflict, "Element feedback inside frames is not supported yet."}
+	}
+	out, _, err := br.inspectNode(ctx, hit.Node, "", "", nil)
+	if err != nil {
+		return err
+	}
+	br.mu.Lock()
+	defer br.mu.Unlock()
+	if epoch != br.controls.inspectEpoch || br.controls.closed {
+		return httpError{http.StatusConflict, "The page changed. Inspect it again."}
+	}
+	if br.controls.inspected == nil {
+		br.controls.inspected = map[string]*browserInspectedNode{}
+	}
+	for handle, n := range br.controls.inspected {
+		if n.node == hit.Node && n.epoch == epoch {
+			out.Handle = handle
+			writeJSON(w, out)
+			return nil
+		}
+	}
+	if len(br.controls.inspected) >= 64 {
+		for handle, n := range br.controls.inspected {
+			if len(n.original) == 0 {
+				delete(br.controls.inspected, handle)
+				break
+			}
+		}
+	}
+	if len(br.controls.inspected) >= 64 {
+		return httpError{http.StatusConflict, "Reset existing element previews or reload before inspecting more elements."}
+	}
+	var random [16]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return err
+	}
+	out.Handle = hex.EncodeToString(random[:])
+	br.controls.inspected[out.Handle] = &browserInspectedNode{node: hit.Node, epoch: epoch, original: map[string]browserStyleValue{}}
+	writeJSON(w, out)
+	return nil
+}
+
+func (b *Box) browserInspectReveal(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Handle string `json:"handle"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	br.inspectMu.Lock()
+	defer br.inspectMu.Unlock()
+	br.mu.Lock()
+	node := br.controls.inspected[req.Handle]
+	epoch, closed := br.controls.inspectEpoch, br.controls.closed
+	br.mu.Unlock()
+	if node == nil || node.epoch != epoch || closed {
+		return httpError{http.StatusConflict, "The page changed. Inspect it again."}
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	out, _, err := br.inspectNode(ctx, node.node, "", "", nil, browserInspectOptions{reveal: true})
+	if err != nil {
+		return err
+	}
+	br.mu.Lock()
+	defer br.mu.Unlock()
+	if epoch != br.controls.inspectEpoch || br.controls.closed {
+		return httpError{http.StatusConflict, "The page changed. Inspect it again."}
+	}
+	out.Handle = req.Handle
+	writeJSON(w, out)
+	return nil
+}
+
+func (b *Box) browserStyle(w http.ResponseWriter, r *http.Request) error {
+	return b.browserStyleChange(w, r, false)
+}
+func (b *Box) browserStyleReset(w http.ResponseWriter, r *http.Request) error {
+	return b.browserStyleChange(w, r, true)
+}
+func (b *Box) browserStyleChange(w http.ResponseWriter, r *http.Request, reset bool) error {
+	var req struct {
+		Handle   string `json:"handle"`
+		Property string `json:"property"`
+		Value    string `json:"value"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	if !reset {
+		if err := validateBrowserStyle(req.Property, req.Value); err != nil {
+			return err
+		}
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	br.inspectMu.Lock()
+	defer br.inspectMu.Unlock()
+	br.mu.Lock()
+	node := br.controls.inspected[req.Handle]
+	epoch := br.controls.inspectEpoch
+	closed := br.controls.closed
+	br.mu.Unlock()
+	if node == nil || node.epoch != epoch || closed {
+		return httpError{http.StatusConflict, "The page changed. Inspect it again."}
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	var restore map[string]browserStyleValue
+	if reset {
+		req.Property = ""
+		req.Value = ""
+		restore = node.original
+	}
+	out, original, err := br.inspectNode(ctx, node.node, req.Property, req.Value, restore, browserInspectOptions{baseline: node.baseline})
+	if err != nil {
+		return err
+	}
+	br.mu.Lock()
+	if epoch != br.controls.inspectEpoch || br.controls.closed {
+		undo := map[string]browserStyleValue{}
+		for p, v := range original.Properties {
+			undo[p] = v
+		}
+		for p, v := range node.original {
+			undo[p] = v
+		}
+		br.mu.Unlock()
+		baseline := node.baseline
+		if baseline == nil {
+			baseline = &original
+		}
+		br.inspectNode(ctx, node.node, "", "", undo, browserInspectOptions{baseline: baseline})
+		return httpError{http.StatusConflict, "The page changed. Inspect it again."}
+	}
+	defer br.mu.Unlock()
+	if !reset && len(node.original) == 0 {
+		node.baseline = &original
+	}
+	for p, v := range original.Properties {
+		if _, ok := node.original[p]; !ok {
+			node.original[p] = v
+		}
+	}
+	if reset {
+		node.original = map[string]browserStyleValue{}
+		node.baseline = nil
+	}
+	out.Handle = req.Handle
+	writeJSON(w, out)
+	return nil
+}
+
+func (br *browser) invalidateInspections() {
+	br.controls.inspectEpoch++
+	if !br.controls.closed {
+		if br.controls.inspectUndo == nil {
+			br.controls.inspectUndo = map[int64]*browserInspectedNode{}
+		}
+		for _, n := range br.controls.inspected {
+			if len(n.original) > 0 {
+				br.controls.inspectUndo[n.node] = n
+			}
+		}
+		if len(br.controls.inspectUndo) > 0 {
+			go func() {
+				br.inspectMu.Lock()
+				defer br.inspectMu.Unlock()
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				defer cancel()
+				br.restoreInspectionPreviews(ctx)
+			}()
+		}
+	} else {
+		br.controls.inspectUndo = nil
+	}
+	br.controls.inspected = nil
+}
+
+func (br *browser) restoreInspectionPreviews(ctx context.Context) {
+	br.mu.Lock()
+	pending := br.controls.inspectUndo
+	br.controls.inspectUndo = nil
+	br.mu.Unlock()
+	for _, n := range pending {
+		br.inspectNode(ctx, n.node, "", "", n.original, browserInspectOptions{baseline: n.baseline})
+	}
+}
