+package box
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+// Only visual CSS values reach a fixed isolated-world function, never executable source.
+func TestBrowserStyleValidation(t *testing.T) {
+	for _, v := range []string{"red", "rgb(12, 20, 30)", "color(display-p3 1 0 0)", "clamp(12px, 2vw, 20px)"} {
+		if err := validateBrowserStyle("color", v); err != nil {
+			t.Fatal(v, err)
+		}
+	}
+	for _, v := range []string{"url(https://example.com)", "var(--network)", "expression(alert(1))", "red;display:none", "red/**/", "r\\65d", "'red'"} {
+		if err := validateBrowserStyle("color", v); err == nil {
+			t.Fatal("accepted", v)
+		}
+	}
+	if err := validateBrowserStyle("background-image", "red"); err == nil {
+		t.Fatal("accepted property")
+	}
+}
+
+// Stale handles and reversible shorthand edits are the boundary between feedback and page damage.
+func TestBrowserInspectionWithRealChromium(t *testing.T) {
+	if testing.Short() {
+		t.Skip("starts Chromium")
+	}
+	if _, err := FindChromium(); err != nil {
+		t.Skip(err)
+	}
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = before })
+	b, wt, _ := browserBox(t, func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprint(w, `<title>Inspection</title><style>body{margin:0}#target{position:absolute;left:100px;top:100px;width:100px;height:50px}</style><button id="target" style="color: red !important;padding-left: 7px;--kept: yes" onclick="window.clicked=true">Feedback</button><iframe style="position:absolute;left:400px;top:100px;width:200px;height:100px" srcdoc="<button>Frame</button>"></iframe><script>window.ready=true</script>`)
+	})
+	m := b.NewBrowsers(t.TempDir(), 1)
+	defer m.CloseAll("test")
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	loc, _ := b.Locations.Get(ctx, "cal")
+	br, err := m.get(ctx, loc, wt, "user-inspect")
+	if err != nil {
+		t.Fatal(err)
+	}
+	site := "http://billing.cal.devbox.localhost:1377"
+	if _, err := br.Open(ctx, site+"/one"); err != nil {
+		t.Fatal(err)
+	}
+	call := func(fn func(http.ResponseWriter, *http.Request) error, body any) (browserInspection, error) {
+		raw, _ := json.Marshal(body)
+		r := httptest.NewRequest("POST", "http://box/?tab=user-inspect", bytes.NewReader(raw))
+		r.SetPathValue("loc", "cal")
+		r.SetPathValue("wt", "billing")
+		rec := httptest.NewRecorder()
+		err := fn(rec, r)
+		var out browserInspection
+		if err == nil {
+			err = json.Unmarshal(rec.Body.Bytes(), &out)
+		}
+		return out, err
+	}
+	eval := func(js string) string {
+		t.Helper()
+		v, err := br.evaluate(ctx, js)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return string(v)
+	}
+	inspect := func(x, y float64) browserInspection {
+		t.Helper()
+		out, err := call(b.browserInspect, map[string]float64{"x": x, "y": y})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return out
+	}
+	style := func(handle, property, value string) browserInspection {
+		t.Helper()
+		out, err := call(b.browserStyle, map[string]string{"handle": handle, "property": property, "value": value})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return out
+	}
+	original := eval(`document.querySelector('#target').getAttribute('style')`)
+	// Hostile page globals cannot hijack our helper calls or disclose editable field values.
+	eval(`window.getComputedStyle=()=>{throw Error('page trap')};window.CSS.supports=()=>{throw Error('page trap')};true`)
+	selected := inspect(110, 110)
+	if selected.Tag != "button" || selected.Text != "Feedback" || selected.Selector != "button#target" || selected.URL != site+"/one" || selected.Bounds.X != 100 || selected.Styles["color"] != "rgb(255, 0, 0)" {
+		t.Fatalf("bad inspection %+v", selected)
+	}
+	if got := eval("!!window.clicked"); got != "false" {
+		t.Fatal("inspection clicked page", got)
+	}
+	if again := inspect(110, 110); again.Handle != selected.Handle {
+		t.Fatal("same element lost undo handle")
+	}
+	// The baseline starts at the first preview, including changes made after inspection.
+	for _, attribute := range []string{"null", `""`, `"color:red!important;padding:7px 9px;border-radius:3px 4px;--kept:yes"`} {
+		eval(`(()=>{let e=document.querySelector('#target'),v=` + attribute + `;if(v===null)e.removeAttribute('style');else e.setAttribute('style',v);return true})()`)
+		style(selected.Handle, "color", "blue")
+		style(selected.Handle, "padding", "20px")
+		style(selected.Handle, "border-radius", "15px")
+		if _, err := call(b.browserStyleReset, map[string]string{"handle": selected.Handle}); err != nil {
+			t.Fatal(err)
+		}
+		if got := eval(`document.querySelector('#target').getAttribute('style')`); got != attribute {
+			t.Fatalf("reset changed exact style attribute: want %s, got %s", attribute, got)
+		}
+		if attribute == "null" && eval(`document.querySelector('#target').matches('[style]')`) != "false" {
+			t.Fatal("reset left an attribute selector active")
+		}
+	}
+	eval(`document.querySelector('#target').setAttribute('style',` + original + `);true`)
+	style(selected.Handle, "color", "blue")
+	style(selected.Handle, "padding", "20px")
+	if got := eval(`document.querySelector('#target').style.color`); got != `"blue"` {
+		t.Fatal(got)
+	}
+	eval(`document.querySelector('#target').style.setProperty('margin-top','13px');true`)
+	if _, err := call(b.browserStyleReset, map[string]string{"handle": selected.Handle}); err != nil {
+		t.Fatal(err)
+	}
+	if got := eval(`(()=>{let e=document.querySelector('#target');return [e.style.color,e.style.getPropertyPriority('color'),e.style.paddingLeft,e.style.paddingTop,e.style.getPropertyValue('--kept'),e.style.marginTop]})()`); got != `["red","important","7px","","yes","13px"]` {
+		t.Fatal("reset damaged inline styles", original, got)
+	}
+	if _, err := call(b.browserStyle, map[string]string{"handle": selected.Handle, "property": "width", "value": "red"}); err == nil {
+		t.Fatal("invalid CSS accepted")
+	}
+	if _, err := call(b.browserInspect, map[string]float64{"x": 410, "y": 110}); err == nil {
+		t.Fatal("inspected child frame with wrong coordinate space")
+	}
+	eval(`document.body.style.height='3000px';window.scrollTo(0,60);true`)
+	scrolled := inspect(110, 65)
+	if scrolled.Handle != selected.Handle || scrolled.Bounds.Y != 53 {
+		t.Fatalf("scrolled coordinate mismatch %+v", scrolled)
+	}
+	eval(`window.scrollTo(0,0);true`)
+	if err := br.applyControlZoom(ctx, 1.5); err != nil {
+		t.Fatal(err)
+	}
+	zoomed := inspect(165, 185)
+	if zoomed.Handle != selected.Handle || zoomed.Bounds.X != 150 {
+		t.Fatalf("zoom coordinate mismatch %+v", zoomed)
+	}
+	if err := br.applyControlZoom(ctx, 1); err != nil {
+		t.Fatal(err)
+	}
+	// A panel resize or page zoom must reveal the same node without calling page-owned helpers.
+	eval(`document.querySelector('#target').style.top='650px';Element.prototype.scrollIntoView=()=>{throw Error('page trap')};true`)
+	if err := br.resize(ctx, Viewport{1280, 800, 1}); err != nil {
+		t.Fatal(err)
+	}
+	reveal := func() browserInspection {
+		t.Helper()
+		out, err := call(b.browserInspectReveal, map[string]string{"handle": selected.Handle})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if out.Handle != selected.Handle || out.Tag != selected.Tag {
+			t.Fatal("reveal changed selected element", out)
+		}
+		return out
+	}
+	reveal()
+	if got := eval(`window.scrollY`); got != "0" {
+		t.Fatal("visible selection was scrolled", got)
+	}
+	if err := br.resize(ctx, Viewport{1280, 400, 1}); err != nil {
+		t.Fatal(err)
+	}
+	for _, zoom := range []float64{1, 1.5} {
+		if err := br.applyControlZoom(ctx, zoom); err != nil {
+			t.Fatal(err)
+		}
+		eval(`window.scrollTo(0,0);true`)
+		out := reveal()
+		if out.Bounds.Y < -1 || out.Bounds.Y+out.Bounds.Height > 401 || out.Bounds.X < -1 || out.Bounds.X+out.Bounds.Width > 1281 {
+			t.Fatalf("selection still clipped after zoom %g: %+v", zoom, out.Bounds)
+		}
+		position := eval(`[visualViewport.pageLeft,visualViewport.pageTop]`)
+		reveal()
+		if got := eval(`[visualViewport.pageLeft,visualViewport.pageTop]`); got != position {
+			t.Fatal("visible selection moved", position, got)
+		}
+	}
+	if err := br.applyControlZoom(ctx, 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := br.resize(ctx, DefaultViewport); err != nil {
+		t.Fatal(err)
+	}
+	eval(`document.querySelector('#target').style.removeProperty('top');window.scrollTo(0,0);true`)
+	style(selected.Handle, "color", "blue")
+	eval(`history.pushState({},'', '/same-document');true`)
+	if _, err := call(b.browserStyle, map[string]string{"handle": selected.Handle, "property": "color", "value": "green"}); err == nil {
+		t.Fatal("same-document stale handle changed page")
+	}
+	if _, err := call(b.browserInspectReveal, map[string]string{"handle": selected.Handle}); err == nil {
+		t.Fatal("same-document stale reveal accepted")
+	}
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) && eval(`document.querySelector('#target').style.color`) != `"red"` {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if got := eval(`document.querySelector('#target').style.color`); got != `"red"` {
+		t.Fatal("navigation left preview behind", got)
+	}
+	selected = inspect(110, 125)
+	eval(`document.querySelector('#target').remove();true`)
+	if _, err := call(b.browserStyle, map[string]string{"handle": selected.Handle, "property": "color", "value": "green"}); err == nil {
+		t.Fatal("detached node accepted")
+	}
+	if _, err := call(b.browserInspectReveal, map[string]string{"handle": selected.Handle}); err == nil {
+		t.Fatal("detached node reveal accepted")
+	}
+	if _, err := br.Open(ctx, site+"/two"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := call(b.browserStyle, map[string]string{"handle": selected.Handle, "property": "color", "value": "green"}); err == nil {
+		t.Fatal("new-document stale handle accepted")
+	}
+	if _, err := call(b.browserInspectReveal, map[string]string{"handle": selected.Handle}); err == nil {
+		t.Fatal("new-document stale reveal accepted")
+	}
+}
diff --git a/internal/box/browsernavigation_controls_test.go b/internal/box/browsernavigation_controls_test.go
