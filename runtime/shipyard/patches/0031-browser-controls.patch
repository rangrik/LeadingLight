+// Chunked exports keep large files readable without loosening the file boundary.
+func TestBrowserDownloadChunks(t *testing.T) {
+	dir := t.TempDir()
+	body := bytes.Repeat([]byte("abc"), 800000)
+	os.WriteFile(filepath.Join(dir, "download-id"), body, 0o600)
+	var out []byte
+	for off := int64(0); off < int64(len(body)); {
+		data, total, _, err := browserFileChunk(dir, "download-id", off, 1<<20)
+		if err != nil || total != int64(len(body)) {
+			t.Fatal(total, err)
+		}
+		out = append(out, data...)
+		off += int64(len(data))
+	}
+	if !bytes.Equal(out, body) {
+		t.Fatal("chunked export changed bytes")
+	}
+	data, total, _, err := browserFileChunk(dir, "download-id", int64(len(body)), 1)
+	if err != nil || len(data) != 0 || total != int64(len(body)) {
+		t.Fatal("EOF", err)
+	}
+	for _, span := range [][2]int64{{-1, 1}, {0, 0}, {0, (1 << 20) + 1}, {int64(len(body)) + 1, 1}} {
+		if _, _, _, err := browserFileChunk(dir, "download-id", span[0], span[1]); err == nil {
+			t.Fatal("accepted invalid range", span)
+		}
+	}
+	if _, _, _, err := browserFileChunk(dir, "../secret", 0, 1); err == nil {
+		t.Fatal("accepted outside file")
+	}
+}
