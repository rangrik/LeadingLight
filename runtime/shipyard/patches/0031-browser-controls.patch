diff --git a/internal/box/browsercast_controls_test.go b/internal/box/browsercast_controls_test.go
new file mode 100644
index 0000000..e41619b
--- /dev/null
+++ b/internal/box/browsercast_controls_test.go
@@ -0,0 +1,151 @@
+package box
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestBrowserCastFailureEndsTheStream(t *testing.T) {
+	for _, closed := range []bool{false, true} {
+		br := &browser{chromium: &chromium{cdp: &cdpConn{err: errors.New("closed")}}, controls: browserControls{closed: closed}, watchers: map[chan frame]struct{}{}, viewport: Viewport{640, 400, 1}}
+		if closed {
+			br.casting = true
+			br.closeWatchers()
+		}
+		frames, stop := br.Watch(context.Background())
+		select {
+		case _, open := <-frames:
+			if open {
+				t.Fatal("a failed screencast produced a frame")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("a failed screencast left its stream open")
+		}
+		stop()
+		if br.casting || len(br.watchers) != 0 {
+			t.Fatal("a failed screencast retained its watcher")
+		}
+	}
+}
+
+// The CDP seam must finish a pending stop before a watcher or resize changes casting again.
+func TestBrowserCastTransitionsStayOrdered(t *testing.T) {
+	for _, resize := range []bool{false, true} {
+		name := "replace-watcher"
+		if resize {
+			name = "close-during-resize"
+		}
+		t.Run(name, func(t *testing.T) {
+			client, chrome := net.Pipe()
+			defer client.Close()
+			defer chrome.Close()
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			conn := newCDP(client, client, nil)
+			br := &browser{chromium: &chromium{cdp: conn}, watchers: map[chan frame]struct{}{}, viewport: Viewport{640, 400, 1}}
+			gate, stopped := make(chan struct{}), make(chan struct{})
+			var release sync.Once
+			unblock := func() { release.Do(func() { close(gate) }) }
+			defer unblock()
+			var holding atomic.Bool
+			unexpected := make(chan string, 4)
+			var writes, logMu sync.Mutex
+			var commands []string
+			reply := func(id int64) {
+				writes.Lock()
+				defer writes.Unlock()
+				raw, _ := json.Marshal(map[string]any{"id": id, "result": map[string]any{}})
+				chrome.Write(append(raw, 0))
+			}
+			go func() {
+				reader := bufio.NewReader(chrome)
+				first := true
+				for {
+					raw, err := reader.ReadBytes(0)
+					if err != nil {
+						return
+					}
+					var msg cdpMessage
+					json.Unmarshal(raw[:len(raw)-1], &msg)
+					if msg.Method == "Page.startScreencast" || msg.Method == "Page.stopScreencast" {
+						logMu.Lock()
+						commands = append(commands, msg.Method)
+						logMu.Unlock()
+						if holding.Load() {
+							unexpected <- msg.Method
+						}
+					}
+					if msg.Method == "Page.stopScreencast" && first {
+						first = false
+						holding.Store(true)
+						close(stopped)
+						go func(id int64) { <-gate; holding.Store(false); reply(id) }(msg.ID)
+					} else {
+						reply(msg.ID)
+					}
+				}
+			}()
+			_, stop := br.Watch(ctx)
+			firstDone, nextDone := make(chan struct{}), make(chan struct{})
+			var resizeErr error
+			go func() {
+				defer close(firstDone)
+				if resize {
+					resizeErr = br.resize(ctx, Viewport{390, 844, 1})
+				} else {
+					stop()
+				}
+			}()
+			select {
+			case <-stopped:
+			case <-ctx.Done():
+				t.Fatal("no stop reached Chromium")
+			}
+			var nextStop func()
+			go func() {
+				defer close(nextDone)
+				if resize {
+					stop()
+				} else {
+					_, nextStop = br.Watch(ctx)
+				}
+			}()
+			select {
+			case method := <-unexpected:
+				t.Fatalf("%s overtook a pending stop", method)
+			case <-time.After(100 * time.Millisecond):
+			}
+			unblock()
+			for _, done := range []chan struct{}{firstDone, nextDone} {
+				select {
+				case <-done:
+				case <-ctx.Done():
+					t.Fatal("casting transition did not finish")
+				}
+			}
+			if resizeErr != nil {
+				t.Fatal(resizeErr)
+			}
+			want := "Page.startScreencast"
+			if resize {
+				want = "Page.stopScreencast"
+			}
+			logMu.Lock()
+			last := commands[len(commands)-1]
+			logMu.Unlock()
+			if last != want {
+				t.Fatalf("last command %s, want %s", last, want)
+			}
+			if nextStop != nil {
+				nextStop()
+			}
+		})
+	}
+}
