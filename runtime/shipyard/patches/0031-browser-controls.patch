+// URL and input validation stop an address or event becoming an arbitrary CDP command.
+func TestBrowserControlValidation(t *testing.T) {
+	for _, s := range []string{"https://example.com/a?q=x", "http://localhost:1420/", "about:blank"} {
+		if _, err := browserControlURL(s); err != nil {
+			t.Fatal(s, err)
+		}
+	}
+	for _, s := range []string{"javascript:alert(1)", "file:///tmp/a", "data:text/html,x", "https://user:pass@example.com/", "https://", "https://a\n.test"} {
+		if _, err := browserControlURL(s); err == nil {
+			t.Fatalf("accepted %q", s)
+		}
+	}
+	for _, i := range []browserInput{{Type: "text", Text: "日本語"}, {Type: "mousePressed", X: 20, Y: 30, Button: "left", ClickCount: 1}, {Type: "keyDown", Key: "a", Code: "KeyA", Modifiers: 4, Commands: []string{"selectAll"}}} {
+		if _, _, err := i.command(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, i := range []browserInput{{Type: "Runtime.evaluate"}, {Type: "text", Text: strings.Repeat("x", 65537)}, {Type: "mouseMoved", X: math.NaN()}, {Type: "keyDown", Key: "a", Commands: []string{"executeScript"}}, {Type: "mousePressed", Buttons: 32}, {Type: "keyDown", Key: "x", Modifiers: 16}} {
+		if _, _, err := i.command(); err == nil {
+			t.Fatalf("accepted %+v", i)
+		}
+	}
