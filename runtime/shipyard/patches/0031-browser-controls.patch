index 0000000..4e3bfe6
--- /dev/null
+++ b/internal/box/browsercontrols.go
@@ -0,0 +1,1479 @@
+package box
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"github.com/cosscom/shipyard/internal/events"
+	"github.com/cosscom/shipyard/internal/statefile"
+)
+
+// LeadingLight: controls use Chromium's state; input never waits for an agent snapshot.
+type browserControls struct {
+	loading      bool
+	navSequence  uint64
+	navCancel    context.CancelFunc
+	failure      string
+	dialog       *BrowserDialog
+	chooser      int64
+	chooserID    string
+	chooserSeq   uint64
+	multiple     bool
+	zoom         float64
+	closed       bool
+	uploadDirs   []string
+	frames       map[string]bool
+	mainRequests map[string]bool
+	requests     map[string]browserControlRequest
+	refusedHosts map[string]bool
+	inspectEpoch uint64
+	inspected    map[string]*browserInspectedNode
+	inspectUndo  map[int64]*browserInspectedNode
+}
+
+type browserControlRequest struct {
+	host    string
+	started time.Time
+}
+
+type BrowserDialog struct {
+	Type          string `json:"type"`
+	Message       string `json:"message"`
+	DefaultPrompt string `json:"defaultPrompt"`
+}
+
+type BrowserControlState struct {
+	Running      bool           `json:"running"`
+	URL          string         `json:"url"`
+	Title        string         `json:"title"`
+	Loading      bool           `json:"loading"`
+	CanGoBack    bool           `json:"canGoBack"`
+	CanGoForward bool           `json:"canGoForward"`
+	Zoom         float64        `json:"zoom"`
+	Error        string         `json:"error,omitempty"`
+	RefusedHosts []string       `json:"refusedHosts"`
+	Dialog       *BrowserDialog `json:"dialog,omitempty"`
+	FileChooser  *struct {
+		Multiple bool   `json:"multiple"`
+		ID       string `json:"id"`
+	} `json:"fileChooser,omitempty"`
+	Viewport Viewport `json:"viewport"`
+}
+
+type navigationHistory struct {
+	CurrentIndex int `json:"currentIndex"`
+	Entries      []struct {
+		ID  int    `json:"id"`
+		URL string `json:"url"`
+	} `json:"entries"`
+}
+
+func browserHistoryStep(h navigationHistory, direction int) (int, bool) {
+	index := h.CurrentIndex + direction
+	if index < 0 || index >= len(h.Entries) {
+		return 0, false
+	}
+	if index == 0 && h.Entries[index].URL == "about:blank" {
+		return 0, false
+	}
+	return index, true
+}
+
+// A duplicate folder name must never send browser input to a different checkout.
+func browserWorktree(loc Location, name string) (Worktree, error) {
+	var found *Worktree
+	for _, wt := range loc.Worktrees {
+		if wt.Name == name {
+			if found != nil {
+				return Worktree{}, badRequest("workspace %s is ambiguous; choose a uniquely named workspace", name)
+			}
+			w := wt
+			found = &w
+		}
+	}
+	if found == nil {
+		return Worktree{}, ErrUnknownWorktree
+	}
+	return *found, nil
+}
+
+type browserFrameTree struct {
+	Frame struct {
+		ID string `json:"id"`
+	} `json:"frame"`
+	Children []browserFrameTree `json:"childFrames"`
+}
+
+func (br *browser) rememberFrames(tree browserFrameTree) {
+	br.mu.Lock()
+	defer br.mu.Unlock()
+	if br.controls.frames == nil {
+		br.controls.frames = map[string]bool{}
+	}
+	var add func(browserFrameTree)
+	add = func(t browserFrameTree) {
+		if t.Frame.ID != "" {
+			br.controls.frames[t.Frame.ID] = true
+		}
+		for _, ch := range t.Children {
+			add(ch)
+		}
+	}
+	add(tree)
+}
+
+func userBrowserTab(name string) bool { return EmbeddedFiles != "" && strings.HasPrefix(name, "user-") }
+
+func personalBrowserProfile(dir, path string) string {
+	sum := sha256.Sum256([]byte(filepath.Clean(path)))
+	return filepath.Join(dir, "profiles", fmt.Sprintf("user-%x", sum[:16]))
+}
+
+func (m *Browsers) browserProfile(path string) (string, bool, error) {
+	if err := os.MkdirAll(filepath.Join(m.Dir, "profiles"), 0o700); err != nil {
+		return "", false, err
+	}
+	if EmbeddedFiles != "" && path != "" {
+		dir := personalBrowserProfile(m.Dir, path)
+		return dir, true, os.MkdirAll(dir, 0o700)
+	}
+	dir, err := os.MkdirTemp(filepath.Join(m.Dir, "profiles"), "p-")
+	return dir, false, err
+}
+
+func (br *browser) controlState(ctx context.Context) BrowserControlState {
+	br.mu.Lock()
+	c := br.controls
+	s := BrowserControlState{Running: !c.closed, URL: br.url, Title: br.title, Loading: c.loading, Zoom: c.zoom, Error: c.failure, Dialog: c.dialog, Viewport: br.viewport}
+	s.RefusedHosts = []string{}
+	if !c.closed {
+		for host := range c.refusedHosts {
+			s.RefusedHosts = append(s.RefusedHosts, host)
+		}
+	}
+	sort.Strings(s.RefusedHosts)
+	if c.chooser != 0 {
+		s.FileChooser = &struct {
+			Multiple bool   `json:"multiple"`
+			ID       string `json:"id"`
+		}{c.multiple, c.chooserID}
+	}
+	br.mu.Unlock()
+	if s.Zoom == 0 {
+		s.Zoom = 1
+	}
+	if !s.Running {
+		return s
+	}
+	var h navigationHistory
+	if err := br.cdp.call(ctx, br.session, "Page.getNavigationHistory", nil, &h); err == nil {
+		_, s.CanGoBack = browserHistoryStep(h, -1)
+		_, s.CanGoForward = browserHistoryStep(h, 1)
+		if h.CurrentIndex >= 0 && h.CurrentIndex < len(h.Entries) {
+			s.URL = h.Entries[h.CurrentIndex].URL
+		}
+	}
+	if s.Dialog == nil && !s.Loading {
+		if raw, err := br.evaluate(ctx, "document.title"); err == nil {
+			json.Unmarshal(raw, &s.Title)
+			br.mu.Lock()
+			br.title = s.Title
+			br.mu.Unlock()
+		}
+	}
+	return s
+}
+
+func (b *Box) browserControlState(w http.ResponseWriter, r *http.Request) error {
+	_, wt, err := b.browserTarget(r)
+	if err != nil {
+		return err
+	}
+	tab, err := browserTab(r)
+	if err != nil {
+		return err
+	}
+	br := b.Browsers.Lookup(wt.Path, tab)
+	if br == nil {
+		writeJSON(w, BrowserControlState{Zoom: 1, RefusedHosts: []string{}, Viewport: b.Browsers.Viewport(wt.Path, tab)})
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 2*time.Second)
+	defer cancel()
+	writeJSON(w, br.controlState(ctx))
+	return nil
+}
+
+func browserControlURL(raw string) (string, error) {
+	raw = strings.TrimSpace(raw)
+	if raw == "about:blank" {
+		return raw, nil
+	}
+	u, err := url.Parse(raw)
+	if err != nil || len(raw) > 16384 || u == nil || (u.Scheme != "http" && u.Scheme != "https") || u.Hostname() == "" || u.User != nil {
+		return "", errors.New("enter an http or https address without a username or password")
+	}
+	return u.String(), nil
+}
+
+func (b *Box) browserNavigate(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Action string `json:"action"`
+		URL    string `json:"url"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	switch req.Action {
+	case "open", "back", "forward", "reload", "stop":
+	default:
+		return badRequest("unknown navigation action")
+	}
+	var next string
+	if req.Action == "open" {
+		var err error
+		next, err = browserControlURL(req.URL)
+		if err != nil {
+			return badRequest("%v", err)
+		}
+	}
+	br, loc, wt, err := b.browserFor(r, req.Action == "open")
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+	defer cancel()
+	method := "Page."
+	var params any
+	switch req.Action {
+	case "open":
+		if err := b.before(r, "browser.open", map[string]any{"location": loc.Name, "name": wt.Name, "path": wt.Path, "tab": br.tab, "url": next}); err != nil {
+			return err
+		}
+		method += "navigate"
+		params = map[string]any{"url": next}
+	case "back", "forward":
+		var h navigationHistory
+		if err := br.cdp.call(ctx, br.session, "Page.getNavigationHistory", nil, &h); err != nil {
+			return err
+		}
+		direction := -1
+		if req.Action == "forward" {
+			direction = 1
+		}
+		i, available := browserHistoryStep(h, direction)
+		if !available {
+			return badRequest("there is no page in that direction")
+		}
+		method += "navigateToHistoryEntry"
+		params = map[string]any{"entryId": h.Entries[i].ID}
+	case "reload":
+		method += "reload"
+	case "stop":
+		method += "stopLoading"
+	}
+	br.mu.Lock()
+	if br.controls.closed {
+		br.mu.Unlock()
+		return httpError{http.StatusConflict, "This tab closed."}
+	}
+	if br.controls.navCancel != nil {
+		br.controls.navCancel()
+	}
+	navigationContext, navigationCancel := context.WithCancel(context.Background())
+	br.controls.navSequence++
+	sequence := br.controls.navSequence
+	br.controls.navCancel = navigationCancel
+	br.controls.failure = ""
+	br.controls.loading = req.Action != "stop"
+	br.mu.Unlock()
+	sent := make(chan struct{})
+	go func() {
+		defer navigationCancel()
+		var nav struct {
+			ErrorText string `json:"errorText"`
+		}
+		err := br.cdp.callNotify(navigationContext, br.session, method, params, &nav, sent)
+		br.mu.Lock()
+		defer br.mu.Unlock()
+		if br.controls.closed || sequence != br.controls.navSequence {
+			return
+		}
+		br.controls.navCancel = nil
+		if errors.Is(err, context.Canceled) || nav.ErrorText == "net::ERR_ABORTED" {
+			return
+		}
+		if err != nil || nav.ErrorText != "" {
+			br.controls.failure = nav.ErrorText
+			if err != nil {
+				br.controls.failure = "The browser could not finish navigating."
+			}
+			br.controls.loading = false
+		}
+	}()
+	<-sent
+	writeJSON(w, map[string]bool{"ok": true})
+	return nil
+}
+
+type browserInput struct {
+	Type       string   `json:"type"`
+	X          float64  `json:"x"`
+	Y          float64  `json:"y"`
+	Button     string   `json:"button"`
+	Buttons    int      `json:"buttons"`
+	ClickCount int      `json:"clickCount"`
+	DeltaX     float64  `json:"deltaX"`
+	DeltaY     float64  `json:"deltaY"`
+	Key        string   `json:"key"`
+	Code       string   `json:"code"`
+	Modifiers  int      `json:"modifiers"`
+	Text       string   `json:"text"`
+	KeyCode    int      `json:"windowsVirtualKeyCode"`
+	Commands   []string `json:"commands"`
+}
+
+func (i browserInput) command() (string, map[string]any, error) {
+	bad := func() (string, map[string]any, error) { return "", nil, errors.New("invalid browser input") }
+	if i.Modifiers < 0 || i.Modifiers > 15 || len(i.Text) > 65536 || len(i.Key) > 80 || len(i.Code) > 80 {
+		return bad()
+	}
+	p := map[string]any{"type": i.Type, "modifiers": i.Modifiers}
+	switch i.Type {
+	case "text":
+		return "Input.insertText", map[string]any{"text": i.Text}, nil
+	case "keyDown", "keyUp":
+		if i.Key == "" || i.KeyCode < 0 || i.KeyCode > 65535 || len(i.Commands) > 6 {
+			return bad()
+		}
+		for _, s := range i.Commands {
+			switch s {
+			case "selectAll", "copy", "cut", "paste", "undo", "redo":
+			default:
+				return bad()
+			}
+		}
+		p["key"], p["code"], p["windowsVirtualKeyCode"] = i.Key, i.Code, i.KeyCode
+		if i.KeyCode == 0 {
+			p["windowsVirtualKeyCode"] = keyCodes[i.Key]
+		}
+		if i.Type == "keyDown" && i.Text != "" {
+			p["text"] = i.Text
+		}
+		if len(i.Commands) > 0 {
+			p["commands"] = i.Commands
+		}
+		return "Input.dispatchKeyEvent", p, nil
+	case "mouseMoved", "mousePressed", "mouseReleased", "mouseWheel":
+		for _, v := range []float64{i.X, i.Y, i.DeltaX, i.DeltaY} {
+			if math.IsNaN(v) || math.IsInf(v, 0) || math.Abs(v) > 100000 {
+				return bad()
+			}
+		}
+		if i.X < 0 || i.Y < 0 || i.Buttons < 0 || i.Buttons > 31 || i.ClickCount < 0 || i.ClickCount > 3 {
+			return bad()
+		}
+		switch i.Button {
+		case "", "none", "left", "right", "middle", "back", "forward":
+		default:
+			return bad()
+		}
+		p["x"], p["y"], p["buttons"] = i.X, i.Y, i.Buttons
+		if i.Button != "" {
+			p["button"] = i.Button
+		}
+		if i.ClickCount > 0 {
+			p["clickCount"] = i.ClickCount
+		}
+		if i.Type == "mouseWheel" {
+			p["deltaX"], p["deltaY"] = i.DeltaX, i.DeltaY
+		}
+		return "Input.dispatchMouseEvent", p, nil
+	}
+	return bad()
+}
+
+func (b *Box) browserInput(w http.ResponseWriter, r *http.Request) error {
+	var req browserInput
+	if err := decodeLimit(r, &req, 1<<20); err != nil {
+		return err
+	}
+	method, p, err := req.command()
+	if err != nil {
+		return badRequest("%v", err)
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	if req.Type == "mousePressed" && (req.Button == "middle" || req.Button == "left" && req.Modifiers&4 != 0) {
+		br.chromium.tmu.Lock()
+		br.chromium.popupSource, br.chromium.popupSourceAt = br, time.Now()
+		br.chromium.tmu.Unlock()
+	}
+	if err := br.cdp.call(ctx, br.session, method, p, nil); err != nil {
+		return err
+	}
+	writeJSON(w, map[string]bool{"ok": true})
+	return nil
+}
+
+func (b *Box) browserFind(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Text      string `json:"text"`
+		Backwards bool   `json:"backwards"`
+		MatchCase bool   `json:"matchCase"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	if len(req.Text) > 4096 {
+		return badRequest("search is too long")
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	expr := fmt.Sprintf("window.find(%s,%t,%t,true,false,true,false)", jsString(req.Text), req.MatchCase, req.Backwards)
+	if req.Text == "" {
+		expr = "(window.getSelection()?.removeAllRanges(),false)"
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	raw, err := br.evaluate(ctx, expr)
+	if err != nil {
+		return err
+	}
+	var found bool
+	json.Unmarshal(raw, &found)
+	writeJSON(w, map[string]bool{"found": found})
+	return nil
+}
+
+func (b *Box) browserSelection(w http.ResponseWriter, r *http.Request) error {
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	raw, err := br.evaluate(ctx, `(()=>{const e=document.activeElement;const s=e&&/^(INPUT|TEXTAREA)$/.test(e.tagName)&&e.type!=='password'&&typeof e.selectionStart==='number'?e.value.slice(e.selectionStart,e.selectionEnd):String(window.getSelection()||'');return s.length>65536?{oversized:true}:{text:s}})()`)
+	if err != nil {
+		return err
+	}
+	var result struct {
+		Text      string `json:"text"`
+		Oversized bool   `json:"oversized"`
+	}
+	if err := json.Unmarshal(raw, &result); err != nil {
+		return err
+	}
+	if result.Oversized || len(result.Text) > 65536 {
+		return httpError{http.StatusRequestEntityTooLarge, "the selection exceeds 64 KB; copy a smaller selection"}
+	}
+	writeJSON(w, map[string]string{"text": result.Text})
+	return nil
+}
+
+func (b *Box) browserZoom(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Factor float64 `json:"factor"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	if math.IsNaN(req.Factor) || math.IsInf(req.Factor, 0) || req.Factor < 0.25 || req.Factor > 3 {
+		return badRequest("zoom must be between 0.25 and 3")
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	if err := br.applyControlZoom(ctx, req.Factor); err != nil {
+		return err
+	}
+	writeJSON(w, map[string]float64{"zoom": req.Factor})
+	return nil
+}
+
+func (br *browser) applyControlZoom(ctx context.Context, factor float64) error {
+	br.zoomMu.Lock()
+	defer br.zoomMu.Unlock()
+	br.mu.Lock()
+	if factor == 0 {
+		factor = br.controls.zoom
+	}
+	closed := br.controls.closed
+	br.mu.Unlock()
+	if closed {
+		return errors.New("this tab closed")
+	}
+	if factor == 0 {
+		return nil
+	}
+	if err := br.cdp.call(ctx, br.session, "Emulation.setPageScaleFactor", map[string]any{"pageScaleFactor": factor}, nil); err != nil {
+		return err
+	}
+	br.mu.Lock()
+	br.controls.zoom = factor
+	br.mu.Unlock()
+	return nil
+}
+
+func (b *Box) browserDialog(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Accept     bool   `json:"accept"`
+		PromptText string `json:"promptText"`
+	}
+	if err := decodeLimit(r, &req, 1<<20); err != nil {
+		return err
+	}
+	if len(req.PromptText) > 65536 {
+		return badRequest("answer is too long")
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+	defer cancel()
+	if err := br.cdp.call(ctx, br.session, "Page.handleJavaScriptDialog", map[string]any{"accept": req.Accept, "promptText": req.PromptText}, nil); err != nil {
+		return err
+	}
+	writeJSON(w, map[string]bool{"ok": true})
+	return nil
+}
