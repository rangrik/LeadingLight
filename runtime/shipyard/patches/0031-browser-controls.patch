+// Revoking one host closes its old HTTPS tunnels without touching another site's forms.
+func TestBrowserRevocationClosesOnlyThatHostsTunnels(t *testing.T) {
+	a, aa := net.Pipe()
+	defer a.Close()
+	defer aa.Close()
+	bb, b := net.Pipe()
+	defer b.Close()
+	defer bb.Close()
+	p := &worktreeProxy{tunnels: map[net.Conn]string{a: "example.com", b: "other.example"}}
+	box := &Box{Events: &events.Bus{}, Flows: &Flows{Path: filepath.Join(t.TempDir(), "flows.json")}, BrowserProxies: &BrowserProxies{proxies: map[string]*worktreeProxy{"p": p}}}
+	if err := box.AllowBrowserOrigin("example.com"); err != nil {
+		t.Fatal(err)
+	}
+	r := httptest.NewRequest("DELETE", "http://box/", strings.NewReader(`{"origin":"example.com"}`))
+	w := httptest.NewRecorder()
+	if err := box.browserRevoke(w, r); err != nil {
+		t.Fatal(err)
+	}
+	aa.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := aa.Read(make([]byte, 1)); err == nil {
+		t.Fatal("revoked tunnel stayed open")
+	}
+	bb.SetReadDeadline(time.Now().Add(time.Millisecond))
+	if _, err := bb.Read(make([]byte, 1)); err == nil {
+		t.Fatal("unexpected data")
+	} else if e, ok := err.(net.Error); !ok || !e.Timeout() {
+		t.Fatal("other tunnel closed", err)
+	}
+	if len(box.browserAllowList()) != 0 {
+		t.Fatal("permission remained")
+	}
+}
