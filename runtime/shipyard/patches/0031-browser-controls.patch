diff --git a/internal/box/browserrefused_controls_test.go b/internal/box/browserrefused_controls_test.go
new file mode 100644
index 0000000..69a4467
--- /dev/null
+++ b/internal/box/browserrefused_controls_test.go
@@ -0,0 +1,158 @@
+package box
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"slices"
+	"testing"
+	"time"
+)
+
+// A proxy refusal belongs only to a matching request in this tab's current page.
+func TestBrowserRefusedScope(t *testing.T) {
+	px := &worktreeProxy{}
+	b := &Box{BrowserProxies: &BrowserProxies{loaded: true, proxies: map[string]*worktreeProxy{"/fixture": px}}}
+	c := &chromium{m: &Browsers{b: b}, path: "/fixture"}
+	one, two := &browser{chromium: c, target: "one"}, &browser{chromium: c, target: "two"}
+	emit := func(br *browser, method string, data any) { raw, _ := json.Marshal(data); br.controlEvent(method, raw) }
+	request := func(br *browser, id, host string) {
+		emit(br, "Network.requestWillBeSent", map[string]any{"requestId": id, "wallTime": float64(time.Now().UnixNano()) / 1e9, "request": map[string]string{"url": "https://" + host + "/"}})
+	}
+	failed := func(br *browser, id string) {
+		emit(br, "Network.loadingFailed", map[string]any{"requestId": id, "errorText": "net::ERR_TUNNEL_CONNECTION_FAILED"})
+	}
+	request(one, "a", "denied.invalid")
+	px.refuse("denied.invalid")
+	failed(one, "a")
+	if !one.controls.refusedHosts["denied.invalid"] || len(two.controls.refusedHosts) != 0 {
+		t.Fatal("refusal escaped request tab")
+	}
+	request(two, "b", "denied.invalid")
+	failed(two, "b")
+	if len(two.controls.refusedHosts) != 0 {
+		t.Fatal("old proxy refusal matched new failure")
+	}
+	request(one, "c", "origin.invalid")
+	emit(one, "Network.responseReceived", map[string]any{"requestId": "c", "response": map[string]int{"status": 403}})
+	if one.controls.refusedHosts["origin.invalid"] {
+		t.Fatal("origin 403 treated as proxy refusal")
+	}
+	request(one, "old", "late.invalid")
+	emit(one, "Page.frameStartedLoading", map[string]string{"frameId": "one"})
+	px.refuse("late.invalid")
+	failed(one, "old")
+	if len(one.controls.refusedHosts) != 0 || len(one.controls.requests) != 0 {
+		t.Fatal("old navigation repopulated refused hosts")
+	}
+	request(one, "d", "http.invalid")
+	px.refuse("http.invalid")
+	emit(one, "Network.responseReceived", map[string]any{"requestId": "d", "response": map[string]int{"status": 403}})
+	emit(one, "Network.responseReceived", map[string]any{"requestId": "d", "response": map[string]int{"status": 403}})
+	if len(one.controls.refusedHosts) != 1 {
+		t.Fatal("HTTP refusal missing or duplicated")
+	}
+	emit(one, "Page.navigatedWithinDocument", map[string]string{"frameId": "child"})
+	if len(one.controls.refusedHosts) != 1 {
+		t.Fatal("child navigation cleared parent state")
+	}
+	emit(one, "Page.navigatedWithinDocument", map[string]string{"frameId": "one"})
+	if len(one.controls.refusedHosts) != 0 {
+		t.Fatal("same-page navigation retained old notice")
+	}
+	for n := range 600 {
+		request(one, fmt.Sprint(n), fmt.Sprintf("host%d.invalid", n))
+		px.refuse(fmt.Sprintf("host%d.invalid", n))
+	}
+	if len(one.controls.requests) > 512 || len(px.lastRefused) > 128 {
+		t.Fatal("refusal evidence grew without bound")
+	}
+	one.controls.refusedHosts = map[string]bool{"old.invalid": true}
+	one.controls.closed = true
+	if got := one.controlState(context.Background()); len(got.RefusedHosts) != 0 || got.Running {
+		t.Fatal("closed tab retained notices", got)
+	}
+}
+
+func TestBrowserRefusedScopeWithRealChromium(t *testing.T) {
+	if testing.Short() {
+		t.Skip("starts Chromium")
+	}
+	if _, err := FindChromium(); err != nil {
+		t.Skip(err)
+	}
+	b, wt, _ := browserBox(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/blocked" {
+			fmt.Fprint(w, `<title>Blocked</title><script>fetch('https://denied-one.invalid/').catch(()=>{});fetch('http://denied-two.invalid/',{mode:'no-cors'}).catch(()=>{});</script>`)
+			return
+		}
+		fmt.Fprint(w, `<title>Clean</title><p>No blocked resources</p>`)
+	})
+	m := b.NewBrowsers(t.TempDir(), 2)
+	defer m.CloseAll("test")
+	ctx, cancel := context.WithTimeout(context.Background(), 45*time.Second)
+	defer cancel()
+	loc, _ := b.Locations.Get(ctx, "cal")
+	one, err := m.get(ctx, loc, wt, "qa-one")
+	if err != nil {
+		t.Fatal(err)
+	}
+	two, err := m.get(ctx, loc, wt, "qa-two")
+	if err != nil {
+		t.Fatal(err)
+	}
+	navigate := func(br *browser, path string) {
+		t.Helper()
+		if err := br.cdp.call(ctx, br.session, "Page.navigate", map[string]string{"url": "http://billing.cal.devbox.localhost:1377" + path}, nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	until := func(fn func() bool) {
+		t.Helper()
+		deadline := time.Now().Add(10 * time.Second)
+		for time.Now().Before(deadline) {
+			if fn() {
+				return
+			}
+			time.Sleep(30 * time.Millisecond)
+		}
+		t.Fatal("browser refusal state did not settle")
+	}
+	navigate(two, "/clean")
+	navigate(one, "/blocked")
+	until(func() bool {
+		s := one.controlState(ctx)
+		return slices.Contains(s.RefusedHosts, "denied-one.invalid") && slices.Contains(s.RefusedHosts, "denied-two.invalid")
+	})
+	if got := two.controlState(ctx).RefusedHosts; len(got) != 0 {
+		t.Fatal("unrelated tab inherited hosts", got)
+	}
+	navigate(one, "/clean")
+	until(func() bool {
+		s := one.controlState(ctx)
+		return s.Title == "Clean" && !s.Loading && len(s.RefusedHosts) == 0
+	})
+	if err := one.cdp.call(ctx, one.session, "Page.navigate", map[string]string{"url": "https://denied-navigation.invalid/"}, nil); err != nil {
+		t.Fatal(err)
+	}
+	until(func() bool { return slices.Contains(one.controlState(ctx).RefusedHosts, "denied-navigation.invalid") })
+	navigate(one, "/clean")
+	until(func() bool {
+		s := one.controlState(ctx)
+		return s.Title == "Clean" && !s.Loading && len(s.RefusedHosts) == 0
+	})
+	if err := b.AllowBrowserOrigin("https://denied-one.invalid"); err != nil {
+		t.Fatal(err)
+	}
+	scope, ok := b.browserScopeWith(ctx, wt.Path, nil)
+	if !ok {
+		t.Fatal("missing browser scope")
+	}
+	if _, allowed := scope.route("denied-one.invalid:443"); !allowed {
+		t.Fatal("public host permission lost")
+	}
+	if _, allowed := scope.route("127.0.0.1:1"); allowed {
+		t.Fatal("private non-worktree port became allowed")
+	}
+}
