+package box
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+// Navigation must remain controllable after its UI request ends, including link-driven loads.
+func TestBrowserSlowNavigationWithRealChromium(t *testing.T) {
+	if testing.Short() {
+		t.Skip("starts Chromium")
+	}
+	if _, err := FindChromium(); err != nil {
+		t.Skip(err)
+	}
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = before })
+	cancelled := make(chan string, 4)
+	b, wt, _ := browserBox(t, func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasPrefix(r.URL.Path, "/slow") {
+			select {
+			case <-time.After(8 * time.Second):
+			case <-r.Context().Done():
+				cancelled <- r.URL.Path
+				return
+			}
+		}
+		fmt.Fprintf(w, `<title>Page %s</title><a id="link" href="/slow-link">Slow link</a><a id="new" href="/new-tab">New tab link</a><p>Loaded %s</p>`, r.URL.Path, r.URL.Path)
+	})
+	m := b.NewBrowsers(t.TempDir(), 1)
+	defer m.CloseAll("test")
+	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Second)
+	defer cancel()
+	loc, _ := b.Locations.Get(ctx, "cal")
+	br, err := m.get(ctx, loc, wt, "user-nav")
+	if err != nil {
+		t.Fatal(err)
+	}
+	site := "http://billing.cal.devbox.localhost:1377"
+	state := func() BrowserControlState {
+		statusContext, statusCancel := context.WithTimeout(ctx, time.Second)
+		defer statusCancel()
+		return br.controlState(statusContext)
+	}
+	activeTab := "user-nav"
+	call := func(fn func(http.ResponseWriter, *http.Request) error, body any) {
+		t.Helper()
+		raw, _ := json.Marshal(body)
+		r := httptest.NewRequest("POST", "http://box/?tab="+activeTab, bytes.NewReader(raw))
+		requestContext, requestCancel := context.WithCancel(ctx)
+		defer requestCancel()
+		r = r.WithContext(requestContext)
+		r.SetPathValue("loc", "cal")
+		r.SetPathValue("wt", "billing")
+		if err := fn(httptest.NewRecorder(), r); err != nil {
+			t.Fatal(err)
+		}
+	}
+	until := func(test func() bool) {
+		t.Helper()
+		deadline := time.Now().Add(10 * time.Second)
+		for time.Now().Before(deadline) {
+			if test() {
+				return
+			}
+			time.Sleep(30 * time.Millisecond)
+		}
+		t.Fatal("browser navigation did not settle")
+	}
+	open := func(path string) {
+		t.Helper()
+		start := time.Now()
+		call(b.browserNavigate, map[string]string{"action": "open", "url": site + path})
+		if time.Since(start) > time.Second {
+			t.Fatal("navigation waited for response")
+		}
+	}
+	open("/start")
+	until(func() bool {
+		s := state()
+		return s.URL == site+"/start" && !s.Loading && s.Title == "Page /start"
+	})
+	open("/slow-open")
+	time.Sleep(5500 * time.Millisecond)
+	if s := state(); !s.Loading || s.Error != "" {
+		t.Fatalf("slow response lost Stop or gained a false error: %+v", s)
+	}
+	until(func() bool {
+		s := state()
+		return s.URL == site+"/slow-open" && !s.Loading && s.Title == "Page /slow-open"
+	})
+	if s := state(); s.Error != "" {
+		t.Fatal(s.Error)
+	}
+	var point struct{ X, Y float64 }
+	raw, err := br.evaluate(ctx, `(()=>{const r=document.querySelector('#link').getBoundingClientRect();return {X:r.x+r.width/2,Y:r.y+r.height/2}})()`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	json.Unmarshal(raw, &point)
+	for _, kind := range []string{"mousePressed", "mouseReleased"} {
+		buttons := 0
+		if kind == "mousePressed" {
+			buttons = 1
+		}
+		call(b.browserInput, browserInput{Type: kind, X: point.X, Y: point.Y, Button: "left", Buttons: buttons, ClickCount: 1})
+	}
+	until(func() bool { return state().Loading })
+	time.Sleep(5500 * time.Millisecond)
+	if s := state(); !s.Loading || s.Error != "" {
+		t.Fatalf("link navigation lost Stop: %+v", s)
+	}
+	call(b.browserNavigate, map[string]string{"action": "stop"})
+	until(func() bool { return !state().Loading })
+	if s := state(); s.Error != "" {
+		t.Fatalf("Stop left navigation error: %+v", s)
+	}
+	select {
+	case path := <-cancelled:
+		if path != "/slow-link" {
+			t.Fatal("wrong navigation cancelled", path)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Stop did not cancel the pending response")
+	}
+	open("/slow-replaced")
+	open("/replacement")
+	until(func() bool {
+		s := state()
+		return s.URL == site+"/replacement" && !s.Loading && s.Title == "Page /replacement"
+	})
+	if s := state(); s.Error != "" {
+		t.Fatal("old navigation replaced current state", s.Error)
+	}
+	br.evaluate(ctx, `document.cookie='personal=yes;path=/';true`)
+	agent, err := m.get(ctx, loc, wt, "agent-nav")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := agent.Open(ctx, site+"/agent"); err != nil {
+		t.Fatal(err)
+	}
+	agent.evaluate(ctx, `document.cookie='agent-only=yes;path=/';true`)
+	for _, target := range []*browser{br, agent} {
+		activeTab = target.tab
+		for _, input := range []browserInput{{Button: "left", Modifiers: 4, Buttons: 1}, {Button: "middle", Buttons: 4}} {
+			raw, _ := target.evaluate(ctx, `(()=>{const r=document.querySelector('#new').getBoundingClientRect();return {X:r.x+r.width/2,Y:r.y+r.height/2}})()`)
+			json.Unmarshal(raw, &point)
+			before := len(br.chromium.list())
+			input.X = point.X
+			input.Y = point.Y
+			input.ClickCount = 1
+			input.Type = "mousePressed"
+			call(b.browserInput, input)
+			input.Type = "mouseReleased"
+			input.Buttons = 0
+			call(b.browserInput, input)
+			time.Sleep(500 * time.Millisecond)
+			if len(br.chromium.list()) != before+1 {
+				var targets any
+				br.cdp.call(ctx, "", "Target.getTargets", nil, &targets)
+				t.Fatalf("%s modifiers=%d did not create a visible tab: %+v", input.Button, input.Modifiers, targets)
+			}
+			for _, popup := range br.chromium.list() {
+				if !strings.Contains(popup.tab, "-popup-") || popup.bctx != target.bctx {
+					continue
+				}
+				until(func() bool { return popup.controlState(ctx).URL == site+"/new-tab" })
+				cookies, _ := popup.evaluate(ctx, "document.cookie")
