@@ -2,13 +2,22 @@ package box
 
 import (
 	"os"
+	"os/exec"
 	"path/filepath"
 	"strings"
 	"testing"
 )
 
 func TestIntegrationsReportAndInstallOneTool(t *testing.T) {
+	tmux, err := exec.LookPath("tmux")
+	if err != nil {
+		t.Skip("tmux not installed")
+	}
 	home, path := t.TempDir(), t.TempDir()
+	// Keep the server fixture available while hiding the person's agent CLIs.
+	if err := os.Symlink(tmux, filepath.Join(path, "tmux")); err != nil {
+		t.Fatal(err)
+	}
 	os.WriteFile(filepath.Join(path, "claude"), []byte("#!/bin/sh\n"), 0o755)
 	t.Setenv("HOME", home)
 	t.Setenv("PATH", path)
