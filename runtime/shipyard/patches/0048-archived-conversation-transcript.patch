+// conversationTranscript reads a saved record without resuming its agent or
+// requiring a tmux session. It uses the same bounded window and history pages
+// as a live chat, including generation/cursor handling after a runtime restart.
+func (b *Box) conversationTranscript(w http.ResponseWriter, r *http.Request) error {
+	dir, err := b.conversationDir(r.PathValue("id"))
+	if err != nil {
+		return err
+	}
+	meta, _ := readConversation(dir)
+	source := transcript.SourceACPHost
+	switch meta.Agent {
+	case "", "claude":
+		source = transcript.SourceClaudeHost
+	case "codex":
+		source = transcript.SourceCodexHost
+	}
+	path := filepath.Join(dir, agenthost.LogName)
+	if r.URL.Query().Has("before") {
+		return olderPage(w, r, source, path, meta.Dir)
+	}
+	since, _ := strconv.Atoi(r.URL.Query().Get("since"))
+	res, err := reader().Follow(source, path, meta.Dir, max(since, 0), r.URL.Query().Get("gen"))
+	if err != nil {
+		return err
+	}
+	writeJSON(w, res)
+	return nil
+}
+
 // readConversation reads a conversation's meta.json.
 func readConversation(dir string) (Conversation, bool) {
 	raw, err := os.ReadFile(filepath.Join(dir, metaName))
