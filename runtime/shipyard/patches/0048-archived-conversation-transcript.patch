+// No session manager or driver is installed: reading a saved chat must never
+// look up tmux sessions, launch an agent, or change the conversation's files.
+func archivedTranscriptFixture(t *testing.T, agent string, log []byte) (*http.ServeMux, string) {
+	t.Helper()
+	root := t.TempDir()
+	dir := filepath.Join(root, "saved-chat")
+	if err := os.Mkdir(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	noteConversation(dir, func(c *Conversation) {
+		c.Agent, c.Dir, c.Session = agent, "/no-longer-present/project", "removed-session"
+	})
+	if err := os.WriteFile(filepath.Join(dir, agenthost.LogName), log, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	b := &Box{ConversationsDir: root}
+	mux := http.NewServeMux()
+	b.mountConversations(func(pattern string, handler func(http.ResponseWriter, *http.Request) error) {
+		mux.HandleFunc(pattern, func(w http.ResponseWriter, r *http.Request) {
+			if err := handler(w, r); err != nil {
+				writeErr(w, err)
+			}
+		})
+	})
+	return mux, dir
+}
+
+func readArchivedTranscript(t *testing.T, mux *http.ServeMux, query string) transcript.Result {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("GET", "/v1/conversations/saved-chat/transcript"+query, nil))
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status %d: %s", rec.Code, rec.Body.String())
+	}
+	var result transcript.Result
+	if err := json.Unmarshal(rec.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
+
+func TestArchivedConversationTranscriptWithoutSession(t *testing.T) {
+	for _, tc := range []struct{ agent, fixture, source, answer string }{
+		{"claude", "claude_host_ask.jsonl", "claude", "You chose Tea."},
+		{"codex", "codex_host_approve.jsonl", "codex", "REFUSED"},
+		{"opencode", "acp_host_opencode.jsonl", "acp", "DONE"},
+	} {
+		t.Run(tc.agent, func(t *testing.T) {
+			log, err := os.ReadFile(filepath.Join("..", "transcript", "testdata", tc.fixture))
+			if err != nil {
+				t.Fatal(err)
+			}
+			mux, dir := archivedTranscriptFixture(t, tc.agent, log)
+			meta, _ := os.ReadFile(filepath.Join(dir, metaName))
+			first := readArchivedTranscript(t, mux, "")
+			if first.Source != tc.source || len(first.Items) == 0 || first.Items[0].Kind != "user" || first.Items[len(first.Items)-1].Text != tc.answer {
+				t.Fatalf("saved conversation: %+v", first)
+			}
+			again := readArchivedTranscript(t, mux, fmt.Sprintf("?since=%d&gen=%s", first.Next, first.Gen))
+			if len(again.Items) != 0 || again.Next != first.Next {
+				t.Fatalf("cursor replayed items: %+v", again)
+			}
+			for name, before := range map[string][]byte{metaName: meta, agenthost.LogName: log} {
+				after, err := os.ReadFile(filepath.Join(dir, name))
+				if err != nil || !bytes.Equal(after, before) {
+					t.Fatalf("reading changed %s: %v", name, err)
+				}
+			}
+			files, _ := os.ReadDir(dir)
+			if len(files) != 2 {
+				t.Fatalf("reading created files: %v", files)
+			}
+		})
+	}
+}
+
+func TestArchivedConversationTranscriptBoundsLongRecordsAndPagesBack(t *testing.T) {
+	// More than 44 MB of protocol padding must not become an unbounded UI response.
+	var log bytes.Buffer
+	pad := strings.Repeat("x", 64<<10)
+	for i := range 700 {
+		fmt.Fprintf(&log, `{"dir":"out","padding":%q,"data":{"type":"user","uuid":"u%d","message":{"role":"user","content":"Question %d"}}}`+"\n", pad, i, i)
+		fmt.Fprintf(&log, `{"dir":"out","data":{"type":"assistant","uuid":"a%d","message":{"role":"assistant","content":[{"type":"text","text":"Answer %d"}]}}}`+"\n", i, i)
+	}
+	mux, _ := archivedTranscriptFixture(t, "claude", log.Bytes())
+	last := readArchivedTranscript(t, mux, "")
+	if !last.Truncated || len(last.Items) < 2 || len(last.Items) > 300 || last.Items[len(last.Items)-1].Text != "Answer 699" {
+		t.Fatalf("unbounded or incomplete final window: truncated=%v items=%d", last.Truncated, len(last.Items))
+	}
+	body, _ := json.Marshal(last)
+	if len(body) > 1<<20 {
+		t.Fatalf("window grew to %d bytes", len(body))
+	}
+	older := readArchivedTranscript(t, mux, fmt.Sprintf("?before=%d&limit=10", last.Start))
+	if len(older.Items) == 0 || len(older.Items) > 10 || older.Items[len(older.Items)-1].Off >= last.Start {
+		t.Fatalf("older window: %+v", older)
+	}
+}
+
+func TestArchivedConversationTranscriptRejectsMissingAndInvalidIDs(t *testing.T) {
+	mux, _ := archivedTranscriptFixture(t, "claude", nil)
+	for _, id := range []string{"missing", ".hidden", "%2E%2E", "%2Ftmp"} {
+		rec := httptest.NewRecorder()
+		mux.ServeHTTP(rec, httptest.NewRequest("GET", "/v1/conversations/"+id+"/transcript", nil))
+		if rec.Code != http.StatusNotFound {
+			t.Errorf("%s: status %d", id, rec.Code)
+		}
+	}
+}
