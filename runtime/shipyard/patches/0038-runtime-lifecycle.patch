--- a/internal/box/worktreesetup_test.go
+++ b/internal/box/worktreesetup_test.go
@@ -1,12 +1,60 @@
 package box
 
 import (
+	"context"
 	"os"
 	"path/filepath"
+	"strings"
 	"testing"
 	"time"
+
+	"github.com/cosscom/shipyard/internal/events"
 )
 
+func TestSetupFinishesAfterItsAutostartServices(t *testing.T) {
+	t.Setenv("SHELL", "/bin/sh")
+	ctx := context.Background()
+	repo := gitRepo(t)
+	writeRepoConfig(t, repo, RepoConfig{Setup: "echo ready > .setup-ran", Services: []WorktreeService{{Name: "web", Run: "echo web", Autostart: true}}})
+	units := &Units{Dir: t.TempDir()}
+	units.svc, _ = fakeService()
+	bus := &events.Bus{}
+	b := &Box{Name: "devbox", Locations: NewLocations(filepath.Join(t.TempDir(), "locations.json")), Events: bus, Units: units, LogDir: t.TempDir()}
+	if _, err := b.Locations.Add(ctx, "cal", repo); err != nil {
+		t.Fatal(err)
+	}
+	trustRepo(t, b.Locations, "cal")
+	loc, err := b.Locations.Get(ctx, "cal")
+	if err != nil {
+		t.Fatal(err)
+	}
+	wt, err := b.Locations.CreateWorktree(ctx, "cal", "billing", "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen, stop := bus.Subscribe()
+	defer stop()
+	b.runSetup("app", loc, wt.Path, wt.Name)
+	var order []string
+	deadline := time.After(10 * time.Second)
+	for len(order) < 3 {
+		select {
+		case e := <-seen:
+			switch e.Type {
+			case "worktree.setup.started", "service.started", "worktree.setup.finished":
+				order = append(order, e.Type)
+			case "worktree.setup.failed", "service.failed":
+				t.Fatalf("setup failed: %+v", e)
+			}
+		case <-deadline:
+			t.Fatalf("setup did not finish: %v", order)
+		}
+	}
+	if got, want := strings.Join(order, ","), "worktree.setup.started,service.started,worktree.setup.finished"; got != want {
+		t.Fatalf("setup events = %s, want %s", got, want)
+	}
+}
