diff --git a/internal/box/repoconfig.go b/internal/box/repoconfig.go
index c6bc241..bfdddab 100644
--- a/internal/box/repoconfig.go
+++ b/internal/box/repoconfig.go
@@ -4,6 +4,7 @@ import (
 	"context"
 	"encoding/json"
 	"fmt"
+	"net"
 	"net/http"
 	"os"
 	"path/filepath"
@@ -245,8 +246,16 @@ func (l *Locations) SetLocalConfig(name string, c RepoConfig) error {
 // Ports: each worktree gets a stable block of ports of its own, so two
 // worktrees of one app never fight over 3000.
 
+// portBase is where blocks start; BERTH_PORT_BASE moves an embedded berthd's
+// blocks clear of the person's own berthd, which starts at 41000.
+var portBase = func() int {
+	if n, err := strconv.Atoi(os.Getenv("BERTH_PORT_BASE")); err == nil && n >= 1024 && n < portLimit {
+		return n
+	}
+	return 41000
+}()
+
 const (
-	portBase            = 41000
 	portLimit           = 48999
 	portBlock           = 10
 	maxPortsPerWorktree = portBlock
@@ -287,7 +296,7 @@ func (p *PortAlloc) For(dir string) (int, error) {
 		used[port] = true
 	}
 	for port := portBase; port+portBlock-1 <= portLimit; port += portBlock {
-		if !used[port] {
+		if !used[port] && portFree(port) {
 			m[dir] = port
 			b, _ := json.MarshalIndent(m, "", "  ")
 			return port, statefile.Write(p.Path, b)
@@ -296,6 +305,17 @@ func (p *PortAlloc) For(dir string) (int, error) {
 	return 0, fmt.Errorf("every port block from %d to %d is taken", portBase, portLimit)
 }
 
+// portFree says nothing listens on port now: another berthd's block, or
+// anything else, is passed over.
+func portFree(port int) bool {
+	ln, err := net.Listen("tcp", "127.0.0.1:"+strconv.Itoa(port))
+	if err != nil {
+		return false
+	}
+	ln.Close()
+	return true
+}
+
 // Release frees dir's block.
 func (p *PortAlloc) Release(dir string) {
 	if p == nil {
diff --git a/internal/box/sessions.go b/internal/box/sessions.go
index 05be49c..6a44b99 100644
--- a/internal/box/sessions.go
+++ b/internal/box/sessions.go
@@ -3,7 +3,9 @@ package box
 import (
 	"bytes"
 	"context"
+	"crypto/sha256"
 	"encoding/base64"
+	"encoding/hex"
 	"errors"
 	"fmt"
 	"maps"
@@ -181,6 +183,23 @@ var tmuxSocket = firstNonEmpty(os.Getenv("BERTH_TMUX_SOCKET"), "berth")
 // leaves the person's agent configuration alone.
 var Embedded = os.Getenv("BERTH_EMBEDDED") == "1"
 
+// EmbeddedBin is a folder holding this berthd as `berthd`, first on an
+// embedded berthd's sessions' PATH, so its agents reach it and no other.
+var EmbeddedBin string
+
+// EmbeddedFiles, when set, holds each workspace's browser downloads and long
+// snapshots, so an embedded berthd writes nothing into the person's folders.
+var EmbeddedFiles string
+
+// browserFiles is where a workspace's browser downloads and long snapshots go.
+func browserFiles(workspace string) string {
+	if EmbeddedFiles == "" {
+		return filepath.Join(workspace, ".berth", "browser")
+	}
+	sum := sha256.Sum256([]byte(workspace))
+	return filepath.Join(EmbeddedFiles, hex.EncodeToString(sum[:6])+"-"+filepath.Base(workspace))
+}
+
 // TmuxSocket is the name of berth's tmux server.
 func TmuxSocket() string { return tmuxSocket }
 
