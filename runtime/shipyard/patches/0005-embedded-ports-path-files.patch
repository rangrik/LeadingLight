From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeadingLight <noreply@leadinglight.app>
Date: Sat, 24 Oct 2026 04:18:25 -0700
Subject: [PATCH] Embedded: its own ports, PATH and scratch files

BERTH_PORT_BASE starts an embedded berthd's port blocks clear of the
person's berthd, and a block whose first port is in use is passed over.
An embedded berthd links itself as berthd in its state's bin folder and
puts that first on its sessions' PATH, so an agent's berthd browser and
tools reach it, not another install. Browser downloads and long snapshots
go to its state, one folder per workspace, not .berth/ in the person's
folder.
---
 cmd/berthd/main.go          |  7 +++++++
 internal/box/agentpaths.go  |  4 ++++
 internal/box/browser.go     |  2 +-
 internal/box/browsertabs.go |  2 +-
 internal/box/repoconfig.go  | 24 ++++++++++++++++++++++--
 internal/box/sessions.go    | 19 +++++++++++++++++++
 6 files changed, 54 insertions(+), 4 deletions(-)

diff --git a/cmd/berthd/main.go b/cmd/berthd/main.go
index 4526f73..1da4372 100644
--- a/cmd/berthd/main.go
+++ b/cmd/berthd/main.go
@@ -419,6 +419,13 @@ func serve(b boxHome, args []string) error {
 	// them before its agent starts.
 	if !box.Embedded {
 		bx.Sessions.Prepare = bx.PrepareAccounts
+	} else if dir := filepath.Join(b.dir, "bin"); os.MkdirAll(dir, 0o700) == nil {
+		link := filepath.Join(dir, "berthd")
+		os.Remove(link)
+		if os.Symlink(exe, link) == nil {
+			box.EmbeddedBin = dir
+		}
+		box.EmbeddedFiles = filepath.Join(b.dir, "browser", "files")
 	}
 	bx.Artifacts = &box.ArtifactStore{Dir: filepath.Join(b.dir, "artifacts"), Events: bus, Box: hostname}
 	go bx.Artifacts.Run(ctx)
diff --git a/internal/box/agentpaths.go b/internal/box/agentpaths.go
index a8a6ea2..8527780 100644
--- a/internal/box/agentpaths.go
+++ b/internal/box/agentpaths.go
@@ -5,6 +5,7 @@ import (
 	"net/http"
 	"os"
 	"path/filepath"
+	"strings"
 	"time"
 
 	"github.com/cosscom/shipyard/internal/agentpath"
@@ -75,6 +76,9 @@ func launchPATH(command, agent string) string {
 // withPATH puts dirs before the session's own PATH, then runs what follows,
 // in shell's syntax.
 func withPATH(shell, dirs, then string) string {
+	if EmbeddedBin != "" {
+		dirs = strings.TrimSuffix(EmbeddedBin+string(filepath.ListSeparator)+dirs, string(filepath.ListSeparator))
+	}
 	if dirs == "" {
 		return then
 	}
