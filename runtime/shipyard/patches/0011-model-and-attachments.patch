diff --git a/internal/box/model.go b/internal/box/model.go
new file mode 100644
index 0000000..87cbb9d
--- /dev/null
+++ b/internal/box/model.go
@@ -0,0 +1,60 @@
+package box
+
+import (
+	"net/http"
+)
+
+// setModel answers POST /v1/sessions/{name}/model {model?, effort?}: a chat's
+// model and effort, changed while its agent runs. Claude Code takes them at
+// once (set_model, and effortLevel in its settings); Codex from its next
+// turn, which carries them. The conversation keeps them, so the agent
+// carries on with them when it is resumed.
+func (b *Box) setModel(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Model  string `json:"model"`
+		Effort string `json:"effort"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	sess, err := b.Sessions.Get(r.Context(), r.PathValue("name"))
+	if err != nil {
+		return err
+	}
+	if sess.Exited {
+		return ErrSessionExited
+	}
+	switch d := b.driverFor(sess).(type) {
+	case *claudeDriver:
+		c, err := d.conv(sess)
+		if err != nil {
+			return err
+		}
+		if req.Model != "" {
+			if _, err := c.control(r.Context(), map[string]any{"subtype": "set_model", "model": req.Model}); err != nil {
+				return err
+			}
+		}
+		if req.Effort != "" {
+			if _, err := c.control(r.Context(), map[string]any{"subtype": "apply_flag_settings", "settings": map[string]any{"effortLevel": req.Effort}}); err != nil {
+				return err
+			}
+		}
+	case *codexDriver:
+		c, err := d.conv(sess)
+		if err != nil {
+			return err
+		}
+		c.mu.Lock()
+		c.model, c.effort = firstNonEmpty(req.Model, c.model), firstNonEmpty(req.Effort, c.effort)
+		c.mu.Unlock()
+	default:
+		return badRequest("this agent's model is set when it starts")
+	}
+	noteConversation(sess.conv, func(m *Conversation) {
+		m.Model, m.Effort = firstNonEmpty(req.Model, m.Model), firstNonEmpty(req.Effort, m.Effort)
+	})
+	b.publish(r, "session.model", map[string]any{"name": sess.Name, "model": req.Model, "effort": req.Effort})
+	writeJSON(w, map[string]any{"model": req.Model, "effort": req.Effort})
+	return nil
+}
