 // SaveAttachment writes an attachment into the worktree at dir and returns
 // it. The file is the box user's alone (0600), in a folder git ignores.
 func SaveAttachment(ctx context.Context, dir, name string, data []byte) (Attachment, error) {
+	return saveAttachment(ctx, filepath.Join(dir, filepath.FromSlash(attachmentDir)), dir, name, data)
+}
+
+// conversationAttachments is where an embedded berthd keeps a conversation's
+// attachments: in its own state, never in the person's folder. Claude Code may
+// read there (launchClaudeIn).
+func conversationAttachments(conv string) string { return filepath.Join(conv, "attachments") }
+
+// saveAttachment keeps the file in folder; repo, when set, is the worktree
+// whose git must not see it.
+func saveAttachment(ctx context.Context, folder, repo, name string, data []byte) (Attachment, error) {
 	if len(data) == 0 {
 		return Attachment{}, badRequest("the file is empty")
 	}
@@ -119,11 +130,12 @@ func SaveAttachment(ctx context.Context, dir, name string, data []byte) (Attachm
 	if err != nil {
 		return Attachment{}, httpError{http.StatusUnsupportedMediaType, err.Error()}
 	}
-	folder := filepath.Join(dir, filepath.FromSlash(attachmentDir))
 	if err := os.MkdirAll(folder, 0o700); err != nil {
 		return Attachment{}, err
 	}
-	excludeFromGit(ctx, dir, attachmentDir+"/")
+	if repo != "" {
+		excludeFromGit(ctx, repo, attachmentDir+"/")
+	}
 	file := attachmentName(name, ext)
 	stamp := time.Now().Format("20060102-150405")
 	for i := 0; ; i++ {
@@ -213,6 +225,18 @@ func (b *Box) sessionAttachment(w http.ResponseWriter, r *http.Request) error {
 	if err != nil {
 		return err
 	}
+	if EmbeddedFiles != "" && sess.conv != "" {
+		name, data, err := readAttachment(r)
+		if err != nil {
+			return err
+		}
+		a, err := saveAttachment(r.Context(), conversationAttachments(sess.conv), "", name, data)
+		if err != nil {
+			return err
+		}
+		writeJSON(w, a)
+		return nil
+	}
 	return b.attach1(w, r, sess.Dir)
 }
 
