 internal/box/attachments.go  | 28 +++++++++++++++--
 internal/box/claudedriver.go |  6 ++++
 internal/box/model.go        | 60 ++++++++++++++++++++++++++++++++++++
 4 files changed, 93 insertions(+), 2 deletions(-)
 create mode 100644 internal/box/model.go

