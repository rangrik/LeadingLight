From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeadingLight <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 07:46:05 -0700
Subject: [PATCH] Codex: at work once answered; its plans and stops in the
 record

Answered, a Codex session reads as working again (an approved command runs) until it asks something else. Plan mode's plan reads as its answer, and a turn stopped part way says Interrupted, as Claude's do.
---
 internal/box/codexdriver.go           |  5 +++++
 internal/transcript/codexhost.go      | 15 +++++++++++++++
 internal/transcript/codexhost_test.go | 24 ++++++++++++++++++++++++
 3 files changed, 44 insertions(+)

diff --git a/internal/box/codexdriver.go b/internal/box/codexdriver.go
index bfef9c4..130646b 100644
--- a/internal/box/codexdriver.go
+++ b/internal/box/codexdriver.go
@@ -359,8 +359,13 @@ func (c *codexConv) apply(e agenthost.Entry, live bool) {
 			c.sent[string(m.ID)] = m.Method
 		case m.Method == "" && len(m.ID) > 0:
 			// berthd answered one of Codex's requests.
+			before := len(c.pending)
 			c.drop(string(m.ID))
 			c.reqs.mark(string(m.ID), ReqRecorded, e.At)
+			// Answered, it works again (an approved command runs) until Codex asks something else.
+			if live && before > 0 && len(c.pending) == 0 && c.busy {
+				say = append(say, func() { c.event(adapters.Started, map[string]any{"signal": "tool"}, nil) })
+			}
 		}
 		return
 	case "out":
diff --git a/internal/transcript/codexhost.go b/internal/transcript/codexhost.go
index 276da6d..39872fb 100644
--- a/internal/transcript/codexhost.go
+++ b/internal/transcript/codexhost.go
@@ -89,6 +89,16 @@ func (p *codexHostParser) line(c *conv, b []byte) {
 			return
 		}
 		codexHostItem(c, params.Item, m.Method == "item/completed", at)
+	case "turn/completed":
+		// A turn stopped part way says so, as Claude's do.
+		var params struct {
+			Turn struct {
+				Status string `json:"status"`
+			} `json:"turn"`
+		}
+		if json.Unmarshal(m.Params, &params) == nil && params.Turn.Status == "interrupted" {
+			c.notice("interrupted", "info", "Interrupted", 0)
+		}
 	case "item/tool/requestUserInput":
 		var params struct {
 			ItemID    string          `json:"itemId"`
@@ -125,6 +135,11 @@ func codexHostItem(c *conv, it codexThreadItem, done bool, at int64) {
 		if text := strings.TrimSpace(strings.Join(parts, "\n")); text != "" {
 			userText(c, text)
 		}
+	case "plan":
+		// Plan mode's plan is its answer.
+		if done && strings.TrimSpace(it.Text) != "" {
+			c.add(Item{Kind: "text", ID: c.id(), Text: clip(strings.TrimSpace(it.Text), maxText)})
+		}
 	case "agentMessage":
 		if done && strings.TrimSpace(it.Text) != "" {
 			c.add(Item{Kind: "text", ID: c.id(), Text: clip(strings.TrimSpace(it.Text), maxText)})
diff --git a/internal/transcript/codexhost_test.go b/internal/transcript/codexhost_test.go
index a8a83c3..885d2d4 100644
--- a/internal/transcript/codexhost_test.go
+++ b/internal/transcript/codexhost_test.go
@@ -1,6 +1,7 @@
 package transcript
 
 import (
+	"os"
 	"path/filepath"
 	"strings"
 	"testing"
@@ -47,3 +48,26 @@ func TestAStructuredCodexSessionsLogReadsAsItsConversation(t *testing.T) {
 		t.Fatalf("detail = %+v, %v", d, err)
 	}
 }
+
+// Plan mode's plan reads as Codex's answer, and a turn stopped part way says so.
+func TestACodexPlanShowsAndAStoppedTurnSaysSo(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "host.jsonl")
+	lines := `{"seq":1,"at":1,"dir":"out","data":{"method":"item/started","params":{"item":{"type":"userMessage","id":"u1","content":[{"type":"text","text":"Plan it"}]}}}}
+{"seq":2,"at":2,"dir":"out","data":{"method":"item/completed","params":{"item":{"type":"plan","id":"p1","text":"1. Read\n2. Write"}}}}
+{"seq":3,"at":3,"dir":"out","data":{"method":"turn/completed","params":{"turn":{"id":"t1","status":"interrupted"}}}}
+`
+	if err := os.WriteFile(path, []byte(lines), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	res, err := NewReader().Read(SourceCodexHost, path, t.TempDir(), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []string
+	for _, it := range res.Items {
+		got = append(got, it.Kind+":"+it.Text+it.Notice)
+	}
+	if strings.Join(got, "|") != "user:Plan it|text:1. Read\n2. Write|notice:Interruptedinterrupted" {
+		t.Fatalf("items: %q", got)
+	}
+}
