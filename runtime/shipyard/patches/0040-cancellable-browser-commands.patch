diff --git a/internal/box/browserqueue_test.go b/internal/box/browserqueue_test.go
new file mode 100644
index 0000000..44f7066
--- /dev/null
+++ b/internal/box/browserqueue_test.go
@@ -0,0 +1,86 @@
+package box
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"testing"
+	"time"
+)
+
+// A cancelled request must leave a busy tab's queue without waiting for Chromium.
+func TestCancelledBrowserCommandDoesNotWaitBehindAnother(t *testing.T) {
+	client, chrome := net.Pipe()
+	defer client.Close()
+	defer chrome.Close()
+	requests := make(chan cdpMessage, 4)
+	go func() {
+		r := bufio.NewReader(chrome)
+		for {
+			raw, err := r.ReadBytes(0)
+			if err != nil {
+				return
+			}
+			var msg cdpMessage
+			if json.Unmarshal(raw[:len(raw)-1], &msg) != nil {
+				return
+			}
+			requests <- msg
+			var params struct {
+				Expression string `json:"expression"`
+			}
+			json.Unmarshal(msg.Params, &params)
+			if params.Expression == "blocked" {
+				continue
+			}
+			reply, _ := json.Marshal(map[string]any{"id": msg.ID, "result": map[string]any{"result": map[string]any{"value": "ready"}}})
+			if _, err := chrome.Write(append(reply, 0)); err != nil {
+				return
+			}
+		}
+	}()
+	br := &browser{chromium: &chromium{cdp: newCDP(client, client, nil)}}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	active := make(chan struct{})
+	go func() { defer close(active); br.Eval(ctx, "blocked") }()
+	select {
+	case <-requests:
+	case <-time.After(3 * time.Second):
+		t.Fatal("first command never reached Chromium")
+	}
+	for _, expired := range []bool{true, false} {
+		cancelled, stop := context.WithTimeout(context.Background(), 50*time.Millisecond)
+		want := context.DeadlineExceeded
+		if expired {
+			stop()
+			want = context.Canceled
+		}
+		queued := make(chan error, 1)
+		go func() { _, err := br.Snapshot(cancelled, false, false, "", 0); queued <- err }()
+		var got error
+		select {
+		case got = <-queued:
+		case <-time.After(time.Second):
+			stop()
+			cancel()
+			<-active
+			<-queued
+			t.Fatalf("cancelled command waited for the active command (already expired: %v)", expired)
+		}
+		stop()
+		if !errors.Is(got, want) {
+			t.Fatalf("cancelled command = %v, want %v", got, want)
+		}
+	}
+	cancel()
+	<-active
+	check, done := context.WithTimeout(context.Background(), time.Second)
+	defer done()
+	out, err := br.Eval(check, "ready")
+	if err != nil || out.Text != `"ready"` {
+		t.Fatalf("next command = %+v, %v", out, err)
+	}
+}
