+// The fake manager blocks while replacing a unit. Cancelling Install must
+// stop that process and must not go on to bootstrap or start the service.
+func TestUnitInstallCancelsItsServiceManager(t *testing.T) {
+	if runtime.GOOS != "darwin" && runtime.GOOS != "linux" {
+		t.Skip("no supported service manager")
+	}
+	dir := t.TempDir()
+	t.Setenv("HOME", dir)
+	t.Setenv("XDG_CONFIG_HOME", dir)
+	bin := filepath.Join(dir, "bin")
+	if err := os.Mkdir(bin, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	marker, calls := filepath.Join(dir, "manager.pid"), filepath.Join(dir, "calls")
+	loaded := filepath.Join(dir, "loaded")
+	script := "#!/bin/sh\nprintf '%s\n' \"$*\" >> " + shellQuote(calls) + "\n" +
+		"case \"$*\" in\n" +
+		"*bootout*|*daemon-reload*) if [ ! -f " + shellQuote(marker) + " ]; then echo $$ > " + shellQuote(marker) + "; exec /bin/sleep 30; fi;;\n" +
+		"*bootstrap*|*restart*) touch " + shellQuote(loaded) + ";;\n" +
+		"*kickstart*|*' start '*) [ -f " + shellQuote(loaded) + " ] || exit 1;;\n" +
+		"*is-active*) echo active; exit;;\n" +
+		"esac\necho 'state = running'\n"
+
+	for _, name := range []string{"launchctl", "systemctl"} {
+		if err := os.WriteFile(filepath.Join(bin, name), []byte(script), 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	u := &Units{Dir: filepath.Join(dir, "logs")}
+	go func() {
+		_, err := u.Install(ctx, UnitRequest{Name: "berth-cancel-probe", Program: "/bin/sh"})
+		done <- err
+	}()
+	finished := false
+	t.Cleanup(func() {
+		cancel()
+		if finished {
+			return
+		}
+		if raw, err := os.ReadFile(marker); err == nil {
+			if pid, err := strconv.Atoi(strings.TrimSpace(string(raw))); err == nil {
+				if p, err := os.FindProcess(pid); err == nil {
+					_ = p.Kill()
+				}
+			}
+		}
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+			t.Error("service manager did not stop during cleanup")
+		}
+	})
+	waitUntil(t, "the manager to start", 5*time.Second, func() bool { _, err := os.Stat(marker); return err == nil })
+	cancel()
+	select {
+	case err := <-done:
+		finished = true
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("Install cancellation: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Install ignored cancellation while waiting on the service manager")
+	}
+	raw, err := os.ReadFile(calls)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Count(string(raw), "\n") != 1 {
+		t.Fatalf("manager commands continued after cancellation: %s", raw)
+	}
+	// A matching file must not make retry skip the interrupted load. The fake
+	// manager rejects kickstart/start until bootstrap/restart actually ran.
+	retryCtx, stopRetry := context.WithTimeout(context.Background(), 5*time.Second)
+	defer stopRetry()
+	unit, err := u.Install(retryCtx, UnitRequest{Name: "berth-cancel-probe", Program: "/bin/sh"})
+	if err != nil || unit.State != "running" {
+		t.Fatalf("retrying the interrupted install = %+v, %v", unit, err)
+	}
+}
+
+func TestSetupCancellationIncludesServiceDiscoveryAndStartup(t *testing.T) {
+	for _, phase := range []string{"discovery", "startup"} {
+		t.Run(phase, func(t *testing.T) {
+			t.Setenv("SHELL", "/bin/sh")
+			b, wt, _ := serviceBox(t, nil, nil)
+			b.LogDir = t.TempDir()
+			if err := b.Locations.SetLocalConfig("cal", RepoConfig{Services: []WorktreeService{
+				{Name: "web", Run: "true", Autostart: true},
+				{Name: "later", Run: "true", Autostart: true},
+			}}); err != nil {
+				t.Fatal(err)
+			}
+			loc, err := b.Locations.Get(context.Background(), "cal")
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			entered := make(chan struct{}, 1)
+			calls := 0
+			blocked := func(ctx context.Context) error {
+				calls++
+				entered <- struct{}{}
+				<-ctx.Done()
+				return ctx.Err()
+			}
+			if phase == "discovery" {
+				b.Units.svc.installedByName = func(string) bool { return true }
+				b.Units.svc.running = func(ctx context.Context, _ service.Spec) (bool, error) {
+					return false, blocked(ctx)
+				}
+			} else {
+				b.Units.svc.install = func(ctx context.Context, _ service.Spec) (string, error) {
+					return "", blocked(ctx)
+				}
+			}
+			seen, stop := b.Events.Subscribe()
+			defer stop()
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				b.lifecycle("app", "setup", loc, wt.Path, wt.Name, "true", func() error {
+					return b.startAutostartContext(ctx, loc.Name, wt.Name)
+				})
+			}()
+			t.Cleanup(func() {
+				cancel()
+				select {
+				case <-done:
+				case <-time.After(3 * time.Second):
+					t.Error("setup did not stop during cleanup")
+				}
+			})
+			select {
+			case <-entered:
+			case <-time.After(5 * time.Second):
+				t.Fatal("setup did not reach service " + phase)
+			}
+			cancel()
+			select {
+			case <-done:
+			case <-time.After(2 * time.Second):
+				t.Fatal("setup did not finish after service cancellation")
+			}
+			if calls != 1 {
+				t.Fatalf("service manager called %d times; continued after cancellation", calls)
+			}
+			var order []string
+			for {
+				select {
+				case e := <-seen:
+					order = append(order, e.Type)
+					if e.Type == "worktree.setup.failed" && !strings.Contains(e.Error, context.Canceled.Error()) {
+						t.Fatalf("setup failure lost cancellation: %+v", e)
+					}
+				default:
+					want := "worktree.setup.started,worktree.setup.failed"
+					if phase == "startup" {
+						want = "worktree.setup.started,service.failed,worktree.setup.failed"
+					}
+					if got := strings.Join(order, ","); got != want {
+						t.Fatalf("setup events = %s, want %s", got, want)
+					}
+					return
+				}
+			}
+		})
+	}
+}
+
+// The request ending must not cancel background setup, and a failed service
+// must produce a setup failure instead of a success after an unbounded wait.
+func TestSetupRequestReturnsBeforeBoundedServiceStartup(t *testing.T) {
+	t.Setenv("SHELL", "/bin/sh")
+	b, wt, _ := serviceBox(t, nil, nil)
+	b.LogDir = t.TempDir()
+	if err := b.Locations.SetLocalConfig("cal", RepoConfig{Setup: "true", Services: []WorktreeService{{Name: "web", Run: "true", Autostart: true}}}); err != nil {
+		t.Fatal(err)
+	}
+	entered := make(chan context.Context, 1)
+	release := make(chan struct{})
+	b.Units.svc.install = func(ctx context.Context, _ service.Spec) (string, error) {
+		entered <- ctx
+		select {
+		case <-release:
+			return "", errors.New("service startup refused")
+		case <-ctx.Done():
+			return "", ctx.Err()
+		}
+	}
+	seen, stop := b.Events.Subscribe()
+	defer stop()
+	t.Cleanup(func() { close(release) })
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	r := httptest.NewRequest("POST", "/v1/locations/cal/worktrees/billing/setup", nil).WithContext(ctx)
+	r.SetPathValue("name", "cal")
+	r.SetPathValue("worktree", wt.Name)
+	w := httptest.NewRecorder()
+	done := make(chan error, 1)
+	go func() { done <- b.setupWorktree(w, r) }()
+	select {
+	case err := <-done:
+		if err != nil || w.Code != 200 {
+			t.Fatalf("setup request = %d, %v", w.Code, err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("setup request waited for its background service")
+	}
+	cancel()
+	select {
+	case startupCtx := <-entered:
+		if err := startupCtx.Err(); err != nil {
+			t.Fatalf("request cancellation stopped background startup: %v", err)
+		}
+		deadline, ok := startupCtx.Deadline()
+		if !ok || time.Until(deadline) <= 0 || time.Until(deadline) > 2*time.Minute {
+			t.Fatalf("startup has no two-minute bound: %v, %v", deadline, ok)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("background service did not start")
+	}
+	// Release once, leaving cleanup to close the channel even on a failed check.
+	release <- struct{}{}
+	var order []string
+	deadline := time.After(5 * time.Second)
+	for {
+		select {
+		case e := <-seen:
+			order = append(order, e.Type)
+			if e.Type == "worktree.setup.finished" {
+				t.Fatal("setup reported success after a service failure")
+			}
+			if e.Type == "worktree.setup.failed" {
+				if !strings.Contains(e.Error, "service startup refused") {
+					t.Fatalf("setup failure lost service error: %+v", e)
+				}
+				if got, want := strings.Join(order, ","), "worktree.setup.started,service.failed,worktree.setup.failed"; got != want {
+					t.Fatalf("setup events = %s, want %s", got, want)
+				}
+				return
+			}
+		case <-deadline:
+			t.Fatalf("setup did not report service failure: %v", order)
+		}
+	}
+}
