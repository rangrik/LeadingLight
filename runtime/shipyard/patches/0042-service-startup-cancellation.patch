@@ -0,0 +1,224 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+// Killing a manager does not guarantee EOF: a child may retain its output
+// pipes. Cancellation must bound that drain without killing managed services.
+func TestCommandCancellationBoundsInheritedPipes(t *testing.T) {
+	marker := filepath.Join(t.TempDir(), "child.pid")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := runCommand(ctx, "/bin/sh", "-c", `/bin/sleep 30 & echo $! > "$1"; wait`, "manager", marker)
+		done <- err
+	}()
+	finished := false
+	t.Cleanup(func() {
+		cancel()
+		if raw, err := os.ReadFile(marker); err == nil {
+			if pid, err := strconv.Atoi(strings.TrimSpace(string(raw))); err == nil {
+				if p, err := os.FindProcess(pid); err == nil {
+					_ = p.Kill()
+				}
+			}
+		}
+		if !finished {
+			select {
+			case <-done:
+			case <-time.After(3 * time.Second):
+				t.Error("test manager did not stop during cleanup")
+			}
+		}
+	})
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		if raw, err := os.ReadFile(marker); err == nil && len(raw) > 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("test manager did not start its child")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	cancel()
+	select {
+	case err := <-done:
+		finished = true
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("command cancellation = %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("manager cancellation waited for a child's inherited pipes")
+	}
+}
+
+func TestInterruptedServiceLoadStopsBeforeBootstrap(t *testing.T) {
+	for _, platform := range []string{"darwin", "linux"} {
+		t.Run(platform, func(t *testing.T) {
+			stub(t, platform)
+			calls := 0
+			command = func(context.Context, string, ...string) ([]byte, error) {
+				calls++
+				return nil, context.DeadlineExceeded
+			}
+			if err := load(context.Background(), spec, "/unused"); !errors.Is(err, context.DeadlineExceeded) {
+				t.Fatalf("load = %v; want deadline exceeded", err)
+			}
+			if calls != 1 {
+				t.Fatalf("load issued %d commands after a timeout", calls)
+			}
+			if running, err := RunningContext(context.Background(), spec); running || !errors.Is(err, context.DeadlineExceeded) {
+				t.Fatalf("RunningContext = %v, %v; want deadline exceeded", running, err)
+			}
+		})
+	}
+}
+
+func TestFailedInstallRestoresThePreviousDefinition(t *testing.T) {
+	for _, name := range []string{"new", "replacement", "restore-old"} {
+		t.Run(name, func(t *testing.T) {
+			home, calls := stub(t, "darwin")
+			original := spec
+			original.LogPath = filepath.Join(home, "service.log")
+			path, _ := UnitPath(original)
+			if name != "new" {
+				if _, err := Install(original); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Chmod(path, 0o640); err != nil {
+					t.Fatal(err)
+				}
+			}
+			updated := original
+			updated.Args = []string{"agent", "--changed"}
+			success := command
+			command = func(context.Context, string, ...string) ([]byte, error) {
+				return nil, context.Canceled
+			}
+			if _, err := EnsureContext(context.Background(), updated); !errors.Is(err, context.Canceled) {
+				t.Fatalf("EnsureContext = %v; want cancellation", err)
+			}
+			if Installed(updated) || Installed(original) {
+				t.Fatal("failed load is still marked installed; retry would skip loading it")
+			}
+			if name != "new" {
+				got, err := os.ReadFile(path)
+				want, _ := Render(original)
+				if err != nil || string(got) != string(want) {
+					t.Fatalf("failed replacement did not restore the previous definition: %q, %v", got, err)
+				}
+				info, err := os.Stat(path)
+				if err != nil || info.Mode().Perm() != 0o640 {
+					t.Fatalf("rollback did not preserve previous permissions: %v, %v", info, err)
+				}
+			} else if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("failed new unit remains on disk: %v", err)
+			}
+			command = success
+			before := len(*calls)
+			retry := updated
+			if name == "restore-old" {
+				retry = original
+			}
+			if _, err := EnsureContext(context.Background(), retry); err != nil {
+				t.Fatal(err)
+			}
+			if !Installed(retry) || len(*calls) == before {
+				t.Fatal("retry did not load and retain the requested definition")
+			}
+			if _, err := os.Stat(pendingUnitPath(path)); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("successful load left its pending marker: %v", err)
+			}
+		})
+	}
+}
+
+func TestFailedInstallLeavesAnExternalEditUntouched(t *testing.T) {
+	home, _ := stub(t, "darwin")
+	s := spec
+	s.LogPath = filepath.Join(home, "service.log")
+	path, _ := UnitPath(s)
+	external := []byte("a definition written by another owner")
+	command = func(context.Context, string, ...string) ([]byte, error) {
+		if err := os.WriteFile(path, external, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		return nil, context.DeadlineExceeded
+	}
+	_, err := InstallContext(context.Background(), s)
+	if !errors.Is(err, context.DeadlineExceeded) || !strings.Contains(err.Error(), "unit changed") {
+		t.Fatalf("installation must report both timeout and incomplete rollback: %v", err)
+	}
+	got, err := os.ReadFile(path)
+	if err != nil || string(got) != string(external) {
+		t.Fatalf("rollback overwrote an external edit: %q, %v", got, err)
+	}
+}
+
+func TestFailedInstallLeavesAnExternalSymlinkUntouched(t *testing.T) {
+	home, _ := stub(t, "darwin")
+	s := spec
+	s.LogPath = filepath.Join(home, "service.log")
+	path, _ := UnitPath(s)
+	moved := filepath.Join(home, "external-definition")
+	command = func(context.Context, string, ...string) ([]byte, error) {
+		if err := os.Rename(path, moved); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(moved, path); err != nil {
+			t.Fatal(err)
+		}
+		return nil, context.Canceled
+	}
+	_, err := InstallContext(context.Background(), s)
+	if !errors.Is(err, context.Canceled) || !strings.Contains(err.Error(), "unit changed") {
+		t.Fatalf("installation must report cancellation and incomplete rollback: %v", err)
+	}
+	if got, err := os.Readlink(path); err != nil || got != moved {
+		t.Fatalf("rollback replaced an external symlink to its former inode: %q, %v", got, err)
+	}
+}
+
+func TestFailedInstallLeavesExternalPermissionChangesUntouched(t *testing.T) {
+	home, _ := stub(t, "darwin")
+	original := spec
+	original.LogPath = filepath.Join(home, "service.log")
+	path, err := Install(original)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(path, 0o640); err != nil {
+		t.Fatal(err)
+	}
+	updated := original
+	updated.Args = []string{"agent", "--changed"}
+	command = func(context.Context, string, ...string) ([]byte, error) {
+		if err := os.Chmod(path, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		return nil, context.Canceled
+	}
+	_, err = InstallContext(context.Background(), updated)
+	if !errors.Is(err, context.Canceled) || !strings.Contains(err.Error(), "unit changed") {
+		t.Errorf("installation must report cancellation and the permission change: %v", err)
+	}
+	info, err := os.Stat(path)
+	if err != nil || info.Mode().Perm() != 0o600 {
+		t.Fatalf("rollback overwrote another owner's permissions: %v, %v", info, err)
+	}
+	got, err := os.ReadFile(path)
+	want, _ := Render(updated)
+	if err != nil || string(got) != string(want) {
+		t.Fatalf("rollback replaced the definition another owner changed: %q, %v", got, err)
+	}
+}
