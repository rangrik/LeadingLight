new file mode 100644
index 0000000000000000000000000000000000000000..51bcbc4289db77b31d035d78d583668779c9f699
--- /dev/null
+++ b/internal/service/transaction.go
@@ -0,0 +1,109 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+)
+
+const pendingUnitContents = "berth service load pending\n"
+
+func pendingUnitPath(path string) string { return path + ".berth-pending" }
+
+// Each cooperating installer holds the same per-unit file lock across its
+// definition write, manager acknowledgement and rollback. Keep the lock file:
+// unlinking it could give another process a different inode to lock.
+func lockUnit(ctx context.Context, path string) (func(), error) {
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return nil, err
+	}
+	f, err := os.OpenFile(path+".berth-lock", os.O_CREATE|os.O_RDWR|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	info, err := f.Stat()
+	if err != nil || !info.Mode().IsRegular() {
+		f.Close()
+		if err == nil {
+			err = errors.New("service lock is not a regular file")
+		}
+		return nil, err
+	}
+	tick := time.NewTicker(20 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		if err := ctx.Err(); err != nil {
+			f.Close()
+			return nil, err
+		}
+		err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+		if err == nil {
+			return func() { syscall.Flock(int(f.Fd()), syscall.LOCK_UN); f.Close() }, nil
+		}
+		if !errors.Is(err, syscall.EWOULDBLOCK) && !errors.Is(err, syscall.EAGAIN) {
+			f.Close()
+			return nil, err
+		}
+		select {
+		case <-ctx.Done():
+		case <-tick.C:
+		}
+	}
+}
+
+// A failed replacement must not turn a linked or special definition into a
+// regular file. Refuse those paths before any definition or manager mutation.
+func readUnitFile(path string) ([]byte, os.FileMode, bool, error) {
+	f, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, 0, false, nil
+	}
+	if err != nil {
+		return nil, 0, false, err
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return nil, 0, false, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, 0, false, fmt.Errorf("refusing to replace non-regular service file %s", path)
+	}
+	data, err := io.ReadAll(f)
+	return data, info.Mode().Perm(), true, err
+}
+
+func markUnitPending(path string) error {
+	pending := pendingUnitPath(path)
+	data, _, exists, err := readUnitFile(pending)
+	if err != nil {
+		return err
+	}
+	if exists {
+		if string(data) != pendingUnitContents {
+			return fmt.Errorf("unrecognized service installation marker %s", pending)
+		}
+		return nil
+	}
+	_, err = writeUnitFile(pending, []byte(pendingUnitContents), 0o600)
+	return err
+}
+
+func clearUnitPending(path string) error {
+	pending := pendingUnitPath(path)
+	data, _, exists, err := readUnitFile(pending)
+	if err != nil || !exists {
+		return err
+	}
+	if string(data) != pendingUnitContents {
+		return fmt.Errorf("unrecognized service installation marker %s", pending)
+	}
+	return os.Remove(pending)
+}
