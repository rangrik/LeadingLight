+	case <-secondEntered:
+	case <-ctx.Done():
+		t.Fatal("second install did not start")
+	}
+	select {
+	case err := <-firstDone:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("first install did not complete")
+	}
+	if Installed(second) {
+		t.Error("first completion cleared the second install's pending marker")
+	}
+	close(secondRelease)
+	select {
+	case err := <-secondDone:
+		if err != nil || !Installed(second) {
+			t.Fatalf("second install did not finish: %v", err)
+		}
+	case <-ctx.Done():
+		t.Fatal("second install did not finish")
+	}
+}
+
+// Join every task before the stub restores process-wide service functions,
+// including when a regression makes the test fail partway through.
+func ensureInBackground(t *testing.T, parent context.Context, s Spec) <-chan error {
+	t.Helper()
+	ctx, cancel := context.WithCancel(parent)
+	done, settled := make(chan error, 1), make(chan struct{})
+	go func() {
+		defer close(settled)
+		_, err := EnsureContext(ctx, s)
+		done <- err
+	}()
+	t.Cleanup(func() {
+		cancel()
+		select {
+		case <-settled:
+		case <-time.After(3 * time.Second):
+			t.Error("test installation did not stop during cleanup")
+		}
+	})
+	return done
+}
