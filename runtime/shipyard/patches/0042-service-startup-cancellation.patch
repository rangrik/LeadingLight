+func TestInstallRefusesLinkedDefinitionsAndForeignMarkers(t *testing.T) {
+	for _, kind := range []string{"linked-definition", "foreign-marker"} {
+		t.Run(kind, func(t *testing.T) {
+			home, calls := stub(t, "darwin")
+			s := spec
+			s.LogPath = filepath.Join(home, "service.log")
+			path, _ := UnitPath(s)
+			if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			owned := filepath.Join(home, "owned-definition")
+			if kind == "foreign-marker" {
+				owned = pendingUnitPath(path)
+			}
+			if err := os.WriteFile(owned, []byte("other owner's configuration"), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if kind == "linked-definition" {
+				if err := os.Symlink(owned, path); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if _, err := InstallContext(context.Background(), s); err == nil {
+				t.Fatal("installation replaced another owner's file")
+			}
+			if len(*calls) != 0 {
+				t.Fatalf("manager mutated before validating the definition: %v", *calls)
+			}
+			got, err := os.ReadFile(owned)
+			if err != nil || string(got) != "other owner's configuration" {
+				t.Fatalf("installation changed a pre-existing file: %q, %v", got, err)
+			}
+			if kind == "linked-definition" {
+				if got, err := os.Readlink(path); err != nil || got != owned {
+					t.Fatalf("installation replaced the symlink: %q, %v", got, err)
+				}
+			}
+		})
+	}
+}
+
