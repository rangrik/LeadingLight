+
+// A blocked filesystem read does not observe context cancellation. Exercise
+// special files in a disposable subprocess so a regression leaves no blocked
+// goroutine holding a unit lock in the test runner.
+func TestServiceDefinitionReadsRejectSpecialFiles(t *testing.T) {
+	if kind := os.Getenv("BERTH_TEST_SERVICE_FILE_KIND"); kind != "" {
+		home, calls := stub(t, "darwin")
+		s := spec
+		s.LogPath = filepath.Join(home, "service.log")
+		path, err := UnitPath(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+			t.Fatal(err)
+		}
+		target := path
+		if kind != "fifo" {
+			target = filepath.Join(home, "external-definition")
+		}
+		if kind == "linked-regular" {
+			data, err := Render(s)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(target, data, 0o600); err != nil {
+				t.Fatal(err)
+			}
+		} else if err := syscall.Mkfifo(target, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if kind != "fifo" {
+			if err := os.Symlink(target, path); err != nil {
+				t.Fatal(err)
+			}
+		}
+		switch os.Getenv("BERTH_TEST_SERVICE_FILE_OPERATION") {
+		case "ensure":
+			ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+			defer cancel()
+			if _, err := EnsureContext(ctx, s); err == nil {
+				t.Fatal("ensure accepted a special or linked definition")
+			}
+		case "installed-any-path":
+			if InstalledAnyPATH(s) {
+				t.Fatal("installed check accepted a special or linked definition")
+			}
+		default:
+			t.Fatal("unknown subprocess operation")
+		}
+		if len(*calls) != 0 {
+			t.Fatalf("read-only rejection invoked the service manager: %v", *calls)
+		}
+		if _, err := os.Stat(pendingUnitPath(path)); !errors.Is(err, os.ErrNotExist) {
+			t.Fatalf("rejected definition acquired a pending-install marker: %v", err)
+		}
+		if kind != "fifo" {
+			if got, err := os.Readlink(path); err != nil || got != target {
+				t.Fatalf("rejection replaced the existing symlink: %q, %v", got, err)
+			}
+		}
+		return
+	}
+	for _, kind := range []string{"fifo", "linked-fifo", "linked-regular"} {
+		for _, operation := range []string{"ensure", "installed-any-path"} {
+			t.Run(kind+"/"+operation, func(t *testing.T) {
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				defer cancel()
+				cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestServiceDefinitionReadsRejectSpecialFiles$")
+				cmd.Env = append(os.Environ(), "TMPDIR="+t.TempDir(), "BERTH_TEST_SERVICE_FILE_KIND="+kind, "BERTH_TEST_SERVICE_FILE_OPERATION="+operation)
+				cmd.WaitDelay = time.Second
+				out, err := cmd.CombinedOutput()
+				if ctx.Err() != nil {
+					t.Fatalf("%s blocked on %s past cancellation: %s", operation, kind, out)
+				}
+				if err != nil {
+					t.Fatalf("subprocess failed: %v\n%s", err, out)
+				}
+			})
+		}
+	}
+}
