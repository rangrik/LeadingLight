+++ b/internal/box/orchestrate.go
@@ -214,18 +214,27 @@ func (b *Box) sendPrompt(ctx context.Context, name string, req SendRequest, orig
 			return hold()
 		}
 	}
-	waiting := ""
+	waiting, busy := "", false
 	if b.Turns != nil {
