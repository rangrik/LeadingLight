From dcd4c8121fb5ea9f94d4be7424247000b29ecc31 Mon Sep 17 00:00:00 2001
From: rangrik <k.pranav.apk@gmail.com>
Date: Fri, 30 Oct 2026 03:53:30 -0700
Subject: [PATCH] A prompt sent into a running turn is part of that turn

A send with when "now" (or a held prompt sent now) while the agent works
is read as part of the turn it is in: Claude Code reads it after its
current step, Codex at once, and neither starts another turn for it. The
ledger still opened a pending turn for it, which no hook ever started, so
it sat open until it expired two minutes later and held the inbox shut
for that long. Such a send is now marked steer: no turn is opened, a held
prompt's turn ends as it is typed, and the result names the running turn.

A send with when "idle" to a fresh agent, which shows running before the
ledger has heard from it, is held too rather than typed at once.
---
 internal/box/inbox.go       | 10 ++++++++++
 internal/box/inbox_test.go  |  7 ++++---
 internal/box/orchestrate.go | 22 ++++++++++++++++++----
 internal/box/turns.go       | 26 ++++++++++++++++++++++++++
 4 files changed, 58 insertions(+), 7 deletions(-)

diff --git a/internal/box/inbox.go b/internal/box/inbox.go
index a92fb83..fb85e87 100644
--- a/internal/box/inbox.go
+++ b/internal/box/inbox.go
@@ -82,10 +82,18 @@ func (b *Box) sendQueued(w http.ResponseWriter, r *http.Request) error {
 		return err
 	}
 	data := map[string]any{"name": name, "from": it.Origin, "when": "now"}
+	steer := ""
+	if waiting == "" {
+		steer, _ = b.Turns.Steering(name)
+	}
 	if waiting != "" {
 		// Typed at a question, it is an answer there, not a turn of its own.
 		data["answer"], data["turn"] = true, waiting
 		b.Turns.endQueued(name, turn, "sent as an answer")
+	} else if steer != "" {
+		// Typed into the running turn, which the agent folds it into.
+		data["steer"], data["turn"] = true, steer
+		b.Turns.endQueued(name, turn, "sent into the running turn")
 	} else {
 		data["turn"] = turn
 	}
@@ -93,6 +101,8 @@ func (b *Box) sendQueued(w http.ResponseWriter, r *http.Request) error {
 	res := SendResult{Sent: true, Turn: turn, Seq: e.Seq, At: e.Time.UTC()}
 	if waiting != "" {
 		res.Turn = waiting
+	} else if steer != "" {
+		res.Turn = steer
 	} else if tr, ok := b.Turns.Get(turn); ok && tr.State == "running" && tr.Fidelity != "hooks" {
 		// The agent cannot say it started: the send says so.
 		b.Events.Publish(events.Event{Type: "agent.started", Box: b.Name, Origin: origin(r), Data: map[string]any{
