-	if got, _ := turns.Get(a.Turn); got.State != "pending" || got.SentSeq == 0 {
+	if got, _ := turns.Get(a.Turn); got.State != "lost" || got.Status != "sent into the running turn" {
 		t.Fatalf("sent turn = %+v", got)
