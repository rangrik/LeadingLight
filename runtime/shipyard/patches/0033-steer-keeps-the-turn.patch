+	if b.Turns != nil && req.When == "idle" && (busy || !b.Turns.Ready(name)) {
 		return hold()
 	}
+	// Typed into a running turn, the agent folds it in (Turns.Steering).
+	steer := ""
+	if b.Turns != nil && waiting == "" {
+		steer, _ = b.Turns.Steering(name)
+	}
 	if err := b.driverFor(sess).Send(ctx, sess, req.Text, enter); err != nil {
 		return SendResult{}, err
 	}
@@ -242,11 +251,16 @@ func (b *Box) sendPrompt(ctx context.Context, name string, req SendRequest, orig
 	if waiting != "" {
 		// Typed at a question: an answer, part of the turn that asked.
 		data["answer"], data["turn"] = true, waiting
+	} else if steer != "" {
+		data["steer"], data["turn"] = true, steer
 	}
 	e := b.Events.Publish(events.Event{Type: "session.sent", Box: b.Name, Origin: origin, Data: data})
 	res := SendResult{Sent: true, Seq: e.Seq, At: e.Time.UTC()}
-	if waiting != "" {
+	if waiting != "" || steer != "" {
 		res.Turn = waiting
+		if steer != "" {
+			res.Turn = steer
+		}
 		return res, nil
 	}
 	if enter && sess.Title == "" && commandName(req.Text) == "" {
diff --git a/internal/box/turns.go b/internal/box/turns.go
index 5bfba76..e83a73d 100644
--- a/internal/box/turns.go
+++ b/internal/box/turns.go
@@ -550,6 +550,12 @@ func (t *Turns) sent(e events.Event) {
 		t.bump()
 		return
 	}
+	if e.Data["steer"] == true {
+		// Typed into a running turn, which the agent reads it as part of
+		// (Steering): no turn of its own.
+		t.bump()
+		return
+	}
 	if c, _ := e.Data["command"].(string); c != "" {
 		// The agent's own command (/cost, /model) starts no turn: its hooks
 		// never say it started, so a pending one would take the next
@@ -1327,6 +1333,26 @@ func (t *Turns) Cancel(name, turn string) error {
 	return nil
 }
 
+// Steering finds the turn a prompt typed now goes into: the running turn of
+// a session whose hooks mark its turns. Claude Code reads the prompt after
+// its current step and Codex at once, but both as part of that turn, and
+// neither starts another for it. A pending turn opened for such a prompt
+// would never start, and would hold the inbox until it expired. ok is false
+// when a send starts a turn of its own.
+func (t *Turns) Steering(name string) (turn string, ok bool) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.init()
+	s := t.sess[name]
+	if s == nil || startsAtSend(s) {
+		return "", false
+	}
+	if cur := s.current(); cur != nil && cur.State == "running" {
+		return cur.ID, true
+	}
+	return "", false
+}
+
 // Ready says whether a prompt can be typed into the session now: its agent
 // is idle or finished (or has never said), and nothing is held before it.
 func (t *Turns) Ready(name string) bool {
