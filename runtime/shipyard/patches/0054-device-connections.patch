+	snapshot := deviceReviews{Folder: mobileIdentity(loc), Reviews: []deviceReview{row}}
+	write := func() {
+		raw, _ := json.Marshal(snapshot)
+		if err := statefile.Write(filepath.Join(m.reviewDir(), "shared.json"), raw); err != nil {
+			t.Fatal(err)
+		}
+	}
