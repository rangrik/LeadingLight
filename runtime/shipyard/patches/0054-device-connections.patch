@@ -0,0 +1,254 @@
+package box
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/cosscom/shipyard/internal/statefile"
+	"github.com/cosscom/shipyard/internal/wire"
+)
+
+func (m *Mobile) reviewDir() string {
+	if m.reviews != "" {
+		return m.reviews
+	}
+	return m.Path + ".reviews"
+}
+
+func (m *Mobile) child(id string) *Mobile {
+	if m.links == nil {
+		m.links = map[string]*Mobile{}
+	}
+	if m.links[id] == nil {
+		m.links[id] = &Mobile{Path: filepath.Join(m.Path+".links", id+".json"), ctx: m.ctx, reviews: m.reviewDir()}
+	}
+	return m.links[id]
+}
+
+func (m *Mobile) restoreDeviceLinks(b *Box) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	files, _ := os.ReadDir(m.Path + ".links")
+	for _, f := range files {
+		id, ok := strings.CutSuffix(f.Name(), ".json")
+		if ok && mobileUUID.MatchString(id) {
+			m.child(id).apply(b)
+		}
+	}
+}
+
+func (b *Box) putDeviceLink(w http.ResponseWriter, r *http.Request) error {
+	id := r.PathValue("id")
+	if !wire.IsLocal(r.Context()) || b.Mobile == nil || !mobileUUID.MatchString(id) {
+		return httpError{403, "Approve this request on the Mac."}
+	}
+	var req struct {
+		Relay   mobileRelay
+		Project string
+		Folder  string
+	}
+	if err := mobileDecode(r, &req); err != nil {
+		return err
+	}
+	if !req.Relay.valid() || !mobileName.MatchString(req.Project) {
+		return badRequest("Invalid project connection.")
+	}
+	loc, err := b.Locations.Get(r.Context(), req.Project)
+	if err != nil || loc.Missing || req.Folder == "" || req.Folder != mobileIdentity(loc) {
+		return badRequest("The project folder is no longer available.")
+	}
+	m := b.Mobile
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.ctx == nil || m.ctx.Err() != nil {
+		return httpError{503, "The Mac is starting. Try again."}
+	}
+	child := m.child(id)
+	c := child.load()
+	if !c.Enabled {
+		secret := make([]byte, 24)
+		if _, err = rand.Read(secret); err != nil {
+			return err
+		}
+		c = mobileConfig{Enabled: true, Relay: &req.Relay, Projects: []string{req.Project}, Token: hex.EncodeToString(secret), Grants: map[string]string{req.Project: mobileIdentity(loc)}}
+		raw, err := json.Marshal(c)
+		if err != nil {
+			return err
+		}
+		if err = statefile.Write(child.Path, raw); err != nil {
+			return err
+		}
+		child.apply(b)
+	} else if c.Relay == nil || c.Relay.Channel != req.Relay.Channel || c.Grants[req.Project] != mobileIdentity(loc) {
+		return httpError{409, "Start a new connection."}
+	}
+	writeJSON(w, child.status(b.Name))
+	return nil
+}
+
+func (b *Box) removeDeviceLink(w http.ResponseWriter, r *http.Request) error {
+	id := r.PathValue("id")
+	if !wire.IsLocal(r.Context()) || b.Mobile == nil || !mobileUUID.MatchString(id) {
+		return httpError{403, "Manage connections on the Mac."}
+	}
+	m := b.Mobile
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	child := m.child(id)
+	child.mu.Lock()
+	defer child.mu.Unlock()
+	if child.cancel != nil {
+		child.cancel()
+	}
+	if err := os.Remove(child.Path); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	delete(m.links, id)
+	writeJSON(w, map[string]bool{"ok": true})
+	return nil
+}
+
+type deviceReview struct {
+	Task        string `json:"task"`
+	Title       string `json:"title"`
+	Report      string `json:"report"`
+	ReportTitle string `json:"reportTitle"`
+	Text        string `json:"text"`
+}
+type deviceReviews struct {
+	Folder  string         `json:"folder"`
+	Reviews []deviceReview `json:"reviews"`
+}
+
+func (b *Box) publishDeviceReviews(w http.ResponseWriter, r *http.Request) error {
+	name := r.PathValue("name")
+	if !wire.IsLocal(r.Context()) || b.Mobile == nil || !mobileName.MatchString(name) {
+		return httpError{403, "Publish project reviews on the Mac."}
+	}
+	loc, err := b.Locations.Get(r.Context(), name)
+	if err != nil || loc.Missing {
+		return badRequest("The project folder is unavailable.")
+	}
+	var snapshot deviceReviews
+	dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1800000))
+	if err := dec.Decode(&snapshot); err != nil {
+		return badRequest("Invalid project reviews.")
+	}
+	if err := dec.Decode(new(any)); err != io.EOF {
+		return badRequest("Invalid project reviews.")
+	}
+	if snapshot.Folder != mobileIdentity(loc) {
+		return httpError{409, "The project folder changed."}
+	}
+	raw, err := json.Marshal(snapshot)
+	if err != nil {
+		return err
+	}
+	if err = statefile.Write(filepath.Join(b.Mobile.reviewDir(), name+".json"), raw); err != nil {
+		return err
+	}
+	writeJSON(w, map[string]bool{"ok": true})
+	return nil
+}
+
+func (m *Mobile) readDeviceReviews(b *Box, w http.ResponseWriter, r *http.Request) error {
+	name := r.PathValue("name")
+	if !mobileName.MatchString(name) {
+		return badRequest("Invalid project.")
+	}
+	if _, err := m.location(r.Context(), b, name); err != nil {
+		return err
+	}
+	raw, err := os.ReadFile(filepath.Join(m.reviewDir(), name+".json"))
+	if err != nil {
+		return httpError{503, "Open LeadingLight on the Mac to load this project’s reviews."}
+	}
+	var snapshot deviceReviews
+	if json.Unmarshal(raw, &snapshot) != nil || snapshot.Folder != m.load().Grants[name] {
+		return httpError{409, "The project folder changed. Reconnect on the Mac."}
+	}
+	writeJSON(w, snapshot.Reviews)
+	return nil
+}
+
+type reviewAction struct {
+	Folder string `json:"folder"`
+	Task   string `json:"task"`
+	Report string `json:"report"`
+}
+
+// A click reaches the same task acceptance code that the Mac uses. Repeating it is harmless.
+func (m *Mobile) acceptDeviceReview(b *Box, w http.ResponseWriter, r *http.Request) error {
+	name, id := r.PathValue("name"), r.PathValue("report")
+	if !mobileName.MatchString(name) || !mobileUUID.MatchString(id) {
+		return badRequest("Invalid report.")
+	}
+	if _, err := m.location(r.Context(), b, name); err != nil {
+		return err
+	}
+	raw, err := os.ReadFile(filepath.Join(m.reviewDir(), name+".json"))
+	if err != nil {
+		return httpError{409, "Refresh this project on the Mac."}
+	}
+	var s deviceReviews
+	if json.Unmarshal(raw, &s) != nil || s.Folder != m.load().Grants[name] {
+		return httpError{409, "The project folder changed."}
+	}
+	for _, row := range s.Reviews {
+		if row.Report == id {
+			action, err := json.Marshal(reviewAction{s.Folder, row.Task, id})
+			if err != nil {
+				return err
+			}
+			if err = statefile.Write(filepath.Join(m.reviewDir(), name+".actions", id), action); err != nil {
+				return err
+			}
+			writeJSON(w, map[string]bool{"pending": true})
+			return nil
+		}
+	}
+	return httpError{409, "This report is no longer waiting for review."}
+}
+func (b *Box) reviewActions(w http.ResponseWriter, r *http.Request) error {
+	name := r.PathValue("name")
+	if b.Mobile == nil || !wire.IsLocal(r.Context()) || !mobileName.MatchString(name) {
+		return httpError{403, "Manage reviews on the Mac."}
+	}
+	dir := filepath.Join(b.Mobile.reviewDir(), name+".actions")
+	if r.Method == http.MethodDelete {
+		id := r.PathValue("report")
+		if !mobileUUID.MatchString(id) {
+			return badRequest("Invalid report.")
+		}
+		err := os.Remove(filepath.Join(dir, id))
+		if err != nil && !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+		writeJSON(w, map[string]bool{"ok": true})
+		return nil
+	}
+	files, err := os.ReadDir(dir)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	out := []reviewAction{}
+	for _, file := range files {
+		if !mobileUUID.MatchString(file.Name()) {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(dir, file.Name()))
+		var action reviewAction
+		if err == nil && json.Unmarshal(data, &action) == nil {
+			out = append(out, action)
+		}
+	}
+	writeJSON(w, out)
+	return nil
+}
