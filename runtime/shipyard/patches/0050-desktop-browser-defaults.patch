+package box
+
+import (
+	"slices"
+	"testing"
+)
+
+// The launch boundary keeps box limits out of the desktop without weakening its proxy or sandbox.
+func TestDesktopBrowserLaunchDefaults(t *testing.T) {
+	previous := Embedded
+	t.Cleanup(func() { Embedded = previous })
+	t.Setenv("BERTH_BROWSER_JS_HEAP_MB", "")
+	for _, desktop := range []bool{false, true} {
+		Embedded = desktop
+		args := chromiumArgs("profile", "http://127.0.0.1:1234", false, Viewport{Width: 1280, Height: 800})
+		if slices.Contains(args, "--hide-scrollbars") == desktop {
+			t.Fatalf("desktop=%v: scrollbar flags %v", desktop, args)
+		}
+		if !slices.Contains(args, "--proxy-server=http://127.0.0.1:1234") || !slices.Contains(args, "--proxy-bypass-list=<-loopback>") || slices.Contains(args, "--no-sandbox") {
+			t.Fatalf("desktop=%v: confinement changed: %v", desktop, args)
+		}
+		limits := agentBrowserArgs()
+		if desktop && len(limits) != 0 {
+			t.Fatalf("desktop limits: %v", limits)
+		}
+		if !desktop && (!slices.Contains(limits, "--renderer-process-limit=2") || !slices.Contains(limits, "--js-flags=--max-old-space-size=512")) {
+			t.Fatalf("box limits: %v", limits)
+		}
+	}
+	t.Setenv("BERTH_BROWSER_JS_HEAP_MB", "1024")
+	if !slices.Contains(agentBrowserArgs(), "--js-flags=--max-old-space-size=1024") {
+		t.Fatal("explicit heap limit was ignored")
+	}
+}
