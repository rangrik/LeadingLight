+// codexReq is what a Codex request asks, for the ledger (requests.go).
+func codexReq(r codexRequest) *Request {
+	var p struct {
+		ItemID     string `json:"itemId"`
+		IsBlocking *bool  `json:"isBlocking"`
+		Questions  []struct {
+			ID       string `json:"id"`
+			Header   string `json:"header"`
+			Question string `json:"question"`
+			Options  []struct {
+				Label       string `json:"label"`
+				Description string `json:"description"`
+			} `json:"options"`
+		} `json:"questions"`
+	}
+	json.Unmarshal(r.Params, &p)
+	req := &Request{native: r.key(), Kind: "approval", Blocking: true, ToolUse: p.ItemID, Input: r.Params, Choices: permissionChoices, raw: r}
+	switch r.Method {
+	case "item/commandExecution/requestApproval":
+		req.Tool = "Bash"
+	case "item/fileChange/requestApproval":
+		req.Tool = "Edit"
+	default:
+		// A question Codex doesn't wait on may be answered later, or not at all.
+		req.Kind, req.Tool, req.Choices = "question", "request_user_input", nil
+		if p.IsBlocking != nil {
+			req.Blocking = *p.IsBlocking
+		}
+		for _, q := range p.Questions {
+			tq := transcript.Question{ID: q.ID, Header: q.Header, Question: q.Question}
+			for _, o := range q.Options {
+				tq.Options = append(tq.Options, transcript.Option{Label: o.Label, Description: o.Description})
+			}
+			req.Questions = append(req.Questions, tq)
+		}
+	}
+	return req
+}
