+	for i := 0; err == nil && rc.State == "writing" && i < 100; i++ {
+		c.mu.Unlock()
+		time.Sleep(50 * time.Millisecond)
+		c.mu.Lock()
+		rc = c.reqs.receipts[body.Command]
+	}
+	if err != nil || rc.Command != "" {
+		defer c.mu.Unlock()
+		if r == nil {
+			return rc, Request{}, err
+		}
+		return rc, *r, err
+	}
+	cr, _ := r.raw.(codexRequest)
+	result, err := codexResponse(r, body)
+	if err != nil {
+		c.mu.Unlock()
+		return Receipt{}, *r, err
+	}
+	rc = c.reqs.beginAnswer(r, body.Command)
+	c.mu.Unlock()
+	werr := c.respond(cr, result)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	rc = c.reqs.endAnswer(rc, werr)
+	return rc, *r, werr
+}
+
+// codexResponse is the result that answers a request as body says.
+func codexResponse(req *Request, body Respond) (any, error) {
+	if req.Kind == "question" {
+		if _, err := answerFor(req.Questions, body.Answers); err != nil {
+			return nil, err
+		}
+		answers := map[string]any{}
+		for i, q := range req.Questions {
+			picks := append([]string{}, body.Answers[i].Picks...)
+			if o := body.Answers[i].Other; o != "" {
+				picks = append(picks, o)
+			}
+			answers[q.ID] = map[string]any{"answers": picks}
+		}
+		return map[string]any{"answers": answers}, nil
+	}
+	decision := map[string]string{"allow": "accept", "allow_always": "acceptForSession", "deny": "decline"}[body.Choice]
+	if decision == "" {
+		return nil, badRequest("an approval takes allow, allow_always or deny")
+	}
+	return map[string]any{"decision": decision}, nil
+}
diff --git a/internal/box/requests.go b/internal/box/requests.go
new file mode 100644
index 0000000..5980527
--- /dev/null
+++ b/internal/box/requests.go
@@ -0,0 +1,354 @@
+package box
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/cosscom/shipyard/internal/events"
+	"github.com/cosscom/shipyard/internal/statefile"
+	"github.com/cosscom/shipyard/internal/transcript"
+)
+
+// Requests (the "requests" capability): what a structured agent asks a person, a question, an
+// approval or a plan, each named once for the app, berthd and the agent: the life of the agent
+// process it came from (its generation, where that process's start sits in the log) and the
+// agent's own id for it. The ledger is rebuilt from the log, which says when each was asked,
+// answered, taken or let go. Only the app's command ids are kept beside it (requests.json), so an
+// answer sent twice is written once, and told the same receipt.
+
+const (
+	ReqPending   = "pending"   // asked, unanswered
+	ReqRecorded  = "recorded"  // an answer is written to the agent, not yet taken
+	ReqResolved  = "resolved"  // taken: the tool ran or was refused, or Codex said so
+	ReqCancelled = "cancelled" // withdrawn: its turn ended, or the agent took it back
+	ReqExpired   = "expired"   // its agent process ended before it was answered
+)
+
+// Request is one thing a structured agent asked.
+type Request struct {
+	ID         string                `json:"id"`
+	Generation int64                 `json:"generation"`
+	Kind       string                `json:"kind"` // question, approval, plan
+	Blocking   bool                  `json:"blocking"`
+	Tool       string                `json:"tool,omitempty"`
+	ToolUse    string                `json:"tool_use,omitempty"`
+	Helper     string                `json:"helper,omitempty"`
+	Input      json.RawMessage       `json:"input,omitempty"`
+	Questions  []transcript.Question `json:"questions,omitempty"`
+	Choices    []AskChoice           `json:"choices,omitempty"`
+	State      string                `json:"state"`
+	Command    string                `json:"command,omitempty"`
+	Opened     int64                 `json:"opened"`
+	Settled    int64                 `json:"settled,omitempty"`
+	native     string
+	raw        any
+}
+
+// Receipt is what became of one command: its answer written, or refused and why.
+type Receipt struct {
+	Command string `json:"command"`
+	Request string `json:"request"`
+	State   string `json:"state"` // writing, written, refused
+	Error   string `json:"error,omitempty"`
+	At      int64  `json:"at"`
+}
+
+// Respond is an answer to one request: a question's answers, or an approval's or a plan's choice
+// (allow, allow_always, deny; accept_edits, approve_each, keep_planning).
+type Respond struct {
+	Command string           `json:"command"`
+	Answers []QuestionAnswer `json:"answers,omitempty"`
+	Choice  string           `json:"choice,omitempty"`
+	Message string           `json:"message,omitempty"`
+}
+
+// requestLedger is one conversation's requests. Its owner's lock guards it.
+type requestLedger struct {
+	gen      int64
+	byID     map[string]*Request
+	order    []string
+	native   map[string]string // the agent's ids in this generation
+	dir      string
+	receipts map[string]Receipt
+	changed  []string // ids changed since last told
+}
+
+func newRequestLedger(dir string) *requestLedger {
+	l := &requestLedger{byID: map[string]*Request{}, native: map[string]string{}, dir: dir, receipts: map[string]Receipt{}}
+	if raw, err := os.ReadFile(filepath.Join(dir, "requests.json")); err == nil {
+		json.Unmarshal(raw, &l.receipts)
+	}
+	return l
+}
+
+func (l *requestLedger) save() {
+	raw, _ := json.MarshalIndent(l.receipts, "", "  ")
+	statefile.Write(filepath.Join(l.dir, "requests.json"), raw)
+}
+
+func (l *requestLedger) settle(r *Request, state string, at int64) {
+	if r.State == state || r.State == ReqResolved || r.State == ReqExpired || r.State == ReqCancelled {
+		return
+	}
+	r.State = state
+	if state != ReqRecorded {
+		r.Settled = at
+	}
+	l.changed = append(l.changed, r.ID)
+}
+
+// started begins a new agent process: what the last one asked can't be answered now.
+func (l *requestLedger) started(seq, at int64) {
+	l.exited(at)
+	l.gen, l.native = seq, map[string]string{}
+}
+
+func (l *requestLedger) exited(at int64) {
+	for _, id := range l.order {
+		if r := l.byID[id]; r.State == ReqPending || r.State == ReqRecorded {
+			l.settle(r, ReqExpired, at)
+		}
+	}
+}
+
+func (l *requestLedger) open(r *Request, at int64) {
+	r.ID = strconv.FormatInt(l.gen, 10) + "-" + r.native
+	if old := l.byNative(r.native); old != nil {
+		if old.State == ReqPending || old.State == ReqRecorded {
+			return
+		}
+		// An id the agent uses again once its request settled names a new one.
+		for k := 2; l.byID[r.ID] != nil; k++ {
+			r.ID = strconv.FormatInt(l.gen, 10) + "-" + r.native + "." + strconv.Itoa(k)
+		}
+	}
+	r.Generation, r.State, r.Opened = l.gen, ReqPending, at
+	l.native[r.native] = r.ID
+	l.byID[r.ID] = r
+	l.order = append(l.order, r.ID)
+	l.changed = append(l.changed, r.ID)
+}
+
+func (l *requestLedger) byNative(native string) *Request { return l.byID[l.native[native]] }
+
+func (l *requestLedger) mark(native, state string, at int64) {
+	if r := l.byNative(native); r != nil {
+		l.settle(r, state, at)
+	}
+}
+
+// resolveToolUse settles the request behind a tool call whose result came back.
+func (l *requestLedger) resolveToolUse(toolUse string, at int64) {
+	for _, id := range l.order {
+		if r := l.byID[id]; r.Generation == l.gen && r.ToolUse == toolUse && toolUse != "" {
+			l.settle(r, ReqResolved, at)
+		}
+	}
+}
+
+// endTurn withdraws what the turn's own agent still waited on; a helper's question, or one the
+// agent didn't wait on, may be answered after it.
+func (l *requestLedger) endTurn(at int64) {
+	for _, id := range l.order {
+		if r := l.byID[id]; r.Generation == l.gen && r.State == ReqPending && r.Helper == "" && r.Blocking {
+			l.settle(r, ReqCancelled, at)
+		}
+	}
+}
+
+// reconcile says what became of commands berthd was writing when it stopped.
+func (l *requestLedger) reconcile() {
+	dirty := false
+	for k, rc := range l.receipts {
+		if rc.State != "writing" {
+			continue
+		}
+		if r := l.byID[rc.Request]; r != nil && r.State != ReqPending && r.State != ReqExpired {
+			rc.State = "written"
+		} else {
+			rc.State, rc.Error = "refused", "berthd stopped before the answer was written"
+		}
+		l.receipts[k], dirty = rc, true
+	}
+	if dirty {
+		l.save()
+	}
+}
+
+func (l *requestLedger) list() []Request {
+	out := make([]Request, 0, len(l.order))
+	for _, id := range l.order {
+		out = append(out, *l.byID[id])
+	}
+	return out
+}
+
+// told takes the ids changed since last asked.
+func (l *requestLedger) told() []string {
+	c := l.changed
+	l.changed = nil
+	return c
+}
+
+// requestHost is a structured driver's side of requests.
+type requestHost interface {
+	requests(sess Session) ([]Request, error)
+	respond(ctx context.Context, sess Session, id string, body Respond) (Receipt, Request, error)
+}
+
+func (b *Box) mountRequests(route func(string, func(http.ResponseWriter, *http.Request) error)) {
+	route("GET /v1/sessions/{name}/requests", b.listRequests)
+	route("POST /v1/sessions/{name}/requests/{id}/respond", b.respondRequest)
+}
+
+func (b *Box) requestDriver(r *http.Request) (Session, requestHost, error) {
+	sess, err := b.Sessions.Get(r.Context(), r.PathValue("name"))
+	if err != nil {
+		return Session{}, nil, err
+	}
+	h, ok := b.driverFor(sess).(requestHost)
+	if !ok {
+		return Session{}, nil, badRequest("%s isn't a structured session", sess.Name)
+	}
+	return sess, h, nil
+}
+
+func (b *Box) listRequests(w http.ResponseWriter, r *http.Request) error {
+	sess, h, err := b.requestDriver(r)
+	if err != nil {
+		return err
+	}
+	all, err := h.requests(sess)
+	if err != nil {
+		return err
+	}
+	writeJSON(w, all)
+	return nil
+}
+
+func (b *Box) respondRequest(w http.ResponseWriter, r *http.Request) error {
+	var body Respond
+	if err := decode(r, &body); err != nil {
+		return err
+	}
+	if strings.TrimSpace(body.Command) == "" {
+		return badRequest("say which command this is (command): a retry carries the same one")
+	}
+	sess, h, err := b.requestDriver(r)
+	if err != nil {
+		return err
+	}
+	rc, req, err := h.respond(r.Context(), sess, r.PathValue("id"), body)
+	if err != nil {
+		var refused requestRefused
+		if errors.As(err, &refused) {
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(refused.status)
+			json.NewEncoder(w).Encode(map[string]any{"code": "refused", "error": refused.msg, "request": req, "receipt": rc})
+			return nil
+		}
+		return err
+	}
+	writeJSON(w, map[string]any{"receipt": rc, "request": req})
+	return nil
+}
+
+// requestRefused is an answer not taken, with the request as it stands.
+type requestRefused struct {
+	status int
+	msg    string
+}
+
+func (e requestRefused) Error() string { return e.msg }
+
+// takeAnswer checks a command against the ledger: its receipt again, or the request it may answer.
+// Called with the owner's lock held.
+func (l *requestLedger) takeAnswer(id string, body Respond) (Receipt, *Request, error) {
+	if rc, ok := l.receipts[body.Command]; ok {
+		r := l.byID[rc.Request]
+		if r == nil {
+			r = &Request{ID: rc.Request, State: ReqExpired}
+		}
+		return rc, r, nil
+	}
+	r := l.byID[id]
+	switch {
+	case r == nil && strings.HasPrefix(id, strconv.FormatInt(l.gen, 10)+"-"):
+		return Receipt{}, nil, requestRefused{http.StatusNotFound, "no such request"}
+	case r == nil:
+		return Receipt{}, &Request{ID: id, State: ReqExpired}, requestRefused{http.StatusGone, "that request was from an agent process that has ended"}
+	case r.State == ReqExpired:
+		return Receipt{}, r, requestRefused{http.StatusGone, "that request was from an agent process that has ended"}
+	case r.State != ReqPending:
+		return Receipt{}, r, requestRefused{http.StatusConflict, "that request is " + r.State + " already"}
+	case r.Command != "":
+		return Receipt{}, r, requestRefused{http.StatusConflict, "another answer to it is being written"}
+	}
+	return Receipt{}, r, nil
+}
+
+// beginAnswer records that a command's answer is being written, before it is.
+func (l *requestLedger) beginAnswer(r *Request, command string) Receipt {
+	rc := Receipt{Command: command, Request: r.ID, State: "writing", At: time.Now().UnixMilli()}
+	l.receipts[command] = rc
+	r.Command = command
+	l.save()
+	return rc
+}
+
+func (l *requestLedger) endAnswer(rc Receipt, err error) Receipt {
+	rc.State = "written"
+	if err != nil {
+		rc.State, rc.Error = "refused", err.Error()
+		if r := l.byID[rc.Request]; r != nil && r.Command == rc.Command {
+			r.Command = ""
+		}
+	}
+	l.receipts[rc.Command] = rc
+	l.save()
+	return rc
+}
+
+// claim marks a request as being answered by an older route, which brings no command of its
+// own, so a second answer at the same moment is refused. Called with the owner's lock held.
+func (l *requestLedger) claim(native string) (string, bool) {
+	r := l.byNative(native)
+	if r == nil {
+		return "", true
+	}
+	if r.State != ReqPending || r.Command != "" {
+		return "", false
+	}
+	r.Command = "berth-" + strconv.FormatInt(time.Now().UnixNano(), 36)
+	return r.Command, true
+}
+
+// release gives back a claim whose answer couldn't be written.
+func (l *requestLedger) release(native, command string, err error) {
+	if r := l.byNative(native); err != nil && r != nil && r.Command == command {
+		r.Command = ""
+	}
+}
+
+// tellRequests says on the bus which requests changed, for clients to read them again.
+func (b *Box) tellRequests(session string, ids []string) {
+	for _, id := range ids {
+		b.Events.Publish(events.Event{Type: "request.changed", Box: b.Name, Data: map[string]any{"session": session, "id": id}})
+	}
+}
+
+// answerFor is a question's answers as the agent takes them, checked against what it asked.
+func answerFor(qs []transcript.Question, as []QuestionAnswer) ([]string, error) {
+	if len(qs) == 0 {
+		return nil, fmt.Errorf("that request asks no questions")
+	}
+	return checkAnswers(qs, as)
+}
diff --git a/internal/box/requests_test.go b/internal/box/requests_test.go
new file mode 100644
index 0000000..cb36a36
--- /dev/null
+++ b/internal/box/requests_test.go
@@ -0,0 +1,75 @@
+package box
+
+import (
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"github.com/cosscom/shipyard/internal/agenthost"
+)
+
+// The seam: one answer per request, whatever is sent twice, and no answer to a request whose
+// agent process has ended, rebuilt the same from the log after berthd restarts.
+func TestRequestsAnswerOnceAndExpire(t *testing.T) {
+	dir := t.TempDir()
+	c := &claudeConv{reqs: newRequestLedger(dir), changed: make(chan struct{}), replies: map[string]chan json.RawMessage{}}
+	line := func(seq int64, dir, data string) agenthost.Entry {
+		return agenthost.Entry{Seq: seq, At: seq, Dir: dir, Data: json.RawMessage(data)}
+	}
+	c.apply(agenthost.Entry{Seq: 1, Dir: "host", Event: "started"}, false)
+	c.apply(line(2, "out", `{"type":"control_request","request_id":"r1","request":{"subtype":"can_use_tool","tool_name":"AskUserQuestion","tool_use_id":"t1","input":{"questions":[{"question":"Colour?","options":[{"label":"Red"},{"label":"Blue"}]}]}}}`), false)
+	reqs := c.reqs.list()
+	if len(reqs) != 1 || reqs[0].ID != "1-r1" || reqs[0].Kind != "question" || reqs[0].State != ReqPending || len(reqs[0].Questions) != 1 {
+		t.Fatalf("asked: %+v", reqs)
+	}
+	body := Respond{Command: "cmd-1", Answers: []QuestionAnswer{{Picks: []string{"Blue"}}}}
+	_, r, err := c.reqs.takeAnswer("1-r1", body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rc := c.reqs.endAnswer(c.reqs.beginAnswer(r, "cmd-1"), nil)
+	// The same command again is told its receipt; another command is refused while it is written.
+	if again, _, err := c.reqs.takeAnswer("1-r1", body); err != nil || again != rc {
+		t.Fatalf("retry: %+v %v", again, err)
+	}
+	var refused requestRefused
+	if _, _, err := c.reqs.takeAnswer("1-r1", Respond{Command: "cmd-2"}); !errors.As(err, &refused) || refused.status != 409 {
+		t.Fatalf("a second answer: %v", err)
+	}
+	c.apply(line(3, "in", `{"type":"control_response","response":{"request_id":"r1","subtype":"success","response":{}}}`), false)
+	c.apply(line(4, "out", `{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1"}]}}`), false)
+	if s := c.reqs.list()[0].State; s != ReqResolved {
+		t.Fatalf("after its result: %s", s)
+	}
+	// A new process: what the last one asked is gone, and its ids answer nothing.
+	c.apply(line(5, "out", `{"type":"control_request","request_id":"r2","request":{"subtype":"can_use_tool","tool_name":"Write","tool_use_id":"t2","input":{}}}`), false)
+	c.apply(agenthost.Entry{Seq: 6, Dir: "host", Event: "started"}, false)
+	if s := c.reqs.list()[1].State; s != ReqExpired {
+		t.Fatalf("after a restart: %s", s)
+	}
+	if _, _, err := c.reqs.takeAnswer("1-r2", Respond{Command: "cmd-5", Choice: "allow"}); !errors.As(err, &refused) || refused.status != 410 {
+		t.Fatalf("an expired request: %v", err)
+	}
+	if _, _, err := c.reqs.takeAnswer("5-r2", Respond{Command: "cmd-3", Choice: "allow"}); !errors.As(err, &refused) || refused.status != 410 {
+		t.Fatalf("an old process's request: %v", err)
+	}
+	// An older route's answer claims the request, so a second at the same moment is refused.
+	c.apply(line(7, "out", `{"type":"control_request","request_id":"r4","request":{"subtype":"can_use_tool","tool_name":"Bash","tool_use_id":"t4","input":{}}}`), false)
+	if _, ok := c.reqs.claim("r4"); !ok {
+		t.Fatal("a free request couldn't be claimed")
+	}
+	if _, ok := c.reqs.claim("r4"); ok {
+		t.Fatal("a claimed request was claimed again")
+	}
+	// berthd stopped mid-write: a receipt for a request still pending is refused, so it can be sent again.
+	c.apply(line(8, "out", `{"type":"control_request","request_id":"r3","request":{"subtype":"can_use_tool","tool_name":"Bash","tool_use_id":"t3","input":{}}}`), false)
+	_, r3, _ := c.reqs.takeAnswer("6-r3", Respond{Command: "cmd-4"})
+	c.reqs.beginAnswer(r3, "cmd-4")
+	reread := newRequestLedger(dir)
+	reread.started(6, 6)
+	reread.open(&Request{native: "r3", Kind: "approval"}, 7)
+	reread.reconcile()
+	if rc := reread.receipts["cmd-4"]; rc.State != "refused" || reread.receipts["cmd-1"].State != "written" {
+		t.Fatalf("receipts after a restart: %+v", reread.receipts)
+	}
+}
