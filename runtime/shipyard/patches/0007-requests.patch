+// respond answers one request by its id, once per command (requests.go).
+func (d *claudeDriver) respond(ctx context.Context, sess Session, id string, body Respond) (Receipt, Request, error) {
+	c, err := d.conv(sess)
+	if err != nil {
+		return Receipt{}, Request{}, err
+	}
+	<-c.caught
+	c.mu.Lock()
+	rc, r, err := c.reqs.takeAnswer(id, body)
+	// The same command still being written: its outcome, once it has one.
+	for i := 0; err == nil && rc.State == "writing" && i < 100; i++ {
+		c.mu.Unlock()
+		time.Sleep(50 * time.Millisecond)
+		c.mu.Lock()
+		rc = c.reqs.receipts[body.Command]
+	}
+	if err != nil || rc.Command != "" {
+		defer c.mu.Unlock()
+		if r == nil {
+			return rc, Request{}, err
+		}
+		return rc, *r, err
+	}
+	cr, _ := r.raw.(claudeRequest)
+	resp, err := claudeResponse(cr, r, body)
+	if err != nil {
+		c.mu.Unlock()
+		return Receipt{}, *r, err
+	}
+	rc = c.reqs.beginAnswer(r, body.Command)
+	c.mu.Unlock()
+	werr := c.respond(cr, resp)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	rc = c.reqs.endAnswer(rc, werr)
+	return rc, *r, werr
+}
+
+// claudeResponse is the control response that answers a request as body says.
+func claudeResponse(r claudeRequest, req *Request, body Respond) (map[string]any, error) {
+	switch req.Kind {
+	case "question":
+		shown, err := answerFor(req.Questions, body.Answers)
+		if err != nil {
+			return nil, err
+		}
+		return answeredInput(r.Input, req.Questions, shown), nil
+	case "plan":
+		switch body.Choice {
+		case "accept_edits", "approve_each":
+			mode := map[string]string{"accept_edits": "acceptEdits", "approve_each": "default"}[body.Choice]
+			return map[string]any{"behavior": "allow", "updatedInput": json.RawMessage(r.Input),
+				"updatedPermissions": []map[string]any{{"type": "setMode", "mode": mode, "destination": "session"}}}, nil
+		case "keep_planning":
+			return map[string]any{"behavior": "deny", "message": firstNonEmpty(body.Message, "The person wants to keep planning.")}, nil
+		}
+		return nil, badRequest("a plan takes accept_edits, approve_each or keep_planning")
+	}
+	switch body.Choice {
+	case "allow", "allow_always":
+		resp := map[string]any{"behavior": "allow", "updatedInput": json.RawMessage(r.Input)}
+		if body.Choice == "allow_always" && len(r.Suggestions) > 0 {
+			resp["updatedPermissions"] = sessionOnly(r.Suggestions)
+		}
+		return resp, nil
+	case "deny":
+		return map[string]any{"behavior": "deny", "message": firstNonEmpty(body.Message, "The person said no.")}, nil
+	}
+	return nil, badRequest("an approval takes allow, allow_always or deny")
 }
 
