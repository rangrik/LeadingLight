+// Only developer-events accepts the event cursor; other commands must not
+// silently ignore a caller's --after argument.
+func TestBrowserDeveloperAfterOnlyAppliesToEvents(t *testing.T) {
+	for _, args := range [][]string{
+		{"browser", "developer-request", "cal/billing", "inspect", "--after", "12"},
+		{"browser", "developer-status", "cal/billing", "--after", "12"},
+		{"browser", "cdp", "cal/billing", "DOM.getDocument", "--after", "12"},
+	} {
+		r := &recorder{reply: `{}`}
+		var out bytes.Buffer
+		if err := Run(context.Background(), &box.Client{Doer: r}, args, &out); err == nil || r.path != "" {
+			t.Errorf("%v: error = %v, request = %q", args, err, r.path)
+		}
+	}
+}
