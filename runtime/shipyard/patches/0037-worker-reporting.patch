+// A report can be queued if the caller is still starting, or becomes busy
+// between the notifier's readiness check and its send. The ordinary inbox
+// dispatcher must deliver it once the caller is ready, as it does a prompt.
+func TestAQueuedReportReachesItsCallerOnceReady(t *testing.T) {
+	dir := t.TempDir()
+	ledger := &Turns{Path: filepath.Join(dir, "turns.json"), InboxPath: filepath.Join(dir, "inbox.json")}
+	var bx *Box
+	_, bus := servedBox(t, func(b *Box) { b.Turns = ledger; bx = b })
+	ledger.Attach(bus)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	fake := filepath.Join(t.TempDir(), "claude")
+	if err := os.WriteFile(fake, []byte("#!/bin/sh\nexec cat\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := bx.Sessions.Create(ctx, "lead", "", t.TempDir(), fake, nil); err != nil {
+		t.Fatal(err)
+	}
+	text := NotificationText([]Report{{Kind: "turn", Session: "worker", Status: "finished"}}, 0)
+	if err := (&boxNotifyHost{bx}).deliver(ctx, "lead", text); err != nil {
+		t.Fatal(err)
+	}
+	queued := ledger.List("lead", 5)
+	if len(queued) != 1 || queued[0].State != "queued" || queued[0].Origin != "berth:report" {
+		t.Fatalf("report for a starting caller: %+v", queued)
+	}
+
+	done := make(chan struct{})
+	go func() { defer close(done); ledger.Run(ctx, bx) }()
+	stopLedger := func() { cancel(); <-done }
+	t.Cleanup(stopLedger)
+	hook(bus, "agent.ready", "lead", "", "claude")
+	report := waitForCallerReport(t, ctx, bx)
+	stopLedger()
+	if report.ID != queued[0].ID {
+		t.Fatalf("delivery started another turn: %+v, queued %+v", report, queued[0])
+	}
+	// Even a repeated readiness signal cannot resend the drained inbox.
+	hook(bus, "agent.ready", "lead", "", "claude")
+	bx.deliverInbox(context.Background())
+	if turns := ledger.List("lead", 5); len(turns) != 1 || turns[0].SentSeq != report.SentSeq {
+		t.Fatalf("queued report delivered more than once: %+v", turns)
+	}
+}
