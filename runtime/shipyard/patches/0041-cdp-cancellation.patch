+
+// These gates protect operations spanning CDP I/O, not just state access.
+// Exercise the actual entry points with the preceding operation still owning
+// each gate, so a cancelled request cannot proceed or wait for that owner.
+func TestBrowserOperationAdmissionsHonorRequestDeadlines(t *testing.T) {
+	b, wt, _ := browserBox(t, func(http.ResponseWriter, *http.Request) {})
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	defer func() { EmbeddedFiles = before }()
+	client, peer := net.Pipe()
+	defer peer.Close()
+	conn := newCDP(client, client, nil)
+	defer conn.close()
+	seen := make(chan cdpMessage, 32)
+	go replyCDP(peer, seen)
+	m := b.NewBrowsers(t.TempDir(), 2)
+	c := &chromium{m: m, cdp: conn, cmd: &exec.Cmd{}, path: wt.Path, done: make(chan struct{}), tabs: map[string]*browser{}, sessions: map[string]*browser{}}
+	br := &browser{chromium: c, tab: "qa", session: "qa", target: "target", url: "http://localhost/test", viewport: DefaultViewport, watchers: map[chan frame]struct{}{}}
+	c.tabs[br.tab] = br
+	c.sessions[br.session] = br
+	m.open[wt.Path] = c
+	loc, err := b.Locations.Get(context.Background(), "cal")
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := func(fn func(http.ResponseWriter, *http.Request) error, body string, tabs ...string) func(context.Context) error {
+		return func(ctx context.Context) error {
+			tab := "qa"
+			if len(tabs) > 0 {
+				tab = tabs[0]
+			}
+			r := httptest.NewRequest("POST", "http://box/?tab="+tab, strings.NewReader(body)).WithContext(ctx)
+			r.SetPathValue("loc", "cal")
+			r.SetPathValue("wt", wt.Name)
+			return fn(httptest.NewRecorder(), r)
+		}
+	}
+	area := fmt.Sprintf(`{"x":1,"y":1,"width":10,"height":10,"viewport":{"width":%d,"height":%d},"expectedURL":"http://localhost/test"}`, DefaultViewport.Width, DefaultViewport.Height)
+	for _, tc := range []struct {
+		name string
+		gate sync.Locker
+		call func(context.Context) error
+	}{
+		{"zoom", &br.zoomMu, func(ctx context.Context) error { return br.applyControlZoom(ctx, 2) }},
+		{"developer-command", &br.developer.run, request(b.browserDeveloperCall, `{"method":"DOM.getDocument"}`)},
+		{"developer-decision", &br.developer.run, request(b.browserDeveloperDecide, `{"id":"pending","allow":true}`)},
+		{"inspection", &br.inspectMu, request(b.browserInspect, `{"x":1,"y":1}`)},
+		{"inspection-hover", &br.inspectMu, request(b.browserInspectHover, `{"x":1,"y":1}`)},
+		{"inspection-reveal", &br.inspectMu, request(b.browserInspectReveal, `{"handle":"node"}`)},
+		{"style", &br.inspectMu, request(b.browserStyle, `{"handle":"node","property":"color","value":"red"}`)},
+		{"style-reset", &br.inspectMu, request(b.browserStyleReset, `{"handle":"node"}`)},
+		{"lease-release", &br.inspectMu, request(b.browserReleaseInspectionLease, `{"lease":"lease"}`)},
+		{"upload", &br.uploadMu, request(b.browserUpload, `{"chooser":"pick","files":[]}`)},
+		{"area-inspection", &br.inspectMu, request(b.browserInspectArea, area)},
+		{"area-screencast", &br.castMu, request(b.browserInspectArea, area)},
+		{"area-zoom", &br.zoomMu, request(b.browserInspectArea, area)},
+		{"watch", &br.castMu, func(ctx context.Context) error {
+			ch, stop := br.Watch(ctx)
+			defer stop()
+			if _, ok := <-ch; ok {
+				return errors.New("cancelled watcher received a frame")
+			}
+			return ctx.Err()
+		}},
+		{"resize", &br.castMu, func(ctx context.Context) error { return br.resize(ctx, Viewport{640, 480, 1}) }},
+		{"tab-open", &c.opening, func(ctx context.Context) error { _, err := c.openTab(ctx, "another", DefaultViewport); return err }},
+		{"browser-launch", &m.launchMu, func(ctx context.Context) error { _, err := m.chromiumFor(ctx, loc, wt); return err }},
+		{"profile-clear-launch", &m.launchMu, request(b.browserClearProfile, `{"confirm":true}`)},
+		{"profile-clear-tab", &c.opening, request(b.browserClearProfile, `{"confirm":true}`)},
+		{"viewport-open", &m.vpMu, request(b.browserOpen, `{"size":"800x600"}`)},
+		{"viewport-resize", &m.vpMu, request(b.browserResize, `{"size":"800x600"}`)},
+		{"viewport-status", &m.vpMu, request(b.browserStatus, `{}`, "absent")},
+		{"viewport-controls", &m.vpMu, request(b.browserControlState, `{}`, "absent")},
+		{"viewport-save-open", &m.vpMu, func(ctx context.Context) error {
+			_, err := m.Resize(ctx, wt.Path, "qa", Viewport{800, 600, 1})
+			return err
+		}},
+		{"viewport-save-closed", &m.vpMu, func(ctx context.Context) error {
+			_, err := m.Resize(ctx, "/closed", "qa", Viewport{800, 600, 1})
+			return err
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			tc.gate.Lock()
+			ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { done <- tc.call(ctx) }()
+			select {
+			case err := <-done:
+				tc.gate.Unlock()
+				if !errors.Is(err, context.DeadlineExceeded) {
+					t.Fatalf("cancelled operation: %v", err)
+				}
+			case <-time.After(time.Second):
+				tc.gate.Unlock()
+				<-done
+				t.Fatal("request remained queued after its deadline")
+			}
+			if len(br.watchers) != 0 || br.busy.Load() != 0 || br.currentViewport() != DefaultViewport {
+				t.Fatal("cancelled operation changed browser state")
+			}
+			if m.Viewport(wt.Path, "qa") != DefaultViewport || m.Viewport("/closed", "qa") != DefaultViewport {
+				t.Fatal("cancelled operation changed saved viewport")
+			}
+		})
+	}
+	pendingCDP(t, conn)
+	select {
+	case msg := <-seen:
+		t.Fatalf("cancelled request reached Chromium: %+v", msg)
+	default:
+	}
+}
+
+func TestBrowserZoomCancellationDoesNotChangeTheNextZoom(t *testing.T) {
+	client, peer := net.Pipe()
+	defer peer.Close()
+	conn := newCDP(client, client, nil)
+	defer conn.close()
+	br := &browser{chromium: &chromium{cdp: conn}}
+	received := make(chan struct{})
+	go func() { var buf [4096]byte; peer.Read(buf[:]); close(received) }()
+	active, stop := context.WithCancel(context.Background())
+	defer stop()
+	first := make(chan error, 1)
+	go func() { first <- br.applyControlZoom(active, 1) }()
+	<-received
+	queued, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- br.applyControlZoom(queued, 2) }()
+	if err := awaitCDP(t, done); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("queued zoom: %v", err)
+	}
+	stop()
+	awaitCDP(t, first)
+	br.mu.Lock()
+	zoom := br.controls.zoom
+	br.mu.Unlock()
+	if zoom != 0 {
+		t.Fatalf("cancelled zoom changed page state to %v", zoom)
+	}
+	seen := make(chan cdpMessage, 1)
+	go replyCDP(peer, seen)
+	ctx, end := context.WithTimeout(context.Background(), time.Second)
+	defer end()
+	if err := br.applyControlZoom(ctx, 1.5); err != nil {
+		t.Fatal(err)
+	}
+	if msg := <-seen; msg.Method != "Emulation.setPageScaleFactor" {
+		t.Fatal(msg.Method)
+	}
+	br.mu.Lock()
+	zoom = br.controls.zoom
+	br.mu.Unlock()
+	if zoom != 1.5 {
+		t.Fatalf("next zoom did not apply: %v", zoom)
+	}
+	pendingCDP(t, conn)
+}
+
+// Persisting a resize is part of the admitted operation too. A queued or
+// already-cancelled request must not change what a future browser opens at.
+func TestCancelledResizeKeepsSavedAndLiveViewport(t *testing.T) {
+	m := &Browsers{Dir: t.TempDir(), open: map[string]*chromium{}}
+	const path = "/test/worktree"
+	initial := Viewport{800, 600, 1}
+	if err := m.setViewport(path, "qa", initial); err != nil {
+		t.Fatal(err)
+	}
+	cancelled, stop := context.WithCancel(context.Background())
+	stop()
+	if _, err := m.Resize(cancelled, path, "qa", Viewport{390, 844, 2}); !errors.Is(err, context.Canceled) {
+		t.Fatalf("closed-browser resize: %v", err)
+	}
+	if got := m.Viewport(path, "qa"); got != initial {
+		t.Fatalf("cancelled closed-browser resize saved %+v", got)
+	}
+	client, peer := net.Pipe()
+	defer peer.Close()
+	conn := newCDP(client, client, nil)
+	defer conn.close()
+	c := &chromium{m: m, cdp: conn, path: path, done: make(chan struct{}), tabs: map[string]*browser{}}
+	br := &browser{chromium: c, tab: "qa", viewport: initial, watchers: map[chan frame]struct{}{}}
+	c.tabs[br.tab] = br
+	m.open[path] = c
+	end, err := br.begin(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	queued, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := m.Resize(queued, path, "qa", Viewport{390, 844, 2}); done <- err }()
+	err = awaitCDP(t, done)
+	end()
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("queued resize: %v", err)
+	}
+	if got := m.Viewport(path, "qa"); got != initial || br.currentViewport() != initial {
+		t.Fatalf("cancelled resize changed saved/live viewport: %+v / %+v", got, br.currentViewport())
+	}
+	br.castMu.Lock()
+	queuedCast, stopCast := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer stopCast()
+	go func() { _, err := m.Resize(queuedCast, path, "qa", Viewport{640, 480, 1}); done <- err }()
+	err = awaitCDP(t, done)
+	br.castMu.Unlock()
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("queued cast resize: %v", err)
+	}
+	if got := m.Viewport(path, "qa"); got != initial || br.currentViewport() != initial {
+		t.Fatalf("cancelled cast resize changed saved/live viewport: %+v / %+v", got, br.currentViewport())
+	}
+	seen := make(chan cdpMessage, 2)
+	go replyCDP(peer, seen)
+	ctx, finish := context.WithTimeout(context.Background(), time.Second)
+	defer finish()
+	for _, v := range []Viewport{{390, 844, 2}, {1280, 800, 1}} {
+		if _, err := m.Resize(ctx, path, "qa", v); err != nil {
+			t.Fatal(err)
+		}
+		if got := m.Viewport(path, "qa"); got != v || br.currentViewport() != v {
+			t.Fatalf("saved/live viewport disagree: %+v / %+v", got, br.currentViewport())
+		}
+		msg := <-seen
+		if msg.Method != "Emulation.setDeviceMetricsOverride" {
+			t.Fatalf("cancelled resize executed later: %+v", msg)
+		}
+	}
+	pendingCDP(t, conn)
+}
