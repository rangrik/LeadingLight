+package box
+
+import (
+	"context"
+	"sync"
+)
+
+// contextGate serializes operations that can wait on an external process.
+// Its zero value is ready to use. State-only critical sections use sync.Mutex.
+type contextGate struct {
+	once sync.Once
+	held chan struct{}
+}
+
+func (g *contextGate) LockContext(ctx context.Context) error {
+	g.once.Do(func() { g.held = make(chan struct{}, 1) })
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	select {
+	case g.held <- struct{}{}:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	if err := ctx.Err(); err != nil {
+		<-g.held
+		return err
+	}
+	return nil
+}
+
+// Lock is for background cleanup which must complete even after its request.
+func (g *contextGate) Lock()   { _ = g.LockContext(context.Background()) }
+func (g *contextGate) Unlock() { <-g.held }
