+	once    sync.Once
+	started chan struct{}
+}
+
+func (w *observedCDPWriter) Write(p []byte) (int, error) {
+	w.once.Do(func() { close(w.started) })
+	return w.Conn.Write(p)
+}
+func pendingCDP(t *testing.T, c *cdpConn) {
+	t.Helper()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.pending) != 0 {
+		t.Fatalf("pending replies leaked: %d", len(c.pending))
+	}
+}
+func awaitCDP(t *testing.T, done <-chan error) error {
+	t.Helper()
+	select {
+	case err := <-done:
+		return err
+	case <-time.After(time.Second):
+		t.Fatal("CDP operation ignored cancellation")
+		return nil
+	}
+}
+func replyCDP(peer net.Conn, seen chan<- cdpMessage) {
+	r := bufio.NewReader(peer)
+	for {
+		raw, err := r.ReadBytes(0)
+		if err != nil {
+			return
+		}
+		var msg cdpMessage
+		if json.Unmarshal(raw[:len(raw)-1], &msg) != nil {
+			return
+		}
+		seen <- msg
+		raw, _ = json.Marshal(map[string]any{"id": msg.ID, "result": map[string]any{"result": map[string]any{"value": "ready"}}})
+		if _, err = peer.Write(append(raw, 0)); err != nil {
+			return
+		}
+	}
+}
+
+// No reader means no bytes were sent: cancellation must release the writer,
+// remove its pending reply, and leave the connection usable for another tab.
+func TestCDPCancelledWriteAndQueuedTabNeverExecuteLater(t *testing.T) {
+	client, peer := net.Pipe()
+	defer peer.Close()
+	writer := &observedCDPWriter{Conn: client, started: make(chan struct{})}
+	c := newCDP(writer, client, nil)
+	defer c.close()
+	firstCtx, stopFirst := context.WithCancel(context.Background())
+	defer stopFirst()
+	first := make(chan error, 1)
+	go func() { first <- c.call(firstCtx, "first-tab", "blocked", nil, nil) }()
+	<-writer.started
+	queuedCtx, stopQueued := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer stopQueued()
+	queued := make(chan error, 1)
+	go func() { queued <- c.call(queuedCtx, "second-tab", "cancelled", nil, nil) }()
+	if err := awaitCDP(t, queued); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("queued command: %v", err)
+	}
+	stopFirst()
+	if err := awaitCDP(t, first); !errors.Is(err, context.Canceled) {
+		t.Fatalf("active command: %v", err)
+	}
+	pendingCDP(t, c)
+	seen := make(chan cdpMessage, 4)
+	go replyCDP(peer, seen)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, session := range []string{"first-tab", "second-tab"} {
+		if err := c.call(ctx, session, "ready", nil, nil); err != nil {
+			t.Fatal(err)
+		}
+		msg := <-seen
+		if msg.Method != "ready" || msg.SessionID != session {
+			t.Fatalf("cancelled bytes executed later: %+v", msg)
+		}
+	}
+	pendingCDP(t, c)
+}
+
+// A partial command cannot be repaired or followed by more JSON: closing the
+// pipe is the only way to keep its cancelled fragment from executing later.
+func TestCDPCancellationClosesAPartialFrame(t *testing.T) {
+	client, peer := net.Pipe()
+	defer peer.Close()
+	c := newCDP(client, client, nil)
+	defer c.close()
+	prefix := make(chan []byte, 1)
+	go func() { buf := make([]byte, 8); n, _ := io.ReadFull(peer, buf); prefix <- buf[:n] }()
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- c.call(ctx, "tab", "blocked", nil, nil) }()
+	got := <-prefix
+	if err := awaitCDP(t, done); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("partial write: %v", err)
+	}
+	select {
+	case <-c.closed:
+	default:
+		t.Fatal("partial frame kept the connection open")
+	}
+	rest, err := io.ReadAll(peer)
+	if err != nil || len(rest) != 0 || strings.ContainsRune(string(got), 0) {
+		t.Fatalf("partial frame completed: %q %q %v", got, rest, err)
+	}
+	if err := c.call(context.Background(), "tab", "later", nil, nil); err == nil {
+		t.Fatal("closed stream accepted another command")
+	}
+	pendingCDP(t, c)
+}
+
+// The real Chromium transport is two OS pipes. Filling its command pipe
+// must honor each deadline, and explicit close must not wait for a writer.
+func TestCDPFullOSPipeAndCloseHonorCancellation(t *testing.T) {
+	toRead, toWrite, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	fromRead, fromWrite, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer toRead.Close()
+	defer fromWrite.Close()
+	c := newCDP(toWrite, fromRead, nil)
+	defer c.close()
+	for i := 0; i < 4; i++ {
+		ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+		done := make(chan error, 1)
+		go func() {
+			done <- c.call(ctx, "tab", "Runtime.evaluate", map[string]string{"expression": strings.Repeat("x", 32<<10)}, nil)
+		}()
+		if err := awaitCDP(t, done); err == nil {
+			t.Fatal("a silent browser replied")
+		}
+		cancel()
+	}
+	closed := make(chan error, 1)
+	go func() { c.close(); closed <- nil }()
+	awaitCDP(t, closed)
+	pendingCDP(t, c)
+}
+
+func TestCDPCloseInterruptsBlockedWriteWithoutARequestDeadline(t *testing.T) {
+	client, peer := net.Pipe()
+	defer peer.Close()
+	writer := &observedCDPWriter{Conn: client, started: make(chan struct{})}
+	c := newCDP(writer, client, nil)
+	defer c.close()
+	done := make(chan error, 1)
+	go func() { done <- c.call(context.Background(), "tab", "blocked", nil, nil) }()
+	<-writer.started
+	closed := make(chan error, 1)
+	go func() { c.close(); closed <- nil }()
+	awaitCDP(t, closed)
+	if err := awaitCDP(t, done); err == nil {
+		t.Fatal("closed write succeeded")
+	}
+	pendingCDP(t, c)
+}
+
+// A zero-byte deadline must not linger on the writer after ownership passes.
+func TestCDPWriteDeadlineDoesNotPoisonRecovery(t *testing.T) {
+	for i := 0; i < 20; i++ {
+		client, peer := net.Pipe()
+		c := newCDP(client, client, nil)
+		ctx, cancel := context.WithTimeout(context.Background(), time.Millisecond)
+		if err := c.call(ctx, "tab", "cancelled", nil, nil); !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("cancelled: %v", err)
+		}
+		cancel()
+		seen := make(chan cdpMessage, 1)
+		go replyCDP(peer, seen)
+		next, stop := context.WithTimeout(context.Background(), time.Second)
+		err := c.call(next, "tab", "ready", nil, nil)
+		stop()
+		c.close()
+		peer.Close()
+		if err != nil {
+			t.Fatalf("recovered write %d: %v", i, err)
+		}
+		if msg := <-seen; msg.Method != "ready" {
+			t.Fatalf("late cancelled command: %+v", msg)
+		}
+		pendingCDP(t, c)
+	}
+}
+
+// A stalled writer on one tab must not prevent replies for another tab
+// from reaching their callers through the pending-reply map.
+func TestCDPRepliesContinueWhileAnotherTabCannotWrite(t *testing.T) {
+	client, peer := net.Pipe()
+	defer peer.Close()
+	c := newCDP(client, client, nil)
+	defer c.close()
+	firstMessage := make(chan cdpMessage, 1)
+	replyNow := make(chan struct{})
+	replied := make(chan struct{})
+	go func() {
+		defer close(replied)
+		raw, err := bufio.NewReader(peer).ReadBytes(0)
+		if err != nil {
+			return
+		}
+		var msg cdpMessage
+		json.Unmarshal(raw[:len(raw)-1], &msg)
+		firstMessage <- msg
+		<-replyNow
+		raw, _ = json.Marshal(map[string]any{"id": msg.ID, "result": map[string]any{}})
+		peer.Write(append(raw, 0))
+	}()
+	first := make(chan error, 1)
+	go func() { first <- c.call(context.Background(), "first-tab", "ready", nil, nil) }()
+	<-firstMessage
+	// This peer has stopped reading. The second call remains blocked until
+	// close, while the first reply arrives independently on the other pipe.
+	second := make(chan error, 1)
+	go func() { second <- c.call(context.Background(), "second-tab", "blocked", nil, nil) }()
+	deadline := time.Now().Add(time.Second)
+	for {
+		c.mu.Lock()
+		pending := len(c.pending)
+		c.mu.Unlock()
+		if pending == 2 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("second command never registered")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	close(replyNow)
+	if err := awaitCDP(t, first); err != nil {
+		t.Fatal(err)
+	}
+	c.close()
+	if err := awaitCDP(t, second); err == nil {
+		t.Fatal("blocked second write succeeded")
+	}
+	<-replied
+	pendingCDP(t, c)
+}
+
+func TestCDPMalformedParametersDoNotLeaveAPendingReply(t *testing.T) {
+	client, peer := net.Pipe()
+	defer peer.Close()
+	c := newCDP(client, client, nil)
+	defer c.close()
+	if err := c.call(context.Background(), "tab", "invalid", make(chan int), nil); err == nil {
+		t.Fatal("non-JSON params accepted")
+	}
+	pendingCDP(t, c)
+	seen := make(chan cdpMessage, 1)
+	go replyCDP(peer, seen)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := c.call(ctx, "tab", "ready", nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	if msg := <-seen; msg.Method != "ready" {
+		t.Fatalf("invalid command reached Chromium: %+v", msg)
+	}
+	pendingCDP(t, c)
+}
