+package box
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func navigationCancellationFixture(t *testing.T) (*browser, *observedCDPWriter, net.Conn, func(context.Context, string) error) {
+	t.Helper()
+	b, wt, _ := browserBox(t, func(http.ResponseWriter, *http.Request) {})
+	client, peer := net.Pipe()
+	writer := &observedCDPWriter{Conn: client, started: make(chan struct{})}
+	conn := newCDP(writer, client, nil)
+	t.Cleanup(func() { conn.close(); peer.Close() })
+	m := b.NewBrowsers(t.TempDir(), 1)
+	c := &chromium{m: m, cdp: conn, path: wt.Path, done: make(chan struct{}), tabs: map[string]*browser{}, sessions: map[string]*browser{}}
+	br := &browser{chromium: c, tab: "qa", session: "qa", viewport: DefaultViewport}
+	c.tabs[br.tab] = br
+	c.sessions[br.session] = br
+	m.open[wt.Path] = c
+	return br, writer, peer, func(ctx context.Context, body string) error {
+		r := httptest.NewRequest("POST", "http://box/?tab=qa", strings.NewReader(body)).WithContext(ctx)
+		r.SetPathValue("loc", "cal")
+		r.SetPathValue("wt", wt.Name)
+		return b.browserNavigate(httptest.NewRecorder(), r)
+	}
+}
+
+func awaitNavigationState(t *testing.T, br *browser, test func(browserControls) bool) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for {
+		br.mu.Lock()
+		ok := test(br.controls)
+		br.mu.Unlock()
+		if ok {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("navigation did not reach expected state")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func TestBrowserNavigationCancelsBeforeItIsSent(t *testing.T) {
+	for _, queued := range []bool{false, true} {
+		name := "blocked-write"
+		if queued {
+			name = "queued-behind-another-tab"
+		}
+		t.Run(name, func(t *testing.T) {
+			br, writer, peer, navigate := navigationCancellationFixture(t)
+			active, stop := context.WithCancel(context.Background())
+			defer stop()
+			first := make(chan error, 1)
+			if queued {
+				go func() { first <- br.cdp.call(active, "another-tab", "blocked", nil, nil) }()
+				<-writer.started
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { done <- navigate(ctx, `{"action":"reload"}`) }()
+			if err := awaitCDP(t, done); !errors.Is(err, context.DeadlineExceeded) {
+				t.Fatalf("unsent navigation: %v", err)
+			}
+			br.mu.Lock()
+			loading, hasCancel := br.controls.loading, br.controls.navCancel != nil
+			br.mu.Unlock()
+			if loading || hasCancel {
+				t.Fatal("cancelled unsent navigation retained loading state")
+			}
+			if queued {
+				stop()
+				if err := awaitCDP(t, first); !errors.Is(err, context.Canceled) {
+					t.Fatal(err)
+				}
+			}
+			pendingCDP(t, br.cdp)
+			seen := make(chan cdpMessage, 2)
+			go replyCDP(peer, seen)
+			if err := navigate(context.Background(), `{"action":"stop"}`); err != nil {
+				t.Fatal(err)
+			}
+			if msg := <-seen; msg.Method != "Page.stopLoading" {
+				t.Fatalf("cancelled navigation executed later: %+v", msg)
+			}
+			awaitNavigationState(t, br, func(s browserControls) bool { return s.navCancel == nil })
+			pendingCDP(t, br.cdp)
+		})
+	}
+}
+
+func TestBrowserSentNavigationOutlivesRequestCancellation(t *testing.T) {
+	br, _, peer, navigate := navigationCancellationFixture(t)
+	message := make(chan cdpMessage, 1)
+	go func() {
+		raw, err := bufio.NewReader(peer).ReadBytes(0)
+		if err != nil {
+			return
+		}
+		var msg cdpMessage
+		json.Unmarshal(raw[:len(raw)-1], &msg)
+		message <- msg
+	}()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	if err := navigate(ctx, `{"action":"reload"}`); err != nil {
+		t.Fatal(err)
+	}
+	msg := <-message
+	cancel()
+	// The command has been accepted; its reply still owns the current
+	// navigation even when the HTTP request is already gone.
+	response, _ := json.Marshal(map[string]any{"id": msg.ID, "result": map[string]string{"errorText": "net::ERR_CONNECTION_REFUSED"}})
+	if _, err := peer.Write(append(response, 0)); err != nil {
+		t.Fatal(err)
+	}
+	awaitNavigationState(t, br, func(s browserControls) bool {
+		return s.navCancel == nil && !s.loading && s.failure == "net::ERR_CONNECTION_REFUSED"
+	})
+	pendingCDP(t, br.cdp)
+}
+
+func TestBrowserSupersededNavigationCannotWriteOrClearItsReplacement(t *testing.T) {
+	br, _, peer, navigate := navigationCancellationFixture(t)
+	br.cdp.writeMu.Lock()
+	locked := true
+	defer func() {
+		if locked {
+			br.cdp.writeMu.Unlock()
+		}
+	}()
+	first := make(chan error, 1)
+	go func() { first <- navigate(context.Background(), `{"action":"reload"}`) }()
+	awaitNavigationState(t, br, func(s browserControls) bool { return s.navSequence == 1 })
+	second := make(chan error, 1)
+	go func() {
+		second <- navigate(context.Background(), `{"action":"open","url":"http://localhost/replacement"}`)
+	}()
+	awaitNavigationState(t, br, func(s browserControls) bool { return s.navSequence == 2 })
+	if err := awaitCDP(t, first); !errors.Is(err, context.Canceled) {
+		t.Fatalf("superseded navigation: %v", err)
+	}
+	br.mu.Lock()
+	loading, hasCancel := br.controls.loading, br.controls.navCancel != nil
+	br.mu.Unlock()
+	if !loading || !hasCancel {
+		t.Fatal("old navigation cleared its replacement's state")
+	}
+	seen := make(chan cdpMessage, 2)
+	go replyCDP(peer, seen)
+	br.cdp.writeMu.Unlock()
+	locked = false
+	if err := awaitCDP(t, second); err != nil {
+		t.Fatal(err)
+	}
+	if msg := <-seen; msg.Method != "Page.navigate" || !strings.Contains(string(msg.Params), "/replacement") {
+		t.Fatalf("superseded navigation reached Chromium: %+v", msg)
+	}
+	awaitNavigationState(t, br, func(s browserControls) bool { return s.navCancel == nil })
+	pendingCDP(t, br.cdp)
+}
