+// The browser may acknowledge closeTarget before removing the page. The
+// extra nonblank page is not a startup target and must never be closed.
+func startupTargetFixture(t *testing.T, accept bool, gone <-chan struct{}) (*chromium, <-chan string, <-chan struct{}) {
+	t.Helper()
+	client, peer := net.Pipe()
+	c := &chromium{cdp: newCDP(client, client, nil), tabs: map[string]*browser{}, sessions: map[string]*browser{}}
+	closed := make(chan string, 4)
+	polled := make(chan struct{}, 1)
+	t.Cleanup(func() { c.cdp.close(); peer.Close() })
+	go func() {
+		r := bufio.NewReader(peer)
+		first := true
+		created := false
+		for {
+			raw, err := r.ReadBytes(0)
+			if err != nil {
+				return
+			}
+			var cmd cdpMessage
+			if json.Unmarshal(raw[:len(raw)-1], &cmd) != nil {
+				return
+			}
+			result := map[string]any{}
+			switch cmd.Method {
+			case "Target.getTargets":
+				pages := []map[string]string{{"targetId": "keep", "type": "page", "url": "https://example.test/"}}
+				if created {
+					pages = append(pages, map[string]string{"targetId": "private-page", "type": "page", "url": "about:blank"},
+						map[string]string{"targetId": "other-blank", "type": "page", "url": "about:blank"})
+				}
+				include := first
+				if !first {
+					select {
+					case <-gone:
+					default:
+						include = true
+					}
+					select {
+					case polled <- struct{}{}:
+					default:
+					}
+				}
+				if include {
+					pages = append(pages, map[string]string{"targetId": "startup", "type": "page", "url": "about:blank"})
+				}
+				first = false
+				result["targetInfos"] = pages
+			case "Target.createBrowserContext":
+				result["browserContextId"] = "private"
+			case "Target.createTarget":
+				created = true
+				result["targetId"] = "private-page"
+			case "Target.attachToTarget":
+				result["sessionId"] = "session"
+			case "Target.closeTarget":
+				var params struct {
+					ID string `json:"targetId"`
+				}
+				json.Unmarshal(cmd.Params, &params)
+				closed <- params.ID
+				result["success"] = accept
+			}
+			response, _ := json.Marshal(map[string]any{"id": cmd.ID, "result": result})
+			if _, err := peer.Write(append(response, 0)); err != nil {
+				return
+			}
+		}
+	}()
+	return c, closed, polled
+}
+
+func TestPrivateBrowserWaitsForStartupTargetDestruction(t *testing.T) {
+	previous := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = previous })
+	gone := make(chan struct{})
+	c, closed, polled := startupTargetFixture(t, true, gone)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- c.attachMain(ctx, DefaultViewport) }()
+	select {
+	case <-polled:
+	case <-ctx.Done():
+		t.Fatal("did not check whether the original target closed")
+	}
+	select {
+	case err := <-done:
+		t.Fatalf("returned while the startup target still existed: %v", err)
+	default:
+	}
+	if id := <-closed; id != "startup" {
+		t.Fatalf("closed unrelated target %q", id)
+	}
+	close(gone)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("did not finish after startup target closed")
+	}
+	select {
+	case id := <-closed:
+		t.Fatalf("closed unrelated target %q", id)
+	default:
+	}
+	if br := c.lookup(""); br == nil || br.bctx != "private" {
+		t.Fatal("private main tab not attached")
+	}
+}
+
+func TestPrivateBrowserRejectsUnclosedStartupTarget(t *testing.T) {
+	previous := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = previous })
+	for _, accept := range []bool{false, true} {
+		t.Run(map[bool]string{false: "refused", true: "never-destroyed"}[accept], func(t *testing.T) {
+			c, _, _ := startupTargetFixture(t, accept, make(chan struct{}))
+			ctx, cancel := context.WithTimeout(context.Background(), 70*time.Millisecond)
+			defer cancel()
+			err := c.attachMain(ctx, DefaultViewport)
+			if accept {
+				if !errors.Is(err, context.DeadlineExceeded) {
+					t.Fatalf("undestroyed target: %v", err)
+				}
+			} else if err == nil || !strings.Contains(err.Error(), "refused") {
+				t.Fatalf("refused close: %v", err)
+			}
+		})
+	}
+}
