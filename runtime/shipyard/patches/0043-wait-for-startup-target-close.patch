+// waitForStartupTargets waits only for the original pages selected at launch.
+// A close acknowledgement alone does not mean Chromium has destroyed them.
+func (c *chromium) waitForStartupTargets(ctx context.Context, closing map[string]bool) error {
+	for len(closing) > 0 {
+		var current struct {
+			Targets []struct {
+				ID string `json:"targetId"`
+			} `json:"targetInfos"`
+		}
+		if err := c.cdp.call(ctx, "", "Target.getTargets", nil, &current); err != nil {
+			return fmt.Errorf("waiting for startup targets to close: %w", err)
+		}
+		remaining := make(map[string]bool)
+		for _, t := range current.Targets {
+			if closing[t.ID] {
+				remaining[t.ID] = true
+			}
+		}
+		if len(remaining) == 0 {
+			return nil
+		}
+		closing = remaining
+		select {
+		case <-ctx.Done():
+			return fmt.Errorf("waiting for startup targets to close: %w", ctx.Err())
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+	return nil
+}
