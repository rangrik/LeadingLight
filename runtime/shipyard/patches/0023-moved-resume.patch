From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeadingLight <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 09:00:24 -0700
Subject: [PATCH] A chat whose folder moved carries on where its location went

Resuming a conversation whose folder is gone, while its location now names another folder (a relink after a move), restarts it there and notes the new folder.
---
diff --git a/internal/box/conversations.go b/internal/box/conversations.go
index 4b3a83f..43f5d1f 100644
--- a/internal/box/conversations.go
+++ b/internal/box/conversations.go
@@ -350,7 +350,12 @@ func (b *Box) carryOnConversation(r *http.Request, dir string) (Session, error)
 		return b.enrich(r.Context(), []Session{s})[0], nil
 	}
 	if st, err := os.Stat(conv.Dir); err != nil || !st.IsDir() {
-		return Session{}, httpError{http.StatusGone, "the folder it worked in, " + conv.Dir + ", is gone"}
+		d, derr := b.Locations.Dir(r.Context(), conv.Location)
+		if derr != nil || d == conv.Dir {
+			return Session{}, httpError{http.StatusGone, "the folder it worked in, " + conv.Dir + ", is gone"}
+		}
+		conv.Dir = d
+		noteConversation(dir, func(c *Conversation) { c.Dir = d })
 	}
 	sid := conversationSession(dir)
 	if sid == "" && conv.Agent == "claude" {
