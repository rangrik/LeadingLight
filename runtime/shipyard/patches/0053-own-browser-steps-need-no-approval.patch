diff --git a/internal/box/ownbrowser.go b/internal/box/ownbrowser.go
new file mode 100644
index 0000000..2e3a208
--- /dev/null
+++ b/internal/box/ownbrowser.go
@@ -0,0 +1,77 @@
+package box
+
+import (
+	"encoding/json"
+	"regexp"
+	"strings"
+)
+
+// bashCommand is the command in Claude's Bash input; codexAskedCommand the one Codex asks to run.
+func bashCommand(in json.RawMessage) string {
+	var v struct {
+		Command string `json:"command"`
+	}
+	json.Unmarshal(in, &v)
+	return v.Command
+}
+
+func codexAskedCommand(params json.RawMessage) string {
+	var v struct {
+		Command string `json:"command"`
+	}
+	json.Unmarshal(params, &v)
+	if m := shellWrappedCmd(v.Command); m != "" {
+		return m
+	}
+	return v.Command
+}
+
+// ownBrowserSteps are the browser commands that act only on the agent's own tab, sealed off
+// from the person's tabs; the runtime allows them without asking. eval, developer access and
+// allowing sites still ask.
+var ownBrowserSteps = map[string]bool{
+	"open": true, "resize": true, "snapshot": true, "click": true, "fill": true, "press": true,
+	"select": true, "hover": true, "check": true, "wait": true, "shot": true, "console": true,
+	"network": true, "status": true, "close": true, "tabs": true, "list": true,
+}
+
+var (
+	ownBrowserSplit  = regexp.MustCompile(`&&|\|\||\||;|&|\n`)
+	ownBrowserAssign = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*=('[^']*'|"[^"]*"|[^\s'"]*)$`)
+	// LOC/WT names another project's browser; a URL has a ':' or "//", so it never matches.
+	ownBrowserOther = regexp.MustCompile(`^[^\s:/@'"]+/[^\s/'"]+$`)
+)
+
+// ownBrowserOnly says whether a shell command only drives the agent's own browser tab: every
+// part is such a browser step, a sleep, an echo, an assignment, or head, tail or grep in a pipe.
+func ownBrowserOnly(cmd string) bool {
+	quiet := strings.NewReplacer("2>&1", "", "2>/dev/null", "", ">/dev/null", "", "> /dev/null", "").Replace(cmd)
+	if strings.ContainsAny(quiet, "<>`(){}") || strings.Contains(quiet, "$(") || strings.Contains(quiet, "--tab") || strings.Contains(quiet, "user-") {
+		return false
+	}
+	parts := ownBrowserSplit.Split(quiet, -1)
+	ops := ownBrowserSplit.FindAllString(quiet, -1)
+	browser := false
+	for i, part := range parts {
+		words := strings.Fields(part)
+		if len(words) == 0 {
+			continue
+		}
+		piped := i > 0 && ops[i-1] == "|"
+		switch {
+		case len(words) >= 3 && words[0] == "berthd" && words[1] == "browser" && ownBrowserSteps[words[2]]:
+			for _, w := range words[3:] {
+				if ownBrowserOther.MatchString(strings.Trim(w, `'"`)) {
+					return false
+				}
+			}
+			browser = true
+		case words[0] == "sleep" && len(words) == 2, words[0] == "echo":
+		case len(words) == 1 && ownBrowserAssign.MatchString(words[0]):
+		case piped && (words[0] == "head" || words[0] == "tail" || words[0] == "grep"):
+		default:
+			return false
+		}
+	}
+	return browser
+}
diff --git a/internal/box/ownbrowser_test.go b/internal/box/ownbrowser_test.go
new file mode 100644
index 0000000..5a1ff34
--- /dev/null
+++ b/internal/box/ownbrowser_test.go
@@ -0,0 +1,29 @@
+package box
+
+import "testing"
+
+// The seam: only commands confined to the agent's own tab skip the person's approval.
+func TestOwnBrowserOnly(t *testing.T) {
+	for cmd, want := range map[string]bool{
+		"berthd browser open http://127.0.0.1:46810/index.html":                       true,
+		"sleep 1; berthd browser open http://localhost:3000 && berthd browser snapshot": true,
+		"B='ll-browser-1'; berthd browser snapshot \"$B\" 2>&1 | head -80":             true,
+		"berthd browser fill @e1 SPRING10 && berthd browser click @e2":                 true,
+		"berthd browser click @e2 --tab user-3f859fab":                                 false,
+		"berthd browser click @e2 --tab other-agent":                                   false,
+		"berthd browser open otherloc/main http://localhost:3000":                      false,
+		"berthd browser eval 'document.cookie'":                                        false,
+		"berthd browser cdp Runtime.evaluate":                                          false,
+		"berthd browser open http://x && curl https://evil.example":                   false,
+		"berthd browser open http://x; rm -rf build":                                   false,
+		"berthd browser open $(cat secret)":                                            false,
+		"berthd browser shot > notes.md":                                               false,
+		"FOO=1 curl https://evil.example":                                              false,
+		"head -5 .env":                                                                 false,
+		"sleep 1":                                                                      false,
+	} {
+		if got := ownBrowserOnly(cmd); got != want {
+			t.Errorf("ownBrowserOnly(%q) = %v, want %v", cmd, got, want)
+		}
+	}
+}
