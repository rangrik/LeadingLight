index 0000000..7b3083f
--- /dev/null
+++ b/internal/box/mobile_relay_test.go
@@ -0,0 +1,101 @@
+package box
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+// Only a paired device can form commands, and a restart cannot repeat an accepted request.
+func TestMobileRelayEncryptionAndDurableReplayBoundary(t *testing.T) {
+	b, m, _ := mobileFixture(t)
+	c := m.load()
+	c.Relay = &mobileRelay{Channel: "00000000-0000-4000-8000-000000000001", HostToken: strings.Repeat("a", 43), ClientToken: strings.Repeat("b", 43)}
+	id := "00000000-0000-4000-8000-000000000002"
+	req := mobileRequest{Deadline: time.Now().Add(30 * time.Second).UnixMilli(), Method: "GET", Path: "/v1/info"}
+	envelope, err := mobileSeal(c, id, "request", req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded mobileRequest
+	if mobileOpen(c, id, "response", envelope, &decoded) == nil {
+		t.Fatal("accepted reflected message")
+	}
+	if mobileOpen(c, "00000000-0000-4000-8000-000000000003", "request", envelope, &decoded) == nil {
+		t.Fatal("accepted another request identity")
+	}
+	wrong := c
+	wrong.Relay = &mobileRelay{Channel: "00000000-0000-4000-8000-000000000003"}
+	if mobileOpen(wrong, id, "request", envelope, &decoded) == nil {
+		t.Fatal("accepted another connection")
+	}
+	answer, err := m.dispatch(context.Background(), b, c, mobileMessage{id, envelope})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var reply mobileReply
+	if err = mobileOpen(c, id, "response", answer, &reply); err != nil || reply.Status != 200 {
+		t.Fatal(err, reply)
+	}
+	restarted := &Mobile{Path: m.Path}
+	answer, err = restarted.dispatch(context.Background(), b, c, mobileMessage{id, envelope})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = mobileOpen(c, id, "response", answer, &reply); err != nil || reply.Status != 503 {
+		t.Fatal("replayed after restart", err, reply)
+	}
+	req.Deadline = time.Now().Add(-time.Second).UnixMilli()
+	id = "00000000-0000-4000-8000-000000000004"
+	envelope, _ = mobileSeal(c, id, "request", req)
+	answer, err = m.dispatch(context.Background(), b, c, mobileMessage{id, envelope})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = mobileOpen(c, id, "response", answer, &reply); err != nil || reply.Status != 503 {
+		t.Fatal("accepted expired request", err, reply)
+	}
+	req = mobileRequest{Deadline: time.Now().Add(30 * time.Second).UnixMilli(), Method: "DELETE", Path: "/v1/sessions/unshared/queue/turn"}
+	id = "00000000-0000-4000-8000-000000000005"
+	envelope, _ = mobileSeal(c, id, "request", req)
+	answer, err = m.dispatch(context.Background(), b, c, mobileMessage{id, envelope})
+	if err != nil {
+		t.Fatal("DELETE did not reach the scoped gateway", err)
+	}
+	if err = mobileOpen(c, id, "response", answer, &reply); err != nil || reply.Status != 403 {
+		t.Fatal("DELETE bypassed project scope", err, reply)
+	}
+}
+
+// The same vector guards the Rust controller and Go runtime's wire format.
+func TestMobileRelaySharedCryptoVector(t *testing.T) {
+	raw, err := os.ReadFile("testdata/mobile-relay-v2.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var vector struct {
+		Key, Channel, ID string
+		Cases            []struct {
+			Direction string
+			Plaintext any
+			Envelope  mobileEnvelope
+		}
+	}
+	if err = json.Unmarshal(raw, &vector); err != nil {
+		t.Fatal(err)
+	}
+	c := mobileConfig{Token: vector.Key, Relay: &mobileRelay{Channel: vector.Channel}}
+	for _, item := range vector.Cases {
+		var plain any
+		if err = mobileOpen(c, vector.ID, item.Direction, item.Envelope, &plain); err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(plain, item.Plaintext) {
+			t.Fatal("cross-language plaintext changed", plain)
+		}
+	}
+}
