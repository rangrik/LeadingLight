+	for _, name := range []string{"shared", "private"} {
+		loc, _ := b.Locations.Get(context.Background(), name)
+		noteConversation(filepath.Join(b.ConversationsDir, name), func(c *Conversation) { c.Agent = "claude"; c.Location = name; c.Dir = loc.Path; c.Title = name })
+	}
+	for _, path := range []string{"/v1/conversations?location=private", "/v1/conversations/private/outputs", "/v1/sessions/private/requests"} {
+		if w := request("GET", path, ""); w.Code != 403 {
+			t.Fatal(path, w.Code, w.Body)
+		}
