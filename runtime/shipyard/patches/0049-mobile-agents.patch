+			t.Fatal(err)
+		}
+	}
+	m := &Mobile{Path: filepath.Join(t.TempDir(), "mobile.json")}
+	mobileGrant(t, b, m, "shared")
+	return b, m, m.handler(b, mobileAddr)
+}
+
+func mobileGrant(t *testing.T, b *Box, m *Mobile, projects ...string) {
+	t.Helper()
+	c := mobileConfig{Enabled: true, Token: strings.Repeat("a", 48), Projects: projects, Grants: map[string]string{}}
+	for _, name := range projects {
+		loc, err := b.Locations.Get(context.Background(), name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		c.Grants[name] = mobileIdentity(loc)
+	}
+	raw, _ := json.Marshal(c)
+	if err := statefile.Write(m.Path, raw); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// The seam is the network grant: neither a token nor a guessed ID bypasses project scope.
+func TestMobileAuthorizationAndScope(t *testing.T) {
+	b, m, h := mobileFixture(t)
+	token := strings.Repeat("a", 48)
+	request := func(method, path, body string) *httptest.ResponseRecorder {
+		return phoneReq(t, h, method, path, mobileAddr, token, body)
+	}
+	if w := phoneReq(t, h, "GET", "/v1/info", mobileAddr, "", ""); w.Code != 401 {
+		t.Fatal(w.Code)
+	}
+	if w := phoneReq(t, h, "GET", "/v1/info", mobileAddr, token, "", "Origin", "https://evil.example"); w.Code != 403 {
+		t.Fatal(w.Code)
+	}
+	if w := phoneReq(t, h, "GET", "/v1/info", "evil.example:1380", token, ""); w.Code != 403 {
+		t.Fatal(w.Code)
+	}
+	if w := request("GET", "/v1/info", ""); w.Code != 200 || !strings.Contains(w.Body.String(), `"mobile":true`) {
+		t.Fatal(w.Code, w.Body)
+	}
+	for _, path := range []string{"/v1/mobile", "/v1/phone", "/v1/exec", "/v1/fs", "/v1/events", "/v1/leadinglight/tools", "/v1/../v1/info", "/v1/sessions/%2fshared"} {
+		if w := request("GET", path, ""); w.Code < 400 {
+			t.Fatalf("%s: %d", path, w.Code)
+		}
+	}
+	if w := request("GET", "/v1/locations", ""); w.Code != 200 || strings.Contains(w.Body.String(), `"private"`) {
+		t.Fatal(w.Code, w.Body)
