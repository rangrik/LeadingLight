+
+const mobileAddr = "100.101.102.103:1380"
+
+func mobileFixture(t *testing.T) (*Box, *Mobile, http.Handler) {
+	t.Helper()
+	b := &Box{Name: "My Mac", Locations: NewLocations(filepath.Join(t.TempDir(), "locations.json")), Sessions: testSessions(t), ConversationsDir: t.TempDir(), Events: &events.Bus{}}
+	for _, name := range []string{"shared", "private"} {
