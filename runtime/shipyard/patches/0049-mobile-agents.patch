+	for _, path := range []string{"/v1/conversations/private/resume", "/v1/sessions/private/send", "/v1/sessions/private/interrupt", "/v1/sessions/private/requests/id/respond"} {
+		if w := request("POST", path, "{}"); w.Code != 403 {
