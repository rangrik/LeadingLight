+}
+
+// The seam is durable dispatch: a retry after a lost reply cannot create another agent.
+func TestMobileStartsOnceAndRequiresApprovals(t *testing.T) {
+	for _, provider := range []string{"claude", "codex"} {
+		t.Run(provider, func(t *testing.T) {
+			bin := t.TempDir()
+			fixture := strings.ReplaceAll(fakeStreamClaude, `"req_"`, `"host:req_"`)
+			if provider == "codex" {
+				fixture = strings.ReplaceAll(fakeCodexAppServer, "rid = srv[0]", `rid = "host:" + str(srv[0])`)
+			}
+			os.WriteFile(filepath.Join(bin, provider), []byte(fixture), 0755)
+			t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+			t.Setenv("CLAUDE_CONFIG_DIR", t.TempDir())
+			t.Setenv("CODEX_HOME", t.TempDir())
+			exe, err := os.Executable()
+			if err != nil {
+				t.Fatal(err)
+			}
+			var b *Box
+			turns := &Turns{}
+			client, bus := servedBox(t, func(box *Box) {
+				b = box
+				b.Turns = turns
+				b.ConversationsDir = conversationsDir(t)
+				b.AgentHost = []string{"env", "BERTH_TEST_AGENT_HOST=1", exe}
+			})
+			turns.Attach(bus)
+			if _, err := b.Locations.Add(context.Background(), "shared", t.TempDir()); err != nil {
+				t.Fatal(err)
+			}
+			m := &Mobile{Path: filepath.Join(t.TempDir(), "mobile.json")}
+			mobileGrant(t, b, m, "shared")
+			h := m.handler(b, mobileAddr)
+			req := func(method, path, body string) *httptest.ResponseRecorder {
+				return phoneReq(t, h, method, path, mobileAddr, strings.Repeat("a", 48), body)
+			}
+			body := strings.ReplaceAll(`{"name":"mobile-one","location":"shared","agent":"claude","driver":"claude","prompt":"run the tests"}`, "claude", provider)
+			for _, bad := range []string{strings.Replace(body, `"prompt"`, `"mode":"bypassPermissions","prompt"`, 1), strings.Replace(body, `"driver":"`+provider+`"`, `"driver":"terminal"`, 1), strings.Replace(body, `"location":"shared"`, `"location":"private"`, 1), strings.Replace(body, "run the tests", "/permissions bypassPermissions", 1)} {
+				if w := req("POST", "/v1/sessions", bad); w.Code < 400 {
+					t.Fatal(w.Code, w.Body)
+				}
+			}
+			w := req("POST", "/v1/sessions", body)
+			if w.Code != 200 {
+				t.Fatalf("start %d %s", w.Code, w.Body)
+			}
+			t.Cleanup(func() { call(t, client, "DELETE", "/v1/sessions/mobile-one", "", nil, nil) })
+			var first Session
+			json.Unmarshal(w.Body.Bytes(), &first)
+			if w = req("POST", "/v1/sessions", body); w.Code != 200 {
+				t.Fatalf("retry %d %s", w.Code, w.Body)
+			}
+			var again Session
+			json.Unmarshal(w.Body.Bytes(), &again)
+			if first.Name != again.Name {
+				t.Fatal("duplicate launch", first.Name, again.Name)
+			}
+			if w = req("POST", "/v1/sessions", strings.Replace(body, "run the tests", "different prompt", 1)); w.Code != 409 {
+				t.Fatal(w.Code, w.Body)
+			}
+			deadline := time.Now().Add(15 * time.Second)
+			var pending []Request
+			for time.Now().Before(deadline) {
+				w = req("GET", "/v1/sessions/mobile-one/requests", "")
+				json.Unmarshal(w.Body.Bytes(), &pending)
+				if len(pending) > 0 {
+					break
+				}
+				time.Sleep(40 * time.Millisecond)
+			}
+			if len(pending) == 0 {
+				t.Fatal("agent never asked for approval")
+			}
+			if w = req("POST", "/v1/sessions/mobile-one/send", `{"text":"/permissions bypassPermissions","idem_key":"mode-1"}`); w.Code != 400 {
+				t.Fatal("slash mode", w.Code, w.Body)
+			}
+			path := "/v1/sessions/mobile-one/requests/" + strings.ReplaceAll(pending[0].ID, ":", "%3A") + "/respond"
+			if !strings.Contains(path, "%3A") {
+				t.Fatal("fixture request must include an escaped colon", path)
+			}
+			if w = req("POST", path, `{"command":"answer-1","choice":"allow_always"}`); w.Code != 400 {
+				t.Fatal(w.Code, w.Body)
+			}
+			if w = req("POST", path, `{"command":"answer-1","choice":"allow"}`); w.Code != 200 {
+				t.Fatal(w.Code, w.Body)
+			}
+			if w = req("POST", path, `{"command":"answer-1","choice":"allow"}`); w.Code != 200 {
+				t.Fatal("approval retry", w.Code, w.Body)
+			}
+			all, err := b.Sessions.List(context.Background())
+			if err != nil || len(all) != 1 {
+				t.Fatal("starts", len(all), err)
+			}
+			s, _ := b.Sessions.Get(context.Background(), "mobile-one")
+			c, _ := readConversation(s.conv)
+			wantMode := "default"
+			if provider == "codex" {
+				wantMode = "untrusted"
+			}
+			if c.Mode != wantMode {
+				t.Fatal("mode", c.Mode)
+			}
+			if provider == "claude" {
+				conv, err := b.driverFor(s).(*claudeDriver).conv(s)
+				if err != nil {
+					t.Fatal(err)
+				}
+				conv.mu.Lock()
+				conv.bypass = true
+				conv.mu.Unlock()
+			} else {
+				conv, err := b.driverFor(s).(*codexDriver).conv(s)
+				if err != nil {
+					t.Fatal(err)
+				}
+				conv.mu.Lock()
+				conv.mode = "bypassPermissions"
+				conv.mu.Unlock()
+			}
+			// The saved metadata still says default; the live driver owns its current mode.
+			if w = req("POST", "/v1/sessions/mobile-one/send", `{"text":"more","idem_key":"more-1"}`); w.Code != 409 {
+				t.Fatal("unsafe continuation", w.Code, w.Body)
+			}
+		})
+	}
+}
