diff --git a/internal/box/requests_feedback_test.go b/internal/box/requests_feedback_test.go
new file mode 100644
index 0000000..77fdfd5
--- /dev/null
+++ b/internal/box/requests_feedback_test.go
@@ -0,0 +1,129 @@
+package box
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/cosscom/shipyard/internal/transcript"
+)
+
+// Provider responses must preserve feedback or reject it before answering.
+func TestApprovalFeedbackUsesProviderFields(t *testing.T) {
+	for _, kind := range []string{"approval", "plan"} {
+		choice := "deny"
+		if kind == "plan" {
+			choice = "keep_planning"
+		}
+		got, err := claudeResponse(claudeRequest{}, &Request{Kind: kind}, Respond{Choice: choice, Message: "Use the test database instead"})
+		if err != nil || got["behavior"] != "deny" || got["message"] != "Use the test database instead" || got["updatedPermissions"] != nil {
+			t.Fatalf("Claude %s: %v %v", kind, got, err)
+		}
+	}
+	for _, choice := range []string{"allow", "deny"} {
+		got, err := codexResponse(&Request{Kind: "approval"}, Respond{Choice: choice})
+		encoded, _ := json.Marshal(got)
+		want := `{"decision":"decline"}`
+		if choice == "allow" {
+			want = `{"decision":"accept"}`
+		}
+		if err != nil || string(encoded) != want {
+			t.Fatalf("Codex %s: %s %v", choice, encoded, err)
+		}
+	}
+	if _, err := codexResponse(&Request{Kind: "approval"}, Respond{Choice: "deny", Message: "Do this instead"}); err == nil {
+		t.Fatal("Codex silently dropped feedback")
+	}
+}
+
+// A restart must preserve proof of our decline without answering again.
+func TestConfirmedDeclineKeepsCommandAfterReplay(t *testing.T) {
+	dir := t.TempDir()
+	before := newRequestLedger(dir)
+	before.started(1, 1)
+	before.open(&Request{native: "approval", Kind: "approval"}, 2)
+	request := before.byNative("approval")
+	before.endAnswer(before.beginAnswer(request, "my-decline"), nil)
+	after := newRequestLedger(dir)
+	after.started(1, 1)
+	after.open(&Request{native: "approval", Kind: "approval"}, 2)
+	after.mark("approval", ReqResolved, 3)
+	after.reconcile()
+	if got := after.byNative("approval"); got.Command != "my-decline" || got.State != ReqResolved {
+		t.Fatalf("lost decline identity after replay: %+v", got)
+	}
+	after.started(4, 4)
+	after.open(&Request{native: "approval", Kind: "approval"}, 5)
+	after.reconcile()
+	if got := after.byNative("approval"); got.Command != "" || got.State != ReqPending {
+		t.Fatalf("old receipt claimed a new request: %+v", got)
+	}
+}
+
+// A confirmed decline and its separate feedback must reach one Codex thread once.
+func TestCodexDeclineThenFeedback(t *testing.T) {
+	bin := t.TempDir()
+	if err := os.WriteFile(filepath.Join(bin, "codex"), []byte(fakeCodexAppServer), 0755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+	exe, _ := os.Executable()
+	turns := &Turns{}
+	client, bus := servedBox(t, func(b *Box) {
+		b.Turns = turns
+		b.ConversationsDir = conversationsDir(t)
+		b.AgentHost = []string{"env", "BERTH_TEST_AGENT_HOST=1", exe}
+	})
+	turns.Attach(bus)
+	call(t, client, "POST", "/v1/locations", "", map[string]string{"name": "shared", "path": t.TempDir()}, nil)
+	var session Session
+	if status := call(t, client, "POST", "/v1/sessions", "", map[string]string{"location": "shared", "agent": "codex", "driver": "codex", "prompt": "run the tests", "mode": "untrusted"}, &session); status != 200 {
+		t.Fatalf("start: %d", status)
+	}
+	base := "/v1/sessions/" + session.Name
+	t.Cleanup(func() { call(t, client, "DELETE", base, "", nil, nil) })
+	until := func(what string, ready func() bool) {
+		t.Helper()
+		deadline := time.Now().Add(15 * time.Second)
+		for !ready() {
+			if time.Now().After(deadline) {
+				t.Fatal(what + " never arrived")
+			}
+			time.Sleep(25 * time.Millisecond)
+		}
+	}
+	var requests []Request
+	until("approval", func() bool { call(t, client, "GET", base+"/requests", "", nil, &requests); return len(requests) == 1 })
+	respond := base + "/requests/" + requests[0].ID + "/respond"
+	if status := call(t, client, "POST", respond, "", Respond{Command: "bad-feedback", Choice: "deny", Message: "Read only"}, nil); status != 400 {
+		t.Fatalf("unsupported feedback: %d", status)
+	}
+	var result struct {
+		Receipt Receipt `json:"receipt"`
+	}
+	if status := call(t, client, "POST", respond, "", Respond{Command: "decline-once", Choice: "deny"}, &result); status != 200 || result.Receipt.State != "written" {
+		t.Fatalf("decline: %d %+v", status, result)
+	}
+	until("declined turn end", func() bool { state, _ := turns.State(session.Name); return state.State == "finished" })
+	body := SendRequest{Text: "Feedback on the declined request: Read only", When: "now", IdemKey: "feedback-once"}
+	var sent SendResult
+	if status := call(t, client, "POST", base+"/send", "", body, &sent); status != 200 {
+		t.Fatalf("feedback: %d", status)
+	}
+	if status := call(t, client, "POST", base+"/send", "", body, &sent); status != 200 || !sent.Duplicate {
+		t.Fatalf("feedback retry: %d %+v", status, sent)
+	}
+	until("feedback reply", func() bool {
+		var transcriptResult transcript.Result
+		call(t, client, "GET", base+"/transcript?since=0", "", nil, &transcriptResult)
+		for _, item := range transcriptResult.Items {
+			if strings.Contains(item.Text, "echo: "+body.Text) {
+				return true
+			}
+		}
+		return false
+	})
+}
