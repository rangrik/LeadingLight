+// Owner access is proved by the socket peer, not a caller-supplied HTTP header.
+func TestBrowserOwnerUsesSocketPeer(t *testing.T) {
+	previous := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	defer func() { EmbeddedFiles = previous }()
+	t.Setenv("BERTH_OWNER_PID", fmt.Sprint(os.Getpid()))
+	b := &Box{}
+	dir, err := os.MkdirTemp("/tmp", "ll-owner-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	sock := filepath.Join(dir, "owner.sock")
+	ln, err := net.Listen("unix", sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := &wire.Server{}
+	b.mountBrowser(func(pattern string, h func(http.ResponseWriter, *http.Request) error) {
+		srv.Handle(pattern, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if err := h(w, r); err != nil {
+				writeErr(w, err)
+			}
+		}))
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go srv.ServeLocal(ctx, ln)
+	client := NewClient(NewLocal(sock))
+	if err := client.Call(ctx, "GET", "/v1/browser/owner", nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	out, err := exec.Command("curl", "-s", "--unix-socket", sock, "-H", "X-Berth-Origin: owner", "-H", "X-Berth-Caller: owner", "-o", "/dev/null", "-w", "%{http_code}", "http://box/v1/browser/owner").Output()
+	if err != nil || string(out) != "403" {
+		t.Fatalf("child process became owner: %s %v", out, err)
+	}
+	t.Setenv("BERTH_OWNER_PID", "")
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("BERTH_OWNER_EXE", exe)
+	b.browserAccess.mu.Lock()
+	b.browserAccess.callers = nil
+	b.browserAccess.mu.Unlock()
+	if err := client.Call(ctx, "GET", "/v1/browser/owner", nil, nil); err != nil {
+		t.Fatalf("app executable not recognised: %v", err)
+	}
+}
