+package box
+
+import (
+	"bytes"
+	"context"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/cosscom/shipyard/internal/wire"
+	"golang.org/x/net/publicsuffix"
+)
+
+type browserIdentity struct {
+	owner   bool
+	session string
+	until   time.Time
+}
+type browserIdentityKey struct{}
+type browserAccess struct {
+	mu      sync.Mutex
+	callers map[int]browserIdentity
+}
+type browserGrant struct {
+	Site    string    `json:"site"`
+	Expires time.Time `json:"expires"`
+}
+
+// Only the app process is the owner; a detached or unknown process stays restricted.
+func (b *Box) browserIdentity(r *http.Request) browserIdentity {
+	if who, ok := r.Context().Value(browserIdentityKey{}).(browserIdentity); ok {
+		return who
+	}
+	if EmbeddedFiles == "" {
+		return browserIdentity{owner: true}
+	}
+	conn := wire.LocalConn(r.Context())
+	if conn == nil {
+		return browserIdentity{}
+	}
+	pid := peerPid(conn)
+	if pid < 2 {
+		return browserIdentity{}
+	}
+	b.browserAccess.mu.Lock()
+	cached := b.browserAccess.callers[pid]
+	b.browserAccess.mu.Unlock()
+	if time.Now().Before(cached.until) {
+		return cached
+	}
+	who := browserIdentity{until: time.Now().Add(2 * time.Second)}
+	if ownerPID, _ := strconv.Atoi(os.Getenv("BERTH_OWNER_PID")); ownerPID > 1 {
+		who.owner = pid == ownerPID
+	} else if owner := os.Getenv("BERTH_OWNER_EXE"); owner != "" {
+		ctx, cancel := context.WithTimeout(r.Context(), time.Second)
+		out, err := exec.CommandContext(ctx, "ps", "-p", strconv.Itoa(pid), "-o", "comm=").Output()
+		cancel()
+		who.owner = err == nil && strings.TrimSpace(string(out)) == owner
+	}
+	if !who.owner && b.Sessions != nil {
+		if caller, err := b.llCaller(r); err == nil {
+			who.session = caller.Session
+		}
+	}
+	b.browserAccess.mu.Lock()
+	defer b.browserAccess.mu.Unlock()
+	if len(b.browserAccess.callers) > 256 {
+		b.browserAccess.callers = nil
+	}
+	if b.browserAccess.callers == nil {
+		b.browserAccess.callers = map[int]browserIdentity{}
+	}
+	b.browserAccess.callers[pid] = who
+	return who
+}
+
+func browserSite(raw string) string {
+	u, err := url.Parse(raw)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") {
+		return ""
+	}
+	host := strings.ToLower(u.Hostname())
+	if host == "localhost" || strings.HasSuffix(host, ".localhost") || host == "127.0.0.1" || host == "::1" {
+		return u.Scheme + "://" + u.Host
+	}
+	if site, err := publicsuffix.EffectiveTLDPlusOne(host); err == nil {
+		return site
+	}
+	return host
+}
+
+func (br *browser) sharedWith(session string) (browserGrant, bool) {
+	br.mu.Lock()
+	defer br.mu.Unlock()
+	grant := br.grants[session]
+	return grant, session != "" && time.Now().Before(grant.Expires) && grant.Site != "" && browserSite(br.url) == grant.Site
+}
+
+func (b *Box) browserGuard(r *http.Request) error {
+	who := b.browserIdentity(r)
+	if who.owner {
+		return nil
+	}
+	path := r.URL.Path
+	if strings.HasPrefix(path, "/v1/browser/") {
+		if r.Method == "GET" && (path == "/v1/browser/health" || path == "/v1/browser/permissions") {
+			return nil
+		}
+		return httpError{http.StatusForbidden, "Only the app can change browser permissions or settings."}
+	}
+	// Files and downloads are workspace-wide; their names do not prove which tab made them.
+	if strings.Contains(path, "/shots/") || strings.Contains(path, "/downloads") || strings.HasSuffix(path, "/profile") || strings.HasSuffix(path, "/developer/decide") || strings.HasSuffix(path, "/handoff") {
+		return httpError{http.StatusForbidden, "This browser action belongs to the person using the app."}
+	}
+	tab, err := browserTab(r)
+	if err != nil {
+		return err
+	}
+	if !userBrowserTab(tab) {
+		return nil
+	}
+	_, wt, err := b.browserTarget(r)
+	if err != nil {
+		return err
+	}
+	br := b.Browsers.Lookup(wt.Path, tab)
+	if br == nil {
+		return httpError{http.StatusForbidden, "Only the app can create personal tabs."}
+	}
+	if _, ok := br.sharedWith(who.session); !ok {
+		return httpError{http.StatusForbidden, "This personal tab is not shared with this chat on its current site. Ask the user to attach it again."}
+	}
+	action := path[strings.LastIndex(path, "/")+1:]
+	switch action {
+	case "snapshot", "act", "wait", "shot", "state", "status", "open", "navigate", "selection", "find":
+		return nil
+	}
+	return httpError{http.StatusForbidden, "Sharing a personal tab allows reading and page actions, not changing its profile, size or developer access."}
+}
+
+func (b *Box) browserSharedNavigation(r *http.Request, br *browser, target string) error {
+	if !userBrowserTab(br.tab) || b.browserIdentity(r).owner {
+		return nil
+	}
+	grant, ok := br.sharedWith(b.browserIdentity(r).session)
+	if !ok || browserSite(target) != grant.Site {
+		return httpError{http.StatusForbidden, "That address is outside the shared site. Ask the user to open it and share it again."}
+	}
+	return nil
+}
+
+func (b *Box) browserVisibleTabs(r *http.Request, path string, tabs []TabStatus) []TabStatus {
+	who := b.browserIdentity(r)
+	if who.owner {
+		return tabs
+	}
+	visible := []TabStatus{}
+	for _, tab := range tabs {
+		if !userBrowserTab(tab.Name) {
+			visible = append(visible, tab)
+			continue
+		}
+		if br := b.Browsers.Lookup(path, tab.Name); br != nil {
+			if _, ok := br.sharedWith(who.session); ok {
+				visible = append(visible, tab)
+			}
+		}
+	}
+	return visible
+}
+
+func (b *Box) browserHandoff(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Session string `json:"session"`
+		URL     string `json:"url"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	_, wt, err := b.browserTarget(r)
+	if err != nil {
+		return err
+	}
+	tab, err := browserTab(r)
+	if err != nil {
+		return err
+	}
+	br := b.Browsers.Lookup(wt.Path, tab)
+	if r.Method == "DELETE" {
+		if br != nil {
+			br.mu.Lock()
+			if req.Session == "" {
+				br.grants = nil
+			} else {
+				delete(br.grants, req.Session)
+			}
+			br.mu.Unlock()
+		}
+		writeJSON(w, map[string]bool{"ok": true})
+		return nil
+	}
+	if br == nil || !userBrowserTab(tab) {
+		return badRequest("open a personal tab before sharing it")
+	}
+	if req.Session == "" {
+		return badRequest("choose a chat to share this tab")
+	}
+	if _, err := b.Sessions.Get(r.Context(), req.Session); err != nil {
+		return err
+	}
+	br.mu.Lock()
+	defer br.mu.Unlock()
+	site := browserSite(br.url)
+	if site == "" {
+		return badRequest("open a website before sharing this tab")
+	}
+	if browserSite(req.URL) != site {
+		return httpError{http.StatusConflict, "The page moved to another site. Attach it again before sending."}
+	}
+	grant := browserGrant{Site: site, Expires: time.Now().Add(30 * time.Minute)}
+	if br.grants == nil {
+		br.grants = map[string]browserGrant{}
+	}
+	br.grants[req.Session] = grant
+	writeJSON(w, grant)
+	return nil
+}
+
+func (b *Box) beforeBrowser(r *http.Request, event string, data map[string]any) error {
+	if userBrowserTab(r.URL.Query().Get("tab")) {
+		return nil
+	}
+	return b.before(r, event, data)
+}
+
+func browserEventURL(tab, raw string) string {
+	if userBrowserTab(tab) {
+		return ""
+	}
+	return raw
+}
+
+// A page can leave the shared site during an action; withhold the resulting contents.
+type browserAnswer struct {
+	header http.Header
+	status int
+	bytes.Buffer
+}
+
+func (w *browserAnswer) Header() http.Header  { return w.header }
+func (w *browserAnswer) WriteHeader(code int) { w.status = code }
+func (b *Box) browserAnswer(w http.ResponseWriter, r *http.Request, h func(http.ResponseWriter, *http.Request) error) error {
+	if !userBrowserTab(r.URL.Query().Get("tab")) || b.browserIdentity(r).owner {
+		return h(w, r)
+	}
+	answer := &browserAnswer{header: make(http.Header), status: 200}
+	if err := h(answer, r); err != nil {
+		return err
+	}
+	if err := b.browserGuard(r); err != nil {
+		return err
+	}
+	for key, values := range answer.header {
+		w.Header()[key] = values
+	}
+	w.WriteHeader(answer.status)
+	_, err := w.Write(answer.Bytes())
+	return err
+}
