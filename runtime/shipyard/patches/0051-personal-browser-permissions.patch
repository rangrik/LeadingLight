+	if err != nil {
+		t.Fatal(err)
+	}
+	if personal.Addr() == agent.Addr() {
+		t.Fatal("listeners were shared")
+	}
+	scope, ok := b.browserScope(context.Background(), wt.Path)
+	if !ok {
+		t.Fatal("missing scope")
+	}
+	if _, ok := scope.route("example.com:443"); ok {
+		t.Fatal("agent policy opened the internet")
+	}
+	scope.personal = true
+	if route, ok := scope.route("example.com:443"); !ok || !route.public {
+		t.Fatal("personal public site refused")
+	}
+	for _, p := range []*worktreeProxy{personal, agent} {
+		client := viaProxy(t, p.Addr())
+		for _, host := range []string{"127.0.0.1:9", "10.0.0.1", "169.254.169.254", "[::1]:9"} {
+			resp, err := client.Get("http://" + host + "/")
+			if err != nil {
+				t.Fatal(err)
+			}
+			resp.Body.Close()
+			if resp.StatusCode == 200 {
+				t.Fatalf("private address allowed: %s", host)
+			}
+		}
+		resp, err := client.Get(fmt.Sprintf("http://127.0.0.1:%d/", port))
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp.Body.Close()
+		if resp.StatusCode != 200 {
+			t.Fatal("own workspace refused")
+		}
+	}
+	for _, host := range []string{"localhost:9", "127.0.0.1:9", "10.0.0.1:9", "169.254.169.254:9", "rebound.test:9"} {
+		if c, err := guardedDial(context.Background(), b.browserPolicy(), host); err == nil {
+			c.Close()
