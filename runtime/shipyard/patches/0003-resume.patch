From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeadingLight <noreply@leadinglight.app>
Date: Sat, 24 Oct 2026 04:02:57 -0700
Subject: [PATCH] Resume: a resumed agent is followed, opened and keeps its
 model

A follower that met an ended log let go without saying so, and a resume
starting moments later was never followed; it now waits briefly for a host
and is followed afresh after. Codex forgets the last process's thread when
its app server ends or starts, so a first send waits for this one's resume
instead of meeting "Not initialized". Claude carries on with the model
and effort the conversation had. Stopping a structured session waits for
its host to let go of the socket, so a resume right after starts its own.
---
 internal/box/claudedriver.go  | 13 +++++++++++--
 internal/box/codexdriver.go   | 14 +++++++++++---
 internal/box/conversations.go |  3 ++-
 internal/box/sessions.go      |  5 +++++
 4 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/internal/box/claudedriver.go b/internal/box/claudedriver.go
index 32218b7..244ed3d 100644
--- a/internal/box/claudedriver.go
+++ b/internal/box/claudedriver.go
@@ -319,9 +319,14 @@ func (c *claudeConv) follow() {
 		c.mu.Lock()
 		from, done := c.lastSeq, c.exited
 		c.mu.Unlock()
-		if done && !hostAlive(c.sock) {
+		if done && !awaitHost(c.sock, resumeGrace) {
 			// Its last word was its end, and no host has started since. (A
-			// host started again listens a moment before it says so.)
+			// host started again listens a moment before it says so; a
+			// resume starting is waited for.) It is followed afresh when
+			// next asked for.
+			c.mu.Lock()
+			c.following = false
+			c.mu.Unlock()
 			return
 		}
 		err := agenthost.Attach(context.Background(), c.sock, from, func(e agenthost.Entry) error {
@@ -357,6 +362,10 @@ func (c *claudeConv) follow() {
 // following its session (until it is asked about again).
 const hostGone = time.Minute
 
+// resumeGrace is how long an ended conversation's log is watched for a host
+// starting again (a resume) before it is let go.
+const resumeGrace = 10 * time.Second
+
 // signal wakes whoever waits on a change. Called with c.mu held.
 func (c *claudeConv) signal() {
 	close(c.changed)
diff --git a/internal/box/codexdriver.go b/internal/box/codexdriver.go
index 44eb492..94f3471 100644
--- a/internal/box/codexdriver.go
+++ b/internal/box/codexdriver.go
@@ -226,9 +226,14 @@ func (c *codexConv) follow() {
 		c.mu.Lock()
 		from, done := c.lastSeq, c.exited
 		c.mu.Unlock()
-		if done && !hostAlive(c.sock) {
+		if done && !awaitHost(c.sock, resumeGrace) {
 			// Its last word was its end, and no host has started since. (A
-			// host started again listens a moment before it says so.)
+			// host started again listens a moment before it says so; a
+			// resume starting is waited for.) It is followed afresh when
+			// next asked for.
+			c.mu.Lock()
+			c.following = false
+			c.mu.Unlock()
 			return
 		}
 		err := agenthost.Attach(context.Background(), c.sock, from, func(e agenthost.Entry) error {
@@ -316,11 +321,14 @@ func (c *codexConv) apply(e agenthost.Entry, live bool) {
 		switch e.Event {
 		case "started":
 			c.busy, c.pending, c.since, c.exited, c.initialized, c.turnID = false, nil, time.Time{}, false, false, ""
+			// A new app server knows no thread until it opens one: a send
+			// waits for that, not the last process's (handshake resumes it).
+			c.threadID = ""
 			if live {
 				say = append(say, func() { go c.handshake() })
 			}
 		case "exited":
-			c.exited, c.busy, c.pending = true, false, nil
+			c.exited, c.busy, c.pending, c.threadID = true, false, nil, ""
 			say = append(say, func() { c.event(adapters.Exited, nil, nil) })
 		}
 		return
diff --git a/internal/box/conversations.go b/internal/box/conversations.go
index b9a627a..3071615 100644
--- a/internal/box/conversations.go
+++ b/internal/box/conversations.go
@@ -256,7 +256,8 @@ func (b *Box) relaunch(ctx context.Context, location, dir, sock, sid, mode strin
 		}
 		return b.launchCodexIn(p, firstNonEmpty(mode, meta.Mode), dir, sock)
 	}
-	return b.launchClaudeIn(b.claudePreset(ctx, Session{Location: location}), "", "", mode, sid, dir, sock)
+	// It carries on with the model and effort it had, not Claude's defaults.
+	return b.launchClaudeIn(b.claudePreset(ctx, Session{Location: location}), meta.Model, meta.Effort, mode, sid, dir, sock)
 }
 
 // presetAt is an agent preset as a location has it.
diff --git a/internal/box/sessions.go b/internal/box/sessions.go
index 0d94f8c..05be49c 100644
--- a/internal/box/sessions.go
+++ b/internal/box/sessions.go
@@ -528,6 +528,11 @@ func (s *Sessions) Kill(ctx context.Context, name string) error {
 	if out, err := s.tmux(ctx, "kill-session", "-t", "="+name); err != nil {
 		return tmuxError("kill-session", out, err)
 	}
+	// A structured agent's host lets go of its socket as its agent ends; a
+	// resume on the same socket waits for that rather than meeting the old.
+	for i := 0; sess.sock != "" && i < 50 && hostAlive(sess.sock); i++ {
+		time.Sleep(100 * time.Millisecond)
+	}
 	s.removeCommand(name)
 	s.cleanup.Add(1)
 	go func() {
