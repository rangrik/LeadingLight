From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeadingLight <noreply@leadinglight.app>
Date: Sat, 24 Oct 2026 04:02:41 -0700
Subject: [PATCH] Embedded mode: own tmux server, leave the person's agent
 config alone

BERTH_TMUX_SOCKET names berthd's tmux server, so a berthd inside another
app never joins the person's own. BERTH_EMBEDDED=1 skips refreshing berth's
hooks in ~/.claude and ~/.codex and preparing agent accounts, and drops the
agent events the person's own berth hooks post from inside its agents: all
of them are structured, and their drivers say what they do.
---
 cmd/berthd/main.go       | 21 +++++++++++++++------
 internal/box/api.go      |  6 ++++++
 internal/box/sessions.go | 11 ++++++++++-
 3 files changed, 31 insertions(+), 7 deletions(-)

diff --git a/cmd/berthd/main.go b/cmd/berthd/main.go
index 949bab8..4526f73 100644
--- a/cmd/berthd/main.go
+++ b/cmd/berthd/main.go
@@ -317,6 +317,13 @@ func serve(b boxHome, args []string) error {
 	}
 	defer journal.Close()
 	bus := &events.Bus{Journal: journal}
+	// Hooks that ran while berthd was down. Embedded, its agents are all
+	// structured and say what they do themselves (api.go, emit).
+	spooled := func(e events.Event) {
+		if !box.Embedded || !strings.HasPrefix(e.Type, "agent.") {
+			bus.Publish(e)
+		}
+	}
 	// A new laptop, by the name it gave and its key; laptops' lists of who
 	// the box trusts follow it.
 	s.OnPaired = func(p trust.Peer) {
@@ -410,7 +417,9 @@ func serve(b boxHome, args []string) error {
 	bx.Sessions.MemoryHigh = bx.Guard.SessionMemoryHigh
 	// A session on an agent account without berth's hooks and skills gets
 	// them before its agent starts.
-	bx.Sessions.Prepare = bx.PrepareAccounts
+	if !box.Embedded {
+		bx.Sessions.Prepare = bx.PrepareAccounts
+	}
 	bx.Artifacts = &box.ArtifactStore{Dir: filepath.Join(b.dir, "artifacts"), Events: bus, Box: hostname}
 	go bx.Artifacts.Run(ctx)
 	go bx.RunShots(ctx)
@@ -427,10 +436,10 @@ func serve(b boxHome, args []string) error {
 	bx.Mount(s)
 	bx.ResumeTeams()
 	// Hooks that ran while berthd was down, in order, before anything new.
-	if n := integrations.DrainSpool(b.spool(), func(e events.Event) { bus.Publish(e) }); n > 0 {
+	if n := integrations.DrainSpool(b.spool(), spooled); n > 0 {
 		logger.Printf("published %d agent hooks spooled while berthd was down", n)
 	}
-	if home, err := os.UserHomeDir(); err == nil {
+	if home, err := os.UserHomeDir(); err == nil && !box.Embedded {
 		if done := integrations.RefreshHooked(home, exe); len(done) > 0 {
 			logger.Printf("updated berth's hooks for %s", strings.Join(done, ", "))
 		}
@@ -491,7 +500,7 @@ func serve(b boxHome, args []string) error {
 		return err
 	}
 	// Hooks that spooled while the socket was being made.
-	integrations.DrainSpool(b.spool(), func(e events.Event) { bus.Publish(e) })
+	integrations.DrainSpool(b.spool(), spooled)
 	go func() {
 		t := time.NewTicker(30 * time.Second)
 		defer t.Stop()
@@ -500,7 +509,7 @@ func serve(b boxHome, args []string) error {
 			case <-ctx.Done():
 				return
 			case <-t.C:
-				integrations.DrainSpool(b.spool(), func(e events.Event) { bus.Publish(e) })
+				integrations.DrainSpool(b.spool(), spooled)
 			}
 		}
 	}()
@@ -533,7 +542,7 @@ func attachLocal(args []string) error {
 	if err != nil {
 		return err
 	}
-	return syscall.Exec(tmux, []string{"tmux", "-u", "-L", "berth", "attach-session", "-t", "=" + args[0]}, os.Environ())
+	return syscall.Exec(tmux, []string{"tmux", "-u", "-L", box.TmuxSocket(), "attach-session", "-t", "=" + args[0]}, os.Environ())
 }
 
 func pair(b boxHome, args []string) error {
diff --git a/internal/box/api.go b/internal/box/api.go
index 208ab00..09f002e 100644
--- a/internal/box/api.go
+++ b/internal/box/api.go
@@ -1193,6 +1193,12 @@ func (b *Box) emit(w http.ResponseWriter, r *http.Request) error {
 	if err := b.before(r, "event.emit", map[string]any{"type": req.Type}); err != nil {
 		return err
 	}
+	if Embedded && strings.HasPrefix(req.Type, "agent.") {
+		// Every agent here is structured and its driver says what it does; the
+		// person's own berth hooks, firing inside it, would say it again.
+		writeJSON(w, map[string]bool{"ok": true})
+		return nil
+	}
 	private := map[string]any{}
 	for _, k := range []string{"title", adapters.AskKey} {
 		if v, ok := req.Data[k]; ok {
diff --git a/internal/box/sessions.go b/internal/box/sessions.go
index bd63ef0..0d94f8c 100644
--- a/internal/box/sessions.go
+++ b/internal/box/sessions.go
@@ -173,7 +173,16 @@ func (s *Sessions) EnvVar(ctx context.Context, sess Session, key string) string
 	return v
 }
 
-const tmuxSocket = "berth"
+// tmuxSocket names berth's tmux server; BERTH_TMUX_SOCKET gives an
+// embedded berthd a server of its own beside the person's.
+var tmuxSocket = firstNonEmpty(os.Getenv("BERTH_TMUX_SOCKET"), "berth")
+
+// Embedded says berthd runs inside another app (BERTH_EMBEDDED=1): it
+// leaves the person's agent configuration alone.
+var Embedded = os.Getenv("BERTH_EMBEDDED") == "1"
+
+// TmuxSocket is the name of berth's tmux server.
+func TmuxSocket() string { return tmuxSocket }
 
 // tmuxConfig is berth's own tmux server's. The status line is off because
 // the app draws its own chrome around every terminal; focus events pass
