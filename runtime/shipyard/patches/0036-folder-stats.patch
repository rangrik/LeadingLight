+// locationWorktreeList rejects a folder inside a repository, which is its own workspace.
+func locationWorktreeList(ctx context.Context, path string) ([]byte, error) {
+	out, err := worktreeList(ctx, path)
+	if _, gerr := os.Lstat(filepath.Join(path, ".git")); err == nil && gerr != nil {
+		err = gerr
+	}
+	return out, err
+}
