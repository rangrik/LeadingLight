+package box
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/cosscom/shipyard/internal/statefile"
+	"github.com/cosscom/shipyard/internal/wire"
+)
+
+// The LeadingLight bridge: a project agent's LeadingLight tools (berthd mcp leadinglight) reach
+// the app that started this berthd. A call never says who makes it: berthd finds the agent's
+// session from the process on the socket's other end. Reads wait for the app; writes are kept
+// first (leadinglight/outbox.json) and offered to the app until it says what became of them, so
+// one made while the app is quit is taken when it next asks, and one sent again is kept once.
+
+// LLCaller is the agent behind a call, as berthd knows it.
+type LLCaller struct {
+	Session      string `json:"session"`
+	Conversation string `json:"conversation,omitempty"`
+	Location     string `json:"location,omitempty"`
+	Dir          string `json:"dir,omitempty"`
+	Agent        string `json:"agent,omitempty"`
+	By           string `json:"by,omitempty"`
+	Turn         string `json:"turn,omitempty"`
+}
+
+// LLFile is a file a write names (evidence), kept by berthd as it was at the call.
+type LLFile struct {
+	Ref   string `json:"ref"`
+	Name  string `json:"name,omitempty"`
+	Size  int64  `json:"size,omitempty"`
+	SHA   string `json:"sha,omitempty"`
+	Error string `json:"error,omitempty"`
+}
+
+// LLCall is one tool call on its way to the app.
+type LLCall struct {
+	ID     string          `json:"id"`
+	Tool   string          `json:"tool"`
+	Args   json.RawMessage `json:"args,omitempty"`
+	Caller LLCaller        `json:"caller"`
+	Write  bool            `json:"write,omitempty"`
+	Sum    string          `json:"sum,omitempty"` // of its arguments, to know it again
+	Files  []LLFile        `json:"files,omitempty"`
+	At     int64           `json:"at"`
+	State  string          `json:"state"` // waiting, done, failed
+	Result json.RawMessage `json:"result,omitempty"`
+	Error  string          `json:"error,omitempty"`
+
+	claimed time.Time
+	settled chan struct{}
+}
+
+const (
+	llLease   = 30 * time.Second
+	llKeep    = 7 * 24 * time.Hour
+	llMaxFile = 50 << 20
+)
+
+// How long a call waits for the app, and who is calling: tests change them.
+var (
+	llReadWait  = 40 * time.Second
+	llWriteWait = 15 * time.Second
+	llCallerOf  = (*Box).llCaller
+)
+
+// llWrites change something in LeadingLight, so they are kept before they are answered.
+var llWrites = map[string]bool{"publish": true, "task": true, "status": true, "context": true}
+
+type llBridge struct {
+	mu     sync.Mutex
+	dir    string
+	calls  map[string]*LLCall
+	wake   chan struct{}
+	asking int
+	asked  time.Time
+}
+
+func (b *Box) leadingLight() *llBridge {
+	b.llOnce.Do(func() {
+		l := &llBridge{dir: filepath.Join(filepath.Dir(b.ConversationsDir), "leadinglight"), calls: map[string]*LLCall{}, wake: make(chan struct{})}
+		var kept []*LLCall
+		if raw, err := os.ReadFile(filepath.Join(l.dir, "outbox.json")); err == nil {
+			json.Unmarshal(raw, &kept)
+		}
+		for _, c := range kept {
+			c.settled = make(chan struct{})
+			if c.State != "waiting" {
+				close(c.settled)
+			}
+			l.calls[c.ID] = c
+		}
+		b.ll = l
+	})
+	return b.ll
+}
+
+func (b *Box) mountLeadingLight(route func(string, func(http.ResponseWriter, *http.Request) error)) {
+	if b.ConversationsDir == "" {
+		return
+	}
+	route("POST /v1/ll/call", b.llCall)
+	route("GET /v1/ll/calls", b.llCalls)
+	route("POST /v1/ll/calls/{id}", b.llAnswer)
+	route("GET /v1/ll/files/{sha}", b.llFile)
+}
+
+// save keeps the writes, dropping settled ones past a week. Called with the lock held.
+func (l *llBridge) save() {
+	out := []*LLCall{}
+	for _, c := range l.calls {
+		if !c.Write {
+			continue
+		}
+		if c.State != "waiting" && time.Since(time.UnixMilli(c.At)) > llKeep {
+			delete(l.calls, c.ID)
+			continue
+		}
+		out = append(out, c)
+	}
+	slices.SortFunc(out, func(a, b *LLCall) int { return int(a.At - b.At) })
+	raw, _ := json.MarshalIndent(out, "", "  ")
+	os.MkdirAll(l.dir, 0o700)
+	statefile.Write(filepath.Join(l.dir, "outbox.json"), raw)
+}
+
+// open says whether the app has asked for calls lately. Called with the lock held.
+func (l *llBridge) open() bool { return l.asking > 0 || time.Since(l.asked) < llLease+5*time.Second }
+
+func (l *llBridge) tell() {
+	close(l.wake)
+	l.wake = make(chan struct{})
+}
+
+// llCaller is the session whose pane runs the process on the other end of the request.
+func (b *Box) llCaller(r *http.Request) (LLCaller, error) {
+	pid := 0
+	if c := wire.LocalConn(r.Context()); c != nil {
+		pid = peerPid(c)
+	}
+	name := ""
+	if pid > 1 {
+		name = b.sessionOfPid(r.Context(), pid)
+	}
+	if name == "" {
+		return LLCaller{}, httpError{http.StatusForbidden, "LeadingLight's tools are for the agents of its projects"}
+	}
+	sess, err := b.Sessions.Get(r.Context(), name)
+	if err != nil {
+		return LLCaller{}, err
+	}
+	c := LLCaller{Session: name, Location: sess.Location, Dir: sess.Dir, Agent: sess.Agent, Turn: sess.Turn}
+	if sess.conv != "" {
+		conv, _ := readConversation(sess.conv)
+		c.Conversation, c.By = filepath.Base(sess.conv), conv.By
+	}
+	return c, nil
+}
+
+func llID() string {
+	b := make([]byte, 8)
+	rand.Read(b)
+	return hex.EncodeToString(b)
+}
+
+// POST /v1/ll/call {tool, args, key?}: an agent's tool call, answered when the app has.
+func (b *Box) llCall(w http.ResponseWriter, r *http.Request) error {
+	var body struct {
+		Tool string          `json:"tool"`
+		Args json.RawMessage `json:"args"`
+		Key  string          `json:"key"`
+	}
+	if err := decodeLimit(r, &body, 4<<20); err != nil {
+		return err
+	}
+	caller, err := llCallerOf(b, r)
+	if err != nil {
+		return err
+	}
+	l := b.leadingLight()
+	l.mu.Lock()
+	write := llWrites[body.Tool]
+	c := l.same(caller, body.Tool, body.Args, body.Key)
+	if c == nil {
+		if !write && !l.open() {
+			l.mu.Unlock()
+			return httpError{http.StatusServiceUnavailable, "LeadingLight isn't open, so its pages can't be read now. The folder's files can still be read."}
+		}
+		id := llID()
+		if body.Key != "" {
+			sum := sha256.Sum256([]byte(caller.Conversation + "\x00" + body.Tool + "\x00" + body.Key))
+			id = hex.EncodeToString(sum[:8])
+		}
+		c = &LLCall{ID: id, Tool: body.Tool, Args: body.Args, Caller: caller, Write: write, Sum: llSum(body.Args), At: time.Now().UnixMilli(), State: "waiting", settled: make(chan struct{})}
+		if write {
+			c.Files = l.keepFiles(caller, body.Tool, body.Args)
+		}
+		l.calls[c.ID] = c
+		if write {
+			l.save()
+		}
+		l.tell()
+	}
+	l.mu.Unlock()
+	wait := llReadWait
+	if write {
+		wait = llWriteWait
+	}
+	select {
+	case <-c.settled:
+	case <-time.After(wait):
+	case <-r.Context().Done():
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if r.Context().Err() != nil {
+		if !write && c.State == "waiting" {
+			delete(l.calls, c.ID)
+		}
+		return nil
+	}
+	switch {
+	case c.State == "done":
+		writeJSON(w, map[string]any{"state": "done", "result": c.Result})
+	case c.State == "failed":
+		writeJSON(w, map[string]any{"state": "failed", "error": c.Error})
+	case write:
+		writeJSON(w, map[string]any{"state": "kept", "note": "LeadingLight hasn't taken this yet (it may be closed). It is kept and will be added when LeadingLight next opens; it isn't visible until then. Don't send it again."})
+	default:
+		delete(l.calls, c.ID)
+		return httpError{http.StatusGatewayTimeout, "LeadingLight didn't answer in time; try again."}
+	}
+	return nil
+}
+
+// same is a call this one repeats: one with the same key, or the conversation's last call of
+// the tool with the same arguments in the last ten minutes. Called with the lock held.
+func (l *llBridge) same(caller LLCaller, tool string, args json.RawMessage, key string) *LLCall {
+	if key != "" {
+		sum := sha256.Sum256([]byte(caller.Conversation + "\x00" + tool + "\x00" + key))
+		return l.calls[hex.EncodeToString(sum[:8])]
+	}
+	var last *LLCall
+	for _, c := range l.calls {
+		if c.Write && c.Tool == tool && c.Caller.Conversation == caller.Conversation && caller.Conversation != "" && (last == nil || c.At > last.At) {
+			last = c
+		}
+	}
+	if last != nil && time.Since(time.UnixMilli(last.At)) < 10*time.Minute && last.Sum == llSum(args) {
+		return last
+	}
+	return nil
+}
+
+func llSum(args json.RawMessage) string {
+	var flat bytes.Buffer
+	json.Compact(&flat, args)
+	sum := sha256.Sum256(flat.Bytes())
+	return hex.EncodeToString(sum[:8])
+}
+
+var llSHA = regexp.MustCompile(`^[0-9a-f]{64}$`)
+
+// keepFiles copies the files a publication's evidence names, so they stay as they were whatever
+// happens to the folder. Only the agent's own folder and conversation are read.
+func (l *llBridge) keepFiles(caller LLCaller, tool string, args json.RawMessage) []LLFile {
+	if tool != "publish" {
+		return nil
+	}
+	var a struct {
+		Evidence []struct {
+			Path   string `json:"path"`
+			Output string `json:"output"`
+		} `json:"evidence"`
+	}
+	json.Unmarshal(args, &a)
+	conv := ""
+	if caller.Conversation != "" {
+		conv = filepath.Join(filepath.Dir(l.dir), "conversations", caller.Conversation)
+	}
+	out := []LLFile{}
+	for _, e := range a.Evidence {
+		f := LLFile{Ref: e.Path}
+		path := ""
+		switch {
+		case e.Output != "":
+			f.Ref = "output:" + e.Output
+			if !outputID.MatchString(e.Output) || conv == "" {
+				f.Error = "no kept output by that id"
+				break
+			}
+			path = filepath.Join(conv, "outputs", e.Output)
+			for _, o := range readOutputs(conv) {
+				if o.ID == e.Output {
+					f.Name = filepath.Base(o.Path)
+				}
+			}
+		case e.Path != "":
+			path = e.Path
+			if !filepath.IsAbs(path) {
+				path = filepath.Join(caller.Dir, path)
+			}
+			real, err := filepath.EvalSymlinks(filepath.Clean(path))
+			if err != nil {
+				f.Error = "no such file"
+				break
+			}
+			inside := false
+			for _, root := range []string{caller.Dir, conv} {
+				if rr, err := filepath.EvalSymlinks(root); err == nil && root != "" && (real == rr || strings.HasPrefix(real, rr+string(filepath.Separator))) {
+					inside = true
+				}
+			}
+			if !inside {
+				f.Error = "it is outside the project's folder"
+				break
+			}
+			path, f.Name = real, filepath.Base(real)
+		default:
+			f.Error = "give a path or an output"
+		}
+		if f.Error == "" {
+			f.Size, f.SHA, f.Error = l.keepFile(path)
+		}
+		out = append(out, f)
+	}
+	return out
+}
+
+func (l *llBridge) keepFile(path string) (int64, string, string) {
+	src, err := os.Open(path)
+	if err != nil {
+		return 0, "", "it can't be read"
+	}
+	defer src.Close()
+	if st, err := src.Stat(); err != nil || st.IsDir() {
+		return 0, "", "it is a folder, not a file"
+	} else if st.Size() > llMaxFile {
+		return 0, "", "it is larger than 50 MB"
+	}
+	data, err := io.ReadAll(io.LimitReader(src, llMaxFile+1))
+	if err != nil || len(data) > llMaxFile {
+		return 0, "", "it can't be read"
+	}
+	sum := sha256.Sum256(data)
+	sha := hex.EncodeToString(sum[:])
+	os.MkdirAll(filepath.Join(l.dir, "files"), 0o700)
+	if err := statefile.Write(filepath.Join(l.dir, "files", sha), data); err != nil {
+		return 0, "", "it couldn't be kept"
+	}
+	return int64(len(data)), sha, ""
+}
+
+// GET /v1/ll/calls?wait=N: the calls the app hasn't answered, waiting up to N seconds for one.
+func (b *Box) llCalls(w http.ResponseWriter, r *http.Request) error {
+	if !wire.IsLocal(r.Context()) {
+		return httpError{http.StatusForbidden, "only the app on this Mac takes LeadingLight's calls"}
+	}
+	wait := 0 * time.Second
+	if d, err := time.ParseDuration(r.URL.Query().Get("wait") + "s"); err == nil {
+		wait = min(d, 30*time.Second)
+	}
+	writeJSON(w, b.leadingLight().take(r.Context(), wait))
+	return nil
+}
+
+// take offers each waiting call once, and again if it isn't answered within the lease.
+func (l *llBridge) take(ctx context.Context, wait time.Duration) []LLCall {
+	deadline := time.Now().Add(wait)
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.asking++
+	defer func() { l.asking--; l.asked = time.Now() }()
+	for {
+		out := []LLCall{}
+		for _, c := range l.calls {
+			if c.State == "waiting" && time.Since(c.claimed) > llLease {
+				c.claimed = time.Now()
+				out = append(out, *c)
+			}
+		}
+		if len(out) > 0 || !time.Now().Before(deadline) || ctx.Err() != nil {
+			slices.SortFunc(out, func(a, b LLCall) int { return int(a.At - b.At) })
+			return out
+		}
+		wake := l.wake
+		l.mu.Unlock()
+		select {
+		case <-wake:
+		case <-time.After(time.Until(deadline)):
+		case <-ctx.Done():
+		}
+		l.mu.Lock()
+	}
+}
+
+// POST /v1/ll/calls/{id} {result?, error?}: what the app made of a call.
+func (b *Box) llAnswer(w http.ResponseWriter, r *http.Request) error {
+	if !wire.IsLocal(r.Context()) {
+		return httpError{http.StatusForbidden, "only the app on this Mac answers LeadingLight's calls"}
+	}
+	var body struct {
+		Result json.RawMessage `json:"result"`
+		Error  string          `json:"error"`
+	}
+	if err := decodeLimit(r, &body, 4<<20); err != nil {
+		return err
+	}
+	c, ok := b.leadingLight().settle(r.PathValue("id"), body.Result, body.Error)
+	if !ok {
+		return httpError{http.StatusNotFound, "no such call"}
+	}
+	writeJSON(w, c)
+	return nil
+}
+
+// settle keeps the app's answer once; a later one for the same call changes nothing.
+func (l *llBridge) settle(id string, result json.RawMessage, failure string) (LLCall, bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	c := l.calls[id]
+	if c == nil {
+		return LLCall{}, false
+	}
+	if c.State == "waiting" {
+		c.State, c.Result, c.Error = "done", result, failure
+		if failure != "" {
+			c.State = "failed"
+		}
+		close(c.settled)
+		if c.Write {
+			l.save()
+		} else {
+			// A read is answered once; its waiter has what it needs.
+			time.AfterFunc(time.Second, func() { l.mu.Lock(); delete(l.calls, id); l.mu.Unlock() })
+		}
+	}
+	return *c, true
+}
+
+// GET /v1/ll/files/{sha}: a kept file's bytes.
+func (b *Box) llFile(w http.ResponseWriter, r *http.Request) error {
+	if !wire.IsLocal(r.Context()) {
+		return httpError{http.StatusForbidden, "only the app on this Mac reads kept files"}
+	}
+	sha := r.PathValue("sha")
+	if !llSHA.MatchString(sha) {
+		return httpError{http.StatusNotFound, "no such file"}
+	}
+	data, err := os.ReadFile(filepath.Join(b.leadingLight().dir, "files", sha))
+	if err != nil {
+		return httpError{http.StatusNotFound, "no such file"}
+	}
+	w.Header().Set("Content-Type", "application/octet-stream")
+	w.Write(data)
+	return nil
+}
+
+// llServer is the MCP server's line for an agent's configuration: this berthd, on this socket.
+func (b *Box) llServer() (exe, sock string, ok bool) {
+	if !Embedded || b.ConversationsDir == "" {
+		return "", "", false
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		return "", "", false
+	}
+	return exe, filepath.Join(filepath.Dir(b.ConversationsDir), "berthd.sock"), true
+}
+
+// llClaudeFlags give Claude Code LeadingLight's tools, allowed without asking: they only read
+// the project's pages and add to them.
+func (b *Box) llClaudeFlags() []string {
+	exe, sock, ok := b.llServer()
+	if !ok {
+		return nil
+	}
+	cfg, _ := json.Marshal(map[string]any{"mcpServers": map[string]any{"leadinglight": map[string]any{"type": "stdio", "command": exe, "args": []string{"mcp", "leadinglight", "--socket", sock}}}})
+	return []string{"--mcp-config", string(cfg), "--allowedTools", "mcp__leadinglight"}
+}
+
+// llCodexFlags are the same for Codex's app server, as config overrides; its tools approved, as
+// Claude's are.
+func (b *Box) llCodexFlags() []string {
+	exe, sock, ok := b.llServer()
+	if !ok {
+		return nil
+	}
+	cmd, _ := json.Marshal(exe)
+	args, _ := json.Marshal([]string{"mcp", "leadinglight", "--socket", sock})
+	return []string{"-c", "mcp_servers.leadinglight.command=" + string(cmd), "-c", "mcp_servers.leadinglight.args=" + string(args),
+		"-c", `mcp_servers.leadinglight.default_tools_approval_mode="approve"`}
+}
diff --git a/internal/box/leadinglight_test.go b/internal/box/leadinglight_test.go
new file mode 100644
index 0000000..9b9292a
--- /dev/null
+++ b/internal/box/leadinglight_test.go
@@ -0,0 +1,54 @@
+package box
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// The seam: an agent's write reaches LeadingLight once, even when the app is closed when it is
+// made, berthd restarts before the app opens, or the agent sends it twice.
+func TestLeadingLightWritesAreKeptUntilTheAppTakesThem(t *testing.T) {
+	llWriteWait, llReadWait = 50*time.Millisecond, 50*time.Millisecond
+	llCallerOf = func(*Box, *http.Request) (LLCaller, error) { return LLCaller{Session: "s", Conversation: "c1"}, nil }
+	dir := filepath.Join(t.TempDir(), "conversations")
+	call := func(b *Box, h func(http.ResponseWriter, *http.Request) error, method, path, body string) map[string]any {
+		r := httptest.NewRequest(method, path, strings.NewReader(body))
+		w := httptest.NewRecorder()
+		if err := h(w, r); err != nil {
+			return map[string]any{"error": err.Error()}
+		}
+		var out any
+		json.Unmarshal(w.Body.Bytes(), &out)
+		if m, ok := out.(map[string]any); ok {
+			return m
+		}
+		return map[string]any{"list": out}
+	}
+	b := &Box{ConversationsDir: dir}
+	if got := call(b, b.llCall, "POST", "/v1/ll/call", `{"tool":"read","args":{"page":"x"}}`); !strings.Contains(got["error"].(string), "isn't open") {
+		t.Fatalf("a read with no app = %v", got)
+	}
+	publish := `{"tool":"publish","args":{"title":"T","markdown":"M"}}`
+	if got := call(b, b.llCall, "POST", "/v1/ll/call", publish); got["state"] != "kept" {
+		t.Fatalf("a write with no app = %v", got)
+	}
+	call(b, b.llCall, "POST", "/v1/ll/call", publish)
+	// berthd starts again: the write is still there, once, for the app.
+	b = &Box{ConversationsDir: dir}
+	calls := b.leadingLight().take(t.Context(), 0)
+	if len(calls) != 1 {
+		t.Fatalf("offered %d calls, want the one write", len(calls))
+	}
+	b.leadingLight().settle(calls[0].ID, json.RawMessage(`{"report":"r1"}`), "")
+	if got := call(b, b.llCall, "POST", "/v1/ll/call", publish); got["state"] != "done" || got["result"].(map[string]any)["report"] != "r1" {
+		t.Fatalf("the same write again = %v, want the first's result", got)
+	}
+	if left := b.leadingLight().take(t.Context(), 0); len(left) != 0 {
+		t.Fatalf("%d calls still offered after the answer", len(left))
+	}
+}
