+package mcpserver
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+
+	"github.com/cosscom/shipyard/internal/box"
+)
+
+// LeadingLight's tools (`berthd mcp leadinglight`), for the agents of an embedded berthd's
+// projects. Each one is passed to the app through berthd (POST /v1/ll/call), which says who is
+// calling; nothing here names the caller.
+
+func arr(item map[string]any, desc string) map[string]any {
+	return map[string]any{"type": "array", "items": item, "description": desc}
+}
+
+var source = obj(map[string]any{"page": str("page id or ll: link"), "quote": str("the exact words it rests on, as the page has them")}, "page")
+
+// LLTools are LeadingLight's tools.
+var LLTools = []Tool{
+	{Name: "project", Description: "Start here. What you are working on in LeadingLight: your project, your task and its brief, who you are, and any feedback waiting for your answer.", InputSchema: obj(map[string]any{}), call: llTool("project")},
+	{Name: "read", Description: "Read a page in your project: its properties, its text as Markdown (a part at a time; pass cursor for the next part), the pages it links to and those linking to it, its reports and attachments. Pages outside the project are refused, and the person's private notes are never shown.", InputSchema: obj(map[string]any{"page": str("page id or ll: link"), "cursor": str("from the last part, for the next")}, "page"), call: llTool("read")},
+	{Name: "search", Description: "Find pages in your project by words in their title or text.", InputSchema: obj(map[string]any{"query": str("words to look for"), "cursor": str("from the last answer, for more")}, "query"), call: llTool("search")},
+	{Name: "attachment", Description: "Copy an attachment of a page (a file, image, video or audio on it) to a file you can open. Returns its path.", InputSchema: obj(map[string]any{"page": str("page id"), "attachment": str("the attachment's id, from read")}, "page", "attachment"), call: llTool("attachment")},
+	{Name: "publish", Description: "Publish a report the person reads in LeadingLight: new, signed prose beside a page (your task by default). It never changes anything written before; to correct a report, publish another. Markdown; evidence copies files from your folder (path) or your kept outputs (output) into LeadingLight as they are now, shown in the report (images, videos, documents). sources are what it rests on. To answer a feedback batch give batch and one answer for every point: {point, markdown}, or {point, unanswered: why}. ready: true when the work is ready for the person to review. key makes a retry publish once.", InputSchema: obj(map[string]any{
+		"title":    str("a short title"),
+		"markdown": str("the report"),
+		"to":       str("page id it is about, if not your task"),
+		"sources":  arr(source, "pages and words it rests on"),
+		"evidence": arr(obj(map[string]any{"path": str("a file in your folder"), "output": str("a kept output's id"), "caption": str("what it shows"), "at": num("for a video: the second that matters")}), "files that show the work"),
+		"batch":    str("the feedback batch this answers"),
+		"answers":  arr(obj(map[string]any{"point": str("the point's id"), "markdown": str("your answer"), "unanswered": str("why it isn't answered")}, "point"), "one per point of the batch"),
+		"ready":    map[string]any{"type": "boolean", "description": "the work is ready for the person's review"},
+		"key":      str("a key of your own: the same key publishes once"),
+	}, "title", "markdown"), call: llTool("publish")},
+	{Name: "task", Description: "Your subtasks of the task you were given: create one (title, brief), or mark one you created done or not done (id). Only the person marks your main task done.", InputSchema: obj(map[string]any{"action": str("create, done or undo"), "id": str("the subtask, for done and undo"), "title": str("for create"), "brief": str("for create: what it is, Markdown")}, "action"), call: llTool("task")},
+	{Name: "status", Description: "Say what you are doing now, and the concrete steps of your work as a checklist, shown live on your task. Each call replaces the last; keep it short.", InputSchema: obj(map[string]any{"activity": str("what you are doing now, one line"), "checklist": arr(obj(map[string]any{"text": str("a step"), "done": map[string]any{"type": "boolean"}}, "text"), "the steps, in order")}), call: llTool("status")},
+	{Name: "context", Description: "Before you ask the person something with your question tool, say what it is about, so LeadingLight shows it beside your question: the exact question, and the pages (with the words), report evidence or video moment it concerns.", InputSchema: obj(map[string]any{"question": str("the question, exactly as you will ask it"), "about": arr(obj(map[string]any{"page": str("page id"), "quote": str("the words it is about"), "evidence": str("an evidence id from a report"), "at": num("for a video: the second")}), "what it is about")}, "question", "about"), call: llTool("context")},
+}
+
+// llTool passes the call to the app through berthd, with a key the agent may give.
+func llTool(name string) func(ctx context.Context, s *Server, a map[string]any) (any, error) {
+	return func(ctx context.Context, s *Server, a map[string]any) (any, error) {
+		var out struct {
+			State  string          `json:"state"`
+			Result json.RawMessage `json:"result"`
+			Error  string          `json:"error"`
+			Note   string          `json:"note"`
+		}
+		err := s.Box.Call(ctx, http.MethodPost, "/v1/ll/call", map[string]any{"tool": name, "args": a, "key": arg(a, "key")}, &out)
+		switch {
+		case err != nil:
+			return nil, err
+		case out.State == "failed":
+			return nil, errors.New(out.Error)
+		case out.State == "kept":
+			return map[string]string{"kept": out.Note}, nil
+		}
+		return out.Result, nil
+	}
+}
+
+// ServeLeadingLight is the stdio loop with LeadingLight's tools.
+func ServeLeadingLight(ctx context.Context, socket string, in io.Reader, out io.Writer) error {
+	c := box.NewClient(box.NewLocal(socket))
+	c.Origin = "mcp"
+	srv := &Server{Box: c, tools: LLTools, info: "LeadingLight, where the person reads your work: read the project's pages, publish reports with evidence, keep your task's checklist and subtasks, and give context to your questions. Start with project."}
+	return srv.Serve(ctx, in, out)
+}
