new file mode 100644
index 0000000..24b472d
--- /dev/null
+++ b/internal/box/peerpid_darwin.go
@@ -0,0 +1,24 @@
+package box
+
+import (
+	"net"
+	"syscall"
+)
+
+// peerPid is the process on the other end of a Unix socket connection, or 0.
+func peerPid(c net.Conn) int {
+	u, ok := c.(*net.UnixConn)
+	if !ok {
+		return 0
+	}
+	raw, err := u.SyscallConn()
+	if err != nil {
+		return 0
+	}
+	pid := 0
+	raw.Control(func(fd uintptr) {
+		// SOL_LOCAL (0), LOCAL_PEERPID (2): the kernel's word, not the caller's.
+		pid, _ = syscall.GetsockoptInt(int(fd), 0, 2)
+	})
+	return pid
+}
