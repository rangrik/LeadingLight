+		}
+		w, h := pngSize(raw)
+		if w != 100 || h != 40 || out.URL != site || !annotationShotName.MatchString(out.Screenshot.Name) {
+			t.Fatalf("wrong crop %dx%d %+v", w, h, out)
+		}
+		highDPR := v
+		highDPR.Scale = 2
+		if err := br.resize(ctx, highDPR); err != nil {
+			t.Fatal(err)
+		}
+		var retina struct {
+			Screenshot struct {
+				File string `json:"file"`
+			} `json:"screenshot"`
+		}
+		if err := request(b.browserInspectArea, body, &retina); err != nil {
+			t.Fatal(err)
+		}
+		highRaw, err := os.ReadFile(retina.Screenshot.File)
+		if err != nil {
+			t.Fatal(err)
+		}
+		hw, hh := pngSize(highRaw)
+		if hw != 200 || hh != 80 {
+			t.Fatalf("retina crop %dx%d", hw, hh)
+		}
+		if err := br.resize(ctx, v); err != nil {
+			t.Fatal(err)
+		}
+		pruneShots(filepath.Dir(out.Screenshot.File), 0)
+		if _, err = os.Stat(out.Screenshot.File); err != nil {
+			t.Fatal("transient GC removed annotation", err)
+		}
+		body["expectedURL"] = site + "changed"
+		if err := request(b.browserInspectArea, body, nil); err == nil {
+			t.Fatal("stale URL captured")
+		}
+		body["expectedURL"] = site
+		body["viewport"] = map[string]int{"width": v.Width - 1, "height": v.Height}
+		if err := request(b.browserInspectArea, body, nil); err == nil {
+			t.Fatal("stale viewport captured")
+		}
+		body["viewport"] = map[string]int{"width": v.Width, "height": v.Height}
+		body["x"] = -1
+		if err := request(b.browserInspectArea, body, nil); err == nil {
+			t.Fatal("negative crop accepted")
+		}
+	})
+	t.Run("element capture validates the selected document and its geometry", func(t *testing.T) {
+		a := lease()
+		eval(`document.querySelector('#first').style.left='10px'`)
+		first := inspect(30, 30, a)
+		v := br.currentViewport()
+		body := map[string]any{"handle": first.Handle, "lease": a, "viewport": map[string]int{"width": v.Width, "height": v.Height}, "expectedURL": site}
+		var out struct {
+			Element    browserInspection `json:"element"`
+			Screenshot struct {
+				File string `json:"file"`
+			} `json:"screenshot"`
+		}
+		if err := request(b.browserInspectArea, body, &out); err != nil {
+			t.Fatal(err)
+		}
+		raw, err := os.ReadFile(out.Screenshot.File)
+		if err != nil {
+			t.Fatal(err)
+		}
+		w, h := pngSize(raw)
+		if out.Element.Text != "First" || w != 100 || h != 40 {
+			t.Fatal("wrong element evidence", out, w, h)
+		}
+		br.cdp.mu.Lock()
+		original := br.cdp.w
+		br.cdp.w = &annotationCaptureMutation{WriteCloser: original, session: br.session, expression: `document.querySelector('#first').style.left='120px'`}
+		br.cdp.mu.Unlock()
+		err = request(b.browserInspectArea, body, nil)
+		br.cdp.mu.Lock()
+		br.cdp.w = original
+		br.cdp.mu.Unlock()
+		if err == nil {
+			t.Fatal("attached old geometry after layout shift")
+		}
+		eval(`document.querySelector('#first').style.left='10px'`)
+		br.cdp.mu.Lock()
+		br.cdp.w = &annotationCaptureMutation{WriteCloser: original, session: br.session, expression: `document.querySelector('#first').replaceWith(document.querySelector('#first').cloneNode(true))`}
+		br.cdp.mu.Unlock()
+		err = request(b.browserInspectArea, body, nil)
+		br.cdp.mu.Lock()
+		br.cdp.w = original
+		br.cdp.mu.Unlock()
+		if err == nil {
+			t.Fatal("attached a replacement node with old metadata")
+		}
+		body["handle"] = inspect(30, 30, a).Handle
+		if _, err := br.Open(ctx, site); err != nil {
+			t.Fatal(err)
+		}
+		if err := request(b.browserInspectArea, body, nil); err == nil {
+			t.Fatal("old handle survived a same-URL reload")
+		}
+	})
+}
+
+// Change the real page exactly before the screenshot command reaches Chromium.
+type annotationCaptureMutation struct {
+	io.WriteCloser
+	session, expression string
+}
+
+func (w *annotationCaptureMutation) Write(raw []byte) (int, error) {
+	if w.expression != "" && bytes.Contains(raw, []byte(`"method":"Page.captureScreenshot"`)) {
+		command, _ := json.Marshal(map[string]any{"id": 0, "sessionId": w.session, "method": "Runtime.evaluate", "params": map[string]any{"expression": w.expression}})
+		w.expression = ""
+		if _, err := w.WriteCloser.Write(append(command, 0)); err != nil {
+			return 0, err
+		}
+	}
+	return w.WriteCloser.Write(raw)
+}
