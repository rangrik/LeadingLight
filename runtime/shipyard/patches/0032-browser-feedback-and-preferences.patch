diff --git a/internal/box/browserinspectarea.go b/internal/box/browserinspectarea.go
new file mode 100644
index 0000000..9469bbe
--- /dev/null
+++ b/internal/box/browserinspectarea.go
@@ -0,0 +1,186 @@
+package box
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/hex"
+	"image"
+	"image/png"
+	"math"
+	"net/http"
+	"os"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"sort"
+	"time"
+)
+
+var annotationShotName = regexp.MustCompile(`^annotation-[a-f0-9]{32}\.png$`)
+
+func (b *Box) browserInspectArea(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		browserBounds
+		Viewport struct {
+			Width  int `json:"width"`
+			Height int `json:"height"`
+		} `json:"viewport"`
+		ExpectedURL string `json:"expectedURL"`
+		Handle      string `json:"handle"`
+		Lease       string `json:"lease"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	for _, v := range []float64{req.X, req.Y, req.Width, req.Height} {
+		if math.IsNaN(v) || math.IsInf(v, 0) {
+			return badRequest("choose an area inside the page")
+		}
+	}
+	if req.Handle == "" && (req.X < 0 || req.Y < 0 || req.Width < 1 || req.Height < 1 || req.X+req.Width > float64(req.Viewport.Width) || req.Y+req.Height > float64(req.Viewport.Height)) {
+		return badRequest("choose an area inside the page")
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	br.inspectMu.Lock()
+	defer br.inspectMu.Unlock()
+	br.castMu.Lock()
+	defer br.castMu.Unlock()
+	br.zoomMu.Lock()
+	defer br.zoomMu.Unlock()
+	br.mu.Lock()
+	epoch, url, viewport, closed := br.controls.inspectEpoch, br.url, br.viewport, br.controls.closed
+	br.mu.Unlock()
+	changed := func() error {
+		return httpError{http.StatusConflict, "The page or viewport changed. Select the area again."}
+	}
+	if closed || req.ExpectedURL == "" || req.ExpectedURL != url || req.Viewport.Width != viewport.Width || req.Viewport.Height != viewport.Height {
+		return changed()
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+	defer cancel()
+	var element *browserInspection
+	var node *browserInspectedNode
+	if req.Handle != "" {
+		br.mu.Lock()
+		node = br.controls.inspected[req.Handle]
+		valid := node != nil && node.epoch == epoch && br.validInspectionLease(node, req.Lease)
+		br.mu.Unlock()
+		if !valid {
+			return staleInspection()
+		}
+		selected, _, inspectErr := br.inspectNode(ctx, node.node, "", "", nil, browserInspectOptions{frame: node.frame, loader: node.loader, reveal: true})
+		if inspectErr != nil {
+			return inspectErr
+		}
+		element = &selected
+		x, y := math.Max(0, selected.Bounds.X), math.Max(0, selected.Bounds.Y)
+		right, bottom := math.Min(float64(viewport.Width), selected.Bounds.X+selected.Bounds.Width), math.Min(float64(viewport.Height), selected.Bounds.Y+selected.Bounds.Height)
+		if right <= x || bottom <= y {
+			return badRequest("The selected element is outside the page. Inspect it again.")
+		}
+		req.browserBounds = browserBounds{X: x, Y: y, Width: right - x, Height: bottom - y}
+	}
+	var shot struct {
+		Data string `json:"data"`
+	}
+	if err = br.cdp.call(ctx, br.session, "Page.captureScreenshot", map[string]any{"format": "png", "captureBeyondViewport": false, "fromSurface": true}, &shot); err != nil {
+		return err
+	}
+	capturedAt := time.Now().UTC().Format(time.RFC3339Nano)
+	if element != nil {
+		after, _, inspectErr := br.inspectNode(ctx, node.node, "", "", nil, browserInspectOptions{frame: node.frame, loader: node.loader})
+		if inspectErr != nil {
+			return inspectErr
+		}
+		if !reflect.DeepEqual(*element, after) {
+			return httpError{http.StatusConflict, "The element changed during capture. Inspect it again."}
+		}
+	}
+	br.mu.Lock()
+	same := epoch == br.controls.inspectEpoch && url == br.url && viewport == br.viewport && !br.controls.closed
+	if node != nil {
+		same = same && br.validInspectionLease(node, req.Lease)
+	}
+	br.mu.Unlock()
+	if !same {
+		return changed()
+	}
+	if len(shot.Data) > 48<<20 {
+		return badRequest("this screenshot is too large")
+	}
+	raw, err := base64.StdEncoding.DecodeString(shot.Data)
+	if err != nil {
+		return err
+	}
+	iw, ih := pngSize(raw)
+	if iw < 1 || ih < 1 || iw > maxViewportW*int(maxViewportScale) || ih > maxViewportH*int(maxViewportScale) {
+		return badRequest("invalid screenshot dimensions")
+	}
+	picture, err := png.Decode(bytes.NewReader(raw))
+	if err != nil {
+		return err
+	}
+	sx, sy := float64(iw)/float64(viewport.Width), float64(ih)/float64(viewport.Height)
+	crop := image.Rect(int(math.Floor(req.X*sx)), int(math.Floor(req.Y*sy)), int(math.Ceil((req.X+req.Width)*sx)), int(math.Ceil((req.Y+req.Height)*sy))).Intersect(picture.Bounds())
+	clipped := picture.(interface {
+		SubImage(image.Rectangle) image.Image
+	}).SubImage(crop)
+	var encoded bytes.Buffer
+	if err = png.Encode(&encoded, clipped); err != nil {
+		return err
+	}
+	if encoded.Len() > 20<<20 {
+		return httpError{http.StatusRequestEntityTooLarge, "This annotation exceeds 20 MiB. Select a smaller area."}
+	}
+	var random [16]byte
+	if _, err = rand.Read(random[:]); err != nil {
+		return err
+	}
+	name := "annotation-" + hex.EncodeToString(random[:]) + ".png"
+	dir := br.m.shotDir(br.location, br.worktree)
+	if err = os.MkdirAll(dir, 0o700); err != nil {
+		return err
+	}
+	file := filepath.Join(dir, name)
+	if err = os.WriteFile(file, encoded.Bytes(), 0o600); err != nil {
+		return err
+	}
+	pruneAnnotationShots(dir)
+	writeJSON(w, map[string]any{"url": url, "bounds": req.browserBounds, "viewport": map[string]int{"width": viewport.Width, "height": viewport.Height}, "screenshot": map[string]string{"file": file, "name": name, "mime": "image/png"}, "capturedAt": capturedAt, "element": element})
+	return nil
+}
+
+// Saved comments outlive transient screenshots, with a separate bounded disk budget.
+func pruneAnnotationShots(dir string) {
+	names, _ := filepath.Glob(filepath.Join(dir, "annotation-*.png"))
+	type entry struct {
+		path string
+		size int64
+		at   time.Time
+	}
+	files := []entry{}
+	var total int64
+	for _, name := range names {
+		if !annotationShotName.MatchString(filepath.Base(name)) {
+			continue
+		}
+		if info, err := os.Lstat(name); err == nil && info.Mode().IsRegular() {
+			files = append(files, entry{name, info.Size(), info.ModTime()})
+			total += info.Size()
+		}
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].at.Before(files[j].at) })
+	for len(files) > 200 || total > 128<<20 {
+		if len(files) == 0 {
+			break
+		}
+		total -= files[0].size
+		os.Remove(files[0].path)
+		files = files[1:]
+	}
+}
