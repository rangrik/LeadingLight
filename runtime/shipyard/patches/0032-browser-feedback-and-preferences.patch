+			return browserCall(ctx, c, loc, wt, tab, "POST", "developer/request", map[string]string{"reason": rest[0]}, out)
+		case "developer-status":
+			if len(rest) != 0 {
+				return usageErr("browser developer-status [LOC/WT] [--tab NAME]")
+			}
+			return browserCall(ctx, c, loc, wt, tab, "GET", "developer", nil, out)
+		case "developer-events":
+			if len(rest) != 0 || *after < 0 {
+				return usageErr("browser developer-events [LOC/WT] [--after N] [--tab NAME]")
+			}
+			return browserCall(ctx, c, loc, wt, tab, "GET", "developer/events?after="+strconv.FormatInt(*after, 10), nil, out)
+		default:
+			if len(rest) < 1 || len(rest) > 2 {
+				return usageErr("browser cdp [LOC/WT] METHOD [JSON_PARAMS] [--tab NAME]")
+			}
+			params := map[string]any{}
+			if len(rest) == 2 && json.Unmarshal([]byte(rest[1]), &params) != nil {
+				return errors.New("CDP params must be a JSON object")
+			}
+			return browserCall(ctx, c, loc, wt, tab, "POST", "developer/cdp", map[string]any{"method": rest[0], "params": params}, out)
+		}
 	case "allow":
 		fs, _ := flags(args)
 		pos, err := parse(fs, args)
