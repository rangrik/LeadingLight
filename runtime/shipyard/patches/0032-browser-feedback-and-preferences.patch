+		}
+		if err := request(b.browserReleaseInspectionLease, map[string]string{"lease": c}, nil); err != nil {
+			t.Fatal(err)
+		}
+		if eval(`document.querySelector('#second').style.color`) != `"red"` {
+			t.Fatal("release left preview")
