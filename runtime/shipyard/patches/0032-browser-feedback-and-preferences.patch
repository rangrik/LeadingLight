+// Frame identity and viewer ownership keep a comment from changing another document or viewer's preview.
+func TestBrowserAnnotationsWithRealChromium(t *testing.T) {
+	if testing.Short() {
+		t.Skip("starts Chromium")
+	}
+	chrome, err := FindChromium()
+	if err != nil {
+		t.Skip(err)
+	}
+	wrapper := filepath.Join(t.TempDir(), "chromium")
+	if err = os.WriteFile(wrapper, []byte("#!/bin/sh\nexec '"+strings.ReplaceAll(chrome, "'", "'\\''")+"' --site-per-process \"$@\"\n"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("BERTH_CHROMIUM", wrapper)
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = before })
+	var port int
+	b, wt, p := browserBox(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("content-type", "text/html; charset=utf-8")
+		switch r.URL.Path {
+		case "/frame":
+			fmt.Fprint(w, `<body style="margin:0"><button id="child" style="position:absolute;left:20px;top:30px;width:100px;height:40px;color:red" onclick="window.clicked=true">Child</button><iframe style="position:absolute;left:25px;top:80px;width:150px;height:100px;border:5px solid" src="http://billing.cal.devbox.localhost:1377/nested"></iframe>`)
+		case "/nested":
+			fmt.Fprint(w, `<body style="margin:0"><button id="nested" style="position:absolute;left:7px;top:9px;width:80px;height:30px;color:red" onclick="window.clicked=true">Nested</button>`)
+		case "/replacement":
+			fmt.Fprint(w, `<button id="child" style="color:purple">Replacement</button>`)
+		default:
+			fmt.Fprintf(w, `<title>Annotations</title><body style="margin:0;height:2000px"><button id="first" style="position:absolute;left:10px;top:10px;width:100px;height:40px;color:red">First</button><button id="second" style="position:absolute;left:10px;top:60px;width:100px;height:30px;color:red">Second</button><iframe id="outer" style="position:absolute;left:200px;top:100px;width:300px;height:200px;border:10px solid;transform:scale(1.25);transform-origin:0 0" src="http://localhost:%d/frame"></iframe>`, port)
+		}
+	})
+	port = p
+	m := b.NewBrowsers(t.TempDir(), 1)
+	defer m.CloseAll("test")
+	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Second)
+	defer cancel()
+	loc, _ := b.Locations.Get(ctx, "cal")
+	br, err := m.get(ctx, loc, wt, "user-annotations")
+	if err != nil {
+		t.Fatal(err)
+	}
+	site := "http://billing.cal.devbox.localhost:1377/"
+	if _, err = br.Open(ctx, site); err != nil {
+		t.Fatal(err)
+	}
+	request := func(fn func(http.ResponseWriter, *http.Request) error, body any, out any) error {
+		raw, _ := json.Marshal(body)
+		r := httptest.NewRequest("POST", "http://box/?tab=user-annotations", bytes.NewReader(raw))
+		r.SetPathValue("loc", "cal")
+		r.SetPathValue("wt", "billing")
+		rec := httptest.NewRecorder()
+		if err := fn(rec, r); err != nil {
+			return err
+		}
+		if out != nil {
+			return json.Unmarshal(rec.Body.Bytes(), out)
+		}
+		return nil
+	}
+	eval := func(js string) string {
+		t.Helper()
+		v, err := br.evaluate(ctx, js)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return string(v)
+	}
+	inspect := func(x, y float64, lease string) browserInspection {
+		t.Helper()
+		var out browserInspection
+		if err := request(b.browserInspect, map[string]any{"x": x, "y": y, "lease": lease}, &out); err != nil {
+			t.Fatal(err)
+		}
+		return out
+	}
+	change := func(handle, lease, color string) error {
+		return request(b.browserStyle, map[string]string{"handle": handle, "lease": lease, "property": "color", "value": color}, nil)
+	}
+	lease := func() string {
+		t.Helper()
+		var out struct {
+			Lease string `json:"lease"`
+		}
+		if err := request(b.browserInspectLease, map[string]string{}, &out); err != nil {
+			t.Fatal(err)
+		}
+		return out.Lease
+	}
+	wait := func(name string, test func() bool) {
+		t.Helper()
+		until := time.Now().Add(4 * time.Second)
+		for time.Now().Before(until) {
+			if test() {
+				return
+			}
+			time.Sleep(15 * time.Millisecond)
+		}
+		t.Fatal(name)
+	}
+
+	t.Run("hover is read only", func(t *testing.T) {
+		for range 4 {
+			var out browserInspection
+			if err := request(b.browserInspectHover, map[string]float64{"x": 30, "y": 30}, &out); err != nil || out.Handle != "" || out.Text != "First" {
+				t.Fatal(out, err)
+			}
+		}
+		br.mu.Lock()
+		count := len(br.controls.inspected)
+		br.mu.Unlock()
+		if count != 0 {
+			t.Fatal("hover created handles", count)
+		}
+	})
+	t.Run("nested cross-origin frames", func(t *testing.T) {
+		child := inspect(250, 165, "")
+		if child.Text != "Child" || child.Bounds.X != 237.5 || child.Bounds.Y != 150 || child.Bounds.Width != 125 || child.Frame == nil || len(child.Frame.Path) != 2 || child.URL != site {
+			t.Fatalf("child %+v", child)
+		}
+		nested := inspect(270, 240, "")
+		if nested.Text != "Nested" || nested.Bounds.X != 258.75 || nested.Bounds.Y != 230 || nested.Bounds.Width != 100 || nested.Frame == nil || len(nested.Frame.Path) != 3 {
+			t.Fatalf("nested %+v", nested)
+		}
+		eval(`document.querySelector('#outer').style.width='300.5px';true`)
+		fractional := inspect(270, 240, "")
+		if fractional.Handle != nested.Handle || fractional.Bounds.X != 258.75 || fractional.Bounds.Width != 100 {
+			t.Fatalf("fractional frame drift %+v", fractional)
+		}
+		eval(`document.querySelector('#outer').style.width='300px';true`)
+		if err := change(nested.Handle, "", "blue"); err != nil {
+			t.Fatal(err)
+		}
+		var reset browserInspection
+		if err := request(b.browserStyleReset, map[string]string{"handle": nested.Handle}, &reset); err != nil || reset.Styles["color"] != "rgb(255, 0, 0)" {
+			t.Fatal(reset, err)
+		}
+		eval(`window.scrollTo(0,50);true`)
+		scrolled := inspect(270, 190, "")
+		if scrolled.Handle != nested.Handle || scrolled.Bounds.Y != 180 {
+			t.Fatalf("scroll %+v", scrolled)
+		}
+		if err := br.applyControlZoom(ctx, 1.5); err != nil {
+			t.Fatal(err)
+		}
+		zoomed := inspect(405, 285, "")
+		if zoomed.Handle != nested.Handle || zoomed.Bounds.X != 388.125 || zoomed.Bounds.Y != 270 {
+			t.Fatalf("zoom %+v", zoomed)
+		}
+		br.applyControlZoom(ctx, 1)
+		eval(`window.scrollTo(0,0);document.querySelector('#outer').style.top='1500px';true`)
+		var revealed browserInspection
+		if err := request(b.browserInspectReveal, map[string]string{"handle": nested.Handle}, &revealed); err != nil {
+			t.Fatal(err)
+		}
+		if revealed.Bounds.Y < 0 || revealed.Bounds.Y+revealed.Bounds.Height > float64(br.currentViewport().Height) {
+			t.Fatalf("frame reveal clipped %+v", revealed)
+		}
+		eval(`document.querySelector('#outer').style.transform='rotate(20deg)';true`)
+		if err := change(nested.Handle, "", "green"); err == nil {
+			t.Fatal("rotated frame accepted")
+		}
+		eval(`document.querySelector('#outer').style.transform='scale(1.25)';document.querySelector('#outer').style.top='100px';window.scrollTo(0,0);true`)
+		eval(fmt.Sprintf(`document.querySelector('#outer').src='http://localhost:%d/replacement';true`, port))
+		wait("frame did not navigate", func() bool {
+			frames, _ := br.inspectionFrames(ctx)
+			for _, f := range frames {
+				if strings.HasSuffix(f.URL, "/replacement") {
+					return true
+				}
+			}
+			return false
+		})
+		if err := change(child.Handle, "", "green"); err == nil {
+			t.Fatal("old frame changed replacement")
+		}
+		fresh := inspect(235, 130, "")
+		if fresh.Handle == child.Handle || fresh.Text != "Replacement" || fresh.Styles["color"] != "rgb(128, 0, 128)" {
+			t.Fatal(fresh)
+		}
+	})
+	t.Run("leases expire independently", func(t *testing.T) {
+		a, c := lease(), lease()
+		first, second := inspect(30, 30, a), inspect(30, 70, c)
+		if err := change(first.Handle, a, "blue"); err != nil {
+			t.Fatal(err)
+		}
+		if err := change(second.Handle, c, "green"); err != nil {
+			t.Fatal(err)
+		}
+		if err := change(first.Handle, c, "black"); err == nil {
+			t.Fatal("another lease used handle")
