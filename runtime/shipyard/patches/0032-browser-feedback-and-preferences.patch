new file mode 100644
index 0000000..5f4eba9
--- /dev/null
+++ b/internal/box/browserdeveloper.go
@@ -0,0 +1,521 @@
+package box
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/cosscom/shipyard/internal/statefile"
+)
+
+const developerLifetime = 15 * time.Minute
+const developerResultLimit = 1 << 20
+
+type browserDeveloper struct {
+	mu                                 sync.Mutex
+	run                                sync.Mutex
+	id, origin, reason, state, session string
+	context                            string
+	epoch                              uint64
+	expires                            time.Time
+	events                             []browserDeveloperEvent
+	sequence                           int64
+	bytes                              int
+	dropped                            int
+	requests                           map[string]bool
+	requestOrder                       []string
+	timer                              *time.Timer
+}
+
+type browserDeveloperEvent struct {
+	Sequence  int64           `json:"sequence"`
+	Method    string          `json:"method"`
+	Params    json.RawMessage `json:"params"`
+	Truncated bool            `json:"truncated,omitempty"`
+}
+
+type browserDeveloperStatus struct {
+	Enabled bool      `json:"enabled"`
+	State   string    `json:"state"`
+	ID      string    `json:"id,omitempty"`
+	Origin  string    `json:"origin,omitempty"`
+	Reason  string    `json:"reason,omitempty"`
+	Expires time.Time `json:"expires,omitempty"`
+	Text    string    `json:"text"`
+}
+
+func (m *Browsers) developerEnabled() bool {
+	var setting struct {
+		Enabled bool `json:"enabled"`
+	}
+	raw, err := os.ReadFile(filepath.Join(m.Dir, "developer.json"))
+	return err == nil && json.Unmarshal(raw, &setting) == nil && setting.Enabled
+}
+
+func developerOrigin(raw string) string {
+	u, err := url.Parse(raw)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" || u.User != nil {
+		return ""
+	}
+	return u.Scheme + "://" + u.Host
+}
+
+func (br *browser) developerPage() (string, uint64, bool) {
+	br.mu.Lock()
+	defer br.mu.Unlock()
+	return developerOrigin(br.url), br.controls.inspectEpoch, br.controls.closed
+}
+
+func (br *browser) developerStatus() browserDeveloperStatus {
+	origin, epoch, closed := br.developerPage()
+	enabled := br.m.developerEnabled()
+	d := &br.developer
+	d.mu.Lock()
+	stale := !enabled || closed || (d.id != "" && (epoch != d.epoch || origin != d.origin || time.Now().After(d.expires)))
+	d.mu.Unlock()
+	if stale {
+		br.developerRevoke("")
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	state := d.state
+	if state == "" {
+		state = "none"
+	}
+	if !enabled {
+		state = "disabled"
+	}
+	out := browserDeveloperStatus{Enabled: enabled, State: state, ID: d.id, Origin: origin, Reason: d.reason, Expires: d.expires}
+	switch state {
+	case "disabled":
+		out.Text = "Developer access is off. Enable it in Browser settings, then request this page."
+	case "pending":
+		out.Text = "Developer access needs your approval in Browser → Developer tools for " + origin + "."
+	case "allowed":
+		out.Text = "Developer access approved for this page until navigation, revocation or " + d.expires.Format(time.RFC3339) + "."
+	case "denied":
+		out.Text = "Developer access was denied for this request."
+	default:
+		out.Text = "Request developer access with a reason before using page-scoped CDP."
+	}
+	return out
+}
+
+// Detaching the private session also stops its profiler and releases its remote object handles.
+func (br *browser) developerRevoke(id string) {
+	d := &br.developer
+	d.mu.Lock()
+	if id != "" && d.id != id {
+		d.mu.Unlock()
+		return
+	}
+	session := d.session
+	if d.timer != nil {
+		d.timer.Stop()
+	}
+	d.id, d.origin, d.reason, d.state, d.session, d.context = "", "", "", "", "", ""
+	d.expires, d.events, d.requests, d.requestOrder, d.timer = time.Time{}, nil, nil, nil, nil
+	d.bytes, d.dropped = 0, 0
+	d.mu.Unlock()
+	if session != "" {
+		br.cdp.listenSession(session, nil)
+		go func() {
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			br.cdp.call(ctx, session, "Profiler.stop", nil, nil)
+			br.cdp.call(ctx, "", "Target.detachFromTarget", map[string]string{"sessionId": session}, nil)
+		}()
+	}
+}
+
+func (br *browser) developerEvent(id, method string, raw json.RawMessage) {
+	if method == "Inspector.detached" || method == "Page.navigatedWithinDocument" {
+		br.developerRevoke(id)
+		return
+	}
+	if method == "Page.frameNavigated" {
+		var e struct {
+			Frame struct {
+				Parent string `json:"parentId"`
+			} `json:"frame"`
+		}
+		if json.Unmarshal(raw, &e) == nil && e.Frame.Parent == "" {
+			br.developerRevoke(id)
+			return
+		}
+	}
+	d := &br.developer
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.id != id || d.state != "allowed" {
+		return
+	}
+	if method == "Runtime.executionContextCreated" {
+		var e struct {
+			Context struct {
+				UniqueID string `json:"uniqueId"`
+				Aux      struct {
+					Default bool   `json:"isDefault"`
+					Frame   string `json:"frameId"`
+				} `json:"auxData"`
+			} `json:"context"`
+		}
+		if json.Unmarshal(raw, &e) == nil && e.Context.Aux.Default && e.Context.Aux.Frame == br.target {
+			d.context = e.Context.UniqueID
+		}
+	}
+	if method == "Network.requestWillBeSent" {
+		var e struct {
+			ID string `json:"requestId"`
+		}
+		if json.Unmarshal(raw, &e) == nil && e.ID != "" && !d.requests[e.ID] {
+			d.requests[e.ID] = true
+			d.requestOrder = append(d.requestOrder, e.ID)
+			if len(d.requestOrder) > 512 {
+				delete(d.requests, d.requestOrder[0])
+				d.requestOrder = d.requestOrder[1:]
+			}
+		}
+	}
+	if !strings.HasPrefix(method, "Network.") && !strings.HasPrefix(method, "Runtime.") && !strings.HasPrefix(method, "Log.") && !strings.HasPrefix(method, "Profiler.") {
+		return
+	}
+	d.sequence++
+	e := browserDeveloperEvent{Sequence: d.sequence, Method: method, Params: append(json.RawMessage(nil), raw...)}
+	if len(raw) > 32<<10 {
+		e.Params = json.RawMessage(`{"notice":"Event exceeds 32 KiB; inspect the individual resource."}`)
+		e.Truncated = true
+	}
+	d.events = append(d.events, e)
+	d.bytes += len(e.Params)
+	for len(d.events) > 256 || d.bytes > developerResultLimit {
+		d.bytes -= len(d.events[0].Params)
+		d.events = d.events[1:]
+		d.dropped++
+	}
+}
+
+func (b *Box) getBrowserDeveloper(w http.ResponseWriter, r *http.Request) error {
+	if b.Browsers == nil {
+		return badRequest("No browser runtime is available.")
+	}
+	writeJSON(w, map[string]bool{"enabled": b.Browsers.developerEnabled()})
+	return nil
+}
+
+func (b *Box) putBrowserDeveloper(w http.ResponseWriter, r *http.Request) error {
+	if b.Browsers == nil {
+		return badRequest("No browser runtime is available.")
+	}
+	var req struct {
+		Enabled bool `json:"enabled"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	if err := b.before(r, "browser.developer.settings", map[string]any{"enabled": req.Enabled}); err != nil {
+		return err
+	}
+	raw, _ := json.Marshal(req)
+	if err := statefile.Write(filepath.Join(b.Browsers.Dir, "developer.json"), raw); err != nil {
+		return err
+	}
+	if !req.Enabled {
+		b.Browsers.mu.Lock()
+		all := make([]*chromium, 0, len(b.Browsers.open))
+		for _, c := range b.Browsers.open {
+			all = append(all, c)
+		}
+		b.Browsers.mu.Unlock()
+		for _, c := range all {
+			for _, br := range c.list() {
+				br.developerRevoke("")
+			}
+		}
+	}
+	b.publish(r, "browser.developer.changed", map[string]any{"enabled": req.Enabled})
+	writeJSON(w, req)
+	return nil
+}
+
+func (b *Box) browserDeveloperStatus(w http.ResponseWriter, r *http.Request) error {
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	writeJSON(w, br.developerStatus())
+	return nil
+}
+
+func (b *Box) browserDeveloperRequest(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Reason string `json:"reason"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	req.Reason = strings.TrimSpace(req.Reason)
+	if req.Reason == "" || len(req.Reason) > 1000 {
+		return badRequest("Describe the developer task in 1–1000 bytes.")
+	}
+	br, loc, wt, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	s := br.developerStatus()
+	if !s.Enabled {
+		return httpError{http.StatusForbidden, s.Text}
+	}
+	origin, epoch, closed := br.developerPage()
+	if closed || origin == "" {
+		return badRequest("Open an HTTP or HTTPS page first.")
+	}
+	if err := b.before(r, "browser.developer.request", map[string]any{"location": loc.Name, "name": wt.Name, "tab": br.tab, "origin": origin, "reason": req.Reason}); err != nil {
+		return err
+	}
+	d := &br.developer
+	d.mu.Lock()
+	if d.state == "allowed" || d.state == "pending" {
+		d.mu.Unlock()
+		writeJSON(w, br.developerStatus())
+		return nil
+	}
+	var token [16]byte
+	if _, err := rand.Read(token[:]); err != nil {
+		d.mu.Unlock()
+		return err
+	}
+	if d.timer != nil {
+		d.timer.Stop()
+	}
+	d.id, d.origin, d.reason, d.state, d.epoch = hex.EncodeToString(token[:]), origin, req.Reason, "pending", epoch
+	d.expires = time.Now().Add(developerLifetime)
+	id := d.id
+	d.timer = time.AfterFunc(developerLifetime, func() { br.developerRevoke(id) })
+	d.mu.Unlock()
+	b.publish(r, "browser.developer.requested", map[string]any{"location": loc.Name, "name": wt.Name, "tab": br.tab, "origin": origin})
+	writeJSON(w, br.developerStatus())
+	return nil
+}
+
+func (b *Box) browserDeveloperDecide(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		ID    string `json:"id"`
+		Allow bool   `json:"allow"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	br, loc, wt, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	d := &br.developer
+	d.run.Lock()
+	defer d.run.Unlock()
+	s := br.developerStatus()
+	if !s.Enabled || s.State != "pending" || s.ID != req.ID || req.ID == "" {
+		return httpError{http.StatusConflict, "This developer request expired. Request the current page again."}
+	}
+	if err := b.before(r, "browser.developer.approve", map[string]any{"location": loc.Name, "name": wt.Name, "tab": br.tab, "origin": s.Origin, "allow": req.Allow}); err != nil {
+		return err
+	}
+	if !req.Allow {
+		d.mu.Lock()
+		d.state = "denied"
+		d.mu.Unlock()
+		writeJSON(w, br.developerStatus())
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)
+	defer cancel()
+	var attached struct {
+		Session string `json:"sessionId"`
+	}
+	if err := br.cdp.call(ctx, "", "Target.attachToTarget", map[string]any{"targetId": br.target, "flatten": true}, &attached); err != nil {
+		return err
+	}
+	d.mu.Lock()
+	if d.id != req.ID || d.state != "pending" {
+		d.mu.Unlock()
+		br.cdp.call(ctx, "", "Target.detachFromTarget", map[string]string{"sessionId": attached.Session}, nil)
+		return httpError{http.StatusConflict, "The page changed before approval."}
+	}
+	d.state, d.session, d.requests = "allowed", attached.Session, map[string]bool{}
+	d.mu.Unlock()
+	br.cdp.listenSession(attached.Session, func(method string, raw json.RawMessage) { br.developerEvent(req.ID, method, raw) })
+	for _, method := range []string{"Page.enable", "Runtime.enable", "DOM.enable", "CSS.enable", "Log.enable", "Profiler.enable", "Performance.enable"} {
+		if err := br.cdp.call(ctx, attached.Session, method, nil, nil); err != nil {
+			br.developerRevoke(req.ID)
+			return err
+		}
+	}
+	if err := br.cdp.call(ctx, attached.Session, "Network.enable", map[string]int{"maxTotalBufferSize": 4 << 20, "maxResourceBufferSize": developerResultLimit}, nil); err != nil {
+		br.developerRevoke(req.ID)
+		return err
+	}
+	writeJSON(w, br.developerStatus())
+	return nil
+}
+
+func (b *Box) browserDeveloperRevoke(w http.ResponseWriter, r *http.Request) error {
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	br.developerRevoke("")
+	writeJSON(w, br.developerStatus())
+	return nil
+}
+
+// Only page inspection methods cross this boundary; profile, process and local-file methods never do.
+func developerMethod(method string, params map[string]any) bool {
+	for _, key := range []string{"sessionId", "targetId", "browserContextId", "files"} {
+		if _, ok := params[key]; ok {
+			return false
+		}
+	}
+	domain, name, ok := strings.Cut(method, ".")
+	if !ok {
+		return false
+	}
+	switch domain {
+	case "DOM":
+		return strings.HasPrefix(name, "get") && name != "getFileInfo" || strings.HasPrefix(name, "querySelector") || name == "describeNode" || name == "resolveNode" || name == "requestNode" || name == "requestChildNodes" || name == "collectClassNamesFromSubtree" || name == "performSearch" || name == "discardSearchResults"
+	case "CSS":
+		return strings.HasPrefix(name, "get") || name == "collectClassNames" || name == "setStyleTexts" || name == "setEffectivePropertyValueForNode" || name == "setStyleSheetText" || name == "addRule" || name == "createStyleSheet"
+	case "Runtime":
+		return name == "evaluate" || name == "callFunctionOn" || name == "getProperties" || name == "releaseObject" || name == "releaseObjectGroup" || name == "getHeapUsage"
+	case "Accessibility":
+		return name == "getFullAXTree" || name == "getPartialAXTree" || name == "getRootAXNode" || name == "getChildAXNodes" || name == "queryAXTree"
+	case "DOMSnapshot":
+		return name == "captureSnapshot"
+	case "Profiler":
+		return name == "start" || name == "stop" || name == "getBestEffortCoverage" || name == "startPreciseCoverage" || name == "stopPreciseCoverage" || name == "takePreciseCoverage"
+	case "Performance":
+		return name == "getMetrics"
+	case "Network":
+		return name == "getResponseBody" || name == "getRequestPostData" || name == "searchInResponseBody"
+	case "Page":
+		return name == "getLayoutMetrics" || name == "getFrameTree"
+	default:
+		return false
+	}
+}
+
+func (b *Box) browserDeveloperCall(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Method string         `json:"method"`
+		Params map[string]any `json:"params"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	if !developerMethod(req.Method, req.Params) {
+		return httpError{http.StatusForbidden, "This method is outside page-scoped developer access."}
+	}
+	br, loc, wt, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	d := &br.developer
+	d.run.Lock()
+	defer d.run.Unlock()
+	s := br.developerStatus()
+	if s.State != "allowed" {
+		return httpError{http.StatusForbidden, s.Text}
+	}
+	d.mu.Lock()
+	session, id, executionContext := d.session, d.id, d.context
+	requestID, _ := req.Params["requestId"].(string)
+	known := d.requests[requestID]
+	d.mu.Unlock()
+	if strings.HasPrefix(req.Method, "Network.") && !known {
+		return httpError{http.StatusForbidden, "That request was not captured by this page's current developer approval."}
+	}
+	if err := b.before(r, "browser.developer.cdp", map[string]any{"location": loc.Name, "name": wt.Name, "tab": br.tab, "origin": s.Origin, "method": req.Method}); err != nil {
+		return err
+	}
+	if req.Params == nil {
+		req.Params = map[string]any{}
+	}
+	if req.Method == "Runtime.evaluate" {
+		if executionContext == "" {
+			return httpError{http.StatusConflict, "The page's execution context is not ready. Try again."}
+		}
+		delete(req.Params, "contextId")
+		req.Params["uniqueContextId"] = executionContext
+		req.Params["timeout"] = 5000
+	}
+	if req.Method == "Runtime.callFunctionOn" {
+		if object, ok := req.Params["objectId"].(string); !ok || object == "" {
+			return badRequest("callFunctionOn requires an objectId from this page's developer session.")
+		}
+		delete(req.Params, "executionContextId")
+		delete(req.Params, "uniqueContextId")
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)
+	defer cancel()
+	var result json.RawMessage
+	if err := br.cdp.call(ctx, session, req.Method, req.Params, &result); err != nil {
+		return err
+	}
+	if now := br.developerStatus(); now.State != "allowed" || now.ID != id {
+		return httpError{http.StatusConflict, "Developer access changed while the command ran; its result was discarded."}
+	}
+	if len(result) > developerResultLimit {
+		return httpError{http.StatusRequestEntityTooLarge, "Developer result exceeds 1 MiB. Narrow the query or capture a shorter profile."}
+	}
+	if len(result) == 0 {
+		result = json.RawMessage(`{}`)
+	}
+	writeJSON(w, map[string]any{"result": result, "text": string(result)})
+	return nil
+}
+
+func (b *Box) browserDeveloperEvents(w http.ResponseWriter, r *http.Request) error {
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	if s := br.developerStatus(); s.State != "allowed" {
+		return httpError{http.StatusForbidden, s.Text}
+	}
+	after, _ := strconv.ParseInt(r.URL.Query().Get("after"), 10, 64)
+	d := &br.developer
+	d.mu.Lock()
+	all := make([]browserDeveloperEvent, 0, len(d.events))
+	for _, e := range d.events {
+		if e.Sequence > after {
+			all = append(all, e)
+		}
+	}
+	sequence, dropped := d.sequence, d.dropped
+	d.mu.Unlock()
+	result := map[string]any{"events": all, "sequence": sequence, "dropped": dropped}
+	raw, _ := json.Marshal(result)
+	result["text"] = string(raw)
+	writeJSON(w, result)
+	return nil
+}
+
+func (b *Box) mountBrowserDeveloper(route func(string, func(http.ResponseWriter, *http.Request) error)) {
+	route("GET /v1/browser/developer", b.getBrowserDeveloper)
+	route("PUT /v1/browser/developer", b.putBrowserDeveloper)
+	p := "/v1/worktrees/{loc}/{wt}/browser/developer"
+	route("GET "+p, b.browserDeveloperStatus)
+	route("POST "+p+"/request", b.browserDeveloperRequest)
+	route("POST "+p+"/decide", b.browserDeveloperDecide)
+	route("DELETE "+p, b.browserDeveloperRevoke)
+	route("POST "+p+"/cdp", b.browserDeveloperCall)
+	route("GET "+p+"/events", b.browserDeveloperEvents)
+}
diff --git a/internal/box/browserdeveloper_test.go b/internal/box/browserdeveloper_test.go
new file mode 100644
index 0000000..5eb14ae
--- /dev/null
+++ b/internal/box/browserdeveloper_test.go
@@ -0,0 +1,237 @@
+package box
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+// Developer methods must not turn a page approval into profile or filesystem access.
+func TestBrowserDeveloperMethodBoundary(t *testing.T) {
+	for _, method := range []string{"DOM.getDocument", "CSS.getComputedStyleForNode", "Runtime.evaluate", "Profiler.start", "Profiler.stop", "Performance.getMetrics", "Network.getResponseBody"} {
+		if !developerMethod(method, nil) {
+			t.Fatalf("refused %s", method)
+		}
+	}
+	for _, method := range []string{"Browser.close", "Target.attachToTarget", "Storage.getCookies", "Network.getAllCookies", "Network.getCookies", "Network.loadNetworkResource", "Security.setIgnoreCertificateErrors", "Fetch.continueResponse", "IO.read", "DOM.setFileInputFiles", "DOM.getFileInfo", "Page.setDownloadBehavior", "Debugger.pause"} {
+		if developerMethod(method, nil) {
+			t.Fatalf("accepted %s", method)
+		}
+	}
+	for _, key := range []string{"sessionId", "targetId", "browserContextId", "files"} {
+		if developerMethod("DOM.getDocument", map[string]any{key: "other"}) {
+			t.Fatalf("accepted %s", key)
+		}
+	}
+}
+
+// An unbounded console or response stream must not retain unlimited page data.
+func TestBrowserDeveloperEventBounds(t *testing.T) {
+	br := &browser{developer: browserDeveloper{id: "grant", state: "allowed", requests: map[string]bool{}}}
+	br.developerEvent("old-grant", "Runtime.consoleAPICalled", json.RawMessage(`{}`))
+	if len(br.developer.events) != 0 {
+		t.Fatal("accepted a stale session event")
+	}
+	for i := 0; i < 300; i++ {
+		br.developerEvent("grant", "Runtime.consoleAPICalled", json.RawMessage(`{"value":"`+strings.Repeat("x", 32<<10)+`"}`))
+	}
+	d := &br.developer
+	if len(d.events) != 256 || d.dropped != 44 || d.bytes > developerResultLimit || !d.events[0].Truncated {
+		t.Fatalf("unbounded event retention: count=%d dropped=%d bytes=%d", len(d.events), d.dropped, d.bytes)
+	}
+	for i := 0; i < 520; i++ {
+		br.developerEvent("grant", "Network.requestWillBeSent", json.RawMessage(fmt.Sprintf(`{"requestId":"request-%d"}`, i)))
+	}
+	if len(d.requests) != 512 || d.requests["request-0"] || !d.requests["request-519"] {
+		t.Fatal("captured request ownership was not bounded")
+	}
+}
+
+// Approval, page identity and event ownership are checked against a real CDP session.
+func TestBrowserDeveloperWithRealChromium(t *testing.T) {
+	if testing.Short() {
+		t.Skip("starts Chromium")
+	}
+	if _, err := FindChromium(); err != nil {
+		t.Skip(err)
+	}
+	b, wt, _ := browserBox(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/data" {
+			fmt.Fprint(w, "developer response")
+			return
+		}
+		fmt.Fprint(w, `<title>Developer fixture</title><style>button{color:rgb(12,34,56)}</style><button id="target">Inspect me</button>`)
+	})
+	m := b.NewBrowsers(t.TempDir(), 1)
+	defer m.CloseAll("test")
+	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Second)
+	defer cancel()
+	loc, _ := b.Locations.Get(ctx, "cal")
+	br, err := m.get(ctx, loc, wt, "user-developer")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := br.Open(ctx, "http://billing.cal.devbox.localhost:1377/one"); err != nil {
+		t.Fatal(err)
+	}
+	call := func(fn func(http.ResponseWriter, *http.Request) error, body any) (map[string]any, error) {
+		raw, _ := json.Marshal(body)
+		r := httptest.NewRequest("POST", "http://box/?tab=user-developer", bytes.NewReader(raw)).WithContext(ctx)
+		r.SetPathValue("loc", "cal")
+		r.SetPathValue("wt", "billing")
+		rec := httptest.NewRecorder()
+		err := fn(rec, r)
+		var result map[string]any
+		if err == nil {
+			err = json.Unmarshal(rec.Body.Bytes(), &result)
+		}
+		return result, err
+	}
+	must := func(fn func(http.ResponseWriter, *http.Request) error, body any) map[string]any {
+		t.Helper()
+		v, err := call(fn, body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return v
+	}
+	cdp := func(method string, params any) map[string]any {
+		t.Helper()
+		v := must(b.browserDeveloperCall, map[string]any{"method": method, "params": params})
+		return v["result"].(map[string]any)
+	}
+	request := func() string {
+		t.Helper()
+		v := must(b.browserDeveloperRequest, map[string]string{"reason": "Inspect the fixture"})
+		return v["id"].(string)
+	}
+	approve := func() {
+		t.Helper()
+		id := request()
+		v := must(b.browserDeveloperDecide, map[string]any{"id": id, "allow": true})
+		if v["state"] != "allowed" {
+			t.Fatal(v)
+		}
+	}
+	if _, err := call(b.browserDeveloperRequest, map[string]string{"reason": "Inspect"}); err == nil {
+		t.Fatal("request allowed while setting off")
+	}
+	must(b.putBrowserDeveloper, map[string]bool{"enabled": true})
+	id := request()
+	if _, err := call(b.browserDeveloperCall, map[string]any{"method": "DOM.getDocument"}); err == nil {
+		t.Fatal("CDP ran before approval")
+	}
+	if v := must(b.browserDeveloperDecide, map[string]any{"id": id, "allow": false}); v["state"] != "denied" {
+		t.Fatal(v)
+	}
+	approve()
+	doc := cdp("DOM.getDocument", map[string]any{"depth": 1})["root"].(map[string]any)
+	node := cdp("DOM.querySelector", map[string]any{"nodeId": doc["nodeId"], "selector": "#target"})["nodeId"]
+	styles := cdp("CSS.getComputedStyleForNode", map[string]any{"nodeId": node})
+	if !strings.Contains(fmt.Sprint(styles), "rgb(12, 34, 56)") {
+		t.Fatal(styles)
+	}
+	cdp("Profiler.start", nil)
+	cdp("Runtime.evaluate", map[string]any{"expression": "(()=>{let t=performance.now();while(performance.now()-t<30){};return document.title})()", "returnByValue": true})
+	profile := cdp("Profiler.stop", nil)["profile"].(map[string]any)
+	if len(profile["nodes"].([]any)) == 0 {
+		t.Fatal("empty CPU profile")
+	}
+	if len(cdp("Performance.getMetrics", nil)["metrics"].([]any)) == 0 {
+		t.Fatal("empty performance metrics")
+	}
+	cdp("Runtime.evaluate", map[string]any{"expression": "fetch('/data').then(r=>r.text())", "awaitPromise": true, "returnByValue": true})
+	var requestID string
+	for i := 0; i < 30 && requestID == ""; i++ {
+		v := must(b.browserDeveloperEvents, nil)
+		for _, raw := range v["events"].([]any) {
+			e := raw.(map[string]any)
+			if e["method"] == "Network.responseReceived" {
+				p := e["params"].(map[string]any)
+				if strings.HasSuffix(p["response"].(map[string]any)["url"].(string), "/data") {
+					requestID = p["requestId"].(string)
+				}
+			}
+		}
+		if requestID == "" {
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	if requestID == "" {
+		t.Fatal("missing captured request")
+	}
+	if got := cdp("Network.getResponseBody", map[string]string{"requestId": requestID})["body"]; got != "developer response" {
+		t.Fatal(got)
+	}
+	if _, err := call(b.browserDeveloperCall, map[string]any{"method": "Network.getResponseBody", "params": map[string]string{"requestId": "another-tab"}}); err == nil {
+		t.Fatal("read another request")
+	}
+	first := must(b.browserDeveloperEvents, nil)
+	second := must(b.browserDeveloperEvents, nil)
+	if len(first["events"].([]any)) == 0 || len(second["events"].([]any)) < len(first["events"].([]any)) {
+		t.Fatal("event read consumed history")
+	}
+	other, err := m.get(ctx, loc, wt, "user-other")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if other.developerStatus().State == "allowed" {
+		t.Fatal("approval leaked to another tab")
+	}
+	if _, err := call(b.browserDeveloperCall, map[string]any{"method": "Runtime.evaluate", "params": map[string]any{"expression": "'x'.repeat(1048576)", "returnByValue": true}}); err == nil {
+		t.Fatal("oversized result accepted")
+	}
+	if _, err := br.Open(ctx, "http://billing.cal.devbox.localhost:1377/two"); err != nil {
+		t.Fatal(err)
+	}
+	if s := br.developerStatus(); s.State == "allowed" || s.ID != "" {
+		t.Fatal("navigation retained approval", s)
+	}
+	if _, err := call(b.browserDeveloperDecide, map[string]any{"id": id, "allow": true}); err == nil {
+		t.Fatal("old approval accepted")
+	}
+	approve()
+	cdp("Profiler.start", nil)
+	must(b.putBrowserDeveloper, map[string]bool{"enabled": false})
+	if s := br.developerStatus(); s.State != "disabled" || s.ID != "" {
+		t.Fatal(s)
+	}
+	br.cdp.mu.Lock()
+	remaining := len(br.cdp.listeners)
+	br.cdp.mu.Unlock()
+	if remaining != 0 {
+		t.Fatal("revocation retained session listener", remaining)
+	}
+	if _, err := br.evaluate(ctx, "document.title"); err != nil {
+		t.Fatal("revocation disrupted ordinary browser", err)
+	}
+	must(b.putBrowserDeveloper, map[string]bool{"enabled": true})
+	approve()
+	br.developer.mu.Lock()
+	br.developer.expires = time.Now().Add(-time.Second)
+	br.developer.mu.Unlock()
+	if s := br.developerStatus(); s.State == "allowed" {
+		t.Fatal("expired approval remained active")
+	}
+	approve()
+	br.chromium.closeTab(br, "developer close test")
+	br.developer.mu.Lock()
+	session := br.developer.session
+	br.developer.mu.Unlock()
+	if session != "" {
+		t.Fatal("close retained developer session")
+	}
+	br.cdp.mu.Lock()
+	remaining = len(br.cdp.listeners)
+	br.cdp.mu.Unlock()
+	if remaining != 0 {
+		t.Fatal("close retained developer event listener")
+	}
+
+}
diff --git a/internal/box/browserdownloads.go b/internal/box/browserdownloads.go
new file mode 100644
index 0000000..8da7d55
--- /dev/null
+++ b/internal/box/browserdownloads.go
@@ -0,0 +1,355 @@
+package box
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"unicode"
+
+	"github.com/cosscom/shipyard/internal/statefile"
+)
+
+type browserDownloadSettings struct {
+	Enabled   bool   `json:"enabled"`
+	Ask       bool   `json:"ask"`
+	Directory string `json:"directory"`
+	Default   string `json:"defaultDirectory"`
+}
+
+var browserDownloadSettingsMu sync.Mutex
+
+func (m *Browsers) downloadSettings() browserDownloadSettings {
+	home, _ := os.UserHomeDir()
+	s := browserDownloadSettings{Default: filepath.Join(home, "Downloads")}
+	raw, err := os.ReadFile(filepath.Join(m.Dir, "download-settings.json"))
+	if err == nil && len(raw) < 16384 {
+		var saved struct {
+			Enabled   bool   `json:"enabled"`
+			Ask       bool   `json:"ask"`
+			Directory string `json:"directory"`
+		}
+		if json.Unmarshal(raw, &saved) == nil {
+			s.Enabled, s.Ask = saved.Enabled, saved.Ask
+			if filepath.IsAbs(saved.Directory) {
+				s.Directory = filepath.Clean(saved.Directory)
+			}
+		}
+	}
+	if s.Directory == "" {
+		s.Directory = s.Default
+	}
+	return s
+}
+
+func (b *Box) browserDownloadPreferences(w http.ResponseWriter, r *http.Request) error {
+	if EmbeddedFiles == "" || b.Browsers == nil {
+		return badRequest("download preferences need the LeadingLight runtime")
+	}
+	browserDownloadSettingsMu.Lock()
+	defer browserDownloadSettingsMu.Unlock()
+	s := b.Browsers.downloadSettings()
+	if r.Method == "PUT" {
+		var req struct {
+			Enabled   *bool   `json:"enabled"`
+			Ask       *bool   `json:"ask"`
+			Directory *string `json:"directory"`
+		}
+		if err := decode(r, &req); err != nil {
+			return err
+		}
+		if req.Enabled != nil {
+			s.Enabled = *req.Enabled
+		}
+		if req.Ask != nil {
+			s.Ask = *req.Ask
+		}
+		if req.Directory != nil {
+			dir := *req.Directory
+			if dir == "" {
+				dir = s.Default
+			}
+			if !filepath.IsAbs(dir) || strings.ContainsRune(dir, 0) || len(dir) > 8192 {
+				return badRequest("choose an absolute download folder")
+			}
+			st, err := os.Stat(dir)
+			if err != nil || !st.IsDir() {
+				return badRequest("the download folder is unavailable")
+			}
+			s.Directory = filepath.Clean(dir)
+		}
+		raw, err := json.Marshal(s)
+		if err != nil {
+			return err
+		}
+		if err := statefile.Write(filepath.Join(b.Browsers.Dir, "download-settings.json"), raw); err != nil {
+			return err
+		}
+	}
+	writeJSON(w, s)
+	return nil
+}
+
+func safeDownloadName(name string) string {
+	name = filepath.Base(strings.ReplaceAll(name, "\\", "/"))
+	name = strings.Map(func(r rune) rune {
+		if unicode.IsControl(r) {
+			return -1
+		}
+		return r
+	}, name)
+	name = strings.Trim(name, ". ")
+	for len(name) > 200 {
+		name = string([]rune(name)[:len([]rune(name))-1])
+	}
+	if name == "" {
+		return "download"
+	}
+	return name
+}
+
+// Exclusive creation prevents a web filename or a second download from replacing an existing file.
+func copyBrowserDownload(source, id, directory, suggested string) (saved string, err error) {
+	if !downloadID.MatchString(id) {
+		return "", errors.New("invalid download")
+	}
+	from, err := os.OpenRoot(source)
+	if err != nil {
+		return "", err
+	}
+	defer from.Close()
+	st, err := from.Lstat(id)
+	if err != nil {
+		return "", err
+	}
+	if !st.Mode().IsRegular() {
+		return "", errors.New("not a regular download")
+	}
+	in, err := from.Open(id)
+	if err != nil {
+		return "", err
+	}
+	defer in.Close()
+	opened, err := in.Stat()
+	if err != nil || !os.SameFile(st, opened) {
+		return "", errors.New("the download changed before saving")
+	}
+	to, err := os.OpenRoot(directory)
+	if err != nil {
+		return "", err
+	}
+	defer to.Close()
+	name := safeDownloadName(suggested)
+	ext := filepath.Ext(name)
+	stem := strings.TrimSuffix(name, ext)
+	var out *os.File
+	for n := 0; n < 10000; n++ {
+		candidate := name
+		if n > 0 {
+			candidate = fmt.Sprintf("%s (%d)%s", stem, n, ext)
+		}
+		out, err = to.OpenFile(candidate, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+		if errors.Is(err, os.ErrExist) {
+			continue
+		}
+		if err != nil {
+			return "", err
+		}
+		name = candidate
+		break
+	}
+	if out == nil {
+		return "", errors.New("too many downloads have this filename")
+	}
+	identity, identityErr := out.Stat()
+	defer func() {
+		closeErr := out.Close()
+		if err == nil {
+			err = closeErr
+		}
+		if err != nil {
+			// Do not remove a file another process replaced after our exclusive create.
+			current, z := to.Lstat(name)
+			if identityErr == nil && z == nil && os.SameFile(identity, current) {
+				_ = to.Remove(name)
+			}
+			saved = ""
+		}
+	}()
+	if identityErr != nil {
+		return "", identityErr
+	}
+	written, err := io.CopyBuffer(out, io.NewSectionReader(in, 0, st.Size()), make([]byte, 1<<20))
+	if err == nil && written != st.Size() {
+		err = io.ErrUnexpectedEOF
+	}
+	if err == nil {
+		now, statErr := in.Stat()
+		if statErr != nil || now.Size() != st.Size() || !now.ModTime().Equal(st.ModTime()) {
+			err = errors.New("the download changed while saving")
+		}
+	}
+	if err == nil {
+		err = out.Sync()
+	}
+	if err != nil {
+		current, e := to.Lstat(name)
+		if e == nil && os.SameFile(identity, current) {
+			_ = to.Remove(name)
+		}
+		return "", err
+	}
+	return filepath.Join(directory, name), nil
+}
+
+func (c *chromium) exportCompletedDownload(id string) {
+	if c.m == nil {
+		return
+	}
+	browserDownloadSettingsMu.Lock()
+	settings := c.m.downloadSettings()
+	browserDownloadSettingsMu.Unlock()
+	if !settings.Enabled || settings.Ask {
+		return
+	}
+	c.dmu.Lock()
+	d, ok := c.downloads[id]
+	active := 0
+	for _, item := range c.downloads {
+		if item.ExportState == "saving" || item.ExportState == "prompted" {
+			active++
+		}
+	}
+	if !ok || d.State != "completed" || !d.Identified || !userBrowserTab(d.Tab) || d.ExportState != "" || c.exports >= 2 || active >= 200 {
+		c.dmu.Unlock()
+		return
+	}
+	d.ExportState = "saving"
+	c.downloads[id] = d
+	raw, err := json.Marshal(c.downloads)
+	if err == nil {
+		err = statefile.Write(filepath.Join(downloadDir(c.path), "index.json"), raw)
+	}
+	if err != nil {
+		d.ExportState, d.ExportError = "error", "Could not record the save. Use Save to choose a destination."
+		c.downloads[id] = d
+		c.dmu.Unlock()
+		return
+	}
+	c.exports++
+	c.dmu.Unlock()
+	defer c.finishDownloadExport()
+	path, err := copyBrowserDownload(downloadDir(c.path), id, settings.Directory, d.Name)
+	c.dmu.Lock()
+	defer c.dmu.Unlock()
+	d, ok = c.downloads[id]
+	if !ok {
+		return
+	}
+	if err != nil {
+		d.ExportState, d.ExportError = "error", browserDownloadText(err.Error(), 1000)
+	} else {
+		d.ExportState, d.SavedPath = "saved", path
+	}
+	c.downloads[id] = d
+	raw, _ = json.Marshal(c.downloads)
+	_ = statefile.Write(filepath.Join(downloadDir(c.path), "index.json"), raw)
+}
+
+// Pending copies stay in the bounded history; finishing one fills the available worker slots.
+func (c *chromium) finishDownloadExport() {
+	c.dmu.Lock()
+	c.exports--
+	pending := make([]BrowserDownload, 0, len(c.downloads))
+	for _, d := range c.downloads {
+		if d.State == "completed" && d.Identified && userBrowserTab(d.Tab) && d.ExportState == "" {
+			pending = append(pending, d)
+		}
+	}
+	sort.Slice(pending, func(i, j int) bool { return pending[i].CreatedAt < pending[j].CreatedAt })
+	if len(pending) > 2-c.exports {
+		pending = pending[:2-c.exports]
+	}
+	c.dmu.Unlock()
+	for _, d := range pending {
+		go c.exportCompletedDownload(d.ID)
+	}
+}
+
+// Persist a single claim before opening a native dialog, including across duplicate panes and reloads.
+func (b *Box) browserDownloadPrompt(w http.ResponseWriter, r *http.Request) error {
+	id := r.PathValue("id")
+	if !downloadID.MatchString(id) {
+		return badRequest("invalid download")
+	}
+	_, wt, err := b.browserTarget(r)
+	if err != nil {
+		return err
+	}
+	c := b.Browsers.lookupChromium(wt.Path)
+	if c == nil {
+		return badRequest("the browser closed")
+	}
+	browserDownloadSettingsMu.Lock()
+	settings := b.Browsers.downloadSettings()
+	browserDownloadSettingsMu.Unlock()
+	c.dmu.Lock()
+	defer c.dmu.Unlock()
+	d, ok := c.downloads[id]
+	if !ok || d.State != "completed" || !userBrowserTab(d.Tab) {
+		return badRequest("this personal download is unavailable")
+	}
+	previous := d
+	if r.Method == "POST" {
+		active := 0
+		for _, item := range c.downloads {
+			if item.ExportState == "saving" || item.ExportState == "prompted" {
+				active++
+			}
+		}
+		if !settings.Enabled || !settings.Ask || !d.Identified || d.ExportState != "" || active >= 200 {
+			writeJSON(w, map[string]bool{"claimed": false})
+			return nil
+		}
+		d.ExportState = "prompted"
+	} else {
+		var req struct {
+			SavedPath string `json:"savedPath"`
+			Error     string `json:"error"`
+			Cancelled bool   `json:"cancelled"`
+		}
+		if err := decode(r, &req); err != nil {
+			return err
+		}
+		if d.ExportState != "prompted" {
+			return badRequest("this download has no pending save dialog")
+		}
+		if req.SavedPath != "" {
+			if !filepath.IsAbs(req.SavedPath) || strings.ContainsRune(req.SavedPath, 0) || len(req.SavedPath) > 8192 || req.Error != "" || req.Cancelled {
+				return badRequest("invalid saved file")
+			}
+			d.ExportState, d.SavedPath = "saved", filepath.Clean(req.SavedPath)
+		} else if req.Error != "" {
+			d.ExportState, d.ExportError = "error", browserDownloadText(req.Error, 1000)
+		} else {
+			d.ExportState = "dismissed"
+		}
+	}
+	c.downloads[id] = d
+	raw, err := json.Marshal(c.downloads)
+	if err == nil {
+		err = statefile.Write(filepath.Join(downloadDir(c.path), "index.json"), raw)
+	}
+	if err != nil {
+		c.downloads[id] = previous
+		return err
+	}
+	writeJSON(w, map[string]any{"claimed": r.Method == "POST", "id": d.ID, "name": d.Name, "tab": d.Tab})
+	return nil
+}
