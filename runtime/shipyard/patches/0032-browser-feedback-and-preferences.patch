+		br.inspectMu.Unlock()
+		wait("cancelled cleanup was not retried", func() bool { return eval(`document.querySelector('#first').style.color`) == `"red"` })
+	})
+	t.Run("area snapshot is scoped and retained", func(t *testing.T) {
+		v := br.currentViewport()
+		body := map[string]any{"x": 10, "y": 10, "width": 100, "height": 40, "viewport": map[string]int{"width": v.Width, "height": v.Height}, "expectedURL": site}
+		var out struct {
+			URL        string `json:"url"`
+			Screenshot struct {
+				File string `json:"file"`
+				Name string `json:"name"`
+			} `json:"screenshot"`
+		}
+		if err := request(b.browserInspectArea, body, &out); err != nil {
+			t.Fatal(err)
+		}
+		raw, err := os.ReadFile(out.Screenshot.File)
+		if err != nil {
