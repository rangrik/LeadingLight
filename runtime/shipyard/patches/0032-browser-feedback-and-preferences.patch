+// Competing viewers and reloads must never reopen a claimed native save dialog.
+func TestBrowserDownloadPromptClaim(t *testing.T) {
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = before })
+	b, wt, _ := browserBox(t, nil)
+	m := &Browsers{Dir: t.TempDir(), open: map[string]*chromium{}}
+	b.Browsers = m
+	c := &chromium{m: m, path: wt.Path, done: make(chan struct{}), downloads: map[string]BrowserDownload{
+		"personal": {ID: "personal", Name: "file.txt", Tab: "user-one", Identified: true, State: "completed"},
+		"agent":    {ID: "agent", Tab: "agent-one", Identified: true, State: "completed"},
+	}}
+	m.open[wt.Path] = c
+	if err := os.MkdirAll(downloadDir(wt.Path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(m.Dir, "download-settings.json"), []byte(`{"enabled":true,"ask":true}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	call := func(method, id, body string) (bool, error) {
+		r := httptest.NewRequest(method, "/?tab=user-one", strings.NewReader(body))
+		r.SetPathValue("loc", "cal")
+		r.SetPathValue("wt", "billing")
+		r.SetPathValue("id", id)
+		w := httptest.NewRecorder()
+		err := b.browserDownloadPrompt(w, r)
+		var result struct {
+			Claimed bool `json:"claimed"`
+		}
+		if err == nil {
+			err = json.Unmarshal(w.Body.Bytes(), &result)
+		}
+		return result.Claimed, err
+	}
+	var claimed atomic.Int32
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Go(func() {
+			ok, err := call("POST", "personal", "{}")
+			if err != nil {
+				t.Error(err)
+			}
+			if ok {
+				claimed.Add(1)
+			}
+		})
+	}
+	wg.Wait()
+	if claimed.Load() != 1 {
+		t.Fatal("duplicate claim", claimed.Load())
+	}
+	raw, err := os.ReadFile(filepath.Join(downloadDir(wt.Path), "index.json"))
+	var persisted map[string]BrowserDownload
+	if err != nil || json.Unmarshal(raw, &persisted) != nil || persisted["personal"].ExportState != "prompted" {
+		t.Fatal("claim not persisted", string(raw), err)
+	}
+	if got := readDownloads(wt.Path)["personal"].ExportState; got != "dismissed" {
+		t.Fatal("restart retained active dialog", got)
+	}
+	if _, err := call("PUT", "personal", `{"savedPath":"relative"}`); err == nil {
+		t.Fatal("accepted relative saved path")
+	}
+	if _, err := call("PUT", "personal", `{"cancelled":true}`); err != nil {
+		t.Fatal(err)
+	}
+	if ok, err := call("POST", "personal", "{}"); ok || err != nil {
+		t.Fatal("reopened cancelled dialog", ok, err)
+	}
+	if _, err := call("PUT", "personal", `{"savedPath":"/tmp/fake"}`); err == nil {
+		t.Fatal("changed a finished dialog")
+	}
+	if _, err := call("POST", "agent", "{}"); err == nil {
+		t.Fatal("claimed agent download")
+	}
+	c.downloads = readDownloads(wt.Path)
+	if ok, err := call("POST", "personal", "{}"); ok || err != nil {
+		t.Fatal("reopened after reload", ok, err)
+	}
+	c.downloads["overflow"] = BrowserDownload{ID: "overflow", Tab: "user-one", Identified: true, State: "completed"}
+	for i := range 200 {
+		id := fmt.Sprintf("pending-%d", i)
+		c.downloads[id] = BrowserDownload{ID: id, ExportState: "prompted"}
+	}
+	if ok, err := call("POST", "overflow", "{}"); ok || err != nil {
+		t.Fatal("unbounded active claims", ok, err)
+	}
+	if err := os.WriteFile(filepath.Join(m.Dir, "download-settings.json"), []byte(`{"enabled":true,"ask":false}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	c.exportCompletedDownload("overflow")
+	if c.downloads["overflow"].ExportState != "" {
+		t.Fatal("unbounded active exports")
+	}
+}
