+package boxcmd
+
+import "testing"
+
+// The CLI must keep the chosen tab and request approval rather than invent a grant.
+func TestBrowserDeveloperCommands(t *testing.T) {
+	r, _ := run(t, `{"text":"pending"}`, "browser", "developer-request", "cal/billing", "Inspect layout", "--tab", "user-one")
+	if r.path != "/v1/worktrees/cal/billing/browser/developer/request?tab=user-one" || r.body["reason"] != "Inspect layout" {
+		t.Fatal(r)
+	}
+	r, _ = run(t, `{"text":"{}"}`, "browser", "cdp", "cal/billing", "DOM.getDocument", `{"depth":2}`, "--tab", "user-one")
+	if r.path != "/v1/worktrees/cal/billing/browser/developer/cdp?tab=user-one" || r.body["method"] != "DOM.getDocument" || r.body["params"].(map[string]any)["depth"] != float64(2) {
+		t.Fatal(r)
+	}
+	r, _ = run(t, `{"text":"[]"}`, "browser", "developer-events", "cal/billing", "--after", "12", "--tab", "user-one")
+	if r.path != "/v1/worktrees/cal/billing/browser/developer/events?after=12&tab=user-one" {
+		t.Fatal(r)
+	}
+}
