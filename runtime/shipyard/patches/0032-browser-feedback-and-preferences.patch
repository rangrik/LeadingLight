@@ -0,0 +1,326 @@
+package box
+
+import (
+	"context"
+	"encoding/json"
+	"math"
+	"net/http"
+	"time"
+)
+
+type browserInspectionFrame struct {
+	URL  string   `json:"url"`
+	Path []string `json:"path"`
+}
+type inspectionFrame struct {
+	ID     string `json:"id"`
+	Parent string `json:"parentId"`
+	Loader string `json:"loaderId"`
+	URL    string `json:"url"`
+}
+type inspectionTree struct {
+	Frame    inspectionFrame  `json:"frame"`
+	Children []inspectionTree `json:"childFrames"`
+}
+
+func staleInspection() error {
+	return httpError{http.StatusConflict, "The element changed. Inspect it again."}
+}
+
+func (br *browser) inspectionFrames(ctx context.Context, wanted ...string) (map[string]inspectionFrame, error) {
+	var response struct {
+		Tree inspectionTree `json:"frameTree"`
+	}
+	if err := br.cdp.call(ctx, br.session, "Page.getFrameTree", nil, &response); err != nil {
+		return nil, err
+	}
+	frames := map[string]inspectionFrame{}
+	var walk func(inspectionTree)
+	walk = func(t inspectionTree) {
+		if _, ok := frames[t.Frame.ID]; !ok && len(frames) >= 256 {
+			return
+		}
+		if t.Frame.Parent == "" {
+			t.Frame.Parent = frames[t.Frame.ID].Parent
+		}
+		frames[t.Frame.ID] = t.Frame
+		for _, child := range t.Children {
+			walk(child)
+		}
+	}
+	walk(response.Tree)
+	var targets struct {
+		Targets []struct {
+			ID          string `json:"targetId"`
+			Type        string `json:"type"`
+			Parent      string `json:"parentId"`
+			ParentFrame string `json:"parentFrameId"`
+			URL         string `json:"url"`
+		} `json:"targetInfos"`
+	}
+	if err := br.cdp.call(ctx, "", "Target.getTargets", nil, &targets); err != nil {
+		return nil, err
+	}
+	for range 16 {
+		added := false
+		for _, target := range targets.Targets {
+			if target.Type != "iframe" || len(frames) >= 256 {
+				continue
+			}
+			if _, ok := frames[target.ID]; ok {
+				continue
+			}
+			parent := target.ParentFrame
+			if parent == "" {
+				parent = target.Parent
+			}
+			if _, ok := frames[parent]; ok {
+				frames[target.ID] = inspectionFrame{ID: target.ID, Parent: parent, URL: target.URL}
+				added = true
+			}
+		}
+		if !added {
+			break
+		}
+	}
+	if len(wanted) > 0 {
+		frame, ok := frames[wanted[0]]
+		if ok && frame.Loader == "" {
+			session, _, release, err := br.inspectionWorld(ctx, frame.ID)
+			if err != nil {
+				return nil, err
+			}
+			defer release()
+			if err = br.cdp.call(ctx, session, "Page.getFrameTree", nil, &response); err != nil {
+				return nil, err
+			}
+			walk(response.Tree)
+		}
+	}
+	return frames, nil
+}
+func inspectionFramePath(frames map[string]inspectionFrame, frame string) []string {
+	path := []string{}
+	for frame != "" && len(path) < 16 {
+		path = append([]string{frame}, path...)
+		frame = frames[frame].Parent
+	}
+	return path
+}
+
+// A child renderer needs its own CDP session; it is detached as soon as this request ends.
+func (br *browser) inspectionWorld(ctx context.Context, frame string) (string, int, func(), error) {
+	session := br.session
+	var world struct {
+		ID int `json:"executionContextId"`
+	}
+	create := func() error {
+		return br.cdp.call(ctx, session, "Page.createIsolatedWorld", map[string]any{"frameId": frame, "worldName": "leadinglight-element-feedback"}, &world)
+	}
+	release := func() {}
+	if err := create(); err != nil {
+		if frame == br.target {
+			return "", 0, release, staleInspection()
+		}
+		var attached struct {
+			Session string `json:"sessionId"`
+		}
+		if err = br.cdp.call(ctx, "", "Target.attachToTarget", map[string]any{"targetId": frame, "flatten": true}, &attached); err != nil {
+			return "", 0, release, staleInspection()
+		}
+		session = attached.Session
+		release = func() {
+			cleanup, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			br.cdp.call(cleanup, "", "Target.detachFromTarget", map[string]any{"sessionId": session}, nil)
+		}
+		if err = create(); err != nil {
+			release()
+			return "", 0, func() {}, staleInspection()
+		}
+	}
+	return session, world.ID, release, nil
+}
+
+const inspectionFrameOwnerFunction = `function(reveal){
+ if(!(this instanceof HTMLIFrameElement||this instanceof HTMLFrameElement)||!this.isConnected)return null;
+ if(reveal)Element.prototype.scrollIntoView.call(this,{block:'nearest',inline:'nearest',behavior:'instant'});
+ const r=this.getBoundingClientRect(),c=getComputedStyle(this),n=p=>parseFloat(c.getPropertyValue(p))||0;
+ const left=n('border-left-width')+n('padding-left'),right=n('border-right-width')+n('padding-right'),top=n('border-top-width')+n('padding-top'),bottom=n('border-bottom-width')+n('padding-bottom');
+ const border=c.boxSizing==='border-box',sx=r.width/(n('width')+(border?0:left+right)),sy=r.height/(n('height')+(border?0:top+bottom));
+ return {x:r.x+left*sx,y:r.y+top*sy,sx,sy};
+}`
+
+func (br *browser) inspectionBounds(ctx context.Context, frames map[string]inspectionFrame, frame string, bounds browserBounds, reveal bool) (browserBounds, error) {
+	path := inspectionFramePath(frames, frame)
+	if len(path) == 0 || path[0] != br.target || len(path) >= 16 {
+		return bounds, badRequest("This frame is nested too deeply to annotate.")
+	}
+	type offset struct {
+		X  float64 `json:"x"`
+		Y  float64 `json:"y"`
+		SX float64 `json:"sx"`
+		SY float64 `json:"sy"`
+	}
+	offsets := make([]offset, 0, len(path)-1)
+	for i := 1; i < len(path); i++ {
+		parent, child := path[i-1], path[i]
+		session, world, release, err := br.inspectionWorld(ctx, parent)
+		if err != nil {
+			return bounds, err
+		}
+		value, err := func() (offset, error) {
+			defer release()
+			var owner struct {
+				Node int64 `json:"backendNodeId"`
+			}
+			if err := br.cdp.call(ctx, session, "DOM.getFrameOwner", map[string]any{"frameId": child}, &owner); err != nil {
+				return offset{}, staleInspection()
+			}
+			var box struct {
+				Model struct {
+					Content []float64 `json:"content"`
+				} `json:"model"`
+			}
+			if err := br.cdp.call(ctx, session, "DOM.getBoxModel", map[string]any{"backendNodeId": owner.Node}, &box); err != nil {
+				return offset{}, staleInspection()
+			}
+			q := box.Model.Content
+			if len(q) != 8 || math.Abs(q[1]-q[3]) > .1 || math.Abs(q[0]-q[6]) > .1 || q[2] <= q[0] || q[5] <= q[1] {
+				return offset{}, badRequest("Rotated, skewed or mirrored frames cannot be annotated yet.")
+			}
+			var remote struct {
+				Object struct {
+					ID string `json:"objectId"`
+				} `json:"object"`
+			}
+			if err := br.cdp.call(ctx, session, "DOM.resolveNode", map[string]any{"backendNodeId": owner.Node, "executionContextId": world}, &remote); err != nil {
+				return offset{}, staleInspection()
+			}
+			defer br.cdp.call(ctx, session, "Runtime.releaseObject", map[string]any{"objectId": remote.Object.ID}, nil)
+			var result struct {
+				Result struct {
+					Value *offset `json:"value"`
+				} `json:"result"`
+				Exception json.RawMessage `json:"exceptionDetails"`
+			}
+			if err := br.cdp.call(ctx, session, "Runtime.callFunctionOn", map[string]any{"objectId": remote.Object.ID, "functionDeclaration": inspectionFrameOwnerFunction, "arguments": []map[string]any{{"value": reveal}}, "returnByValue": true}, &result); err != nil {
+				return offset{}, err
+			}
+			if result.Result.Value == nil || len(result.Exception) > 0 || result.Result.Value.SX <= 0 || result.Result.Value.SY <= 0 {
+				return offset{}, staleInspection()
+			}
+			return *result.Result.Value, nil
+		}()
+		if err != nil {
+			return bounds, err
+		}
+		offsets = append(offsets, value)
+	}
+	for i := len(offsets) - 1; i >= 0; i-- {
+		o := offsets[i]
+		bounds.X = o.X + bounds.X*o.SX
+		bounds.Y = o.Y + bounds.Y*o.SY
+		bounds.Width *= o.SX
+		bounds.Height *= o.SY
+	}
+	var metrics struct {
+		Visual struct {
+			X     float64 `json:"offsetX"`
+			Y     float64 `json:"offsetY"`
+			Scale float64 `json:"scale"`
+		} `json:"cssVisualViewport"`
+	}
+	if err := br.cdp.call(ctx, br.session, "Page.getLayoutMetrics", nil, &metrics); err != nil {
+		return bounds, err
+	}
+	scale := metrics.Visual.Scale
+	if scale <= 0 {
+		scale = 1
+	}
+	bounds.X = (bounds.X - metrics.Visual.X) * scale
+	bounds.Y = (bounds.Y - metrics.Visual.Y) * scale
+	bounds.Width *= scale
+	bounds.Height *= scale
+	return bounds, nil
+}
+
+func (br *browser) inspectionHit(ctx context.Context, x, y float64) (int64, string, error) {
+	session := br.session
+	documentX, documentY := x, y
+	var metrics struct {
+		Visual struct {
+			Scale float64 `json:"scale"`
+			X     float64 `json:"pageX"`
+			Y     float64 `json:"pageY"`
+		} `json:"cssVisualViewport"`
+	}
+	if err := br.cdp.call(ctx, session, "Page.getLayoutMetrics", nil, &metrics); err != nil {
+		return 0, "", err
+	}
+	scale := metrics.Visual.Scale
+	if scale <= 0 {
+		scale = 1
+	}
+	documentX = x/scale + metrics.Visual.X
+	documentY = y/scale + metrics.Visual.Y
+	for range 16 {
+		var hit struct {
+			Node  int64  `json:"backendNodeId"`
+			Frame string `json:"frameId"`
+		}
+		if err := br.cdp.call(ctx, session, "DOM.getNodeForLocation", map[string]any{"x": int(documentX), "y": int(documentY)}, &hit); err != nil {
+			return 0, "", err
+		}
+		var description struct {
+			Node struct {
+				Name  string `json:"nodeName"`
+				Frame string `json:"frameId"`
+			} `json:"node"`
+		}
+		if err := br.cdp.call(ctx, session, "DOM.describeNode", map[string]any{"backendNodeId": hit.Node}, &description); err != nil {
+			return 0, "", err
+		}
+		child := description.Node.Frame
+		if (description.Node.Name != "IFRAME" && description.Node.Name != "FRAME") || child == "" {
+			return hit.Node, hit.Frame, nil
+		}
+		childSession, world, release, err := br.inspectionWorld(ctx, child)
+		if err != nil || childSession == session {
+			if release != nil {
+				release()
+			}
+			return hit.Node, hit.Frame, nil
+		}
+		defer release()
+		frames, err := br.inspectionFrames(ctx, child)
+		if err != nil {
+			return 0, "", err
+		}
+		origin, err := br.inspectionBounds(ctx, frames, child, browserBounds{Width: 1, Height: 1}, false)
+		if err != nil {
+			return 0, "", err
+		}
+		localX, localY := (x-origin.X)/origin.Width, (y-origin.Y)/origin.Height
+		var size struct {
+			Result struct {
+				Value struct {
+					Width  float64 `json:"width"`
+					Height float64 `json:"height"`
+					X      float64 `json:"x"`
+					Y      float64 `json:"y"`
+				} `json:"value"`
+			} `json:"result"`
+		}
+		if err = br.cdp.call(ctx, childSession, "Runtime.evaluate", map[string]any{"contextId": world, "expression": "({width:innerWidth,height:innerHeight,x:scrollX,y:scrollY})", "returnByValue": true}, &size); err != nil {
+			return 0, "", err
+		}
+		if localX < 0 || localY < 0 || localX >= size.Result.Value.Width || localY >= size.Result.Value.Height {
+			return hit.Node, hit.Frame, nil
+		}
+		session = childSession
+		documentX = localX + size.Result.Value.X
+		documentY = localY + size.Result.Value.Y
+	}
+	return 0, "", badRequest("This frame is nested too deeply to annotate.")
+}
diff --git a/internal/box/browserinspectlease.go b/internal/box/browserinspectlease.go
new file mode 100644
index 0000000..d67a2cf
--- /dev/null
+++ b/internal/box/browserinspectlease.go
@@ -0,0 +1,190 @@
+package box
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"net/http"
+	"time"
+)
+
+const browserInspectionLeaseTTL = 15 * time.Second
+
+func expiredInspectionLease() error {
+	return httpError{http.StatusConflict, "This feedback session expired. Inspect the element again."}
+}
+
+func (b *Box) browserInspectLease(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Lease string `json:"lease"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	br.mu.Lock()
+	defer br.mu.Unlock()
+	if br.controls.closed {
+		return httpError{http.StatusConflict, "This tab closed."}
+	}
+	now := time.Now()
+	if req.Lease != "" && !now.Before(br.controls.inspectLeases[req.Lease]) {
+		return expiredInspectionLease()
+	}
+	if req.Lease == "" {
+		if len(br.controls.inspectLeases) >= 16 {
+			return badRequest("Too many viewers are commenting on this tab.")
+		}
+		var random [16]byte
+		if _, err = rand.Read(random[:]); err != nil {
+			return err
+		}
+		req.Lease = hex.EncodeToString(random[:])
+	}
+	if br.controls.inspectLeases == nil {
+		br.controls.inspectLeases = map[string]time.Time{}
+	}
+	until := now.Add(browserInspectionLeaseTTL)
+	br.controls.inspectLeases[req.Lease] = until
+	br.scheduleInspectionExpiry()
+	writeJSON(w, map[string]any{"lease": req.Lease, "expiresAt": until.UnixMilli()})
+	return nil
+}
+func (b *Box) browserReleaseInspectionLease(w http.ResponseWriter, r *http.Request) error {
+	var req struct {
+		Lease string `json:"lease"`
+	}
+	if err := decode(r, &req); err != nil {
+		return err
+	}
+	if req.Lease == "" {
+		return badRequest("name the feedback session to close")
+	}
+	br, _, _, err := b.browserFor(r, false)
+	if err != nil {
+		return err
+	}
+	br.inspectMu.Lock()
+	defer br.inspectMu.Unlock()
+	br.mu.Lock()
+	delete(br.controls.inspectLeases, req.Lease)
+	pending := map[string]*browserInspectedNode{}
+	for handle, node := range br.controls.inspected {
+		if node.lease == req.Lease {
+			pending[handle] = node
+			delete(br.controls.inspected, handle)
+		}
+	}
+	br.mu.Unlock()
+	ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+	defer cancel()
+	br.undoInspections(ctx, pending)
+	writeJSON(w, map[string]bool{"released": true})
+	return nil
+}
+
+// Call with br.mu held; renewal changes the deadline, never another viewer's ownership.
+func (br *browser) validInspectionLease(node *browserInspectedNode, lease string) bool {
+	if node.lease != lease {
+		return false
+	}
+	now := time.Now()
+	if lease != "" {
+		return now.Before(br.controls.inspectLeases[lease])
+	}
+	if !now.Before(node.expires) {
+		return false
+	}
+	node.expires = now.Add(browserInspectionLeaseTTL)
+	br.scheduleInspectionExpiry()
+	return true
+}
+func (br *browser) scheduleInspectionExpiry() {
+	if br.controls.inspectTimer != nil {
+		br.controls.inspectTimer.Stop()
+		br.controls.inspectTimer = nil
+	}
+	if br.controls.closed {
+		return
+	}
+	var next time.Time
+	take := func(t time.Time) {
+		if next.IsZero() || t.Before(next) {
+			next = t
+		}
+	}
+	for _, until := range br.controls.inspectLeases {
+		take(until)
+	}
+	for _, node := range br.controls.inspected {
+		if node.lease == "" {
+			take(node.expires)
+		}
+	}
+	if len(br.controls.inspectUndo) > 0 {
+		take(time.Now().Add(time.Second))
+	}
+	if !next.IsZero() {
+		br.controls.inspectTimer = time.AfterFunc(max(time.Millisecond, time.Until(next)), br.expireInspections)
+	}
+}
+func (br *browser) expireInspections() {
+	br.inspectMu.Lock()
+	defer br.inspectMu.Unlock()
+	br.mu.Lock()
+	now := time.Now()
+	for lease, until := range br.controls.inspectLeases {
+		if !now.Before(until) {
+			delete(br.controls.inspectLeases, lease)
+		}
+	}
+	pending := br.controls.inspectUndo
+	br.controls.inspectUndo = nil
+	if pending == nil {
+		pending = map[string]*browserInspectedNode{}
+	}
+	for handle, node := range br.controls.inspected {
+		expired := !now.Before(node.expires)
+		if node.lease != "" {
+			expired = !now.Before(br.controls.inspectLeases[node.lease])
+		}
+		if expired {
+			pending[handle] = node
+			delete(br.controls.inspected, handle)
+		}
+	}
+	br.mu.Unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	br.undoInspections(ctx, pending)
+	br.mu.Lock()
+	br.scheduleInspectionExpiry()
+	br.mu.Unlock()
+}
+func (br *browser) undoInspections(ctx context.Context, pending map[string]*browserInspectedNode) {
+	for handle, node := range pending {
+		if len(node.original) == 0 {
+			continue
+		}
+		_, _, err := br.inspectNode(ctx, node.node, "", "", node.original, browserInspectOptions{frame: node.frame, loader: node.loader, baseline: node.baseline})
+		if err != nil {
+			if e, ok := err.(httpError); ok && e.status == http.StatusConflict {
+				continue
+			}
+			br.mu.Lock()
+			if !br.controls.closed {
+				if br.controls.inspectUndo == nil {
+					br.controls.inspectUndo = map[string]*browserInspectedNode{}
+				}
+				br.controls.inspectUndo[handle] = node
+			}
+			br.mu.Unlock()
+		}
+	}
+	br.mu.Lock()
+	br.scheduleInspectionExpiry()
+	br.mu.Unlock()
+}
