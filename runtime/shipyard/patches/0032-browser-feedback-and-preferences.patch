+// Native activation and personal-tab ownership gate automatic filesystem writes.
+func TestBrowserDownloadPreferencesAndExport(t *testing.T) {
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = before })
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	defaultDir := filepath.Join(home, "Downloads")
+	if err := os.Mkdir(defaultDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	dest := t.TempDir()
+	m := &Browsers{Dir: t.TempDir()}
+	b := &Box{Browsers: m}
+	preferences := func(method, body string) (browserDownloadSettings, error) {
+		r := httptest.NewRequest(method, "/v1/browser/download-settings", strings.NewReader(body))
+		w := httptest.NewRecorder()
+		err := b.browserDownloadPreferences(w, r)
+		var settings browserDownloadSettings
+		if err == nil {
+			err = json.Unmarshal(w.Body.Bytes(), &settings)
+		}
+		return settings, err
+	}
+	s, err := preferences("GET", "")
+	if err != nil || s.Enabled || s.Ask || s.Directory != defaultDir {
+		t.Fatal(s, err)
+	}
+	encoded, _ := json.Marshal(map[string]any{"enabled": true, "directory": dest})
+	s, err = preferences("PUT", string(encoded))
+	if err != nil || !s.Enabled || s.Directory != dest || s.Ask {
+		t.Fatal(s, err)
+	}
+	for _, body := range []string{`{"directory":"relative"}`, `{"directory":"/missing-download-folder"}`} {
+		if _, err := preferences("PUT", body); err == nil {
+			t.Fatal("accepted invalid folder")
+		}
+	}
+	c := &chromium{m: m, path: t.TempDir(), downloads: map[string]BrowserDownload{}}
+	dir := downloadDir(c.path)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range []BrowserDownload{
+		{ID: "personal", Tab: "user-one", Identified: true, State: "completed"},
+		{ID: "agent", Tab: "agent-one", Identified: true, State: "completed"},
+		{ID: "unknown", Tab: "user-one", State: "completed"},
+		{ID: "partial", Tab: "user-one", Identified: true, State: "inProgress"},
+	} {
+		d.Name = d.ID + ".txt"
+		c.downloads[d.ID] = d
+		if err := os.WriteFile(filepath.Join(dir, d.ID), []byte(d.ID), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		c.exportCompletedDownload(d.ID)
+	}
+	if d := c.downloads["personal"]; d.ExportState != "saved" || d.SavedPath != filepath.Join(dest, "personal.txt") {
+		t.Fatal(d)
+	}
+	c.exportCompletedDownload("personal")
+	entries, _ := os.ReadDir(dest)
+	if len(entries) != 1 {
+		t.Fatal("exported agent, unknown, partial or duplicate download", entries)
+	}
+	if _, err := preferences("PUT", `{"ask":true}`); err != nil {
+		t.Fatal(err)
+	}
+	c.downloads["ask"] = BrowserDownload{ID: "ask", Name: "ask", Tab: "user-one", Identified: true, State: "completed"}
+	c.exportCompletedDownload("ask")
+	if c.downloads["ask"].ExportState != "" {
+		t.Fatal("copied Ask download")
+	}
+	delete(c.downloads, "ask")
+	if _, err := preferences("PUT", `{"ask":false}`); err != nil {
+		t.Fatal(err)
+	}
+	c.downloads["missing"] = BrowserDownload{ID: "missing", Tab: "user-one", Identified: true, State: "completed"}
+	c.exportCompletedDownload("missing")
+	if d := c.downloads["missing"]; d.ExportState != "error" || d.ExportError == "" || d.SavedPath != "" {
+		t.Fatal("failed export reported saved", d)
+	}
+	s, err = preferences("PUT", `{"directory":""}`)
+	if err != nil || s.Directory != defaultDir {
+		t.Fatal("reset failed", s, err)
+	}
+}
