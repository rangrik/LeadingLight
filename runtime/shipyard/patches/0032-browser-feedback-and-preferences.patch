+		if err := request(b.browserInspectLease, map[string]string{"lease": a}, &renewed); err != nil {
+			t.Fatal(err)
+		}
+		if time.Until(time.UnixMilli(renewed.ExpiresAt)) < 10*time.Second {
+			t.Fatal("renewal did not extend the preview lease")
+		}
+		if eval(`document.querySelector('#first').style.color`) != `"blue"` {
+			t.Fatal("renewed preview expired")
