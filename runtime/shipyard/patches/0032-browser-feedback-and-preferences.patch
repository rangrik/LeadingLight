+// History trimming must not lose the result of an active copy or native Save dialog.
+func TestBrowserDownloadRetentionPinsActiveExports(t *testing.T) {
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = before })
+	c := &chromium{path: t.TempDir(), downloads: map[string]BrowserDownload{}}
+	if err := os.MkdirAll(downloadDir(c.path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	for i := range 201 {
+		id := fmt.Sprintf("file-%03d", i)
+		c.downloads[id] = BrowserDownload{ID: id, State: "completed", CreatedAt: fmt.Sprintf("%04d", i)}
+	}
+	for id, state := range map[string]string{"file-000": "prompted", "file-001": "saving"} {
+		d := c.downloads[id]
+		d.ExportState = state
+		c.downloads[id] = d
+	}
+	c.downloadEvent("Browser.downloadProgress", json.RawMessage(`{"guid":"file-200","state":"completed"}`))
+	if len(c.downloads) != 200 || c.downloads["file-000"].ExportState != "prompted" || c.downloads["file-001"].ExportState != "saving" {
+		t.Fatal("trimmed an active export")
+	}
+	if _, kept := c.downloads["file-002"]; kept {
+		t.Fatal("did not trim oldest inactive record")
+	}
+	restarted := readDownloads(c.path)
+	if restarted["file-000"].ExportState != "dismissed" || restarted["file-001"].ExportState != "error" {
+		t.Fatal("restart retained active export states")
+	}
+}
+
+// A completion burst must drain pending files without running more than two automatic copies.
+func TestBrowserDownloadExportsDrainWithBoundedWorkers(t *testing.T) {
+	before := EmbeddedFiles
+	EmbeddedFiles = t.TempDir()
+	t.Cleanup(func() { EmbeddedFiles = before })
+	dest := t.TempDir()
+	m := &Browsers{Dir: t.TempDir()}
+	raw, _ := json.Marshal(browserDownloadSettings{Enabled: true, Directory: dest})
+	if err := os.WriteFile(filepath.Join(m.Dir, "download-settings.json"), raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	c := &chromium{m: m, path: t.TempDir(), downloads: map[string]BrowserDownload{}}
+	if err := os.MkdirAll(downloadDir(c.path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	payload := bytes.Repeat([]byte("bounded-copy"), 100000)
+	for i := range 16 {
+		id := fmt.Sprintf("file-%02d", i)
+		c.downloads[id] = BrowserDownload{ID: id, Name: id, State: "completed", Tab: "user-one", Identified: true}
+		if err := os.WriteFile(filepath.Join(downloadDir(c.path), id), payload, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for id := range c.downloads {
+		wg.Go(func() { <-start; c.exportCompletedDownload(id) })
+	}
+	close(start)
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		c.dmu.Lock()
+		active, saved := c.exports, 0
+		for _, d := range c.downloads {
+			if d.ExportState == "saved" {
+				saved++
+			}
+		}
+		c.dmu.Unlock()
+		if active > 2 {
+			t.Fatal("unbounded copies", active)
+		}
+		if saved == 16 && active == 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("pending exports did not drain", saved, active)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	wg.Wait()
+	for i := range 16 {
+		data, err := os.ReadFile(filepath.Join(dest, fmt.Sprintf("file-%02d", i)))
+		if err != nil || !bytes.Equal(data, payload) {
+			t.Fatal("changed saved bytes", i, err)
+		}
+	}
+}
