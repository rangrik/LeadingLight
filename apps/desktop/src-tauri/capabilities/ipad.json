{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "ipad",
  "description": "Local notes and attachments in the iPad app",
  "platforms": ["iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "opener:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "itms-services://*" }] },
    "leadinglight-preview:allow-asset-preview",
    "leadinglight-preview:allow-asset-capture",
    "leadinglight-preview:allow-asset-text",
    "leadinglight-preview:allow-voice-transcribe",
    "leadinglight-preview:allow-paper-edit",
    "leadinglight-preview:allow-document-ink",
    "sql:default",
    "sql:allow-execute",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "dialog:allow-open"
  ]
}
