{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeadingLight",
  "version": "0.2.0",
  "identifier": "com.leadinglight.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LeadingLight",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 28
        },
        "dragDropEnabled": false
      },
      {
        "label": "capture",
        "title": "New idea",
        "url": "capture.html",
        "width": 688,
        "height": 368,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "externalBin": [
      "binaries/berthd",
      "binaries/tmux",
      "binaries/leadinglight-transcribe"
    ],
    "resources": {
      "../../../LICENSE": "licenses/leadinglight/LICENSE",
      "../../../runtime/tmux/licenses/": "licenses/tmux/",
      "../licenses/": "licenses/app/",
      "../../../vendor/shipyard/LICENSE": "licenses/shipyard/LICENSE",
      "../../../vendor/shipyard/THIRD_PARTY_NOTICES.md": "licenses/shipyard/THIRD_PARTY_NOTICES.md"
    }
  }
}
