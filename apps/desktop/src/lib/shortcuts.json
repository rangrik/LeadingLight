{
  "_": "LeadingLight's keyboard shortcuts, in Shipyard's shape (vendor/shipyard/app/src/lib/shortcuts.ts reads it through an alias; src-tauri/src/menu.rs builds the Mac menu bar from it). group is the menu an item is in; accel, when set, puts it there with that accelerator, so macOS cannot take the key first. Never give ⌘C, ⌘V, ⌘A or ⌘F an accelerator: text fields need them. The editor's own keys (⌘B, ⌘I, ⌘/ for the block menu, …) stay out: its toolbar shows them. Settings › Shortcuts can change any key here (lib/keymap.ts).",
  "shortcuts": [
    { "id": "new-page", "group": "File", "label": "New page", "keys": "⌘N", "accel": "CmdOrCtrl+N" },
    { "id": "new-idea", "group": "File", "label": "New idea", "keys": "⌃⌥I", "accel": "Ctrl+Alt+I" },
    { "id": "save", "group": "File", "label": "Save", "keys": "⌘S", "accel": "CmdOrCtrl+S", "what": "Save now" },
    { "id": "sidebar", "group": "View", "label": "Show or hide the sidebar", "keys": "⌘\\", "accel": "CmdOrCtrl+\\" },
    { "id": "zoom-in", "group": "View", "label": "Zoom in", "keys": "⌘+", "accel": "CmdOrCtrl+=", "sep": true },
    { "id": "zoom-out", "group": "View", "label": "Zoom out", "keys": "⌘−", "accel": "CmdOrCtrl+-" },
    { "id": "zoom-reset", "group": "View", "label": "Actual size", "keys": "⌘0", "accel": "CmdOrCtrl+0" },
    { "id": "focus", "group": "View", "label": "Focus mode", "keys": "⇧⌘F", "accel": "CmdOrCtrl+Shift+F", "sep": true },
    { "id": "syntax", "group": "View", "label": "Syntax highlight", "keys": "⇧⌘D", "accel": "CmdOrCtrl+Shift+D" },
    { "id": "style", "group": "View", "label": "Style check", "keys": "⌥⇧⌘D", "accel": "CmdOrCtrl+Alt+Shift+D" },
    { "id": "grammar", "group": "View", "label": "Grammar check", "keys": "⇧⌘G", "accel": "CmdOrCtrl+Shift+G" },
    { "id": "count", "group": "View", "label": "Counts", "keys": "⇧⌘W", "accel": "CmdOrCtrl+Shift+W" },
    { "id": "ask", "group": "Go", "label": "Ask about this…", "keys": "⌘J", "accel": "CmdOrCtrl+J", "what": "Ask Claude about the selected words, or the page" },
    { "id": "feed", "group": "Go", "label": "Feed", "keys": "⌥⌘F", "accel": "CmdOrCtrl+Alt+F", "what": "Show or hide what agents need from you" },
    { "id": "settings", "group": "Go", "label": "Settings…", "keys": "⌘,", "accel": "CmdOrCtrl+,", "sep": true },
    { "id": "shortcuts", "group": "Help", "label": "Keyboard shortcuts", "keys": "⌘⌥/", "accel": "CmdOrCtrl+Alt+/" }
  ]
}
