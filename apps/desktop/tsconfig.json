{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "~/*": ["./src/*"],
      "@/lib/shortcuts.json": ["./src/lib/shortcuts.json"],
      "@/*": ["../../vendor/shipyard/app/src/*"],
      "@berth/plugin": ["../../vendor/shipyard/packages/plugin-sdk/src/index.ts"],
      "@berth/plugin/ui": ["../../vendor/shipyard/packages/plugin-sdk/src/ui.ts"],
      "@leadinglight/ui/*": ["../../packages/ui/src/*"],
      "@leadinglight/editor/*": ["../../packages/editor/src/*"]
    }
  },
  "include": ["src", "qa", "../../vendor/shipyard/app/src/vite-env.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
