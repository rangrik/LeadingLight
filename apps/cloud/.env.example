APP_ORIGIN=http://127.0.0.1:1431
DATABASE_URL=postgres://leadinglight:local-development-only@127.0.0.1:55439/leadinglight
# Generate a different random 32+ character secret for production.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Approved ChatGPT commercial client only; this is identity, not an API subscription.
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
# Private by default. Add account ids from /api/me, or deliberately opt into public access.
CLOUD_ALLOWED_USERS=
CLOUD_ACCESS=private

# Google Calendar uses the Google web client above and a separate token encryption key.
# Register APP_ORIGIN/api/calendar/callback as an exact Google redirect URI.
# Generate once with: openssl rand -base64 32. Keep it stable and backed up privately.
CALENDAR_TOKEN_KEY=

# Keep existing browser sessions and installed devices working during the address change.
LEGACY_APP_ORIGINS=
