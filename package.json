{
  "name": "leadinglight",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @leadinglight/desktop tauri dev",
    "build": "pnpm --filter @leadinglight/desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "qa": "pnpm --filter @leadinglight/desktop qa",
    "check:themes": "pnpm --filter @leadinglight/themes run check",
    "sync:shipyard": "scripts/sync-shipyard.sh",
    "install:app": "scripts/install-app.sh",
    "install:dev-app": "scripts/install-dev-app.sh",
    "ios:init": "scripts/ios.sh init --ci",
    "ios:build": "scripts/ios.sh build --target aarch64 --debug --no-sign --archive-only",
    "ios:build:sim": "scripts/ios.sh build --target aarch64-sim --debug --no-sign --archive-only",
    "ios:archive": "scripts/ios.sh release-archive",
    "ios:export": "scripts/ios.sh release-export",
    "runtime:build": "scripts/project-runtime/build.sh && scripts/project-runtime/build-tmux.sh",
    "runtime:probe": "node scripts/project-runtime/probe.mjs"
  }
}
