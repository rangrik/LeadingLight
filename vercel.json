{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @leadinglight/cloud migrate && pnpm --filter @leadinglight/desktop build && DOCS_BASE=/help/ pnpm --filter @leadinglight/docs build && cp -R apps/docs/.vitepress/dist apps/desktop/dist/help",
  "outputDirectory": "apps/desktop/dist",
  "regions": ["iad1"],
  "functions": { "api/gateway.mjs": { "maxDuration": 180 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway?route=:path*" },
    { "source": "/((?!help/|google91415a0dc0d5c471.html|assets/|sw.js|manifest.webmanifest|icon.svg|apple-touch-icon.png|builtin-plugins/).*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.leadinglight.app" }], "destination": "https://leadinglight.app/:path*", "permanent": true },
    { "source": "/help", "destination": "/help/", "permanent": true }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "same-origin" }, { "key": "X-Frame-Options", "value": "DENY" }] }
  ]
}
